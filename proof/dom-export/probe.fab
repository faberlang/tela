+++
locale = "en"
+++

# Cross-package consumer of the EXPORTED SUBSET of the live-used tela:dom
# surface in examples/triga-drift-city, examples/triga-budapest, and
# examples/hello-voxel. Handler implementations and state types are named here.
# The nine handler registration fns are checked as KNOWN-ABSENT in
# known-absent.fab, not claimed as consumable through the file interface.
# G4 authority: src/dom.fab, fix:g4: "the 9 `dom.on*` WARN014 skips are
# RECORDED"; they are "read through the documented host binding at the
# harness boundary (the DOM_NS assembly)". See also AGENTS.md, Stage 3
# "Export and workaround state". This is a limitation, not API retirement.

import from "tela:dom" public * as dom

fn handle_frame(dom.FrameState frame) → void {
    print frame.frame
}

fn handle_resize(dom.ResizeState resize) → void {
    print resize.width
}

fn handle_key(dom.KeyboardState key) → void {
    print key.code
}

fn handle_pointer(dom.PointerState pointer) → void {
    print pointer.x
}

fn handle_focus(dom.FocusState focus) → void {
    print focus.focused
}

fn handle_lock(dom.PointerLockState state) → void {
    print state.locked
}

fn handle_submit(dom.Element form) → void {
    print form
}

fn handle_event(dom.DomEvent event) → void {
    print event.kind
}

fn probe_live_surface() → list<dom.Subscription> {
    const dom.Scope made ← dom.scope("#probe")
    const dom.Element extra ← dom.element(".extra")
    const dom.Element root ← dom.require(made, ".root")
    const dom.SubmitOptions opts ← dom.SubmitOptions { prevent_default = true }
    const dom.PointerLockState lock ← dom.pointer_lock_state(root)
    const dom.PointerLockState requested ← dom.request_pointer_lock(root)
    print extra
    print opts
    print lock
    print requested
    print handle_frame
    print handle_resize
    print handle_key
    print handle_pointer
    print handle_focus
    print handle_lock
    print handle_submit
    print handle_event
    dom.text_set(root, "ok")
    dom.attr_set(root, "data-ok", "1")
    dom.class_add(root, "ready")
    dom.class_remove(root, "pending")
    const list<dom.Subscription> empty ← empty
    return empty
}

main {
    print probe_live_surface()
}
