# tela/proof/benchmark/extension-lib/src/extension.fab
# Stage 1 U5 benchmark — the extension package's public surface (real package,
# provider extensionlib). A SEPARATE package from the kernel: own faber.toml,
# flat single module (G4 rule), importing tela:tela through the public seam.
#
# This package contributes (public shape only — no tela/radix edits):
#   1. one custom view helper — bar_metrum (horizontal bar meter with label
#      and textual value) returning the kernel's tela.Visus;
#   2. one namespaced theme token — chart.axis.muted (campaign §5: extension
#      libraries add namespaced tokens; Tela does not widen a closed Theme)
#      plus the component style bundle chart_stilum referencing it;
#   3. the U6 static-render input: the app imports tela:tela + extensionlib:extension
#      and renders the composition through tela.html_visus / tela.css.
#
# Seam posture (recorded G/D workarounds, applied not fought):
#   - G2: wildcard import + qualified references (bare type binds do not work);
#   - G1: namespace values via the kernel's html_spatium()/svg_spatium() helpers;
#   - G3: imported-union construction via kernel-owned constructors
#     (elementum_omne/elementum_view/...);
#   - G4 seam (the U5 named escalation): this module's PUBLIC signatures
#     reference the imported sibling type tela.Visus / tela.Stilum. If the
#     export snapshot skips them (WARN014.file_interface_export_skipped), the
#     app falls back to composing with tela constructors + consuming the
#     token + style bundle — recorded in stage-1-benchmark-static.md; the
#     contract is not weakened (no duplicated Visus in this extension).
#
# Stage 2 U3 — fix:snapshot-nomen-collision (NEW observation, escalated to
# the radix lane): the extension's local token class was originally named
# `Scopulum`, which COLLIDES with the kernel's U1 `Scopulum` type in the
# shared file-interface snapshot — importing BOTH packages made the snapshot
# skip every class-returning export in both providers (WARN014 cascade) and
# broke the app's token binding. The workaround: the extension's local token
# class is renamed `Scopulus` (a distinct name — extension-local classes must
# avoid kernel type names). Additionally the extension-local class name is
# NOT a nameable qualified type from the app (SEM002 qualified_type_not_exported),
# so consumers read tokens via field access on the zero-arg accessor call
# results (tela.scopulum(ext.chart_axis_muted().nomen, ...).valor)) — the
# compose-without collect-app-side pattern. Removal of both workarounds is a
# grep-replace after the radix snapshot fix lands.

import from "tela:tela" public * ut tela

# --- Namespaced theme token (declared only; theme/token rendering is Stage 2)

class Scopulus {
    string nomen
    string valor
}

fn chart_axis_muted() → Scopulus {
    return Scopulus { nomen = "chart.axis.muted", valor = "#6b7280" }
}

# --- Tenebrae (dark) theme tokens — the second, materially different token
# collection (Stage 2 U3). Same namespaced paths as the light palette, with
# different values: the two-theme proof renders the same component tree
# under both, and only the token layer differs.

fn chart_axis_muted_tenebrae() → Scopulus {
    return Scopulus { nomen = "chart.axis.muted", valor = "#9ca3af" }
}

fn chart_grid_muted() → Scopulus {
    return Scopulus { nomen = "chart.grid.muted", valor = "#e5e7eb" }
}

fn chart_grid_muted_tenebrae() → Scopulus {
    return Scopulus { nomen = "chart.grid.muted", valor = "#1f2937" }
}

# The extension's token collection (what a product assembler would collect;
# product assembly / cascade ordering is Stage 2).
fn chart_scopuli() → list<Scopulus> {
    return [ chart_axis_muted(), chart_grid_muted() ]
}

# The extension's dark token collection (the tenebrae palette).
fn chart_scopuli_tenebrae() → list<Scopulus> {
    return [ chart_axis_muted_tenebrae(), chart_grid_muted_tenebrae() ]
}

# --- Custom view helper (G4 seam): horizontal bar meter with label + textual
# value, returning the kernel's tela.Visus. Behavior stays adjacent and typed
# (Stage 3); this benchmark is static composition only.

fn bar_metrum(string label, string valor, int latitudo) → tela.Visus {
    # The Proprietas below (aria-valuenow) is a browser-lane DOM property:
    # carried in the tree, NOT serialized statically (Stage 1 static
    # posture; the data-prop: marker is superseded).
    return tela.elementum_omne(
        tela.nova_identitas("tela-chart-bar"),
        tela.html_spatium(),
        "div",
        [
            tela.Attributum { nomen = "role", valor = "meter" },
            tela.Attributum { nomen = "aria-label", valor = label },
            tela.Attributum { nomen = "data-latitudo", valor = "§"(latitudo) }
        ],
        [
            tela.Proprietas { nomen = "aria-valuenow", valor = valor }
        ],
        [
            tela.elementum_view(tela.html_spatium(), "span", [ tela.textus_view(label) ]),
            tela.elementum_view(tela.html_spatium(), "x-bar", [
                tela.elementum_view(tela.html_spatium(), "x-fill", [ tela.textus_view(valor) ])
            ])
        ]
    )
}

# --- Component style bundle (G4 seam): returns the kernel's tela.Stilum; the
# rule references the namespaced token as the CSS custom property
# --chart-axis-muted (declared, not rendered — token rendering is Stage 2).

fn chart_stilum() → tela.Stilum {
    return tela.Stilum {
        regulae = [
            tela.Regula {
                selector = "[data-tela='tela-chart-bar']",
                declarationes = [
                    tela.Declaratio { nomen = "color", valor = "var(--chart-axis-muted)" },
                    tela.Declaratio { nomen = "display", valor = "grid" },
                    tela.Declaratio { nomen = "gap", valor = "0.5rem" }
                ]
            }
        ]
    }
}
