import from "tela:tela" public * ut tela
import from "extensionlib:extension" public * ut ext
import from "formslib:forms" public * ut forms
import from "tela:browser" public * ut browser
import from "tela:reference" public * ut ref
import from "web:dom" public * ut dom

# --- Themed panel: a div with a stable identity + accessible name; the panel
# rule in main's style bundle keys on the identity (policy (d) seam).
# Stage 5 U3 rename: `panel` → `app_panel` — the catalog's `ref.panel`
# component fn (tela:reference, U3) shares the assembled TS file with this
# app fn in the harness assemblies; the duplicate top-level `panel`
# declaration broke the tsc lane (TS2393). The app fn is app-owned; the
# rename keeps the rendered bytes identical (the canary-panelum identity +
# aria-label are unchanged).

fn app_panel(list<tela.View> children) → tela.View {
    return tela.element_full(
        tela.new_identity("canary-panelum"),
        tela.html_space(),
        "div",
        [ tela.Attribute { name = "aria-label", value = "metric panel" } ],
        [],
        children
    )
}

# --- Two-column metric table: dl with dt/dd pairs (labels + values).

fn metric_table() → tela.View {
    return tela.element_view(tela.html_space(), "dl", [
        tela.element_view(tela.html_space(), "dt", [ tela.text_view("uptime") ]),
        tela.element_view(tela.html_space(), "dd", [ tela.text_view("99.9%") ]),
        tela.element_view(tela.html_space(), "dt", [ tela.text_view("requests") ]),
        tela.element_view(tela.html_space(), "dd", [ tela.text_view("12 480") ]),
        tela.element_view(tela.html_space(), "dt", [ tela.text_view("error rate") ]),
        tela.element_view(tela.html_space(), "dd", [ tela.text_view("0.02%") ])
    ])
}

# --- Horizontal bar meter — app-side composition (G4 workaround). ---------
# The extension's bar_meter (tela.View-returning signature) is skipped in
# the cross-package export snapshot (WARN014 — G4 confirmed against the
# kernel; recorded in stage-1-benchmark-static.md). Per the U5 spec's
# documented workaround, the app composes the same meter shape with tela
# constructors and consumes the extension's token + style bundle. The
# contract is not weakened: the extension keeps its bar_meter seam and no
# duplicated View exists IN the extension.
fn bar_meter_app(string label, string value, int width) → tela.View {
    return tela.element_full(
        tela.new_identity("tela-chart-bar"),
        tela.html_space(),
        "div",
        [
            tela.Attribute { name = "role", value = "meter" },
            tela.Attribute { name = "aria-label", value = label },
            tela.Attribute { name = "data-latitudo", value = "§"(width) }
        ],
        [],
        [
            tela.element_view(tela.html_space(), "span", [ tela.text_view(label) ]),
            tela.element_view(tela.html_space(), "x-bar", [
                tela.element_view(tela.html_space(), "x-fill", [ tela.text_view(value) ])
            ])
        ]
    )
}

# ===========================================================================
# Stage 3 U3 — the segmented-control component (behavior-design §1).
#
# The control is an ordinary component function over typed props (no
# compiler-known component kind) producing a View with:
#   - stable data-tela identities on the group + per segment (§1.1);
#   - role='radiogroup' on the group, role='radio' + aria-selected
#     true/false on the segments (§1.4);
#   - the keyboard-contract structure: one tab stop as a whole (§1.3) —
#     the selected segment carries tabindex='0', the others tabindex='-1'
#     (only the selected segment is in the tab sequence; Tab leaves the
#     control as a unit);
#   - the control-owned declared live region (role='status' +
#     aria-live='polite', §1.5).
# The same component function renders statically (through html_visus, below)
# and mounts interactively (the driver) — shared-source evidence.
# ===========================================================================

class ControlProps {
    list<string> options
    string selected
    string name
}

fn selected_text(bool selected) → string {
    if selected then return "true"
    return "false"
}

fn active_tabindex(bool selected) → string {
    if selected then return "0"
    return "-1"
}

# One segment: role=radio + aria-selected + the roving tabindex (§1.3/§1.4).
fn segment_view(string identity, string optio, string tabindex, string selected) → tela.View {
    return tela.element_full(
        tela.new_identity(identity),
        tela.html_space(),
        "button",
        [
            tela.Attribute { name = "role", value = "radio" },
            tela.Attribute { name = "aria-selected", value = selected },
            tela.Attribute { name = "tabindex", value = tabindex }
        ],
        [],
        [ tela.text_view(optio) ]
    )
}

# The control-owned declared live region (§1.5): explicitly marked with a
# live-region policy (role='status' / aria-live='polite'), owned by the
# control, not an ambient page notification.
fn live_region() → tela.View {
    return tela.element_full(
        tela.new_identity("tela-live"),
        tela.html_space(),
        "div",
        [
            tela.Attribute { name = "role", value = "status" },
            tela.Attribute { name = "aria-live", value = "polite" }
        ],
        [],
        []
    )
}

# The segment children in focus order (index 1-based identity: tela-seg-N).
fn control_segments(ControlProps props) → list<tela.View> {
    var list<tela.View> segmenta ← vacua
    var int i ← 1
    while i ≤ props.options.longitudo() {
        const string identity ← "tela-seg-" + "§"(i)
        const string optio ← props.options[i - 1]
        const bool selected ← identity ≡ props.selected
        segmenta.appende(segment_view(identity, optio, active_tabindex(selected), selected_text(selected)))
        i ← i + 1
    }
    segmenta.appende(live_region())
    return segmenta
}

# The segmented-control component: ordinary Faber over typed props (campaign
# §3 component contract) → a View keyed to stable data-tela identities.
fn segmented_control(ControlProps props) → tela.View {
    return tela.element_full(
        tela.new_identity("tela-control"),
        tela.html_space(),
        "div",
        [
            tela.Attribute { name = "role", value = "radiogroup" },
            tela.Attribute { name = "aria-label", value = props.name }
        ],
        [],
        control_segments(props)
    )
}

# The default control props (the shared source both renderers consume).
fn control_props() → ControlProps {
    return ControlProps {
        options = ["One", "Two", "Three"],
        selected = "tela-seg-1",
        name = "segmented control"
    }
}

# Props with a changed selection (the update loop's view render input).
fn selected_props(ControlProps props, string selected) → ControlProps {
    return ControlProps {
        options = props.options,
        selected = selected,
        name = props.name
    }
}

# The interactive proof's theme (the 8-token core baseline — mount requires
# theme_css non-null, so the mounted control needs a theme covering the core).
fn control_theme() → tela.Theme {
    return tela.theme("controllum", [
        tela.token("surface.canvas", "#ffffff"),
        tela.token("surface.panel", "#f9fafb"),
        tela.token("text.primary", "#111827"),
        tela.token("text.muted", "#6b7280"),
        tela.token("border.default", "#e5e7eb"),
        tela.token("accent.primary", "#2563eb"),
        tela.token("state.positive", "#16a34a"),
        tela.token("state.caution", "#d97706")
    ])
}

# ===========================================================================
# Stage 3 U3 — the app-typed behavior plan (Branch B, behavior-design §2/§3).
#
# The concrete message type + EventBinding-shaped bindings (event_name +
# message-producing closures) keyed to the data-tela identities, built
# APP-SIDE (the D1 constraint, recorded: generic user-type construction is
# blocked, so the kernel owns only the non-generic carriers — EventName/
# Effect/Update — and the concrete plan is the application's surface,
# never kernel-generic). The update function is an ordinary app function
# over the concrete message type. Behavior is carried by typed message-
# producing closures — never erased into strings.
# ===========================================================================

# The concrete app message type (two variants):
#   Selected — select a segment (pointer click, Space, Enter on the focused
#     segment) — the update loop consumes it;
#   Moved   — move focus to a segment (arrows, Home, End) — focus only,
#     selection unchanged, no announcement (the driver executes the DOM
#     focus move from the message).
union Message {
    Selected { string identity },
    Moved { string identity }
}

# EventBinding-shaped binding: one event subscription keyed to a stable node
# identity, carrying a typed message-producing closure (Branch B plan).
class EventBinding {
    string identity
    string event_name
    (tela.EventName) → Message message
}

fn selected(string identity) → Message {
    return variant Selected { identity = identity }
}

fn moved(string identity) → Message {
    return variant Moved { identity = identity }
}

# The pointer binding for one segment: the plan maps the click event → the
# Selected message naming the clicked identity (the event's name carries it).
fn segment_binding(string identity) → EventBinding {
    return EventBinding {
        identity = identity,
        event_name = "click",
        message = (tela.EventName event_name) → Message ∴ selected(event_name.name)
    }
}

# The subscription plan: one pointer binding per segment identity (the
# web:dom subscriptions attach by identity — never ambient document
# shortcuts; the driver binds the webDom* surface at the harness level).
fn control_bindings() → list<EventBinding> {
    return [
        segment_binding("tela-seg-1"),
        segment_binding("tela-seg-2"),
        segment_binding("tela-seg-3")
    ]
}

# The focus order (one tab stop as a whole; arrows wrap at the ends).
fn segment_order() → list<string> {
    return ["tela-seg-1", "tela-seg-2", "tela-seg-3"]
}

fn identity_index(string identity) → int {
    const list<string> ordines ← segment_order()
    var int i ← 0
    while i < ordines.longitudo() {
        if ordines[i] ≡ identity {
            return i
        }
        i ← i + 1
    }
    return 0
}

fn wrapped_identity(int index) → string {
    const list<string> ordines ← segment_order()
    const int longitudo ← ordines.longitudo()
    var int i ← index
    while i < 0 {
        i ← i + longitudo
    }
    while i ≥ longitudo {
        i ← i - longitudo
    }
    return ordines[i]
}

# First-occurrence index of a fragment in a string (the cascade-ordering
# assert: the extension bundle's selector appears before the forms bundle's).
fn index_in(string text, string fragment) → int {
    var int i ← 0
    while not (i + fragment.longitudo() > text.longitudo()) {
        if text.sectio(i, i + fragment.longitudo()) ≡ fragment {
            return i
        }
        i ← i + 1
    }
    return -1
}

# The keyboard mapping (behavior-design §1.3): the app owns the key
# semantics, the driver executes the resulting message. Arrows move focus
# only (Moved, wrap supported); Home/End move focus to first/last; Space/
# Enter select the focused segment (Selected); anything else is a focus
# no-op (Moved to the same identity). Tab is unhandled — the control's
# single tab stop leaves as a unit (§1.3).
fn key_message(string focused_identity, string clavis) → Message {
    const int index ← identity_index(focused_identity)
    if clavis ≡ "ArrowRight" or clavis ≡ "ArrowDown" {
        return moved(wrapped_identity(index + 1))
    }
    if clavis ≡ "ArrowLeft" or clavis ≡ "ArrowUp" {
        return moved(wrapped_identity(index - 1))
    }
    if clavis ≡ "Home" {
        return moved(wrapped_identity(0))
    }
    if clavis ≡ "End" {
        return moved(wrapped_identity(-1))
    }
    if clavis ≡ "Space" or clavis ≡ "Enter" {
        return selected(focused_identity)
    }
    return moved(focused_identity)
}

# The update function — an ordinary app function over the concrete message
# type. Selected changes the selection; Moved leaves it unchanged (focus
# only, live-region-silent per §1.5).
fn update_control(string selected, Message message) → string {
    match message {
        case Selected const identity {
            return identity
        }
        case Moved const identity {
            return selected
        }
    }
}

# The live-region announcement text (§1.5): names the newly selected option.
# The host writes it into the declared live region ONLY when the selection
# changes — silent when a click/keypress lands on the already-selected
# segment or when the update does not change selection.
fn announcement(ControlProps props, string selected) → string {
    const int index ← identity_index(selected)
    if index < props.options.longitudo() {
        return props.options[index] + " selected"
    }
    return ""
}

# ===========================================================================
# Stage 4 U4 — the forms behavior plan (app-typed — D1, recorded).
#
# The concrete message type + EventBinding-shaped bindings keyed to the forms
# identities, the update/validation semantics (invalid → aria-invalid +
# error text; valid → cleared; the no-op rule) + the live-region policy
# (announce on a validation-state change, silent on no-op — the Stage 3
# §1.5 pattern extended to form validation), built APP-SIDE — the D1
# constraint, recorded: the concrete plan is the application's surface,
# never kernel-generic. Behavior is carried by typed message-producing
# closures (the Branch B shape) — never erased into strings.
# ===========================================================================

# The concrete app message type (four variants — the forms plan):
#   FieldText     — a field text entry (the "input" event) — live
#     validation per keystroke;
#   CheckboxToggle     — a checkbox toggle (the "change" event);
#   SelectChange — a select selection change (the "change" event);
#   Submit       — the form-level submit (the "submit" event) —
#     validates the field.
union FormMessage {
    FieldText {
        string identity
        string value
    },
    CheckboxToggle {
        string identity
        bool selected
    },
    SelectChange {
        string identity
        string selected
    },
    Submit {
        string identity
    },
}

# EventBinding-shaped binding (the Branch B shape, the U3 pattern): one event
# subscription keyed to a stable node identity, carrying a typed
# message-producing closure. The event spellings come from the package's
# contract constants (forms.eventus_* — the G4-safe string surface).
class FormBinding {
    string identity
    string event_name
    (tela.EventName) → FormMessage message
}

# The form model — the app-side validation state for one field identity
# (error "" = valid; the error text is the invalid → aria-invalid source).
class FieldState {
    string identity
    string value
    string error
}

# Message-producing helpers (the closure bodies).
fn field_text_message(string identity, string value) → FormMessage {
    return variant FieldText { identity = identity, value = value }
}

fn checkbox_toggle_message(string identity, bool selected) → FormMessage {
    return variant CheckboxToggle { identity = identity, selected = selected }
}

fn select_change_message(string identity, string selected) → FormMessage {
    return variant SelectChange { identity = identity, selected = selected }
}

fn submit_message(string identity) → FormMessage {
    return variant Submit { identity = identity }
}

# The bindings — keyed to the forms identities; the event spellings are the
# package's contract constants (consumable; never a magic string in the
# plan).
fn field_binding(string identity, string value) → FormBinding {
    return FormBinding {
        identity = identity,
        event_name = forms.field_event(),
        message = (tela.EventName event_name) → FormMessage ∴ field_text_message(event_name.name, value)
    }
}

fn checkbox_binding(string identity, bool selected) → FormBinding {
    return FormBinding {
        identity = identity,
        event_name = forms.change_event(),
        message = (tela.EventName event_name) → FormMessage ∴ checkbox_toggle_message(event_name.name, selected)
    }
}

fn select_binding(string identity, string selected) → FormBinding {
    return FormBinding {
        identity = identity,
        event_name = forms.change_event(),
        message = (tela.EventName event_name) → FormMessage ∴ select_change_message(event_name.name, selected)
    }
}

fn submit_binding(string identity) → FormBinding {
    return FormBinding {
        identity = identity,
        event_name = forms.submit_event(),
        message = (tela.EventName event_name) → FormMessage ∴ submit_message(event_name.name)
    }
}

fn field_state(string identity, string value, string error) → FieldState {
    return FieldState { identity = identity, value = value, error = error }
}

# The update function — an ordinary app function over the concrete message
# type. Validation semantics: an empty field value is invalid (the error
# text is set — the model flips to invalid); a non-empty value clears the
# error (valid). The checkbox toggle / select change update the value. The
# submit validates: the field keeps its error if still invalid, clears if
# valid (the no-op rule: a state-unchanging update is silent downstream).
fn update_field(FieldState state, FormMessage message) → FieldState {
    match message {
        case FieldText const identity, value {
            if value ≡ "" {
                return field_state(identity, value, "Required")
            }
            return field_state(identity, value, "")
        }
        case CheckboxToggle const identity, selected {
            if selected {
                return field_state(identity, "true", "")
            }
            return field_state(identity, "false", "")
        }
        case SelectChange const identity, selected {
            return field_state(identity, selected, "")
        }
        case Submit const identity {
            if state.value ≡ "" {
                return field_state(identity, state.value, "Required")
            }
            return field_state(identity, state.value, "")
        }
    }
}

# The live-region announcement (the §1.5 pattern extended to form
# validation): announce on a validation-state change (the value or the
# error flipped), SILENT on a no-op (the state unchanged — "" return).
fn form_announcement(FieldState ante, FieldState post) → string {
    if ante.value ≡ post.value and ante.error ≡ post.error {
        return ""
    }
    if not (post.error ≡ "") {
        return post.identity + " invalid: " + post.error
    }
    return post.identity + " valid"
}

# The app-side mapping: the model state → the field props (the package's
# FieldProps — consumable), so the ARIA/validation semantics round-trip
# through the package's render helpers (invalid → aria-invalid='true' +
# aria-describedby → the error identity + the error text; valid → cleared).
fn props_from_state(string name, string label, FieldState state) → forms.FieldProps {
    return forms.field_props(
        name,
        label,
        state.value,
        forms.invalid_state(forms.error_present(state.error)),
        state.error
    )
}

# ===========================================================================
# Stage 4 U7 — the interactive plan surface.
#
# The mounted forms composition (the REAL component fns through the normal
# package interface), the app-typed re-render (the model → the next View),
# and the seam mount (dom.scope + browser.mount through the app's OWN
# imports). The scripted interaction driver (check-forms-interactive) calls
# these against the documented faber-web host binding.
# ===========================================================================

# The interactive proof's theme (the 8-token core baseline).
fn forms_theme() → tela.Theme {
    return tela.theme("formae", [
        tela.token("surface.canvas", "#ffffff"),
        tela.token("surface.panel", "#f9fafb"),
        tela.token("text.primary", "#111827"),
        tela.token("text.muted", "#6b7280"),
        tela.token("border.default", "#e5e7eb"),
        tela.token("accent.primary", "#2563eb"),
        tela.token("state.positive", "#16a34a"),
        tela.token("state.caution", "#d97706")
    ])
}

# The forms composition — the family's `→ tela.View` component fns through
# the NORMAL qualified imports (the U7 "no compose-without" condition): the
# field group + the checkbox + the select + the form-level live region
# under one group identity.
fn forms_composition() → tela.View {
    return tela.element_full(
        tela.new_identity("forma"),
        tela.html_space(),
        "div",
        [],
        [],
        [
            forms.field_group(forms.field_props("name", "Name", "", "false", "")),
            forms.checkbox(forms.checkbox_props("agree", "Agree", "false", "false")),
            forms.select(forms.select_props("tone", "Tone", ["Light", "Dark"], "false")),
            forms.form_live_region()
        ]
    )
}

fn bool_text(bool b) → string {
    if b then return "true"
    return "false"
}

# The composition re-rendered from the app model (the field's validation
# state + the checkbox + the select state) — the update loop's view-render
# input (the driver applies the model via the messages).
fn forms_composition_from_state(FieldState state, bool agree, string tone) → tela.View {
    return tela.element_full(
        tela.new_identity("forma"),
        tela.html_space(),
        "div",
        [],
        [],
        [
            forms.field_group(props_from_state("name", "Name", state)),
            forms.checkbox(forms.checkbox_props("agree", "Agree", bool_text(agree), "false")),
            forms.select(forms.select_props("tone", "Tone", ["Light", "Dark"], "false")),
            forms.form_live_region()
        ]
    )
}

# The seam call through the app's OWN imports: a real web:dom scope +
# tela.browser.mount (the cds-u5/u6 conditions at the app boundary). The
# driver (the node host) calls this; the pre-existing hydration state is
# read via dom.snapshot inside mount.
fn mount_forms(string selector) → browser.Mounted ∪ null {
    const dom.Scope scope ← dom.scope(selector)
    return browser.mount(scope, forms_composition(), forms_theme())
}

# ===========================================================================
# Stage 5 U2 — the reference catalog composition (tela:reference). The
# layout + typography families compose through NORMAL qualified imports;
# the mount seam fns supply the check-reference browser-proof surface.
# ===========================================================================

# The reference mount theme: the 8-token core baseline + the namespaced
# ref.* tokens (the catalog's token surface collected app-side — the
# compose-without pattern; mount requires a theme covering the core).
fn reference_theme() → tela.Theme {
    return tela.theme("referentiale", [
        tela.token("surface.canvas", "#ffffff"),
        tela.token("surface.panel", "#f9fafb"),
        tela.token("text.primary", "#111827"),
        tela.token("text.muted", "#6b7280"),
        tela.token("border.default", "#e5e7eb"),
        tela.token("accent.primary", "#2563eb"),
        tela.token("state.positive", "#16a34a"),
        tela.token("state.caution", "#d97706"),
        ref.ref_layout_gap(),
        ref.ref_layout_prose_measure(),
        ref.ref_type_scale_xs(),
        ref.ref_type_scale_sm(),
        ref.ref_type_scale_md(),
        ref.ref_type_scale_lg(),
        ref.ref_type_scale_xl(),
        ref.ref_type_heading_weight(),
        ref.ref_type_heading_margin(),
        ref.ref_type_prose_line_height(),
        ref.ref_type_prose_margin(),
        ref.ref_panel_surface(),
        ref.ref_panel_border(),
        ref.ref_panel_radius(),
        ref.ref_panel_padding(),
        ref.ref_badge_size(),
        ref.ref_badge_padding(),
        ref.ref_badge_radius(),
        ref.ref_metric_label_size(),
        ref.ref_metric_label_muted(),
        ref.ref_metric_value_size(),
        ref.ref_metric_value_weight()
    ])
}

# The layout composition: the stacked rows, the two-column grid, and the
# prose measure — the family's ordinary component fns (the ref-layout-*
# identities; the grid columns are text — a grid of prose paragraphs would
# reuse the static ref-typography-prose identity, which the browser
# lifecycle diagnoses as a duplicate — asserted separately in
# check-reference). The wrapper identity is app-owned data (the canary-*
# precedent — MF-8).
fn layout_composition() → tela.View {
    return tela.element_full(
        tela.new_identity("canary-ref-layout"),
        tela.html_space(),
        "div",
        [],
        [],
        [
            ref.layout_stack(ref.stack_props([
                tela.text_view("row one"),
                tela.text_view("row two")
            ])),
            ref.layout_grid(ref.grid_props([
                tela.text_view("column one"),
                tela.text_view("column two")
            ])),
            ref.layout_prose(ref.layout_prose_props([
                ref.typography_prose(ref.prose_props([ tela.text_view("measure prose") ]))
            ]))
        ]
    )
}

# The duplicate-identity case (the check-reference diagnosis assert): a
# composition that reuses the static ref-typography-prose identity twice —
# the browser lifecycle diagnoses the ambiguity, never a silent bind
# (identity-hydration.md §6). The wrapper identity is app-owned data.
fn duplicate_prose_composition() → tela.View {
    return tela.element_full(
        tela.new_identity("canary-ref-duplicate"),
        tela.html_space(),
        "div",
        [],
        [],
        [
            ref.typography_prose(ref.prose_props([ tela.text_view("first") ])),
            ref.typography_prose(ref.prose_props([ tela.text_view("second") ]))
        ]
    )
}

# The typography composition: the heading hierarchy (native h1..h6), the
# prose paragraph with mixed emphasis, and the type-scale steps — the
# family's ordinary component fns (the ref-typography-* identities). The
# wrapper identity is app-owned data.
fn typography_composition() → tela.View {
    return tela.element_full(
        tela.new_identity("canary-ref-typography"),
        tela.html_space(),
        "div",
        [],
        [],
        [
            ref.typography_heading(ref.heading_props(1, "Catalog title")),
            ref.typography_heading(ref.heading_props(2, "Section")),
            ref.typography_prose(ref.prose_props([
                tela.text_view("Prose with "),
                ref.typography_emphasis(ref.emphasis_props("strong", "emphasis")),
                tela.text_view(" carried by markup.")
            ])),
            ref.typography_scale(ref.scale_props("lg", "lead text")),
            ref.typography_scale(ref.scale_props("xs", "caption text"))
        ]
    )
}

# The seam mounts for the browser proof: the check-reference driver calls
# these through the app's own imports (dom.scope + browser.mount, the U7
# pattern). Each family mounts independently — done_when (e).
fn mount_layout(string selector) → browser.Mounted ∪ null {
    const dom.Scope scope ← dom.scope(selector)
    return browser.mount(scope, layout_composition(), reference_theme())
}

fn mount_typography(string selector) → browser.Mounted ∪ null {
    const dom.Scope scope ← dom.scope(selector)
    return browser.mount(scope, typography_composition(), reference_theme())
}

# ===========================================================================
# Stage 5 U3 — the panel + badge + metric compositions (tela:reference).
# The three families compose through NORMAL qualified imports; the mount
# seam fns supply the check-reference U3 browser-proof surface.
# ===========================================================================

# The panel composition: a themed panel wrapping a prose paragraph. The
# panel's surface semantics come from the ref.panel.* tokens (referencing
# the theme core surface.panel / border.default — no hardcoded color).
# The wrapper identity is app-owned data.
fn panel_composition() → tela.View {
    return tela.element_full(
        tela.new_identity("canary-ref-panel"),
        tela.html_space(),
        "div",
        [],
        [],
        [
            ref.panel(ref.panel_props("status", "Status panel", [
                ref.typography_prose(ref.prose_props([ tela.text_view("all systems operational") ]))
            ]))
        ]
    )
}

# The badge composition: two textual status badges — the meaning is
# textual (label + the status word in the accessible name), never color
# alone. The wrapper identity is app-owned data.
fn badge_composition() → tela.View {
    return tela.element_full(
        tela.new_identity("canary-ref-badge"),
        tela.html_space(),
        "div",
        [],
        [],
        [
            ref.badge(ref.badge_props("new", "New", "3 messages")),
            ref.badge(ref.badge_props("ok", "Ok", "all checks passed"))
        ]
    )
}

# The metric composition: three metrics in the benchmark grammar's
# dl/dt/dd pattern — the textual form preserved (label + value + optional
# delta rows). The wrapper identity is app-owned data.
fn metric_composition() → tela.View {
    return tela.element_full(
        tela.new_identity("canary-ref-metric"),
        tela.html_space(),
        "div",
        [],
        [],
        [
            ref.metric(ref.metric_props("uptime", "uptime", "99.9%", "")),
            ref.metric(ref.metric_props("requests", "requests", "12 480", "+3.1%")),
            ref.metric(ref.metric_props("error", "error rate", "0.02%", "-0.01%"))
        ]
    )
}

# The seam mounts for the U3 browser proof: the check-reference driver
# calls these through the app's own imports (dom.scope + browser.mount,
# the U7 pattern). Each family mounts independently — done_when (d).
fn mount_panel(string selector) → browser.Mounted ∪ null {
    const dom.Scope scope ← dom.scope(selector)
    return browser.mount(scope, panel_composition(), reference_theme())
}

fn mount_badge(string selector) → browser.Mounted ∪ null {
    const dom.Scope scope ← dom.scope(selector)
    return browser.mount(scope, badge_composition(), reference_theme())
}

fn mount_metric(string selector) → browser.Mounted ∪ null {
    const dom.Scope scope ← dom.scope(selector)
    return browser.mount(scope, metric_composition(), reference_theme())
}

main {
    # G4 seam attempt (recorded in the evidence record): ext.bar_meter
    # resolves to WARN014 export-skip; the app composes the meter with tela
    # constructors (documented workaround).
    const tela.View bar ← bar_meter_app("throughput", "7.4 Mbps", 74)

    # --- Assembled tree: panel > (two-column metric table, bar meter,
    # segmented control) — the control renders statically alongside the
    # Stage 1/2 composition (shared source: the same component function
    # that mounts interactively).
    const ControlProps props ← control_props()
    const tela.View control ← segmented_control(props)
    const tela.View tree ← app_panel([
        metric_table(),
        bar,
        control
    ])

    # --- Extension tokens — both palettes (zero-arg accessors per the
    # G4-safe seam; consumed via field access on the call result, since the
    # extension-local token class name is not a nameable qualified type from
    # the app — fix:snapshot-name-collision, see the extension header).
    # Stage 5 U2: the catalog's namespaced ref.* tokens join both themes
    # (collected app-side via the zero-arg accessors — MF-7).
    const tela.Theme lumen ← tela.theme("lumen", [
        tela.token("surface.canvas", "#ffffff"),
        tela.token("surface.panel", "#f9fafb"),
        tela.token("text.primary", "#111827"),
        tela.token("text.muted", "#6b7280"),
        tela.token("border.default", "#e5e7eb"),
        tela.token("accent.primary", "#2563eb"),
        tela.token("state.positive", "#16a34a"),
        tela.token("state.caution", "#d97706"),
        tela.token(ext.chart_axis_muted().name, ext.chart_axis_muted().value),
        tela.token(ext.chart_grid_muted().name, ext.chart_grid_muted().value),
        tela.token(forms.form_field_invalid().name, forms.form_field_invalid().value),
        tela.token(forms.form_field_valid().name, forms.form_field_valid().value),
        tela.token(forms.form_focus().name, forms.form_focus().value),
        ref.ref_layout_gap(),
        ref.ref_layout_prose_measure(),
        ref.ref_type_scale_xs(),
        ref.ref_type_scale_sm(),
        ref.ref_type_scale_md(),
        ref.ref_type_scale_lg(),
        ref.ref_type_scale_xl(),
        ref.ref_type_heading_weight(),
        ref.ref_type_heading_margin(),
        ref.ref_type_prose_line_height(),
        ref.ref_type_prose_margin(),
        ref.ref_panel_surface(),
        ref.ref_panel_border(),
        ref.ref_panel_radius(),
        ref.ref_panel_padding(),
        ref.ref_badge_size(),
        ref.ref_badge_padding(),
        ref.ref_badge_radius(),
        ref.ref_metric_label_size(),
        ref.ref_metric_label_muted(),
        ref.ref_metric_value_size(),
        ref.ref_metric_value_weight()
    ])
    const tela.Theme tenebrae ← tela.theme("tenebrae", [
        tela.token("surface.canvas", "#0f172a"),
        tela.token("surface.panel", "#1e293b"),
        tela.token("text.primary", "#f8fafc"),
        tela.token("text.muted", "#94a3b8"),
        tela.token("border.default", "#334155"),
        tela.token("accent.primary", "#3b82f6"),
        tela.token("state.positive", "#22c55e"),
        tela.token("state.caution", "#f59e0b"),
        tela.token(ext.chart_axis_muted_dark().name, ext.chart_axis_muted_dark().value),
        tela.token(ext.chart_grid_muted_dark().name, ext.chart_grid_muted_dark().value),
        tela.token(forms.form_field_invalid().name, forms.form_field_invalid().value),
        tela.token(forms.form_field_valid().name, forms.form_field_valid().value),
        tela.token(forms.form_focus().name, forms.form_focus().value),
        ref.ref_layout_gap(),
        ref.ref_layout_prose_measure(),
        ref.ref_type_scale_xs(),
        ref.ref_type_scale_sm(),
        ref.ref_type_scale_md(),
        ref.ref_type_scale_lg(),
        ref.ref_type_scale_xl(),
        ref.ref_type_heading_weight(),
        ref.ref_type_heading_margin(),
        ref.ref_type_prose_line_height(),
        ref.ref_type_prose_margin(),
        ref.ref_panel_surface(),
        ref.ref_panel_border(),
        ref.ref_panel_radius(),
        ref.ref_panel_padding(),
        ref.ref_badge_size(),
        ref.ref_badge_padding(),
        ref.ref_badge_radius(),
        ref.ref_metric_label_size(),
        ref.ref_metric_label_muted(),
        ref.ref_metric_value_size(),
        ref.ref_metric_value_weight()
    ])

    # --- App + extension style bundles (identical under both themes) -------
    const tela.Style ext_stilum ← ext.chart_style()
    const tela.Bundle ext_bundle ← tela.bundle("extensionlib", ext_stilum)

    # --- The formslib component style bundle (the three-package input) -----
    # Class-returning (→ tela.Style) — consumable from the consumer today
    # (the stage-1 §3 evidence); the identity "formslib" is the package's
    # assembly-identity entry (the order map declares it app-side).
    const tela.Style forms_stilum ← forms.form_style()
    const tela.Bundle forms_bundle ← tela.bundle("formslib", forms_stilum)

    # --- The reference catalog's component style bundles (Stage 5 U2/U3) --
    # The component layer (input order): rules keyed on the ref-* identities,
    # referencing the --ref-* tokens (the layout + typography bundles, U2;
    # the panel + badge + metric bundles, U3 — prefix-keyed on the
    # variable-suffix identities).
    const tela.Style ref_layout_stilum ← ref.layout_style()
    const tela.Bundle ref_layout_bundle ← tela.bundle("reference-layout", ref_layout_stilum)
    const tela.Style ref_typography_stilum ← ref.typography_style()
    const tela.Bundle ref_typography_bundle ← tela.bundle("reference-typography", ref_typography_stilum)
    const tela.Style ref_panel_stilum ← ref.panel_style()
    const tela.Bundle ref_panel_bundle ← tela.bundle("reference-panel", ref_panel_stilum)
    const tela.Style ref_badge_stilum ← ref.badge_style()
    const tela.Bundle ref_badge_bundle ← tela.bundle("reference-badge", ref_badge_stilum)
    const tela.Style ref_metric_stilum ← ref.metric_style()
    const tela.Bundle ref_metric_bundle ← tela.bundle("reference-metric", ref_metric_stilum)

    # App style bundle: the panel rule + the segmented-control rule, both
    # keyed on the data-tela identity (the control's styles are app-owned).
    const tela.Style app_stilum ← tela.Style {
        rules = [
            tela.Rule {
                selector = "[data-tela='canary-panelum']",
                declarations = [
                    tela.Declaration { name = "display", value = "grid" },
                    tela.Declaration { name = "gap", value = "1rem" },
                    tela.Declaration { name = "color", value = "var(--chart-axis-muted)" }
                ]
            },
            tela.Rule {
                selector = "[data-tela='tela-control']",
                declarations = [
                    tela.Declaration { name = "display", value = "flex" },
                    tela.Declaration { name = "gap", value = "0.25rem" },
                    tela.Declaration { name = "border-radius", value = "0.375rem" }
                ]
            }
        ]
    }
    const tela.Bundle app_bundle ← tela.bundle("canary-app", app_stilum)

    # --- Full cascade under each theme (assemble: tokens -> extensionlib ->
    # formslib -> canary-app; the token layer + the library bundles are the
    # only differences between the two). The three-package order map: both
    # extensionlib and formslib depend on nothing (tela is the shared base),
    # so the kernel's topological tie-break (stable package identity) orders
    # extensionlib before formslib — the documented cascade order.
    const tela.Style ∪ null cascade_lumen_result ← tela.assemble(
        lumen,
        null,
        [ref_layout_bundle, ref_typography_bundle, ref_panel_bundle, ref_badge_bundle, ref_metric_bundle],
        [ tela.order("extensionlib", []), tela.order("formslib", []) ],
        [ext_bundle, forms_bundle],
        app_bundle
    )
    const tela.Style ∪ null cascade_tenebrae_result ← tela.assemble(
        tenebrae,
        null,
        [ref_layout_bundle, ref_typography_bundle, ref_panel_bundle, ref_badge_bundle, ref_metric_bundle],
        [ tela.order("extensionlib", []), tela.order("formslib", []) ],
        [ext_bundle, forms_bundle],
        app_bundle
    )
    assert not (cascade_lumen_result ≡ null)
    assert not (cascade_tenebrae_result ≡ null)
    const string css_lumen ← tela.css(tela.Style { rules = cascade_lumen_result!.rules }) coalesce ""
    const string css_tenebrae ← tela.css(tela.Style { rules = cascade_tenebrae_result!.rules }) coalesce ""

    # --- The Stage 2 campaign gate proof (bullets 1 + 2) -------------------
    # HTML is theme-independent: the same tree renders byte-identically
    # (themes supply values, not markup).
    const string html_a ← tela.html_visus(tree) coalesce ""
    const string html_b ← tela.html_visus(tree) coalesce ""
    assert html_a ≡ html_b
    # The two theme token layers differ materially.
    assert css_lumen ≠ css_tenebrae

    # --- The Stage 4 U3 three-package cascade assertions -------------------
    # The :root token layer includes the namespaced --form-* values (the
    # forms tokens flow through the kernel token rendering).
    assert css_lumen.continet("--form-field-invalid: #dc2626")
    assert css_lumen.continet("--form-field-valid: #16a34a")
    assert css_lumen.continet("--form-focus: #2563eb")
    # The forms component style bundle rides the cascade (keyed on the
    # family identities, referencing the --form-* tokens).
    assert css_lumen.continet("[data-tela^='form-field-']")
    assert css_lumen.continet("[data-tela^='form-error-']")
    assert css_lumen.continet("[data-tela='form-live']")
    assert css_lumen.continet("var(--form-field-invalid)")
    assert css_lumen.continet("var(--form-focus)")

    # --- The Stage 5 U2 reference-catalog cascade (done_when (f)) ---------
    # The :root token layer includes the namespaced --ref-* values (the
    # catalog tokens flow through the kernel token rendering).
    assert css_lumen.continet("--ref-layout-gap: 1rem")
    assert css_lumen.continet("--ref-type-scale-xl: 1.5rem")
    # The reference component bundles ride the cascade (keyed on the ref-*
    # identities, referencing the --ref-* tokens).
    assert css_lumen.continet("[data-tela='ref-layout-stack']")
    assert css_lumen.continet("[data-tela='ref-layout-grid']")
    assert css_lumen.continet("[data-tela='ref-layout-prose']")
    assert css_lumen.continet("[data-tela='ref-typography-heading-1']")
    assert css_lumen.continet("[data-tela='ref-typography-prose']")
    assert css_lumen.continet("var(--ref-layout-gap)")
    assert css_lumen.continet("var(--ref-type-scale-xl)")
    assert css_lumen.continet("var(--ref-type-prose-line-height)")

    # --- The Stage 5 U3 reference-catalog cascade (done_when (e)) ---------
    # The :root token layer includes the ref.panel.* / ref.badge.* /
    # ref.metric.* values — the panel surface + border and the metric
    # label color reference the theme's core tokens (theme-surface
    # semantics — no hardcoded color in the token layer).
    assert css_lumen.continet("--ref-panel-surface: var(--surface-panel)")
    assert css_lumen.continet("--ref-panel-border: var(--border-default)")
    assert css_lumen.continet("--ref-badge-size: 0.75rem")
    assert css_lumen.continet("--ref-metric-label-muted: var(--text-muted)")
    assert css_lumen.continet("--ref-metric-value-size: 1.5rem")
    # The U3 component bundles ride the cascade (prefix-keyed on the
    # variable-suffix identities, referencing the --ref-* tokens).
    assert css_lumen.continet("[data-tela^='ref-panel-']")
    assert css_lumen.continet("[data-tela^='ref-badge-']")
    assert css_lumen.continet("[data-tela^='ref-metric-']")
    assert css_lumen.continet("var(--ref-panel-surface)")
    assert css_lumen.continet("var(--ref-metric-label-muted)")
    # The theme-surface round trip: the panel's surface token resolves to
    # the theme's core surface.panel value in the assembled token layer
    # (the core token itself carries the resolved color).
    assert css_lumen.continet("--surface-panel: #f9fafb")

    # --- The Stage 2 fail-closed regressions re-asserted (three-package) ---
    # A cycle in the order map rejects (fail-closed — no partial cascade).
    const tela.Style ∪ null cycle_result ← tela.assemble(
        lumen,
        null,
        [],
        [ tela.order("extensionlib", ["formslib"]), tela.order("formslib", ["extensionlib"]) ],
        [ext_bundle, forms_bundle],
        app_bundle
    )
    assert cycle_result ≡ null
    # Duplicate package identity with different content rejects (dedup by
    # stable identity — fail-closed, the Stage 2 contract).
    const tela.Bundle forms_bundle_altera ← tela.bundle(
        "formslib",
        tela.Style {
            rules = [
                tela.Rule {
                    selector = "[data-tela^='form-select-']",
                    declarations = [
                        tela.Declaration { name = "color", value = "var(--form-focus)" }
                    ]
                }
            ]
        }
    )
    const tela.Style ∪ null duplicate_result ← tela.assemble(
        lumen,
        null,
        [],
        [ tela.order("extensionlib", []), tela.order("formslib", []) ],
        [ext_bundle, forms_bundle, forms_bundle_altera],
        app_bundle
    )
    assert duplicate_result ≡ null
    # Invalid output (an empty-selector rule) rejects (fail-closed).
    const tela.Bundle malum_bundle ← tela.bundle(
        "mala",
        tela.Style {
            rules = [
                tela.Rule {
                    selector = "",
                    declarations = [
                        tela.Declaration { name = "color", value = "#000000" }
                    ]
                }
            ]
        }
    )
    const tela.Style ∪ null malum_result ← tela.assemble(
        lumen,
        null,
        [],
        [ tela.order("extensionlib", []), tela.order("formslib", []) ],
        [ext_bundle, forms_bundle, malum_bundle],
        app_bundle
    )
    assert malum_result ≡ null

    # --- The forms family static render (Stage 4 U3, runner input) --------
    # U0 re-route (MF-6): the runner renders the family through the
    # `→ tela.View` component fns via the NORMAL package interface (the
    # exempla-mode consumption re-verified live against in-tree radix
    # 0.80.0 — post-cds-u6, green). The `*_html` helpers are RETIRED. The
    # rendered bytes are IDENTICAL to the pre-route output (the helpers
    # were exactly `tela.html_visus(fn(...))`), so the determinism sha is
    # unaffected by the re-route.
    const string forma_composita ←
        tela.html_visus(forms.field(forms.field_props("name", "Name", "", "false", ""))) coalesce "" +
        tela.html_visus(forms.checkbox(forms.checkbox_props("agree", "Agree", "true", "false"))) coalesce "" +
        tela.html_visus(forms.select(forms.select_props("tone", "Tone", ["Light", "Dark"], "false"))) coalesce "" +
        tela.html_visus(forms.error_region("name", "")) coalesce "" +
        tela.html_visus(forms.form_live_region()) coalesce ""
    assert forma_composita ≡ "<input type='text' aria-label='Name' aria-invalid='false' data-tela='form-field-name'><input type='checkbox' aria-label='Agree' aria-checked='true' aria-invalid='false' data-tela='form-checkbox-agree'><select aria-label='Tone' aria-invalid='false' data-tela='form-select-tone'><option>Light</option><option>Dark</option></select><div role='alert' data-tela='form-error-name'></div><div role='status' aria-live='polite' data-tela='form-live'></div>"
    # The extension bundle resolves before the forms bundle in the cascade
    # (the topological tie-break orders extensionlib before formslib).
    const int ext_index ← index_in(css_lumen, "[data-tela='tela-chart-bar']")
    const int forms_index ← index_in(css_lumen, "[data-tela^='form-field-']")
    assert ext_index < forms_index

    # --- The Stage 3 static half (U3 done_when (a)) ------------------------
    # The segmented control renders deterministically through html_visus:
    # exact bytes — role=radiogroup on the group, role=radio + aria-selected
    # + the roving tabindex on the segments (§1.3/§1.4), the control-owned
    # declared live region (§1.5), stable data-tela identities throughout.
    const string html_controllum ← tela.html_visus(control) coalesce ""
    # Serializer emission order: attributes in author order, then data-tela
    # (the identity attribute) — the U2 exempla precedent.
    assert html_controllum ≡ "<div role='radiogroup' aria-label='segmented control' data-tela='tela-control'><button role='radio' aria-selected='true' tabindex='0' data-tela='tela-seg-1'>One</button><button role='radio' aria-selected='false' tabindex='-1' data-tela='tela-seg-2'>Two</button><button role='radio' aria-selected='false' tabindex='-1' data-tela='tela-seg-3'>Three</button><div role='status' aria-live='polite' data-tela='tela-live'></div></div>"

    # --- The app-typed behavior plan (U3 done_when (b)) — pure proof -------
    # The plan is app-typed (D1 recorded, never kernel-generic) and carried
    # by typed message-producing closures (not erased into strings).
    const list<EventBinding> vincula ← control_bindings()
    assert vincula.longitudo() ≡ 3
    # Invoke a binding's closure: click on tela-seg-2 → Selected{tela-seg-2}.
    const Message click_msg ← vincula[1].message(tela.event_name("tela-seg-2"))
    match click_msg {
        case Selected const identity {
            assert identity ≡ "tela-seg-2"
        }
        case Moved const identity {
            assert false
        }
    }
    # The update loop: Selected changes the selection.
    const string post ← update_control("tela-seg-1", click_msg)
    assert post ≡ "tela-seg-2"
    # The keyboard mapping: arrows move focus only (Moved) — the update
    # leaves the selection unchanged (§1.3; live-region-silent per §1.5).
    const Message arrow_msg ← key_message("tela-seg-2", "ArrowRight")
    match arrow_msg {
        case Moved const identity {
            assert identity ≡ "tela-seg-3"
        }
        case Selected const identity {
            assert false
        }
    }
    const string post_arrow ← update_control(post, arrow_msg)
    assert post_arrow ≡ post
    # Home/End move focus to first/last (Moved); Space/Enter select.
    match key_message("tela-seg-3", "Home") {
        case Moved const identity {
            assert identity ≡ "tela-seg-1"
        }
        case Selected const identity {
            assert false
        }
    }
    match key_message("tela-seg-1", "End") {
        case Moved const identity {
            assert identity ≡ "tela-seg-3"
        }
        case Selected const identity {
            assert false
        }
    }
    match key_message("tela-seg-2", "Space") {
        case Selected const identity {
            assert identity ≡ "tela-seg-2"
        }
        case Moved const identity {
            assert false
        }
    }
    # A no-op selection change: clicking the already-selected segment keeps
    # the model unchanged — the update returns the same selection (silent).
    const Message noop_msg ← vincula[1].message(tela.event_name("tela-seg-2"))
    assert update_control(post, noop_msg) ≡ post
    # The declarative effects (behavior-design §3.2) — the kernel carriers
    # + the key accessor (fix:sem001 — the kernel owns the only Effect
    # matcher; the host executes effects by reading the key).
    const tela.Effect restore ← tela.restore("tela-seg-2")
    assert tela.effect_identity(restore) ≡ "tela-seg-2"
    const tela.Effect anchor ← tela.anchor("#root")
    assert tela.effect_identity(anchor) ≡ "#root"
    # The live-region announcement mapping (§1.5): names the new option.
    assert announcement(props, "tela-seg-2") ≡ "Two selected"
    assert announcement(props, "tela-seg-1") ≡ "One selected"
    # The props carrier + the interactive theme (the driver + update loop
    # consume these).
    assert selected_props(props, "tela-seg-3").selected ≡ "tela-seg-3"
    assert not (tela.theme_css(control_theme()) ≡ null)

    # --- The forms behavior plan (U4 done_when (b)) — pure proof --------
    # The plan is app-typed (D1 recorded, never kernel-generic) and carried
    # by typed message-producing closures (not erased into strings). The
    # bindings key to the forms identities; the event spellings are the
    # package's contract constants (consumable — the G4-safe surface).
    assert forms.field_event() ≡ "input"
    assert forms.change_event() ≡ "change"
    assert forms.submit_event() ≡ "submit"
    assert forms.click_event() ≡ "click"
    const FormBinding v_campum ← field_binding("form-field-name", "Ada")
    const FormBinding v_boxum ← checkbox_binding("form-checkbox-agree", true)
    const FormBinding v_selectum ← select_binding("form-select-tone", "Dark")
    const FormBinding v_submissio ← submit_binding("form-submit")
    assert v_campum.event_name ≡ forms.field_event()
    assert v_boxum.event_name ≡ forms.change_event()
    assert v_selectum.event_name ≡ forms.change_event()
    assert v_submissio.event_name ≡ forms.submit_event()
    assert v_campum.identity ≡ "form-field-name"
    assert v_boxum.identity ≡ "form-checkbox-agree"
    assert v_selectum.identity ≡ "form-select-tone"
    assert v_submissio.identity ≡ "form-submit"

    # Invoke the bindings' closures (the event's name carries the
    # identity — the event subscription keys by identity, never ambient).
    const FormMessage m_campum ← v_campum.message(tela.event_name("form-field-name"))
    match m_campum {
        case FieldText const identity, value {
            assert identity ≡ "form-field-name"
            assert value ≡ "Ada"
        }
        case CheckboxToggle const identity, selected {
            assert false
        }
        case SelectChange const identity, selected {
            assert false
        }
        case Submit const identity {
            assert false
        }
    }
    const FormMessage m_boxum ← v_boxum.message(tela.event_name("form-checkbox-agree"))
    match m_boxum {
        case CheckboxToggle const identity, selected {
            assert identity ≡ "form-checkbox-agree"
            assert selected ≡ true
        }
        case FieldText const identity, value {
            assert false
        }
        case SelectChange const identity, selected {
            assert false
        }
        case Submit const identity {
            assert false
        }
    }
    const FormMessage m_selectum ← v_selectum.message(tela.event_name("form-select-tone"))
    match m_selectum {
        case SelectChange const identity, selected {
            assert identity ≡ "form-select-tone"
            assert selected ≡ "Dark"
        }
        case FieldText const identity, value {
            assert false
        }
        case CheckboxToggle const identity, selected {
            assert false
        }
        case Submit const identity {
            assert false
        }
    }
    const FormMessage m_submissio ← v_submissio.message(tela.event_name("form-submit"))
    match m_submissio {
        case Submit const identity {
            assert identity ≡ "form-submit"
        }
        case FieldText const identity, value {
            assert false
        }
        case CheckboxToggle const identity, selected {
            assert false
        }
        case SelectChange const identity, selected {
            assert false
        }
    }

    # The update/validation semantics: an empty field input → invalid (the
    # error text set — the model flips to invalid); the validation-state
    # mapping flips aria-invalid to "true" + the error text is present.
    const FieldState statu_init ← field_state("form-field-name", "", "")
    const FieldState statu_invalidum ← update_field(statu_init, field_text_message("form-field-name", ""))
    assert statu_invalidum.error ≡ "Required"
    assert forms.invalid_state(forms.error_present(statu_invalidum.error)) ≡ "true"
    # The round trip through the package's render helper: invalid → the
    # bytes carry aria-invalid='true' + aria-describedby → the error
    # identity + the error text (the field_group association, U2).
    const string grex_invalidum ← tela.html_visus(forms.field_group(props_from_state("name", "Name", statu_invalidum))) coalesce ""
    assert grex_invalidum.continet("aria-invalid='true'")
    assert grex_invalidum.continet("aria-describedby='form-error-name'")
    assert grex_invalidum.continet(">Required</div>")
    # A non-empty field input → valid: the error cleared (aria-invalid
    # flips "false", no describedby).
    const FieldState statu_validum ← update_field(statu_invalidum, field_text_message("form-field-name", "Ada"))
    assert statu_validum.error ≡ ""
    const string grex_validum ← tela.html_visus(forms.field_group(props_from_state("name", "Name", statu_validum))) coalesce ""
    assert not grex_validum.continet("aria-invalid='true'")
    assert not grex_validum.continet("aria-describedby")
    # The live-region policy (§1.5 extended to form validation): the
    # invalid → valid transition announces; a no-op input (same value,
    # same state) is SILENT ("" — the no-op rule).
    assert form_announcement(statu_invalidum, statu_validum) ≡ "form-field-name valid"
    const FieldState statu_noop ← update_field(statu_validum, field_text_message("form-field-name", "Ada"))
    assert statu_noop.value ≡ statu_validum.value
    assert form_announcement(statu_validum, statu_noop) ≡ ""
    # The checkbox toggle + select change update the model (the change
    # messages keyed to the forms identities); the second identical toggle
    # is a state no-op → silent.
    const FieldState statu_boxum ← update_field(statu_validum, checkbox_toggle_message("form-checkbox-agree", true))
    assert statu_boxum.value ≡ "true"
    assert form_announcement(statu_validum, statu_boxum) ≡ "form-checkbox-agree valid"
    const FieldState statu_boxum_noop ← update_field(statu_boxum, checkbox_toggle_message("form-checkbox-agree", true))
    assert statu_boxum_noop.value ≡ statu_boxum.value
    assert form_announcement(statu_boxum, statu_boxum_noop) ≡ ""
    const FieldState statu_selectum ← update_field(statu_boxum, select_change_message("form-select-tone", "Dark"))
    assert statu_selectum.value ≡ "Dark"
    # The submit validates: an invalid field keeps the error (a state
    # no-op — silent); a valid field stays cleared (submitted).
    const FieldState statu_submit_invalidum ← update_field(statu_invalidum, submit_message("form-submit"))
    assert statu_submit_invalidum.error ≡ "Required"
    assert form_announcement(statu_invalidum, statu_submit_invalidum) ≡ ""
    const FieldState statu_submit_validum ← update_field(statu_validum, submit_message("form-submit"))
    assert statu_submit_validum.error ≡ ""
    # fix:sem001 held (the recorded G3-family gap): effect keys are read
    # through the kernel's effect_identity — the app never matches an
    # imported union. The declarative effect keys attach to the same
    # data-tela values the bindings key to (identity-hydration §7).
    const tela.Effect restore_formae ← tela.restore("form-field-name")
    assert tela.effect_identity(restore_formae) ≡ "form-field-name"
    const tela.Effect ancora_formae ← tela.anchor("#root")
    assert tela.effect_identity(ancora_formae) ≡ "#root"

    # --- The static-render runner output: HTML once, the full cascade CSS
    # under each theme (the U6/U3 double-build hook consumes this), then
    # the segmented-control static render (the U4 determinism hook).
    print html_a
    print css_lumen
    print css_tenebrae
    print "two-theme static rendered (lumen vs tenebrae; tela-s2-u3)"
    print html_controllum
    print "segmented control static rendered (initial selection tela-seg-1; tela-s3-u3)"
    print forma_composita
    print "forms family static rendered (field/checkbox/select + error/live; tela-s4-u3)"
    print "forms behavior plan asserted (input/toggle/change/submit + validation semantics; tela-s4-u4)"

    # --- Stage 5 U2 — the reference catalog static render (done_when (f)).
    # The layout + typography families compose through NORMAL qualified
    # imports (the U1 probe (i) at real use); the runner output extends —
    # the Stage 4 determinism sha is SUPERSEDED (recorded in the header).
    # The a11y structure asserts (the documented structure): the heading
    # hierarchy (native h1..h6), the prose semantics (p), the semantic
    # emphasis (strong/em/code), the scale steps — the wrapper identities
    # are app-owned data (canary-*).
    const string html_layout ← tela.html_visus(layout_composition()) coalesce ""
    const string html_typography ← tela.html_visus(typography_composition()) coalesce ""
    assert html_layout.continet("<div data-tela='ref-layout-stack'>")
    assert html_layout.continet("<div data-tela='ref-layout-grid'>")
    assert html_layout.continet("<div data-tela='ref-layout-prose'>")
    assert html_layout.continet("<div data-tela='ref-layout-grid'>column onecolumn two</div>")
    assert html_layout.continet("<p data-tela='ref-typography-prose'>measure prose</p>")
    assert html_typography.continet("<h1 data-tela='ref-typography-heading-1'>Catalog title</h1>")
    assert html_typography.continet("<h2 data-tela='ref-typography-heading-2'>Section</h2>")
    assert html_typography.continet("<p data-tela='ref-typography-prose'>Prose with ")
    assert html_typography.continet("<strong data-tela='ref-typography-emphasis-strong'>emphasis</strong>")
    assert html_typography.continet("<span data-tela='ref-typography-scale-lg'>lead text</span>")
    assert html_typography.continet("<span data-tela='ref-typography-scale-xs'>caption text</span>")
    # The mount seam is the check-reference browser-proof surface (the
    # driver calls mount_layout/mount_typography through the app's own
    # imports AFTER installing the host DOM — main{} stays seam-free, the
    # driver executes the seam).
    assert not (tela.theme_css(reference_theme()) ≡ null)
    print html_layout
    print "layout family static rendered (stack/grid/prose; tela-s5-u2)"
    print html_typography
    print "typography family static rendered (headings/prose/emphasis/scale; tela-s5-u2)"
    print "reference composition asserted (layout + typography families; tela-s5-u2)"

    # --- Stage 5 U3 — the panel + badge + metric static render -------------
    # The families compose through NORMAL qualified imports; the runner
    # output extends — the determinism sha stays SUPERSEDED (recorded).
    # The a11y structure asserts: the panel's region landmark + accessible
    # name, the badge's role=status + the textual meaning (the status word
    # in the accessible name — never color alone), the metric's dl/dt/dd
    # label/value(+delta) structure (the textual form preserved).
    const string html_panel ← tela.html_visus(panel_composition()) coalesce ""
    const string html_badge ← tela.html_visus(badge_composition()) coalesce ""
    const string html_metric ← tela.html_visus(metric_composition()) coalesce ""
    assert html_panel.continet("<div role='region' aria-label='Status panel' data-tela='ref-panel-status'>")
    assert html_panel.continet("<p data-tela='ref-typography-prose'>all systems operational</p>")
    assert html_badge.continet("<span role='status' aria-label='New: 3 messages' data-tela='ref-badge-new'>3 messages</span>")
    assert html_badge.continet("<span role='status' aria-label='Ok: all checks passed' data-tela='ref-badge-ok'>all checks passed</span>")
    assert html_metric.continet("<dl data-tela='ref-metric-uptime'><dt>uptime</dt><dd>99.9%</dd></dl>")
    assert html_metric.continet("<dl data-tela='ref-metric-requests'><dt>requests</dt><dd>12 480</dd><dd>+3.1%</dd></dl>")
    assert html_metric.continet("<dl data-tela='ref-metric-error'><dt>error rate</dt><dd>0.02%</dd><dd>-0.01%</dd></dl>")
    print html_panel
    print "panel family static rendered (theme-surface container; tela-s5-u3)"
    print html_badge
    print "badge family static rendered (textual status; tela-s5-u3)"
    print html_metric
    print "metric family static rendered (label/value/delta; tela-s5-u3)"
    print "reference composition asserted (panel + badge + metric families; tela-s5-u3)"

    # --- The U7 interactive plan surface (the provider-seam claim) --------
    # The composition mounts through the app's own seam call (dom.scope +
    # browser.mount); the pure surface is asserted here, the scripted DOM
    # sequence executes under check-forms-interactive (the documented
    # faber-web host binding).
    const tela.View compositio ← forms_composition()
    assert tela.html_visus(compositio) not is null
    assert tela.html_visus(compositio) coalesce "" ≡ "<div data-tela='forma'><div data-tela='form-control-name'><input type='text' aria-label='Name' aria-invalid='false' data-tela='form-field-name'><div role='alert' data-tela='form-error-name'></div></div><input type='checkbox' aria-label='Agree' aria-checked='false' aria-invalid='false' data-tela='form-checkbox-agree'><select aria-label='Tone' aria-invalid='false' data-tela='form-select-tone'><option>Light</option><option>Dark</option></select><div role='status' aria-live='polite' data-tela='form-live'></div></div>"
    assert bool_text(true) ≡ "true"
    assert bool_text(false) ≡ "false"
    const FieldState state_invalid ← field_state("form-field-name", "", "Required")
    const string compositio_invalida ← tela.html_visus(forms_composition_from_state(state_invalid, false, "Light")) coalesce ""
    assert compositio_invalida.continet("aria-invalid='true'")
    assert compositio_invalida.continet("aria-describedby='form-error-name'")
    assert compositio_invalida.continet(">Required</div>")
    print "forms interactive plan surface asserted (real imports + seam mount; tela-s4-u7)"
}
