# tela/proof/benchmark/canary-app/src/main.fab
# Benchmark canary application (kind app). Shared source for the static
# composition runner, the app-typed behavior plans, and the mount seams
# the package-test harnesses call.
#
# Imports tela:tela, tela:reference, tela:browser, tela:dom,
# extensionlib:extension, and formslib:forms. main prints theme-
# independent HTML plus the full cascade CSS under two Theme values
# (lumen / tenebrae). check-determinism byte-compares that stdout.
# Interactive proofs run under check-mount, check-reference, and
# check-forms-interactive.
#
# Workarounds that still bind (removal = grep-replace after the radix
# fix lands):
#   html_view — G5: `fn html` collides with Space.html (SEM005).
#   bar_meter_app — G4: ext.bar_meter is WARN014-skipped; the app
#     composes the same meter with tela constructors and still consumes
#     the extension token + style bundle.
#   app_panel — not named `panel`: reference.panel shares the assembled
#     TS file in harnesses (TS2393). Rendered identity stays
#     canary-panelum.
#   D1 — concrete message types and bindings are app-local. The kernel
#     owns only EventName / Effect / Update.
#   fix:sem001 — read Effect keys through tela.effect_identity; never
#     match an imported union's variants.
#   fix:snapshot-name-collision — plan types do not reuse kernel or
#     catalog type names.
#   fix:g4 — signatures that mention imported sibling types stay
#     WARN014-skipped; harnesses read the emitted file.
#   fix:codegen001 — Rust emit-across-imports is blocked; TS is the
#     proven runtime lane.
#
# Synchronous only: no @ future, no fetch, no async event sources.
# Catalog identities (ref-*, form-*, tela-chart-bar) are hydration
# keys. canary-* wrappers are app-owned data.

import from "tela:tela" public * ut tela
import from "extensionlib:extension" public * ut ext
import from "formslib:forms" public * ut forms
import from "tela:browser" public * ut browser
import from "tela:reference" public * ut reference
import from "tela:dom" public * ut dom

# --- Themed panel: a div with a stable identity + accessible name; the panel
# rule in main's style bundle keys on the identity (policy (d) seam).
# Stage 5 U3 rename: `panel` → `app_panel` — the catalog's `ref.panel`
# component fn (tela:reference, U3) shares the assembled TS file with this
# app fn in the harness assemblies; the duplicate top-level `panel`
# declaration broke the tsc lane (TS2393). The app fn is app-owned; the
# rename keeps the rendered bytes identical (the canary-panelum identity +
# aria-label are unchanged).

fn app_panel(list<tela.View> children) → tela.View {
    return tela.element_full(
        tela.new_identity("canary-panelum"),
        tela.html_space(),
        "div",
        [ tela.Attribute { name = "aria-label", value = "metric panel" } ],
        [],
        children
    )
}

fn metric_table() → tela.View {
    return tela.element_view(tela.html_space(), "dl", [
        tela.element_view(tela.html_space(), "dt", [ tela.text_view("uptime") ]),
        tela.element_view(tela.html_space(), "dd", [ tela.text_view("99.9%") ]),
        tela.element_view(tela.html_space(), "dt", [ tela.text_view("requests") ]),
        tela.element_view(tela.html_space(), "dd", [ tela.text_view("12 480") ]),
        tela.element_view(tela.html_space(), "dt", [ tela.text_view("error rate") ]),
        tela.element_view(tela.html_space(), "dd", [ tela.text_view("0.02%") ])
    ])
}

# --- Horizontal bar meter — app-side composition (G4 workaround). ---------
# The extension's bar_meter (tela.View-returning signature) is skipped in
# the cross-package export snapshot (WARN014 — G4 confirmed against the
# kernel; recorded in stage-1-benchmark-static.md). Per the U5 spec's
# documented workaround, the app composes the same meter shape with tela
# constructors and consumes the extension's token + style bundle. The
# contract is not weakened: the extension keeps its bar_meter seam and no
# duplicated View exists IN the extension.
fn bar_meter_app(string label, string value, int width) → tela.View {
    return tela.element_full(
        tela.new_identity("tela-chart-bar"),
        tela.html_space(),
        "div",
        [
            tela.Attribute { name = "role", value = "meter" },
            tela.Attribute { name = "aria-label", value = label },
            tela.Attribute { name = "data-latitudo", value = "§"(width) }
        ],
        [],
        [
            tela.element_view(tela.html_space(), "span", [ tela.text_view(label) ]),
            tela.element_view(tela.html_space(), "x-bar", [
                tela.element_view(tela.html_space(), "x-fill", [ tela.text_view(value) ])
            ])
        ]
    )
}

# Segmented control: compose reference.segmented_control; the D1 plan
# below re-targets ref-seg-* identities. A11y contract lives in
# reference.fab (radiogroup / radio / roving tabindex / live region).

# Shared props for the static render and the app-typed plan.
fn control_props() → reference.SegmentedProps {
    return reference.segmented_props("control", "segmented control", ["One", "Two", "Three"], "ref-seg-control-1")
}

# Props with a changed selection (the update loop's view-render input).
fn selected_props(reference.SegmentedProps props, string selected) → reference.SegmentedProps {
    return reference.segmented_props(props.name, props.label, props.options, selected)
}

# App-typed segmented plan (D1 / Branch B). Concrete Message plus
# EventBinding closures keyed to data-tela identities. The kernel owns
# only EventName / Effect / Update.

# The concrete app message type (two variants):
#   Selected — select a segment (pointer click, Space, Enter on the focused
#     segment) — the update loop consumes it;
#   Moved   — move focus to a segment (arrows, Home, End) — focus only,
#     selection unchanged, no announcement (the driver executes the DOM
#     focus move from the message).
union Message {
    Selected { string identity },
    Moved { string identity }
}

# EventBinding-shaped binding: one event subscription keyed to a stable node
# identity, carrying a typed message-producing closure (Branch B plan).
class EventBinding {
    string identity
    string event_name
    (tela.EventName) → Message message
}

fn selected(string identity) → Message {
    return variant Selected { identity = identity }
}

fn moved(string identity) → Message {
    return variant Moved { identity = identity }
}

# The pointer binding for one segment: the plan maps the click event → the
# Selected message naming the clicked identity (the event's name carries it).
fn segment_binding(string identity) → EventBinding {
    return EventBinding {
        identity = identity,
        event_name = "click",
        message = (tela.EventName event_name) → Message ∴ selected(event_name.name)
    }
}

# The subscription plan: one pointer binding per segment identity (the
# tela:dom subscriptions attach by identity — never ambient document
# shortcuts; the driver binds the webDom* surface at the harness level).
# Stage 5 U5: the bindings re-target the reference identities
# (ref-seg-control-N).
fn control_bindings() → list<EventBinding> {
    return [
        segment_binding("ref-seg-control-1"),
        segment_binding("ref-seg-control-2"),
        segment_binding("ref-seg-control-3")
    ]
}

# The focus order (one tab stop as a whole; arrows wrap at the ends).
# Stage 5 U5: re-targeted to the reference identities.
fn segment_order() → list<string> {
    return ["ref-seg-control-1", "ref-seg-control-2", "ref-seg-control-3"]
}

fn identity_index(string identity) → int {
    const list<string> ordines ← segment_order()
    var int i ← 0
    while i < ordines.longitudo() {
        if ordines[i] ≡ identity {
            return i
        }
        i ← i + 1
    }
    return 0
}

fn wrapped_identity(int index) → string {
    const list<string> ordines ← segment_order()
    const int longitudo ← ordines.longitudo()
    var int i ← index
    while i < 0 {
        i ← i + longitudo
    }
    while i ≥ longitudo {
        i ← i - longitudo
    }
    return ordines[i]
}

# First-occurrence index of a fragment in a string (the cascade-ordering
# assert: the extension bundle's selector appears before the forms bundle's).
fn index_in(string text, string fragment) → int {
    var int i ← 0
    while not (i + fragment.longitudo() > text.longitudo()) {
        if text.sectio(i, i + fragment.longitudo()) ≡ fragment {
            return i
        }
        i ← i + 1
    }
    return -1
}

# The keyboard mapping (behavior-design §1.3): the app owns the key
# semantics, the driver executes the resulting message. Arrows move focus
# only (Moved, wrap supported); Home/End move focus to first/last; Space/
# Enter select the focused segment (Selected); anything else is a focus
# no-op (Moved to the same identity). Tab is unhandled — the control's
# single tab stop leaves as a unit (§1.3).
fn key_message(string focused_identity, string clavis) → Message {
    const int index ← identity_index(focused_identity)
    if clavis ≡ «ArrowRight" or clavis ≡ "ArrowDown» {
        return moved(wrapped_identity(index + 1))
    }
    if clavis ≡ «ArrowLeft" or clavis ≡ "ArrowUp» {
        return moved(wrapped_identity(index - 1))
    }
    if clavis ≡ "Home" {
        return moved(wrapped_identity(0))
    }
    if clavis ≡ "End" {
        return moved(wrapped_identity(-1))
    }
    if clavis ≡ «Space" or clavis ≡ "Enter» {
        return selected(focused_identity)
    }
    return moved(focused_identity)
}

# The update function — an ordinary app function over the concrete message
# type. Selected changes the selection; Moved leaves it unchanged (focus
# only, live-region-silent per §1.5).
fn update_control(string selected, Message message) → string {
    match message {
        case Selected const identity {
            return identity
        }
        case Moved const identity {
            return selected
        }
    }
}

# The live-region announcement text (§1.5): names the newly selected option.
# The host writes it into the declared live region ONLY when the selection
# changes — silent when a click/keypress lands on the already-selected
# segment or when the update does not change selection.
fn announcement(reference.SegmentedProps props, string selected) → string {
    const int index ← identity_index(selected)
    if index < props.options.longitudo() {
        return props.options[index] + " selected"
    }
    return ""
}

# App-typed forms plan (D1). FormMessage plus FormBinding closures keyed
# to form-* identities. Invalid → aria-invalid + error text; valid →
# cleared; announce only when validation state changes.

# The concrete app message type (four variants — the forms plan):
#   FieldText     — a field text entry (the "input" event) — live
#     validation per keystroke;
#   CheckboxToggle     — a checkbox toggle (the "change" event);
#   SelectChange — a select selection change (the "change" event);
#   Submit       — the form-level submit (the "submit" event) —
#     validates the field.
union FormMessage {
    FieldText {
        string identity
        string value
    },
    CheckboxToggle {
        string identity
        bool selected
    },
    SelectChange {
        string identity
        string selected
    },
    Submit {
        string identity
    }
}

# EventBinding-shaped binding (the Branch B shape, the U3 pattern): one event
# subscription keyed to a stable node identity, carrying a typed
# message-producing closure. The event spellings come from the package's
# contract constants (forms.eventus_* — the G4-safe string surface).
class FormBinding {
    string identity
    string event_name
    (tela.EventName) → FormMessage message
}

# The form model — the app-side validation state for one field identity
# (error "" = valid; the error text is the invalid → aria-invalid source).
class FieldState {
    string identity
    string value
    string error
}

# Message-producing helpers (the closure bodies).
fn field_text_message(string identity, string value) → FormMessage {
    return variant FieldText { identity = identity, value = value }
}

fn checkbox_toggle_message(string identity, bool selected) → FormMessage {
    return variant CheckboxToggle { identity = identity, selected = selected }
}

fn select_change_message(string identity, string selected) → FormMessage {
    return variant SelectChange { identity = identity, selected = selected }
}

fn submit_message(string identity) → FormMessage {
    return variant Submit { identity = identity }
}

# The bindings — keyed to the forms identities; the event spellings are the
# package's contract constants (consumable; never a magic string in the
# plan).
fn field_binding(string identity, string value) → FormBinding {
    return FormBinding {
        identity = identity,
        event_name = forms.field_event(),
        message = (tela.EventName event_name) → FormMessage ∴ field_text_message(event_name.name, value)
    }
}

fn checkbox_binding(string identity, bool selected) → FormBinding {
    return FormBinding {
        identity = identity,
        event_name = forms.change_event(),
        message = (tela.EventName event_name) → FormMessage ∴ checkbox_toggle_message(event_name.name, selected)
    }
}

fn select_binding(string identity, string selected) → FormBinding {
    return FormBinding {
        identity = identity,
        event_name = forms.change_event(),
        message = (tela.EventName event_name) → FormMessage ∴ select_change_message(event_name.name, selected)
    }
}

fn submit_binding(string identity) → FormBinding {
    return FormBinding {
        identity = identity,
        event_name = forms.submit_event(),
        message = (tela.EventName event_name) → FormMessage ∴ submit_message(event_name.name)
    }
}

fn field_state(string identity, string value, string error) → FieldState {
    return FieldState { identity = identity, value = value, error = error }
}

# The update function — an ordinary app function over the concrete message
# type. Validation semantics: an empty field value is invalid (the error
# text is set — the model flips to invalid); a non-empty value clears the
# error (valid). The checkbox toggle / select change update the value. The
# submit validates: the field keeps its error if still invalid, clears if
# valid (the no-op rule: a state-unchanging update is silent downstream).
fn update_field(FieldState state, FormMessage message) → FieldState {
    match message {
        case FieldText const identity, value {
            if value ≡ "" {
                return field_state(identity, value, "Required")
            }
            return field_state(identity, value, "")
        }
        case CheckboxToggle const identity, selected {
            if selected {
                return field_state(identity, "true", "")
            }
            return field_state(identity, "false", "")
        }
        case SelectChange const identity, selected {
            return field_state(identity, selected, "")
        }
        case Submit const identity {
            if state.value ≡ "" {
                return field_state(identity, state.value, "Required")
            }
            return field_state(identity, state.value, "")
        }
    }
}

# The live-region announcement (the §1.5 pattern extended to form
# validation): announce on a validation-state change (the value or the
# error flipped), SILENT on a no-op (the state unchanged — "" return).
fn form_announcement(FieldState ante, FieldState post) → string {
    if ante.value ≡ post.value and ante.error ≡ post.error {
        return ""
    }
    if not (post.error ≡ "") {
        return post.identity + " invalid: " + post.error
    }
    return post.identity + " valid"
}

# The app-side mapping: the model state → the field props (the package's
# FieldProps — consumable), so the ARIA/validation semantics round-trip
# through the package's render helpers (invalid → aria-invalid="true" +
# aria-describedby → the error identity + the error text; valid → cleared).
fn props_from_state(string name, string label, FieldState state) → forms.FieldProps {
    return forms.field_props(
        name,
        label,
        state.value,
        forms.invalid_state(forms.error_present(state.error)),
        state.error
    )
}

# Forms interactive surface: composition, model → View, and
# mount_forms (dom.scope + browser.mount). check-forms-interactive
# drives the scripted sequence against the tela:dom host binding.

# The interactive proof's theme (the 8-token core baseline).
fn forms_theme() → tela.Theme {
    return tela.theme("formae", [
        tela.token("surface.canvas", "#ffffff"),
        tela.token("surface.panel", "#f9fafb"),
        tela.token("text.primary", "#111827"),
        tela.token("text.muted", "#6b7280"),
        tela.token("border.default", "#e5e7eb"),
        tela.token("accent.primary", "#2563eb"),
        tela.token("state.positive", "#16a34a"),
        tela.token("state.caution", "#d97706")
    ])
}

# The forms composition — the family's `→ tela.View` component fns through
# the NORMAL qualified imports (the U7 "no compose-without" condition): the
# field group + the checkbox + the select + the form-level live region
# under one group identity.
fn forms_composition() → tela.View {
    return tela.element_full(
        tela.new_identity("forma"),
        tela.html_space(),
        "div",
        [],
        [],
        [
            forms.field_group(forms.field_props("name", "Name", "", "false", "")),
            forms.checkbox(forms.checkbox_props("agree", "Agree", "false", "false")),
            forms.select(forms.select_props("tone", "Tone", ["Light", "Dark"], "false")),
            forms.form_live_region()
        ]
    )
}

fn bool_text(bool b) → string {
    if b then return "true"
    return "false"
}

# The composition re-rendered from the app model (the field's validation
# state + the checkbox + the select state) — the update loop's view-render
# input (the driver applies the model via the messages).
fn forms_composition_from_state(FieldState state, bool agree, string tone) → tela.View {
    return tela.element_full(
        tela.new_identity("forma"),
        tela.html_space(),
        "div",
        [],
        [],
        [
            forms.field_group(props_from_state("name", "Name", state)),
            forms.checkbox(forms.checkbox_props("agree", "Agree", bool_text(agree), "false")),
            forms.select(forms.select_props("tone", "Tone", ["Light", "Dark"], "false")),
            forms.form_live_region()
        ]
    )
}

# The seam call through the app's OWN imports: a real tela:dom scope +
# tela.browser.mount (the web-surface-import U4 flip — the seam is
# tela-owned; the cds-u5/u6 conditions at the app boundary). The
# driver (the node host) calls this; the pre-existing hydration state is
# read via dom.snapshot inside mount.
fn mount_forms(string selector) → browser.Mounted ∪ null {
    const dom.Scope scope ← dom.scope(selector)
    return browser.mount(scope, forms_composition(), forms_theme())
}

# Layout + typography (tela:reference). Mount seams: mount_layout /
# mount_typography.

# The reference mount theme: the 8-token core baseline + the namespaced
# ref.* tokens (the catalog's token surface collected app-side — the
# compose-without pattern; mount requires a theme covering the core).
# Stage 5 U7: the field family's form.* tokens join (the Stage 4
# namespaced-token surface, re-homed — the check-reference field mount
# covers the field's cascade).
fn reference_theme() → tela.Theme {
    return tela.theme("referentiale", [
        tela.token("surface.canvas", "#ffffff"),
        tela.token("surface.panel", "#f9fafb"),
        tela.token("text.primary", "#111827"),
        tela.token("text.muted", "#6b7280"),
        tela.token("border.default", "#e5e7eb"),
        tela.token("accent.primary", "#2563eb"),
        tela.token("state.positive", "#16a34a"),
        tela.token("state.caution", "#d97706"),
        reference.ref_layout_gap(),
        reference.ref_layout_prose_measure(),
        reference.ref_type_scale_xs(),
        reference.ref_type_scale_sm(),
        reference.ref_type_scale_md(),
        reference.ref_type_scale_lg(),
        reference.ref_type_scale_xl(),
        reference.ref_type_heading_weight(),
        reference.ref_type_heading_margin(),
        reference.ref_type_prose_line_height(),
        reference.ref_type_prose_margin(),
        reference.ref_panel_surface(),
        reference.ref_panel_border(),
        reference.ref_panel_radius(),
        reference.ref_panel_padding(),
        reference.ref_badge_size(),
        reference.ref_badge_padding(),
        reference.ref_badge_radius(),
        reference.ref_metric_label_size(),
        reference.ref_metric_label_muted(),
        reference.ref_metric_value_size(),
        reference.ref_metric_value_weight(),
        reference.ref_table_border(),
        reference.ref_table_padding(),
        reference.ref_table_header_weight(),
        reference.ref_table_caption_muted(),
        reference.ref_seg_gap(),
        reference.ref_seg_radius(),
        reference.ref_seg_size(),
        reference.ref_seg_padding(),
        reference.ref_seg_border(),
        reference.ref_seg_selected_border(),
        reference.field_invalid_token(),
        reference.field_valid_token(),
        reference.field_focus_token()
    ])
}

# The layout composition: the stacked rows, the two-column grid, and the
# prose measure — the family's ordinary component fns (the ref-layout-*
# identities; the grid columns are text — a grid of prose paragraphs would
# reuse the static ref-typography-prose identity, which the browser
# lifecycle diagnoses as a duplicate — asserted separately in
# check-reference). The wrapper identity is app-owned data (the canary-*
# precedent — MF-8).
fn layout_composition() → tela.View {
    return tela.element_full(
        tela.new_identity("canary-ref-layout"),
        tela.html_space(),
        "div",
        [],
        [],
        [
            reference.layout_stack(reference.stack_props([
                tela.text_view("row one"),
                tela.text_view("row two")
            ])),
            reference.layout_grid(reference.grid_props([
                tela.text_view("column one"),
                tela.text_view("column two")
            ])),
            reference.layout_prose(reference.layout_prose_props([
                reference.typography_prose(reference.prose_props([ tela.text_view("measure prose") ]))
            ]))
        ]
    )
}

# The duplicate-identity case (the check-reference diagnosis assert): a
# composition that reuses the static ref-typography-prose identity twice —
# the browser lifecycle diagnoses the ambiguity, never a silent bind
# (identity-hydration.md §6). The wrapper identity is app-owned data.
fn duplicate_prose_composition() → tela.View {
    return tela.element_full(
        tela.new_identity("canary-ref-duplicate"),
        tela.html_space(),
        "div",
        [],
        [],
        [
            reference.typography_prose(reference.prose_props([ tela.text_view("first") ])),
            reference.typography_prose(reference.prose_props([ tela.text_view("second") ]))
        ]
    )
}

# The typography composition: the heading hierarchy (native h1..h6), the
# prose paragraph with mixed emphasis, and the type-scale steps — the
# family's ordinary component fns (the ref-typography-* identities). The
# wrapper identity is app-owned data.
fn typography_composition() → tela.View {
    return tela.element_full(
        tela.new_identity("canary-ref-typography"),
        tela.html_space(),
        "div",
        [],
        [],
        [
            reference.typography_heading(reference.heading_props(1, "Catalog title")),
            reference.typography_heading(reference.heading_props(2, "Section")),
            reference.typography_prose(reference.prose_props([
                tela.text_view("Prose with "),
                reference.typography_emphasis(reference.emphasis_props("strong", "emphasis")),
                tela.text_view(" carried by markup.")
            ])),
            reference.typography_scale(reference.scale_props("lg", "lead text")),
            reference.typography_scale(reference.scale_props("xs", "caption text"))
        ]
    )
}

# check-reference mount seams (dom.scope + browser.mount).
fn mount_layout(string selector) → browser.Mounted ∪ null {
    const dom.Scope scope ← dom.scope(selector)
    return browser.mount(scope, layout_composition(), reference_theme())
}

fn mount_typography(string selector) → browser.Mounted ∪ null {
    const dom.Scope scope ← dom.scope(selector)
    return browser.mount(scope, typography_composition(), reference_theme())
}

# Panel, badge, and metric (tela:reference).

# The panel composition: a themed panel wrapping a prose paragraph. The
# panel's surface semantics come from the ref.panel.* tokens (referencing
# the theme core surface.panel / border.default — no hardcoded color).
# The wrapper identity is app-owned data.
fn panel_composition() → tela.View {
    return tela.element_full(
        tela.new_identity("canary-ref-panel"),
        tela.html_space(),
        "div",
        [],
        [],
        [
            reference.panel(reference.panel_props("status", "Status panel", [
                reference.typography_prose(reference.prose_props([ tela.text_view("all systems operational") ]))
            ]))
        ]
    )
}

# The badge composition: two textual status badges — the meaning is
# textual (label + the status word in the accessible name), never color
# alone. The wrapper identity is app-owned data.
fn badge_composition() → tela.View {
    return tela.element_full(
        tela.new_identity("canary-ref-badge"),
        tela.html_space(),
        "div",
        [],
        [],
        [
            reference.badge(reference.badge_props("new", "New", "3 messages")),
            reference.badge(reference.badge_props("ok", "Ok", "all checks passed"))
        ]
    )
}

# The metric composition: three metrics in the benchmark grammar's
# dl/dt/dd pattern — the textual form preserved (label + value + optional
# delta rows). The wrapper identity is app-owned data.
fn metric_composition() → tela.View {
    return tela.element_full(
        tela.new_identity("canary-ref-metric"),
        tela.html_space(),
        "div",
        [],
        [],
        [
            reference.metric(reference.metric_props("uptime", "uptime", "99.9%", "")),
            reference.metric(reference.metric_props("requests", "requests", "12 480", "+3.1%")),
            reference.metric(reference.metric_props("error", "error rate", "0.02%", "-0.01%"))
        ]
    )
}

# check-reference mount seams.
fn mount_panel(string selector) → browser.Mounted ∪ null {
    const dom.Scope scope ← dom.scope(selector)
    return browser.mount(scope, panel_composition(), reference_theme())
}

fn mount_badge(string selector) → browser.Mounted ∪ null {
    const dom.Scope scope ← dom.scope(selector)
    return browser.mount(scope, badge_composition(), reference_theme())
}

fn mount_metric(string selector) → browser.Mounted ∪ null {
    const dom.Scope scope ← dom.scope(selector)
    return browser.mount(scope, metric_composition(), reference_theme())
}

# Table (tela:reference). Native table markup is the a11y structure;
# interaction stays in the consumer plan (D1).

# The table composition: the benchmark table grammar — headers + rows +
# cells + a caption (the accessible name). The a11y structure: the native
# <table>/<caption>/<thead>/<th scope="col">/<tbody>/<tr>/<td> markup IS
# the structure (screen readers expose the grid natively); the header
# association rides the th[scope]; the table is stateless (the declared
# interaction stays in the consumer plan — D1). The wrapper identity is
# app-owned data.
fn table_composition() → tela.View {
    return tela.element_full(
        tela.new_identity("canary-ref-table"),
        tela.html_space(),
        "div",
        [],
        [],
        [
            reference.table(reference.table_props("services", "Services", ["Service", "Status"], [
                reference.table_row(["gateway", "ok"]),
                reference.table_row(["database", "ok"]),
                reference.table_row(["queue", "caution"])
            ]))
        ]
    )
}

# check-reference mount seam.
fn mount_table(string selector) → browser.Mounted ∪ null {
    const dom.Scope scope ← dom.scope(selector)
    return browser.mount(scope, table_composition(), reference_theme())
}

# Segmented-control composition + mount_segmented.

# The segmented-control composition: the catalog's control through NORMAL
# qualified imports (the U5 re-home). The wrapper identity is app-owned
# data (the canary-* precedent — MF-8).
fn segmented_composition() → tela.View {
    return tela.element_full(
        tela.new_identity("canary-ref-seg"),
        tela.html_space(),
        "div",
        [],
        [],
        [ reference.segmented_control(control_props()) ]
    )
}

# check-reference mount seam.
fn mount_segmented(string selector) → browser.Mounted ∪ null {
    const dom.Scope scope ← dom.scope(selector)
    return browser.mount(scope, segmented_composition(), reference_theme())
}

# Button composition + app-typed plan (D1). Bind only enabled buttons'
# declared activation event (reference.button_event() = "click"). The
# disabled delete button has no subscription. Host models Space/Enter
# on a focused native button as a click.

# The shared props (the static render + the app-typed plan consume the
# same carriers — the segment pattern). The delete button declares its
# accessible name via the aria-label override (the label/aria-label
# contract) + the disabled state.
fn save_button_props() → reference.ButtonProps {
    return reference.button_props("save", "Save", "primary", "enabled", reference.button_event(), "")
}

fn cancel_button_props() → reference.ButtonProps {
    return reference.button_props("cancel", "Cancel", "secondary", "enabled", reference.button_event(), "")
}

fn delete_button_props() → reference.ButtonProps {
    return reference.button_props("delete", "Delete", "primary", "disabled", reference.button_event(), "Delete permanently")
}

# The concrete app message type (one variant): Pressed — an activation of
# a button (the plan's update loop consumes it).
union ButtonMessage {
    Pressed { string identity }
}

# ButtonBinding-shaped binding (the Branch B shape, the U3/U4 pattern):
# one event subscription keyed to a stable node identity, carrying a typed
# message-producing closure. The event name is the props' declared
# activation event (the event surface).
class ButtonBinding {
    string identity
    string event_name
    (tela.EventName) → ButtonMessage message
}

# The button model — the app-side activation state (the press count + the
# last activated identity; the proof's consequence tracker — the button
# itself is stateless, the consequence is the app's).
class ButtonState {
    int presses
    string last
}

fn button_state(int presses, string last) → ButtonState {
    return ButtonState { presses = presses, last = last }
}

fn pressed(string identity) → ButtonMessage {
    return variant Pressed { identity = identity }
}

# The binding for one button: keyed to its ref-button-<name> identity,
# bound to its DECLARED activation event (props.event_name — the event
# surface flows from the props into the plan).
fn button_binding(reference.ButtonProps props) → ButtonBinding {
    return ButtonBinding {
        identity = "ref-button-" + props.name,
        event_name = props.event_name,
        message = (tela.EventName event_name) → ButtonMessage ∴ pressed(event_name.name)
    }
}

# The subscription plan: one activation binding per ENABLED button (the
# tela:dom subscriptions attach by identity — never ambient document
# shortcuts). The DISABLED delete button is deliberately NOT bound — a
# disabled click is a no-op by construction (the native disabled
# semantics + no subscription).
fn button_bindings() → list<ButtonBinding> {
    return [
        button_binding(save_button_props()),
        button_binding(cancel_button_props())
    ]
}

# The enabled-button focus order (the native keyboard contract targets —
# Space/Enter on a focused native button fire a click; the disabled
# button is not in the tab sequence, so it carries no keyboard target).
fn button_order() → list<string> {
    return ["ref-button-save", "ref-button-cancel"]
}

# The update function — an ordinary app function over the concrete message
# type: a Pressed message increments the press count + records the last
# activated identity.
fn update_button(ButtonState state, ButtonMessage message) → ButtonState {
    match message {
        case Pressed const identity {
            return button_state(state.presses + 1, identity)
        }
    }
}

# The button composition: the enabled save/cancel buttons + the disabled
# delete button (native disabled semantics — no activation, the state
# exposed). The wrapper identity is app-owned data (the canary-*
# precedent — MF-8).
fn button_composition() → tela.View {
    return tela.element_full(
        tela.new_identity("canary-ref-button"),
        tela.html_space(),
        "div",
        [],
        [],
        [
            reference.button(save_button_props()),
            reference.button(cancel_button_props()),
            reference.button(delete_button_props())
        ]
    )
}

# check-reference mount seam.
fn mount_button(string selector) → browser.Mounted ∪ null {
    const dom.Scope scope ← dom.scope(selector)
    return browser.mount(scope, button_composition(), reference_theme())
}

# Field composition (static ARIA surface). Valid name, invalid email
# (aria-describedby → error identity), disabled phone. Behavior plan
# is field_plan_* below.

# The shared props carriers — the VALID name field (value present, no
# error, enabled).
fn name_field_props() → reference.FieldInputProps {
    return reference.field_input_props("name", "Name", "Ada", "", "enabled")
}

# The INVALID email field (empty value + the error text — the
# aria-invalid/aria-describedby surface is live).
fn email_field_props() → reference.FieldInputProps {
    return reference.field_input_props("email", "Email", "", "Required", "enabled")
}

# The DISABLED phone field (the native disabled attribute — no entry, the
# state exposed; no subscription in the U8 plan by construction).
fn phone_field_props() → reference.FieldInputProps {
    return reference.field_input_props("phone", "Phone", "", "", "disabled")
}

# The field composition: the three field controls (the field_control
# association surface — the field + its error node under
# form-control-<name>) + the field-own declared live region
# (form-live). The wrapper identity is app-owned data (the canary-*
# precedent — MF-8).
fn field_composition() → tela.View {
    return tela.element_full(
        tela.new_identity("canary-ref-field"),
        tela.html_space(),
        "div",
        [],
        [],
        [
            reference.field_control(name_field_props()),
            reference.field_control(email_field_props()),
            reference.field_control(phone_field_props()),
            reference.field_live_region()
        ]
    )
}

# check-reference mount seam.
fn mount_field(string selector) → browser.Mounted ∪ null {
    const dom.Scope scope ← dom.scope(selector)
    return browser.mount(scope, field_composition(), reference_theme())
}

# Catalog-field behavior plan (D1). Catalog owns field_input_event,
# field_error_for_value, and field_announcement. App owns FieldMessage /
# FieldBinding / FieldPlanState / update_field_plan.
#
# Branch B closures carry no event payload: the input value is host-read
# (webDomValue) and folded into field_text. FieldBinding is therefore
# identity + event_name only. Disabled phone has no subscription.

# The concrete app message type (one variant): FieldInput — an input
# event carrying the field identity (form-field-<name>) + the input's
# value.
union FieldMessage {
    FieldInput { string identity string value }
}

# The field binding — the subscription surface (the Branch B shape, the
# U5/U6 pattern): one input subscription keyed to a stable node identity,
# bound to the catalog's declared input event.
class FieldBinding {
    string identity
    string event_name
}

# The field model — the app-side validation state for ONE catalog field
# (name + label + value + error; the error is the validation source —
# the catalog's static mapping derives aria-invalid from it).
class FieldPlanState {
    string name
    string label
    string value
    string error
}

fn field_plan_state(string name, string label, string value, string error) → FieldPlanState {
    return FieldPlanState { name = name, label = label, value = value, error = error }
}

# The message-producing helper (the closure body / the driver's
# constructor): an input event for a field identity carrying the input's
# value.
fn field_text(string identity, string value) → FieldMessage {
    return variant FieldInput { identity = identity, value = value }
}

# The state → catalog props mapping (the ARIA/validation semantics
# round-trip through the catalog's render helpers — the U7 static
# surface is the source of truth).
fn field_plan_props(FieldPlanState state) → reference.FieldInputProps {
    return reference.field_input_props(state.name, state.label, state.value, state.error, "enabled")
}

# The binding for one enabled field: keyed to its form-field-<name>
# identity, bound to the catalog's declared input event.
fn field_plan_binding(FieldPlanState state) → FieldBinding {
    return FieldBinding {
        identity = "form-field-" + state.name,
        event_name = reference.field_input_event()
    }
}

# The subscription plan: one input binding per ENABLED field (name +
# email). The DISABLED phone field is deliberately NOT bound — no entry,
# the state exposed (a disabled input event is a no-op by construction).
fn field_plan_bindings() → list<FieldBinding> {
    return [
        field_plan_binding(field_plan_state("name", "Name", "", "")),
        field_plan_binding(field_plan_state("email", "Email", "", "Required"))
    ]
}

# The update loop — an ordinary app function over the concrete message
# type. Validation semantics: the incoming value through the CATALOG's
# rule (field_error_for_value — empty → "Required", non-empty → "").
# A message for a DIFFERENT field identity is a no-op (the model keeps
# its state — the silent no-op rule downstream).
fn update_field_plan(FieldPlanState state, FieldMessage message) → FieldPlanState {
    match message {
        case FieldInput const identity, value {
            if not (identity ≡ "form-field-" + state.name) {
                return state
            }
            return field_plan_state(state.name, state.label, value, reference.field_error_for_value(value))
        }
    }
}

# The announcement wiring: the CATALOG's live-region policy over the
# state's props (announce once on a validation-state change, silent on a
# no-op — the §1.5 rule extended to the catalog field).
fn field_plan_announcement(FieldPlanState ante, FieldPlanState post) → string {
    return reference.field_announcement(field_plan_props(ante), field_plan_props(post))
}

# The field composition re-rendered from the app model — the update
# loop's view-render input (the driver applies the model via the
# messages): the name field from the model + the static email (invalid)
# + phone (disabled) companions + the field-own live region. The
# wrapper identity is app-owned data (the canary-* precedent — MF-8).
fn field_plan_composition(FieldPlanState name_state) → tela.View {
    return tela.element_full(
        tela.new_identity("canary-ref-field"),
        tela.html_space(),
        "div",
        [],
        [],
        [
            reference.field_control(field_plan_props(name_state)),
            reference.field_control(email_field_props()),
            reference.field_control(phone_field_props()),
            reference.field_live_region()
        ]
    )
}

# check-reference mount seam.
fn mount_field_plan(string selector) → browser.Mounted ∪ null {
    const dom.Scope scope ← dom.scope(selector)
    return browser.mount(scope, field_plan_composition(field_plan_state("name", "Name", "", "")), reference_theme())
}

main {
    # G4 seam attempt (recorded in the evidence record): ext.bar_meter
    # resolves to WARN014 export-skip; the app composes the meter with tela
    # constructors (documented workaround).
    const tela.View bar ← bar_meter_app("throughput", "7.4 Mbps", 74)

    # --- Assembled tree: panel > (two-column metric table, bar meter,
    # segmented control) — the control renders statically alongside the
    # Stage 1/2 composition (shared source: the same component function
    # that mounts interactively).
    const reference.SegmentedProps props ← control_props()
    const tela.View control ← reference.segmented_control(props)
    const tela.View tree ← app_panel([
        metric_table(),
        bar,
        control
    ])

    # --- Extension tokens — both palettes (zero-arg accessors per the
    # G4-safe seam; consumed via field access on the call result, since the
    # extension-local token class name is not a nameable qualified type from
    # the app — fix:snapshot-name-collision, see the extension header).
    # Stage 5 U2: the catalog's namespaced ref.* tokens join both themes
    # (collected app-side via the zero-arg accessors — MF-7). Stage 5 U7:
    # the field family's form.* tokens join too (identical names + values
    # to the formslib tokens — the kernel dedups by name-identical-content;
    # the catalog's field is self-sufficient).
    const tela.Theme lumen ← tela.theme("lumen", [
        tela.token("surface.canvas", "#ffffff"),
        tela.token("surface.panel", "#f9fafb"),
        tela.token("text.primary", "#111827"),
        tela.token("text.muted", "#6b7280"),
        tela.token("border.default", "#e5e7eb"),
        tela.token("accent.primary", "#2563eb"),
        tela.token("state.positive", "#16a34a"),
        tela.token("state.caution", "#d97706"),
        tela.token(ext.chart_axis_muted().name, ext.chart_axis_muted().value),
        tela.token(ext.chart_grid_muted().name, ext.chart_grid_muted().value),
        tela.token(forms.form_field_invalid().name, forms.form_field_invalid().value),
        tela.token(forms.form_field_valid().name, forms.form_field_valid().value),
        tela.token(forms.form_focus().name, forms.form_focus().value),
        reference.ref_layout_gap(),
        reference.ref_layout_prose_measure(),
        reference.ref_type_scale_xs(),
        reference.ref_type_scale_sm(),
        reference.ref_type_scale_md(),
        reference.ref_type_scale_lg(),
        reference.ref_type_scale_xl(),
        reference.ref_type_heading_weight(),
        reference.ref_type_heading_margin(),
        reference.ref_type_prose_line_height(),
        reference.ref_type_prose_margin(),
        reference.ref_panel_surface(),
        reference.ref_panel_border(),
        reference.ref_panel_radius(),
        reference.ref_panel_padding(),
        reference.ref_badge_size(),
        reference.ref_badge_padding(),
        reference.ref_badge_radius(),
        reference.ref_metric_label_size(),
        reference.ref_metric_label_muted(),
        reference.ref_metric_value_size(),
        reference.ref_metric_value_weight(),
        reference.ref_table_border(),
        reference.ref_table_padding(),
        reference.ref_table_header_weight(),
        reference.ref_table_caption_muted(),
        reference.ref_seg_gap(),
        reference.ref_seg_radius(),
        reference.ref_seg_size(),
        reference.ref_seg_padding(),
        reference.ref_seg_border(),
        reference.ref_seg_selected_border(),
        reference.ref_button_size(),
        reference.ref_button_padding(),
        reference.ref_button_radius(),
        reference.ref_button_border(),
        reference.ref_button_text(),
        reference.ref_button_primary_background(),
        reference.ref_button_primary_text(),
        reference.ref_button_secondary_background(),
        reference.ref_button_ghost_background(),
        reference.ref_button_focus(),
        reference.ref_button_disabled_opacity(),
        reference.field_invalid_token(),
        reference.field_valid_token(),
        reference.field_focus_token()
    ])
    const tela.Theme tenebrae ← tela.theme("tenebrae", [
        tela.token("surface.canvas", "#0f172a"),
        tela.token("surface.panel", "#1e293b"),
        tela.token("text.primary", "#f8fafc"),
        tela.token("text.muted", "#94a3b8"),
        tela.token("border.default", "#334155"),
        tela.token("accent.primary", "#3b82f6"),
        tela.token("state.positive", "#22c55e"),
        tela.token("state.caution", "#f59e0b"),
        tela.token(ext.chart_axis_muted_dark().name, ext.chart_axis_muted_dark().value),
        tela.token(ext.chart_grid_muted_dark().name, ext.chart_grid_muted_dark().value),
        tela.token(forms.form_field_invalid().name, forms.form_field_invalid().value),
        tela.token(forms.form_field_valid().name, forms.form_field_valid().value),
        tela.token(forms.form_focus().name, forms.form_focus().value),
        reference.ref_layout_gap(),
        reference.ref_layout_prose_measure(),
        reference.ref_type_scale_xs(),
        reference.ref_type_scale_sm(),
        reference.ref_type_scale_md(),
        reference.ref_type_scale_lg(),
        reference.ref_type_scale_xl(),
        reference.ref_type_heading_weight(),
        reference.ref_type_heading_margin(),
        reference.ref_type_prose_line_height(),
        reference.ref_type_prose_margin(),
        reference.ref_panel_surface(),
        reference.ref_panel_border(),
        reference.ref_panel_radius(),
        reference.ref_panel_padding(),
        reference.ref_badge_size(),
        reference.ref_badge_padding(),
        reference.ref_badge_radius(),
        reference.ref_metric_label_size(),
        reference.ref_metric_label_muted(),
        reference.ref_metric_value_size(),
        reference.ref_metric_value_weight(),
        reference.ref_table_border(),
        reference.ref_table_padding(),
        reference.ref_table_header_weight(),
        reference.ref_table_caption_muted(),
        reference.ref_seg_gap(),
        reference.ref_seg_radius(),
        reference.ref_seg_size(),
        reference.ref_seg_padding(),
        reference.ref_seg_border(),
        reference.ref_seg_selected_border(),
        reference.ref_button_size(),
        reference.ref_button_padding(),
        reference.ref_button_radius(),
        reference.ref_button_border(),
        reference.ref_button_text(),
        reference.ref_button_primary_background(),
        reference.ref_button_primary_text(),
        reference.ref_button_secondary_background(),
        reference.ref_button_ghost_background(),
        reference.ref_button_focus(),
        reference.ref_button_disabled_opacity(),
        reference.field_invalid_token(),
        reference.field_valid_token(),
        reference.field_focus_token()
    ])

    # --- App + extension style bundles (identical under both themes) -------
    const tela.Style ext_stilum ← ext.chart_style()
    const tela.Bundle ext_bundle ← tela.bundle("extensionlib", ext_stilum)

    # --- The formslib component style bundle (the three-package input) -----
    # Class-returning (→ tela.Style) — consumable from the consumer today
    # (the stage-1 §3 evidence); the identity "formslib" is the package's
    # assembly-identity entry (the order map declares it app-side).
    const tela.Style forms_stilum ← forms.form_style()
    const tela.Bundle forms_bundle ← tela.bundle("formslib", forms_stilum)

    # --- The reference catalog's component style bundles (Stage 5 U2/U3) --
    # The component layer (input order): rules keyed on the ref-* identities,
    # referencing the --ref-* tokens (the layout + typography bundles, U2;
    # the panel + badge + metric bundles, U3 — prefix-keyed on the
    # variable-suffix identities).
    const tela.Style ref_layout_stilum ← reference.layout_style()
    const tela.Bundle ref_layout_bundle ← tela.bundle("reference-layout", ref_layout_stilum)
    const tela.Style ref_typography_stilum ← reference.typography_style()
    const tela.Bundle ref_typography_bundle ← tela.bundle("reference-typography", ref_typography_stilum)
    const tela.Style ref_panel_stilum ← reference.panel_style()
    const tela.Bundle ref_panel_bundle ← tela.bundle("reference-panel", ref_panel_stilum)
    const tela.Style ref_badge_stilum ← reference.badge_style()
    const tela.Bundle ref_badge_bundle ← tela.bundle("reference-badge", ref_badge_stilum)
    const tela.Style ref_metric_stilum ← reference.metric_style()
    const tela.Bundle ref_metric_bundle ← tela.bundle("reference-metric", ref_metric_stilum)
    # Stage 5 U4: the table bundle (prefix-keyed on the ref-table-*
    # identities, referencing the --ref-table-* tokens).
    const tela.Style ref_table_stilum ← reference.table_style()
    const tela.Bundle ref_table_bundle ← tela.bundle("reference-table", ref_table_stilum)
    # Stage 5 U5: the segmented-control bundle (the ref-seg-* identities —
    # the group's flex layout + the segments' shaping + the selected-state
    # accent border, all referencing the --ref-seg-* tokens).
    const tela.Style ref_seg_stilum ← reference.segmented_style()
    const tela.Bundle ref_seg_bundle ← tela.bundle("reference-seg", ref_seg_stilum)
    # Stage 5 U6: the button bundle (the ref-button-* identities — the
    # shape + the variant treatments + the visible-focus :focus-visible
    # rule + the native-disabled dim, referencing the --ref-button-*
    # tokens).
    const tela.Style ref_button_stilum ← reference.button_style()
    const tela.Bundle ref_button_bundle ← tela.bundle("reference-button", ref_button_stilum)
    # Stage 5 U7: the field bundle (the form-* identities — the invalid
    # border + the focus ring + the error/live-region rules + the
    # native-disabled dim, referencing the --form-* tokens).
    const tela.Style ref_field_stilum ← reference.field_style()
    const tela.Bundle ref_field_bundle ← tela.bundle("reference-field", ref_field_stilum)

    # App style bundle: the panel rule (the segmented-control rule was
    # app-owned in Stage 3; the control's styles now ride the reference
    # segmented bundle — Stage 5 U5 re-home).
    const tela.Style app_stilum ← tela.Style {
        rules = [
            tela.Rule {
                selector = "[data-tela='canary-panelum']",
                declarations = [
                    tela.Declaration { name = "display", value = "grid" },
                    tela.Declaration { name = "gap", value = "1rem" },
                    tela.Declaration { name = "color", value = "var(--chart-axis-muted)" }
                ]
            }
        ]
    }
    const tela.Bundle app_bundle ← tela.bundle("canary-app", app_stilum)

    # --- Full cascade under each theme (assemble: tokens -> extensionlib ->
    # formslib -> canary-app; the token layer + the library bundles are the
    # only differences between the two). The three-package order map: both
    # extensionlib and formslib depend on nothing (tela is the shared base),
    # so the kernel's topological tie-break (stable package identity) orders
    # extensionlib before formslib — the documented cascade order.
    const tela.Style ∪ null cascade_lumen_result ← tela.assemble(
        lumen,
        null,
        [ref_layout_bundle, ref_typography_bundle, ref_panel_bundle, ref_badge_bundle, ref_metric_bundle, ref_table_bundle, ref_seg_bundle, ref_button_bundle, ref_field_bundle],
        [ tela.order("extensionlib", []), tela.order("formslib", []) ],
        [ext_bundle, forms_bundle],
        app_bundle
    )
    const tela.Style ∪ null cascade_tenebrae_result ← tela.assemble(
        tenebrae,
        null,
        [ref_layout_bundle, ref_typography_bundle, ref_panel_bundle, ref_badge_bundle, ref_metric_bundle, ref_table_bundle, ref_seg_bundle, ref_button_bundle, ref_field_bundle],
        [ tela.order("extensionlib", []), tela.order("formslib", []) ],
        [ext_bundle, forms_bundle],
        app_bundle
    )
    assert not (cascade_lumen_result ≡ null)
    assert not (cascade_tenebrae_result ≡ null)
    const string css_lumen ← tela.css(tela.Style { rules = cascade_lumen_result!.rules }) coalesce ""
    const string css_tenebrae ← tela.css(tela.Style { rules = cascade_tenebrae_result!.rules }) coalesce ""

    # --- The Stage 2 campaign gate proof (bullets 1 + 2) -------------------
    # HTML is theme-independent: the same tree renders byte-identically
    # (themes supply values, not markup).
    const string html_a ← tela.html_view(tree) coalesce ""
    const string html_b ← tela.html_view(tree) coalesce ""
    assert html_a ≡ html_b
    # The two theme token layers differ materially.
    assert css_lumen ≠ css_tenebrae

    # --- The Stage 4 U3 three-package cascade assertions -------------------
    # The :root token layer includes the namespaced --form-* values (the
    # forms tokens flow through the kernel token rendering).
    assert css_lumen.continet("--form-field-invalid: #dc2626")
    assert css_lumen.continet("--form-field-valid: #16a34a")
    assert css_lumen.continet("--form-focus: #2563eb")
    # The forms component style bundle rides the cascade (keyed on the
    # family identities, referencing the --form-* tokens).
    assert css_lumen.continet("[data-tela^='form-field-']")
    assert css_lumen.continet("[data-tela^='form-error-']")
    assert css_lumen.continet("[data-tela='form-live']")
    assert css_lumen.continet("var(--form-field-invalid)")
    assert css_lumen.continet("var(--form-focus)")

    # --- The Stage 5 U2 reference-catalog cascade (done_when (f)) ---------
    # The :root token layer includes the namespaced --ref-* values (the
    # catalog tokens flow through the kernel token rendering).
    assert css_lumen.continet("--ref-layout-gap: 1rem")
    assert css_lumen.continet("--ref-type-scale-xl: 1.5rem")
    # The reference component bundles ride the cascade (keyed on the ref-*
    # identities, referencing the --ref-* tokens).
    assert css_lumen.continet("[data-tela='ref-layout-stack']")
    assert css_lumen.continet("[data-tela='ref-layout-grid']")
    assert css_lumen.continet("[data-tela='ref-layout-prose']")
    assert css_lumen.continet("[data-tela='ref-typography-heading-1']")
    assert css_lumen.continet("[data-tela='ref-typography-prose']")
    assert css_lumen.continet("var(--ref-layout-gap)")
    assert css_lumen.continet("var(--ref-type-scale-xl)")
    assert css_lumen.continet("var(--ref-type-prose-line-height)")

    # --- The Stage 5 U3 reference-catalog cascade (done_when (e)) ---------
    # The :root token layer includes the ref.panel.* / ref.badge.* /
    # ref.metric.* values — the panel surface + border and the metric
    # label color reference the theme's core tokens (theme-surface
    # semantics — no hardcoded color in the token layer).
    assert css_lumen.continet("--ref-panel-surface: var(--surface-panel)")
    assert css_lumen.continet("--ref-panel-border: var(--border-default)")
    assert css_lumen.continet("--ref-badge-size: 0.75rem")
    assert css_lumen.continet("--ref-metric-label-muted: var(--text-muted)")
    assert css_lumen.continet("--ref-metric-value-size: 1.5rem")
    # The U3 component bundles ride the cascade (prefix-keyed on the
    # variable-suffix identities, referencing the --ref-* tokens).
    assert css_lumen.continet("[data-tela^='ref-panel-']")
    assert css_lumen.continet("[data-tela^='ref-badge-']")
    assert css_lumen.continet("[data-tela^='ref-metric-']")
    assert css_lumen.continet("var(--ref-panel-surface)")
    assert css_lumen.continet("var(--ref-metric-label-muted)")
    # The theme-surface round trip: the panel's surface token resolves to
    # the theme's core surface.panel value in the assembled token layer
    # (the core token itself carries the resolved color).
    assert css_lumen.continet("--surface-panel: #f9fafb")

    # --- The Stage 5 U4 reference-catalog cascade (done_when (e)) ---------
    # The :root token layer includes the ref.table.* values — the border +
    # caption color reference the theme's core tokens (theme-surface
    # semantics — no hardcoded color in the token layer).
    assert css_lumen.continet("--ref-table-border: var(--border-default)")
    assert css_lumen.continet("--ref-table-padding: 0.5rem 0.75rem")
    assert css_lumen.continet("--ref-table-header-weight: 600")
    assert css_lumen.continet("--ref-table-caption-muted: var(--text-muted)")
    # The table component bundle rides the cascade (prefix-keyed on the
    # ref-table-* identities, referencing the --ref-table-* tokens).
    assert css_lumen.continet("[data-tela^='ref-table-']")
    assert css_lumen.continet("var(--ref-table-border)")
    assert css_lumen.continet("var(--ref-table-caption-muted)")

    # --- The Stage 5 U5 reference-catalog cascade (done_when (e)) ---------
    # The :root token layer includes the ref.seg.* values — the border color
    # references the theme's core tokens (the selected state is SEMANTIC —
    # aria-selected — the accent border is decorative emphasis).
    assert css_lumen.continet("--ref-seg-gap: 0.25rem")
    assert css_lumen.continet("--ref-seg-radius: 0.375rem")
    assert css_lumen.continet("--ref-seg-border: var(--border-default)")
    assert css_lumen.continet("--ref-seg-selected-border: var(--accent-primary)")
    # The segmented-control bundle rides the cascade (role-scoped rules on
    # the ref-seg-* identities, referencing the --ref-seg-* tokens).
    assert css_lumen.continet("[data-tela^='ref-seg-'][role='radiogroup']")
    assert css_lumen.continet("[data-tela^='ref-seg-'][role='radio']")
    assert css_lumen.continet("var(--ref-seg-gap)")
    assert css_lumen.continet("var(--ref-seg-selected-border)")

    # --- The Stage 5 U6 reference-catalog cascade (done_when (d)) ---------
    # The :root token layer includes the ref.button.* values — the
    # color-bearing tokens reference the theme's core tokens (the primary
    # background = the accent, the primary text = the inverse surface, the
    # focus = the accent — no hardcoded color).
    assert css_lumen.continet("--ref-button-size: 0.875rem")
    assert css_lumen.continet("--ref-button-padding: 0.5rem 1rem")
    assert css_lumen.continet("--ref-button-border: var(--border-default)")
    assert css_lumen.continet("--ref-button-primary-background: var(--accent-primary)")
    assert css_lumen.continet("--ref-button-primary-text: var(--surface-canvas)")
    assert css_lumen.continet("--ref-button-focus: var(--accent-primary)")
    assert css_lumen.continet("--ref-button-disabled-opacity: 0.6")
    # The button bundle rides the cascade: the shape rule (prefix-keyed on
    # the ref-button-* identities), the variant treatments (the
    # data-ref-variant attribute), THE VISIBLE FOCUS (:focus-visible — the
    # campaign §8 visible-focus contract), the disabled dim (:disabled).
    assert css_lumen.continet("[data-tela^='ref-button-']")
    assert css_lumen.continet(«[data-tela^='ref-button-'][data-ref-variant="primary"]»)
    assert css_lumen.continet("[data-tela^='ref-button-']:focus-visible")
    assert css_lumen.continet("[data-tela^='ref-button-']:disabled")
    assert css_lumen.continet("var(--ref-button-focus)")
    assert css_lumen.continet("var(--ref-button-primary-background)")

    # --- The Stage 5 U7 reference-catalog cascade (done_when (b)) ---------
    # The :root token layer includes the form.* values — the Stage 4
    # namespaced-token surface RE-HOMED (identical names + values; the
    # catalog's field is self-sufficient — the kernel dedups against the
    # formslib tokens by name-identical-content).
    assert css_lumen.continet("--form-field-invalid: #dc2626")
    assert css_lumen.continet("--form-field-valid: #16a34a")
    assert css_lumen.continet("--form-focus: #2563eb")
    # The field bundle rides the cascade: the invalid border + the focus
    # ring + the error/live-region rules (keyed on the form-* identities,
    # referencing the --form-* tokens) + the native-disabled dim.
    assert css_lumen.continet("[data-tela^='form-field-']")
    assert css_lumen.continet("[data-tela^='form-field-']:focus")
    assert css_lumen.continet("[data-tela^='form-error-']")
    assert css_lumen.continet("[data-tela='form-live']")
    assert css_lumen.continet("[data-tela^='form-field-']:disabled")
    assert css_lumen.continet("var(--form-field-invalid)")
    assert css_lumen.continet("var(--form-focus)")

    # --- The Stage 2 fail-closed regressions re-asserted (three-package) ---
    # A cycle in the order map rejects (fail-closed — no partial cascade).
    const tela.Style ∪ null cycle_result ← tela.assemble(
        lumen,
        null,
        [],
        [ tela.order("extensionlib", ["formslib"]), tela.order("formslib", ["extensionlib"]) ],
        [ext_bundle, forms_bundle],
        app_bundle
    )
    assert cycle_result ≡ null
    # Duplicate package identity with different content rejects (dedup by
    # stable identity — fail-closed, the Stage 2 contract).
    const tela.Bundle forms_bundle_altera ← tela.bundle(
        "formslib",
        tela.Style {
            rules = [
                tela.Rule {
                    selector = "[data-tela^='form-select-']",
                    declarations = [
                        tela.Declaration { name = "color", value = "var(--form-focus)" }
                    ]
                }
            ]
        }
    )
    const tela.Style ∪ null duplicate_result ← tela.assemble(
        lumen,
        null,
        [],
        [ tela.order("extensionlib", []), tela.order("formslib", []) ],
        [ext_bundle, forms_bundle, forms_bundle_altera],
        app_bundle
    )
    assert duplicate_result ≡ null
    # Invalid output (an empty-selector rule) rejects (fail-closed).
    const tela.Bundle malum_bundle ← tela.bundle(
        "mala",
        tela.Style {
            rules = [
                tela.Rule {
                    selector = "",
                    declarations = [
                        tela.Declaration { name = "color", value = "#000000" }
                    ]
                }
            ]
        }
    )
    const tela.Style ∪ null malum_result ← tela.assemble(
        lumen,
        null,
        [],
        [ tela.order("extensionlib", []), tela.order("formslib", []) ],
        [ext_bundle, forms_bundle, malum_bundle],
        app_bundle
    )
    assert malum_result ≡ null

    # --- The forms family static render (Stage 4 U3, runner input) --------
    # U0 re-route (MF-6): the runner renders the family through the
    # `→ tela.View` component fns via the NORMAL package interface (the
    # exempla-mode consumption re-verified live against in-tree radix
    # 0.80.0 — post-cds-u6, green). The `*_html` helpers are RETIRED. The
    # rendered bytes are IDENTICAL to the pre-route output (the helpers
    # were exactly `tela.html_view(fn(...))`), so the determinism sha is
    # unaffected by the re-route.
    const string forma_composita ←
        tela.html_view(forms.field(forms.field_props("name", "Name", "", "false", ""))) coalesce "" +
        tela.html_view(forms.checkbox(forms.checkbox_props("agree", "Agree", "true", "false"))) coalesce "" +
        tela.html_view(forms.select(forms.select_props("tone", "Tone", ["Light", "Dark"], "false"))) coalesce "" +
        tela.html_view(forms.error_region("name", "")) coalesce "" +
        tela.html_view(forms.form_live_region()) coalesce ""
    assert forma_composita ≡ «<input type="text" aria-label="Name" aria-invalid="false" data-tela="form-field-name"><input type="checkbox" aria-label="Agree" aria-checked="true" aria-invalid="false" data-tela="form-checkbox-agree"><select aria-label="Tone" aria-invalid="false" data-tela="form-select-tone"><option>Light</option><option>Dark</option></select><div role="alert" data-tela="form-error-name"></div><div role="status" aria-live="polite" data-tela="form-live"></div>»
    # The extension bundle resolves before the forms bundle in the cascade
    # (the topological tie-break orders extensionlib before formslib). The
    # forms probe is formslib-UNIQUE ([data-tela^='form-checkbox-']): the
    # catalog's field bundle (Stage 5 U7) legitimately emits the shared
    # [data-tela^='form-field-'] rule in the COMPONENT layer (which
    # precedes the library layer in the cascade order) — the library-layer
    # ordering assert must probe a formslib-only selector.
    const int ext_index ← index_in(css_lumen, "[data-tela='tela-chart-bar']")
    const int forms_index ← index_in(css_lumen, "[data-tela^='form-checkbox-']")
    assert ext_index < forms_index

    # --- The Stage 3 static half (U3 done_when (a)) ------------------------
    # The segmented control renders deterministically through html_view:
    # exact bytes — role=radiogroup on the group, role=radio + aria-selected
    # + the roving tabindex on the segments (§1.3/§1.4), the control-owned
    # declared live region (§1.5), stable ref-seg-* data-tela identities
    # throughout (Stage 5 U5 — the reference re-home).
    const string html_controllum ← tela.html_view(control) coalesce ""
    # Serializer emission order: attributes in author order, then data-tela
    # (the identity attribute) — the U2 exempla precedent.
    assert html_controllum ≡ «<div role="radiogroup" aria-label="segmented control" data-tela="ref-seg-control"><button role="radio" aria-selected="true" tabindex="0" data-tela="ref-seg-control-1">One</button><button role="radio" aria-selected="false" tabindex="-1" data-tela="ref-seg-control-2">Two</button><button role="radio" aria-selected="false" tabindex="-1" data-tela="ref-seg-control-3">Three</button><div role="status" aria-live="polite" data-tela="ref-seg-live"></div></div>»

    # --- The app-typed behavior plan (U3 done_when (b)) — pure proof -------
    # The plan is app-typed (D1 recorded, never kernel-generic) and carried
    # by typed message-producing closures (not erased into strings). Stage 5
    # U5: the plan re-targets the reference identities (ref-seg-control-N).
    const list<EventBinding> vincula ← control_bindings()
    assert vincula.longitudo() ≡ 3
    # Invoke a binding's closure: click on ref-seg-control-2 → Selected.
    const Message click_msg ← vincula[1].message(tela.event_name("ref-seg-control-2"))
    match click_msg {
        case Selected const identity {
            assert identity ≡ "ref-seg-control-2"
        }
        case Moved const identity {
            assert false
        }
    }
    # The update loop: Selected changes the selection.
    const string post ← update_control("ref-seg-control-1", click_msg)
    assert post ≡ "ref-seg-control-2"
    # The keyboard mapping: arrows move focus only (Moved) — the update
    # leaves the selection unchanged (§1.3; live-region-silent per §1.5).
    const Message arrow_msg ← key_message("ref-seg-control-2", "ArrowRight")
    match arrow_msg {
        case Moved const identity {
            assert identity ≡ "ref-seg-control-3"
        }
        case Selected const identity {
            assert false
        }
    }
    const string post_arrow ← update_control(post, arrow_msg)
    assert post_arrow ≡ post
    # Home/End move focus to first/last (Moved); Space/Enter select.
    match key_message("ref-seg-control-3", "Home") {
        case Moved const identity {
            assert identity ≡ "ref-seg-control-1"
        }
        case Selected const identity {
            assert false
        }
    }
    match key_message("ref-seg-control-1", "End") {
        case Moved const identity {
            assert identity ≡ "ref-seg-control-3"
        }
        case Selected const identity {
            assert false
        }
    }
    match key_message("ref-seg-control-2", "Space") {
        case Selected const identity {
            assert identity ≡ "ref-seg-control-2"
        }
        case Moved const identity {
            assert false
        }
    }
    # A no-op selection change: clicking the already-selected segment keeps
    # the model unchanged — the update returns the same selection (silent).
    const Message noop_msg ← vincula[1].message(tela.event_name("ref-seg-control-2"))
    assert update_control(post, noop_msg) ≡ post
    # The declarative effects (behavior-design §3.2) — the kernel carriers
    # + the key accessor (fix:sem001 — the kernel owns the only Effect
    # matcher; the host executes effects by reading the key).
    const tela.Effect restore ← tela.restore("ref-seg-control-2")
    assert tela.effect_identity(restore) ≡ "ref-seg-control-2"
    const tela.Effect anchor ← tela.anchor("#root")
    assert tela.effect_identity(anchor) ≡ "#root"
    # The live-region announcement mapping (§1.5): names the new option.
    assert announcement(props, "ref-seg-control-2") ≡ "Two selected"
    assert announcement(props, "ref-seg-control-1") ≡ "One selected"
    # The props carrier + the mount theme (the driver + update loop consume
    # these; the reference mount theme covers the core — asserted below).
    assert selected_props(props, "ref-seg-control-3").selected ≡ "ref-seg-control-3"

    # --- The forms behavior plan (U4 done_when (b)) — pure proof --------
    # The plan is app-typed (D1 recorded, never kernel-generic) and carried
    # by typed message-producing closures (not erased into strings). The
    # bindings key to the forms identities; the event spellings are the
    # package's contract constants (consumable — the G4-safe surface).
    assert forms.field_event() ≡ "input"
    assert forms.change_event() ≡ "change"
    assert forms.submit_event() ≡ "submit"
    assert forms.click_event() ≡ "click"
    const FormBinding v_campum ← field_binding("form-field-name", "Ada")
    const FormBinding v_boxum ← checkbox_binding("form-checkbox-agree", true)
    const FormBinding v_selectum ← select_binding("form-select-tone", "Dark")
    const FormBinding v_submissio ← submit_binding("form-submit")
    assert v_campum.event_name ≡ forms.field_event()
    assert v_boxum.event_name ≡ forms.change_event()
    assert v_selectum.event_name ≡ forms.change_event()
    assert v_submissio.event_name ≡ forms.submit_event()
    assert v_campum.identity ≡ "form-field-name"
    assert v_boxum.identity ≡ "form-checkbox-agree"
    assert v_selectum.identity ≡ "form-select-tone"
    assert v_submissio.identity ≡ "form-submit"

    # Invoke the bindings' closures (the event's name carries the
    # identity — the event subscription keys by identity, never ambient).
    const FormMessage m_campum ← v_campum.message(tela.event_name("form-field-name"))
    match m_campum {
        case FieldText const identity, value {
            assert identity ≡ "form-field-name"
            assert value ≡ "Ada"
        }
        case CheckboxToggle const identity, selected {
            assert false
        }
        case SelectChange const identity, selected {
            assert false
        }
        case Submit const identity {
            assert false
        }
    }
    const FormMessage m_boxum ← v_boxum.message(tela.event_name("form-checkbox-agree"))
    match m_boxum {
        case CheckboxToggle const identity, selected {
            assert identity ≡ "form-checkbox-agree"
            assert selected ≡ true
        }
        case FieldText const identity, value {
            assert false
        }
        case SelectChange const identity, selected {
            assert false
        }
        case Submit const identity {
            assert false
        }
    }
    const FormMessage m_selectum ← v_selectum.message(tela.event_name("form-select-tone"))
    match m_selectum {
        case SelectChange const identity, selected {
            assert identity ≡ "form-select-tone"
            assert selected ≡ "Dark"
        }
        case FieldText const identity, value {
            assert false
        }
        case CheckboxToggle const identity, selected {
            assert false
        }
        case Submit const identity {
            assert false
        }
    }
    const FormMessage m_submissio ← v_submissio.message(tela.event_name("form-submit"))
    match m_submissio {
        case Submit const identity {
            assert identity ≡ "form-submit"
        }
        case FieldText const identity, value {
            assert false
        }
        case CheckboxToggle const identity, selected {
            assert false
        }
        case SelectChange const identity, selected {
            assert false
        }
    }

    # The update/validation semantics: an empty field input → invalid (the
    # error text set — the model flips to invalid); the validation-state
    # mapping flips aria-invalid to "true" + the error text is present.
    const FieldState statu_init ← field_state("form-field-name", "", "")
    const FieldState statu_invalidum ← update_field(statu_init, field_text_message("form-field-name", ""))
    assert statu_invalidum.error ≡ "Required"
    assert forms.invalid_state(forms.error_present(statu_invalidum.error)) ≡ "true"
    # The round trip through the package's render helper: invalid → the
    # bytes carry aria-invalid="true" + aria-describedby → the error
    # identity + the error text (the field_group association, U2).
    const string grex_invalidum ← tela.html_view(forms.field_group(props_from_state("name", "Name", statu_invalidum))) coalesce ""
    assert grex_invalidum.continet(«aria-invalid="true"»)
    assert grex_invalidum.continet(«aria-describedby="form-error-name"»)
    assert grex_invalidum.continet(">Required</div>")
    # A non-empty field input → valid: the error cleared (aria-invalid
    # flips "false", no describedby).
    const FieldState statu_validum ← update_field(statu_invalidum, field_text_message("form-field-name", "Ada"))
    assert statu_validum.error ≡ ""
    const string grex_validum ← tela.html_view(forms.field_group(props_from_state("name", "Name", statu_validum))) coalesce ""
    assert not grex_validum.continet(«aria-invalid="true"»)
    assert not grex_validum.continet("aria-describedby")
    # The live-region policy (§1.5 extended to form validation): the
    # invalid → valid transition announces; a no-op input (same value,
    # same state) is SILENT ("" — the no-op rule).
    assert form_announcement(statu_invalidum, statu_validum) ≡ "form-field-name valid"
    const FieldState statu_noop ← update_field(statu_validum, field_text_message("form-field-name", "Ada"))
    assert statu_noop.value ≡ statu_validum.value
    assert form_announcement(statu_validum, statu_noop) ≡ ""
    # The checkbox toggle + select change update the model (the change
    # messages keyed to the forms identities); the second identical toggle
    # is a state no-op → silent.
    const FieldState statu_boxum ← update_field(statu_validum, checkbox_toggle_message("form-checkbox-agree", true))
    assert statu_boxum.value ≡ "true"
    assert form_announcement(statu_validum, statu_boxum) ≡ "form-checkbox-agree valid"
    const FieldState statu_boxum_noop ← update_field(statu_boxum, checkbox_toggle_message("form-checkbox-agree", true))
    assert statu_boxum_noop.value ≡ statu_boxum.value
    assert form_announcement(statu_boxum, statu_boxum_noop) ≡ ""
    const FieldState statu_selectum ← update_field(statu_boxum, select_change_message("form-select-tone", "Dark"))
    assert statu_selectum.value ≡ "Dark"
    # The submit validates: an invalid field keeps the error (a state
    # no-op — silent); a valid field stays cleared (submitted).
    const FieldState statu_submit_invalidum ← update_field(statu_invalidum, submit_message("form-submit"))
    assert statu_submit_invalidum.error ≡ "Required"
    assert form_announcement(statu_invalidum, statu_submit_invalidum) ≡ ""
    const FieldState statu_submit_validum ← update_field(statu_validum, submit_message("form-submit"))
    assert statu_submit_validum.error ≡ ""
    # fix:sem001 held (the recorded G3-family gap): effect keys are read
    # through the kernel's effect_identity — the app never matches an
    # imported union. The declarative effect keys attach to the same
    # data-tela values the bindings key to (identity-hydration §7).
    const tela.Effect restore_formae ← tela.restore("form-field-name")
    assert tela.effect_identity(restore_formae) ≡ "form-field-name"
    const tela.Effect ancora_formae ← tela.anchor("#root")
    assert tela.effect_identity(ancora_formae) ≡ "#root"

    # --- The static-render runner output: HTML once, the full cascade CSS
    # under each theme (the U6/U3 double-build hook consumes this), then
    # the segmented-control static render (the U4 determinism hook).
    print html_a
    print css_lumen
    print css_tenebrae
    print "two-theme static rendered (lumen vs tenebrae; tela-s2-u3)"
    print html_controllum
    print "segmented control static rendered (reference re-home, initial selection ref-seg-control-1; tela-s5-u5)"
    print forma_composita
    print "forms family static rendered (field/checkbox/select + error/live; tela-s4-u3)"
    print "forms behavior plan asserted (input/toggle/change/submit + validation semantics; tela-s4-u4)"

    # --- Stage 5 U2 — the reference catalog static render (done_when (f)).
    # The layout + typography families compose through NORMAL qualified
    # imports (the U1 probe (i) at real use); the runner output extends —
    # the Stage 4 determinism sha is SUPERSEDED (recorded in the header).
    # The a11y structure asserts (the documented structure): the heading
    # hierarchy (native h1..h6), the prose semantics (p), the semantic
    # emphasis (strong/em/code), the scale steps — the wrapper identities
    # are app-owned data (canary-*).
    const string html_layout ← tela.html_view(layout_composition()) coalesce ""
    const string html_typography ← tela.html_view(typography_composition()) coalesce ""
    assert html_layout.continet(«<div data-tela="ref-layout-stack">»)
    assert html_layout.continet(«<div data-tela="ref-layout-grid">»)
    assert html_layout.continet(«<div data-tela="ref-layout-prose">»)
    assert html_layout.continet(«<div data-tela="ref-layout-grid">column onecolumn two</div>»)
    assert html_layout.continet(«<p data-tela="ref-typography-prose">measure prose</p>»)
    assert html_typography.continet(«<h1 data-tela="ref-typography-heading-1">Catalog title</h1>»)
    assert html_typography.continet(«<h2 data-tela="ref-typography-heading-2">Section</h2>»)
    assert html_typography.continet(«<p data-tela="ref-typography-prose">Prose with »)
    assert html_typography.continet(«<strong data-tela="ref-typography-emphasis-strong">emphasis</strong>»)
    assert html_typography.continet(«<span data-tela="ref-typography-scale-lg">lead text</span>»)
    assert html_typography.continet(«<span data-tela="ref-typography-scale-xs">caption text</span>»)
    # The mount seam is the check-reference browser-proof surface (the
    # driver calls mount_layout/mount_typography through the app's own
    # imports AFTER installing the host DOM — main{} stays seam-free, the
    # driver executes the seam).
    assert not (tela.theme_css(reference_theme()) ≡ null)
    print html_layout
    print "layout family static rendered (stack/grid/prose; tela-s5-u2)"
    print html_typography
    print "typography family static rendered (headings/prose/emphasis/scale; tela-s5-u2)"
    print "reference composition asserted (layout + typography families; tela-s5-u2)"

    # --- Stage 5 U3 — the panel + badge + metric static render -------------
    # The families compose through NORMAL qualified imports; the runner
    # output extends — the determinism sha stays SUPERSEDED (recorded).
    # The a11y structure asserts: the panel's region landmark + accessible
    # name, the badge's role=status + the textual meaning (the status word
    # in the accessible name — never color alone), the metric's dl/dt/dd
    # label/value(+delta) structure (the textual form preserved).
    const string html_panel ← tela.html_view(panel_composition()) coalesce ""
    const string html_badge ← tela.html_view(badge_composition()) coalesce ""
    const string html_metric ← tela.html_view(metric_composition()) coalesce ""
    assert html_panel.continet(«<div role="region" aria-label="Status panel" data-tela="ref-panel-status">»)
    assert html_panel.continet(«<p data-tela="ref-typography-prose">all systems operational</p>»)
    assert html_badge.continet(«<span role="status" aria-label="New: 3 messages" data-tela="ref-badge-new">3 messages</span>»)
    assert html_badge.continet(«<span role="status" aria-label="Ok: all checks passed" data-tela="ref-badge-ok">all checks passed</span>»)
    assert html_metric.continet(«<dl data-tela="ref-metric-uptime"><dt>uptime</dt><dd>99.9%</dd></dl>»)
    assert html_metric.continet(«<dl data-tela="ref-metric-requests"><dt>requests</dt><dd>12 480</dd><dd>+3.1%</dd></dl>»)
    assert html_metric.continet(«<dl data-tela="ref-metric-error"><dt>error rate</dt><dd>0.02%</dd><dd>-0.01%</dd></dl>»)
    print html_panel
    print "panel family static rendered (theme-surface container; tela-s5-u3)"
    print html_badge
    print "badge family static rendered (textual status; tela-s5-u3)"
    print html_metric
    print "metric family static rendered (label/value/delta; tela-s5-u3)"
    print "reference composition asserted (panel + badge + metric families; tela-s5-u3)"

    # --- Stage 5 U4 — the table static render -----------------------------
    # The table family composes through NORMAL qualified imports; the
    # runner output extends AGAIN — the determinism sha stays SUPERSEDED
    # (recorded in the header). The a11y structure asserts: the native
    # <table>/<caption>/<thead>/<th scope="col">/<tbody>/<tr>/<td> markup
    # IS the structure — the header association rides th[scope], the
    # caption provides the accessible name, the ref-table-* identities
    # (root + header cells + body cells) are the stable focus targets for
    # the declared consumer-plan navigation interaction.
    const string html_table ← tela.html_view(table_composition()) coalesce ""
    assert html_table.continet(«<div data-tela="canary-ref-table">»)
    assert html_table.continet(«<table data-tela="ref-table-services"><caption>Services</caption>»)
    assert html_table.continet(«<thead><tr><th scope="col" data-tela="ref-table-services-header-0">Service</th><th scope="col" data-tela="ref-table-services-header-1">Status</th></tr></thead>»)
    assert html_table.continet(«<tbody><tr><td data-tela="ref-table-services-cell-0-0">gateway</td><td data-tela="ref-table-services-cell-0-1">ok</td></tr>»)
    assert html_table.continet(«<td data-tela="ref-table-services-cell-2-1">caution</td>»)
    print html_table
    print "table family static rendered (headers/rows/cells/caption; tela-s5-u4)"
    print "reference composition asserted (table family; tela-s5-u4)"

    # --- Stage 5 U5 — the segmented-control static render ----------------
    # The reference control composes through NORMAL qualified imports (the
    # re-home — the app-typed plan re-targets the ref-seg-* identities,
    # asserted in the pure-proof section above); the runner output extends —
    # the determinism sha stays SUPERSEDED (recorded in the header). The
    # a11y structure asserts: the group's radiogroup + accessible name,
    # the segments' role=radio + aria-selected + the roving tabindex (one
    # tab stop as a whole), the control-owned declared live region.
    const string html_seg ← tela.html_view(segmented_composition()) coalesce ""
    assert html_seg.continet(«<div data-tela="canary-ref-seg">»)
    assert html_seg.continet(«<div role="radiogroup" aria-label="segmented control" data-tela="ref-seg-control">»)
    assert html_seg.continet(«<button role="radio" aria-selected="true" tabindex="0" data-tela="ref-seg-control-1">One</button>»)
    assert html_seg.continet(«<button role="radio" aria-selected="false" tabindex="-1" data-tela="ref-seg-control-2">Two</button>»)
    assert html_seg.continet(«<div role="status" aria-live="polite" data-tela="ref-seg-live"></div>»)
    # The mount seam is the check-reference U5 browser-proof surface (the
    # driver calls mount_segmented through the app's own imports after
    # installing the host DOM — main{} stays seam-free).
    assert not (tela.theme_css(reference_theme()) ≡ null)
    print html_seg
    print "segmented control family static rendered (ref-seg-* identities; tela-s5-u5)"
    print "reference composition asserted (segmented-control family; tela-s5-u5)"

    # --- Stage 5 U6 — the button static render ----------------------------
    # The button family composes through NORMAL qualified imports (the
    # first catalog behavior component); the runner output extends — the
    # determinism sha stays SUPERSEDED (recorded in the header). The a11y
    # structure asserts: the NATIVE <button> semantics (no ARIA role — no
    # duplication), the label/aria-label accessible name, the native
    # disabled attribute on the delete button (no activation, the state
    # exposed), the data-ref-variant treatments.
    const string html_button ← tela.html_view(button_composition()) coalesce ""
    assert html_button.continet(«<div data-tela="canary-ref-button">»)
    assert html_button.continet(«<button data-ref-variant="primary" data-tela="ref-button-save">Save</button>»)
    assert html_button.continet(«<button data-ref-variant="secondary" data-tela="ref-button-cancel">Cancel</button>»)
    assert html_button.continet(«<button aria-label="Delete permanently" disabled="" data-ref-variant="primary" data-tela="ref-button-delete">Delete</button>»)
    assert not html_button.continet("role=")

    # --- the app-typed button plan (U6 done_when (a)+(c)) — pure proof ----
    # The plan is app-typed (D1 recorded, never kernel-generic) and carried
    # by typed message-producing closures (not erased into strings). The
    # bindings key to the ref-button-* identities + the DECLARED activation
    # event (props.event_name = the catalog's button_event() = "click").
    assert reference.button_event() ≡ "click"
    const list<ButtonBinding> button_vincula ← button_bindings()
    assert button_vincula.longitudo() ≡ 2
    # Only the ENABLED buttons are bound (the disabled delete button
    # carries no subscription — a disabled click no-ops by construction).
    assert button_vincula[0].identity ≡ "ref-button-save"
    assert button_vincula[1].identity ≡ "ref-button-cancel"
    assert button_vincula[0].event_name ≡ reference.button_event()
    # Invoke a binding's closure: click on ref-button-save → Pressed.
    const ButtonMessage press_msg ← button_vincula[0].message(tela.event_name("ref-button-save"))
    match press_msg {
        case Pressed const identity {
            assert identity ≡ "ref-button-save"
        }
    }
    # The update loop: Pressed increments the press count + records the
    # last activated identity.
    const ButtonState bstate_init ← button_state(0, "")
    const ButtonState bstate_post ← update_button(bstate_init, press_msg)
    assert bstate_post.presses ≡ 1
    assert bstate_post.last ≡ "ref-button-save"
    # The declarative effects (the focus-restoration pattern): restore by
    # identity — the kernel carriers + the key accessor (fix:sem001).
    const tela.Effect restore_button ← tela.restore("ref-button-save")
    assert tela.effect_identity(restore_button) ≡ "ref-button-save"
    # The mount seam is the check-reference U6 browser-proof surface (the
    # driver calls mount_button through the app's own imports after
    # installing the host DOM — main{} stays seam-free).
    assert not (tela.theme_css(reference_theme()) ≡ null)
    print html_button
    print "button family static rendered (native semantics + disabled state; tela-s5-u6)"
    print "reference composition asserted (button family; tela-s5-u6)"

    # --- Stage 5 U7 — the field static render ----------------------------
    # The field family composes through NORMAL qualified imports (the
    # Stage 4 formslib field contract re-homed — the forms split half 1);
    # the runner output extends — the determinism sha stays SUPERSEDED
    # (recorded in the header). The a11y structure asserts: the NATIVE
    # <input type="text"> semantics (no ARIA role — no duplication), the
    # aria-label accessible name, the aria-invalid true/false surface,
    # the aria-describedby → the error identity when invalid, the
    # error/live-region association structure (the form-control-* group
    # + the role=alert error node + the declared form-live live region),
    # the native disabled attribute.
    const string html_field ← tela.html_view(field_composition()) coalesce ""
    assert html_field.continet(«<div data-tela="canary-ref-field">»)
    assert html_field.continet(«<div data-tela="form-control-name">»)
    assert html_field.continet(«<input type="text" aria-label="Name" aria-invalid="false" value="Ada" data-tela="form-field-name">»)
    assert html_field.continet(«<div data-tela="form-control-email"><input type="text" aria-label="Email" aria-invalid="true" aria-describedby="form-error-email" data-tela="form-field-email">»)
    assert html_field.continet(«<div role="alert" data-tela="form-error-email">Required</div>»)
    assert html_field.continet(«<input type="text" aria-label="Phone" aria-invalid="false" disabled="" data-tela="form-field-phone">»)
    assert html_field.continet(«<div role="status" aria-live="polite" data-tela="form-live"></div>»)
    assert not html_field.continet("<form")
    # The shared app-typed carriers (the U8 plan's props surface).
    assert name_field_props().value ≡ "Ada"
    assert email_field_props().error ≡ "Required"
    assert phone_field_props().disabled ≡ "disabled"
    # The mount seam is the check-reference U7 browser-proof surface (the
    # driver calls mount_field through the app's own imports after
    # installing the host DOM — main{} stays seam-free).
    assert not (tela.theme_css(reference_theme()) ≡ null)
    print html_field
    print "field family static rendered (form-field-* identities + ARIA surface; tela-s5-u7)"
    print "reference composition asserted (field family; tela-s5-u7)"

    # --- Stage 5 U8 — the catalog-field behavior surface ------------------
    # The forms split half 2 (behavior + a11y): the PURE field behavior
    # contract — the validation semantics (field_error_for_value: empty →
    # invalid, non-empty → cleared; the static mapping field_invalid
    # derives aria-invalid from the error), the event-name constant
    # (field_input_event), the live-region policy (field_announcement: announce
    # once on a validation-state change, SILENT on a no-op — the §1.5
    # rule). The D1 app-typed boundary (recorded): the message type +
    # bindings + update loop (FieldMessage/FieldBinding/FieldPlanState/
    # update_field_plan/field_plan_announcement) stay APP-side. The
    # runner output extends — the determinism sha stays SUPERSEDED
    # (recorded in the header).
    assert reference.field_input_event() ≡ "input"
    assert reference.field_error_for_value("") ≡ "Required"
    assert reference.field_error_for_value("Ada") ≡ ""
    const reference.FieldInputProps f_ante ← reference.field_input_props("name", "Name", "", "", "enabled")
    const reference.FieldInputProps f_inv ← reference.field_input_props("name", "Name", "", "Required", "enabled")
    const reference.FieldInputProps f_val ← reference.field_input_props("name", "Name", "Ada", "", "enabled")
    assert reference.field_announcement(f_ante, f_inv) ≡ "form-field-name invalid: Required"
    assert reference.field_announcement(f_ante, f_val) ≡ "form-field-name valid"
    assert reference.field_announcement(f_val, f_val) ≡ ""
    # The app-typed update loop: the incoming value through the catalog's
    # rule; a foreign identity is a state no-op (the silent rule).
    const FieldPlanState fp0 ← field_plan_state("name", "Name", "", "")
    const FieldMessage fmsg ← field_text("form-field-name", "Ada")
    const FieldPlanState fp1 ← update_field_plan(fp0, fmsg)
    assert fp1.value ≡ «Ada" and fp1.error ≡ "»
    assert field_plan_announcement(fp0, fp1) ≡ "form-field-name valid"
    const FieldMessage fmsg2 ← field_text("form-field-name", "")
    const FieldPlanState fp2 ← update_field_plan(fp1, fmsg2)
    assert fp2.error ≡ "Required"
    assert field_plan_announcement(fp1, fp2) ≡ "form-field-name invalid: Required"
    const FieldMessage fmsg3 ← field_text("form-field-name", "Ada")
    const FieldPlanState fp3 ← update_field_plan(fp2, fmsg3)
    assert fp3.error ≡ ""
    assert field_plan_announcement(fp2, fp3) ≡ "form-field-name valid"
    const FieldMessage fmsg4 ← field_text("form-field-email", "x")
    const FieldPlanState fp4 ← update_field_plan(fp3, fmsg4)
    assert fp4.value ≡ «Ada" and fp4.error ≡ "»
    # The update loop's view-render input: the model → the composition.
    const string html_field_plan ← tela.html_view(field_plan_composition(fp3)) coalesce ""
    assert html_field_plan.continet(«value="Ada"»)
    assert html_field_plan.continet(«aria-invalid="false"»)
    # The mount seam is the check-reference U8 browser-proof surface (the
    # driver calls mount_field_plan through the app's own imports after
    # installing the host DOM — main{} stays seam-free).
    print "field plan surface asserted (validation semantics + live-region policy + update loop; tela-s5-u8)"
    print "reference composition asserted (field plan; tela-s5-u8)"

    # --- The U7 interactive plan surface (the provider-seam claim) --------
    # The composition mounts through the app's own seam call (dom.scope +
    # browser.mount); the pure surface is asserted here, the scripted DOM
    # sequence executes under check-forms-interactive (the documented
    # tela:dom host binding).
    const tela.View compositio ← forms_composition()
    assert tela.html_view(compositio) not is null
    assert tela.html_view(compositio) coalesce "" ≡ «<div data-tela="forma"><div data-tela="form-control-name"><input type="text" aria-label="Name" aria-invalid="false" data-tela="form-field-name"><div role="alert" data-tela="form-error-name"></div></div><input type="checkbox" aria-label="Agree" aria-checked="false" aria-invalid="false" data-tela="form-checkbox-agree"><select aria-label="Tone" aria-invalid="false" data-tela="form-select-tone"><option>Light</option><option>Dark</option></select><div role="status" aria-live="polite" data-tela="form-live"></div></div>»
    assert bool_text(true) ≡ "true"
    assert bool_text(false) ≡ "false"
    const FieldState state_invalid ← field_state("form-field-name", "", "Required")
    const string compositio_invalida ← tela.html_view(forms_composition_from_state(state_invalid, false, "Light")) coalesce ""
    assert compositio_invalida.continet(«aria-invalid="true"»)
    assert compositio_invalida.continet(«aria-describedby="form-error-name"»)
    assert compositio_invalida.continet(">Required</div>")
    print "forms interactive plan surface asserted (real imports + seam mount; tela-s4-u7)"
}
