# main.fab: the Vox page. A vocal tract you can see, play, make speak and make
# sing: the voice engine runs in an AudioWorklet (or on the main thread if the
# worklet cannot load) and this page draws what it reports and sends what you
# do (keys, or a program of phonemes and notes for the engine's sequencer).

import from "tela:web" web
import from "tela:dom" dom
import from "./state" state
import from "./layout" layout
import from "./ui" ui
import from "./speech" speech

# One controller mounts the whole page. Everything the page remembers lives in
# one App value that the handlers share (Faber has no module-level state).
@ WebController { selector = "#vox-app" }
fn vox_controller(dom.Scope scope) → list<dom.Subscription> {
    mut state.App app ← state.make_app(layout.compute(1280.0, 800.0, layout.ACT_PLAY))
    let state.Surfaces surfaces ← ui.surfaces(scope)

    mut list<dom.Subscription> subs ← empty
    subs.extend(ui.wire_header(scope, mut app))
    subs.extend(ui.wire_controls(scope, mut app))
    subs.extend(ui.wire_keys(scope, mut app))
    subs.extend(ui.wire_anatomy(scope, mut app))
    subs.extend(speech.wire(scope, mut app))

    # on_resize also reports once now, which does the first placement.
    subs.append(dom.on_resize((dom.ResizeState s) → void ∴ do {
        app.dpr ← s.device_pixel_ratio ↦ f64
        app.win_w ← s.width ↦ f64
        app.win_h ← s.height ↦ f64
        app.place ← layout.compute(app.win_w, app.win_h, app.activity)
        ui.place_all(scope, app)
    }))
    subs.append(dom.on_frame((dom.FrameState f) → void ∴ do {
        ui.frame(scope, mut app, surfaces)
    }))
    return subs
}
