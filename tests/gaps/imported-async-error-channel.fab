+++
locale = "en"
+++

# GAP: the `⇥` error channel of an imported async fn never reaches the
# caller's `catch`.
#
# tela:audio declares `load_worklet(...) async → void ⇥ string` (as tela:dom
# declares `fetch_text`). `faber check` accepts the do/catch below. In the TS
# output the call is awaited, but the `do` body carries no try/catch, so a
# rejected promise from the bound runtime function propagates out of the
# entry (printed by the entry's last-resort handler and rethrown) and the
# Faber `catch err` arm is dead code:
#
#   $ faber emit --library-home <dir holding tela/> -t ts --locale en imported-async-error-channel.fab
#   const t0 = await (async () => { {
#       await audio.load_worklet(l_ctx, "worklet.js");     <- no `try` around it
#       ...
#   }return { ok: true as const, value: undefined }; })() as result.Result<any, string>;
#   if (!t0.ok) { ... catch arm ... }                      <- never taken
#
# A local async failable fn gets the try/catch; so does a sync imported
# failable fn (its Result is unwrapped). Only the imported async case is
# unhandled, and it also calls the import without unwrapping a Result, so a
# bound runtime fn must resolve with the raw value and reject with an Error
# (tela:dom's fetch_text does the same). Effect for the Vox app: a failed
# worklet load cannot be caught from Faber to fall back to the block route.
# Owner: radix (TS emit of cross-module async failable calls).

import from "tela:audio" public * as audio

async_main {
    let audio.AudioContext ctx ← audio.create_context()
    do {
        await audio.load_worklet(ctx, "worklet.js")
        print "loaded"
    } catch err {
        print "failed: §"(err)
    }
}
