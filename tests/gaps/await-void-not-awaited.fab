+++
locale = "en"
+++

# GAP: `await_const void _ ← f()` is accepted but the TS backend drops the
# await.
#
# `faber check` accepts every await below. `faber emit -t ts` awaits the
# non-void binding and the `await` statement, but emits the void binding as a
# bare call (when it is the only await in the entry, the entry is not even
# emitted as an async function):
#
#   $ faber emit -t ts --locale en await-void-not-awaited.fab
#   load_void("v");                                      <- await_const void _ ← load_void("v")
#   const l_ok: boolean = await load_flag("f");          <- awaited
#   await load_void("w");                                <- `await load_void("w")` is awaited
#
# A void async call must be awaited with the statement form `await f()`;
# `await_const void _ ←` silently runs it unawaited. tela:audio's
# `load_worklet` returns void, so callers must write
# `await audio.load_worklet(ctx, url)`. Owner: radix (TS emit of await-const).

fn load_void(string url) async → void {
    print url
}

fn load_flag(string url) async → bool {
    print url
    return true
}

async_main {
    await_const void _ ← load_void("v")
    await_const bool ok ← load_flag("f")
    print ok
    await load_void("w")
}
