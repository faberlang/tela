+++
term = "validation"
kind = "keyword"
category = "library"
locale = "en"
+++

# tela/exempla/validation.fab — Stage 1 U2 exempla for the fail-closed
# validation module (src/validate.fab). Covers every case from U2 done_when (e):
#   valid custom element; valid data-*/aria-* attributes; rejected empty tag,
#   space-containing tag, markup char in tag, leading-digit tag, quote in
#   attribute name; void-element-with-children rejection; unknown-but-valid
#   names accepted (campaign dependency rule 9). The fail-closed contract
#   itself is documented in the validate.fab module header: invalid lexical
#   shape, namespace misuse, or impossible void-element structure NEVER emits
#   markup — the serializer boundary (U3) rejects before emission.

import from "tela:validate" validate

main {
    # --- (a) Tag names: valid_tag_name --------------------------------

    # Accepted: custom elements, standard names, SVG camelCase, unknown-but-valid.
    assert validate.valid_tag_name("x-metric")
    assert validate.valid_tag_name("article")
    assert validate.valid_tag_name("feGaussianBlur")
    assert validate.valid_tag_name("futuristic-2026")

    # Rejected: empty, whitespace, markup/attr delimiters, leading digit, controls.
    assert not validate.valid_tag_name("")
    assert not validate.valid_tag_name("my tag")
    assert not validate.valid_tag_name("di<v")
    assert not validate.valid_tag_name("di>v")
    assert not validate.valid_tag_name("1div")
    assert not validate.valid_tag_name("di'v")
    assert not validate.valid_tag_name("di/v")
    assert not validate.valid_tag_name("di=v")
    assert not validate.valid_tag_name("di\nv")

    # --- (b) Attribute names: valid_attribute_name --------------------

    # Accepted: data-*, aria-*, xlink:*, standard names.
    assert validate.valid_attribute_name("data-index")
    assert validate.valid_attribute_name("aria-label")
    assert validate.valid_attribute_name("xlink:href")
    assert validate.valid_attribute_name("class")

    # Rejected: whitespace, =, quotes, < > /, control chars.
    assert not validate.valid_attribute_name("bad name")
    assert not validate.valid_attribute_name("a=b")
    assert not validate.valid_attribute_name("a\"b")
    assert not validate.valid_attribute_name("a'b")
    assert not validate.valid_attribute_name("a/b")
    assert not validate.valid_attribute_name("<a")
    assert not validate.valid_attribute_name("a\tb")

    # --- (c) HTML void-element set: valid_void_html --------------------

    assert validate.valid_void_html("img")
    assert validate.valid_void_html("br")
    assert validate.valid_void_html("wbr")
    assert validate.valid_void_html("input")
    assert not validate.valid_void_html("div")
    assert not validate.valid_void_html("image")

    # --- (d) Void structure: valid_void_structure ----------------------

    assert validate.valid_void_structure("img", false)
    assert validate.valid_void_structure("div", true)
    assert not validate.valid_void_structure("img", true)

    # --- (c) Namespace context: valid_name_in_space ------------------

    assert validate.valid_name_in_space("div", "html")
    assert validate.valid_name_in_space("circle", "svg")
    assert validate.valid_name_in_space("x-metric", "html")
    assert validate.valid_name_in_space("x-metric", "svg")
    assert validate.valid_name_in_space("futuristic-2026", "svg")
    assert not validate.valid_name_in_space("circle", "html")
    assert not validate.valid_name_in_space("div", "svg")
    assert not validate.valid_name_in_space("img", "svg")
    assert not validate.valid_name_in_space("my tag", "html")
    assert not validate.valid_name_in_space("div", "web")

    # --- (c) Namespace string surface: valid_space -------------------

    assert validate.valid_space("html")
    assert validate.valid_space("svg")
    assert not validate.valid_space("xml")

    print "validation exempla ready"
}
