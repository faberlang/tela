+++
term = "reference"
kind = "concept"
category = "library"
locale = "en"
+++

# tela/exempla/reference.fab — Stage 5 U2/U3/U4/U5/U6/U7 exempla for the
# reference catalog (tela:reference): the layout (stacked rows / two-column
# grid / prose measures) + typography (headings / prose / emphasis / scale)
# families (U2), the panel (theme-surface container) + badge (textual
# status — no color-only communication) + metric (label + value + delta,
# dl/dt/dd) families (U3), and the table (headers + rows + cells + optional
# caption — the benchmark table grammar) family (U4) + the segmented-control
# (the Stage 3 control re-homed — radiogroup/radio + aria-selected + the
# roving tabindex + the declared live region) family (U5) + the button
# (native <button> semantics — the accessible name (label/aria-label), the
# native keyboard contract (Space/Enter), the visible focus (:focus-visible
# rule), the native disabled state) family (U6) + the field (the Stage 4
# formslib field contract re-homed — the native <input type="text">
# semantics (no ARIA role), the label/aria-label accessible name, the
# aria-invalid true/false surface, the aria-describedby → the error
# identity when invalid, the error/live-region association structure, the
# native disabled attribute) family (U7 — the forms split half 1, static).
# Asserts the EXACT static
# bytes (the serializer emission order: tag, then attributes in
# author order, then the data-tela identity) + the a11y structure (the
# heading hierarchy via native h1..h6, prose semantics via p, semantic
# emphasis via strong/em/code — never color-only communication, the scale
# as decorative sizing, the panel's region landmark + accessible name, the
# badge's role=status + aria-label, the metric's definition-list
# label/value structure, the table's native table/caption/thead/th[scope]/
# tbody/tr/td semantics — the §8 table accessibility contract, the
# segmented control's radiogroup/radio + aria-selected + roving tabindex +
# live-region structure, the button's native <button> semantics — no
# ARIA role, the label/aria-label accessible name, the native disabled
# attribute, and the field's native <input> semantics — the
# aria-invalid/aria-describedby surface + the error/live-region
# association), fail-closed,
# executed under node (check-exempla runtime gate).
#
# fix:<id> markers: none applied beyond reference.fab's (fix:g5 — NONE,
# fix:codegen001, fix:snapshot-name-collision, fix:verum-b; the G6 notes —
# the button variant prop spelled variant (probe: the contextual keyword
# accepts the NAME positions — field/param — the U6 PARSE001 finding did
# NOT reproduce for the prop name, a false alarm; the value-position limit
# + the variant_value helper-param workaround are recorded in reference.fab
# as fix:g6-value-position); the U7 field prop names probed against the en
# pack — no collisions; the LOCALE002 advisory on the BadgeProps status
# field — recorded).

import from "tela:tela" tela
import from "tela:reference" ref

main {
    # --- layout: the stack — stacked rows --------------------------------
    # No attributes, no ARIA (pure layout grouping): the identity emits
    # after the tag; text children concatenate without a wrapper.
    const string stack_html ← tela.html_view(ref.layout_stack(ref.stack_props([
        tela.text_view("row one"),
        tela.text_view("row two")
    ]))) coalesce ""
    assert stack_html ≡ «<div data-tela="ref-layout-stack">row onerow two</div>»

    # --- layout: the two-column grid --------------------------------------
    const string grid ← tela.html_view(ref.layout_grid(ref.grid_props([
        tela.text_view("column one"),
        tela.text_view("column two")
    ]))) coalesce ""
    assert grid ≡ «<div data-tela="ref-layout-grid">column onecolumn two</div>»

    # --- layout: the prose measure container (wraps the typography prose)
    const string prose_layout ← tela.html_view(ref.layout_prose(ref.layout_prose_props([
        ref.typography_prose(ref.prose_props([ tela.text_view("prose text") ]))
    ]))) coalesce ""
    assert prose_layout ≡ «<div data-tela="ref-layout-prose"><p data-tela="ref-typography-prose">prose text</p></div>»

    # --- typography: the heading hierarchy (native h1..h6) ----------------
    # The heading RANK is carried in the native tag (screen readers expose
    # the hierarchy) — never in styling alone (no color-only communication).
    assert tela.html_view(ref.typography_heading(ref.heading_props(1, "Title"))) coalesce "" ≡ «<h1 data-tela="ref-typography-heading-1">Title</h1>»
    assert tela.html_view(ref.typography_heading(ref.heading_props(3, "Section"))) coalesce "" ≡ «<h3 data-tela="ref-typography-heading-3">Section</h3>»
    assert tela.html_view(ref.typography_heading(ref.heading_props(6, "Footnote"))) coalesce "" ≡ «<h6 data-tela="ref-typography-heading-6">Footnote</h6>»
    # The range contract 1..6 is clamped fail-safe at the edges — h0/h7
    # never emit (asserted, not silent).
    assert tela.html_view(ref.typography_heading(ref.heading_props(0, "zero"))) coalesce "" ≡ «<h1 data-tela="ref-typography-heading-1">zero</h1>»
    assert tela.html_view(ref.typography_heading(ref.heading_props(9, "nine"))) coalesce "" ≡ «<h6 data-tela="ref-typography-heading-6">nine</h6>»

    # --- typography: the prose paragraph (prose semantics) ----------------
    # Mixed content: text + semantic emphasis compose inline within the p.
    assert tela.html_view(ref.typography_prose(ref.prose_props([ tela.text_view("A paragraph.") ]))) coalesce "" ≡ «<p data-tela="ref-typography-prose">A paragraph.</p>»
    assert tela.html_view(ref.typography_prose(ref.prose_props([
        tela.text_view("Read the "),
        ref.typography_emphasis(ref.emphasis_props("strong", "docs"))
    ]))) coalesce "" ≡ «<p data-tela="ref-typography-prose">Read the <strong data-tela="ref-typography-emphasis-strong">docs</strong></p>»

    # --- typography: semantic emphasis — strong / em / code ---------------
    # The meaning rides the SEMANTIC TAG (strong/em/code), never color or
    # size alone (campaign §8 no-color-only-communication).
    assert tela.html_view(ref.typography_emphasis(ref.emphasis_props("strong", "bold"))) coalesce "" ≡ «<strong data-tela="ref-typography-emphasis-strong">bold</strong>»
    assert tela.html_view(ref.typography_emphasis(ref.emphasis_props("em", "italic"))) coalesce "" ≡ «<em data-tela="ref-typography-emphasis-em">italic</em>»
    assert tela.html_view(ref.typography_emphasis(ref.emphasis_props("code", "x"))) coalesce "" ≡ «<code data-tela="ref-typography-emphasis-code">x</code>»

    # --- typography: the type scale (decorative sizing, never state) ------
    # The scale is a span at a documented step; the size comes from the
    # ref.type.scale.* tokens via the typography bundle — the scale never
    # carries semantic state and never communicates by color.
    assert tela.html_view(ref.typography_scale(ref.scale_props("lg", "lead"))) coalesce "" ≡ «<span data-tela="ref-typography-scale-lg">lead</span>»
    assert tela.html_view(ref.typography_scale(ref.scale_props("xs", "caption"))) coalesce "" ≡ «<span data-tela="ref-typography-scale-xs">caption</span>»

    # --- the layout style bundle (keyed on the identities, --ref-* tokens)
    const string css_layout ← tela.css(ref.layout_style())
    assert css_layout ≡ "[data-tela='ref-layout-stack'] { display: flex; flex-direction: column; gap: var(--ref-layout-gap); }\n[data-tela='ref-layout-grid'] { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--ref-layout-gap); }\n[data-tela='ref-layout-prose'] { max-width: var(--ref-layout-prose-measure); margin: 0 auto; }\n"

    # --- the typography style bundle (the heading scale + prose) ----------
    const string css_typography ← tela.css(ref.typography_style())
    assert css_typography.contains("[data-tela='ref-typography-heading-1'] { font-size: var(--ref-type-scale-xl); font-weight: var(--ref-type-heading-weight); margin: var(--ref-type-heading-margin); }")
    assert css_typography.contains("[data-tela='ref-typography-heading-6'] { font-size: var(--ref-type-scale-xs); font-weight: var(--ref-type-heading-weight); margin: var(--ref-type-heading-margin); }")
    assert css_typography.contains("[data-tela='ref-typography-prose'] { font-size: var(--ref-type-scale-md); line-height: var(--ref-type-prose-line-height); margin: var(--ref-type-prose-margin); }")
    assert css_typography.contains("[data-tela='ref-typography-scale-xl'] { font-size: var(--ref-type-scale-xl); }")
    # Author order is the emission order (the heading scale descends from
    # heading-1 to heading-6; the exact first rule above pins the order).
    assert css_typography.contains("[data-tela='ref-typography-heading-1']")
    assert css_typography.contains("[data-tela='ref-typography-heading-6']")

    # --- the namespaced ref.* tokens (the kernel Token carrier, MF-7) -----
    assert ref.ref_layout_gap().name ≡ "ref.layout.gap"
    assert ref.ref_layout_gap().value ≡ "1rem"
    assert ref.ref_type_scale_xl().name ≡ "ref.type.scale.xl"
    assert ref.ref_type_scale_xl().value ≡ "1.5rem"
    assert ref.ref_type_prose_line_height().name ≡ "ref.type.prose.line-height"
    # Every token name passes the kernel lexical predicate (fail-closed
    # token-name shape — theme_css/assemble reject invalid names).
    assert tela.token_name_valid(ref.ref_layout_gap().name)
    assert tela.token_name_valid(ref.ref_type_prose_line_height().name)
    const list<tela.Token> collectio ← ref.reference_tokens()
    assert collectio.length() ≡ 46

    # --- determinism: identical input → identical bytes -------------------
    const string stack_b ← tela.html_view(ref.layout_stack(ref.stack_props([
        tela.text_view("row one"),
        tela.text_view("row two")
    ]))) coalesce ""
    assert stack_b ≡ stack_html
    assert tela.css(ref.layout_style()) ≡ css_layout

    # =====================================================================
    # Stage 5 U3 — the panel + badge + metric families.
    # =====================================================================

    # --- panel: theme-surface semantics + the region landmark -------------
    # The a11y structure: role="region" (a named landmark) + aria-label =
    # the title when present. The SURFACE comes from the ref.panel.* tokens
    # (referencing the theme core surface.panel / border.default) — the
    # component carries no hardcoded color (asserted by the token values).
    assert tela.html_view(ref.panel(ref.panel_props("status", "Status panel", [
        tela.text_view("all systems operational")
    ]))) coalesce "" ≡ «<div role="region" aria-label="Status panel" data-tela="ref-panel-status">all systems operational</div>»
    # No title → no aria-label (the region landmark stays; the accessible
    # name is then the content).
    assert tela.html_view(ref.panel(ref.panel_props("plain", "", [
        tela.text_view("content")
    ]))) coalesce "" ≡ «<div role="region" data-tela="ref-panel-plain">content</div>»

    # --- badge: textual status — meaning never color alone ----------------
    # role="status" + aria-label = "<status>: <text>" — the status word
    # rides the accessible name AND the visible label is present; the
    # meaning is TEXTUAL (no color-only communication, campaign §8).
    assert tela.html_view(ref.badge(ref.badge_props("new", "New", "3 messages"))) coalesce "" ≡ «<span role="status" aria-label="New: 3 messages" data-tela="ref-badge-new">3 messages</span>»
    assert tela.html_view(ref.badge(ref.badge_props("ok", "Ok", "all checks passed"))) coalesce "" ≡ «<span role="status" aria-label="Ok: all checks passed" data-tela="ref-badge-ok">all checks passed</span>»

    # --- metric: label + value (+ optional delta) — the textual form ------
    # The benchmark grammar's definition-list pattern (dl/dt/dd): dt = the
    # label, dd = the value, optional second dd = the delta. The textual
    # form is preserved — label + value (+ delta) are visible text.
    assert tela.html_view(ref.metric(ref.metric_props("uptime", "uptime", "99.9%", ""))) coalesce "" ≡ «<dl data-tela="ref-metric-uptime"><dt>uptime</dt><dd>99.9%</dd></dl>»
    assert tela.html_view(ref.metric(ref.metric_props("requests", "requests", "12 480", "+3.1%"))) coalesce "" ≡ «<dl data-tela="ref-metric-requests"><dt>requests</dt><dd>12 480</dd><dd>+3.1%</dd></dl>»

    # --- the panel/badge/metric style bundles (prefix-keyed, --ref-* tokens)
    const string css_panel ← tela.css(ref.panel_style())
    assert css_panel ≡ "[data-tela^='ref-panel-'] { background: var(--ref-panel-surface); border: 1px solid var(--ref-panel-border); border-radius: var(--ref-panel-radius); padding: var(--ref-panel-padding); }\n"
    const string css_badge ← tela.css(ref.badge_style())
    assert css_badge ≡ "[data-tela^='ref-badge-'] { display: inline-block; font-size: var(--ref-badge-size); padding: var(--ref-badge-padding); border-radius: var(--ref-badge-radius); }\n"
    const string css_metric ← tela.css(ref.metric_style())
    assert css_metric.contains("[data-tela^='ref-metric-'] { margin: 0; padding: 0; }")
    assert css_metric.contains("[data-tela^='ref-metric-'] dt { font-size: var(--ref-metric-label-size); color: var(--ref-metric-label-muted); }")
    assert css_metric.contains("[data-tela^='ref-metric-'] dd { font-size: var(--ref-metric-value-size); font-weight: var(--ref-metric-value-weight); margin: 0; }")

    # --- the ref.panel.* / ref.badge.* / ref.metric.* tokens --------------
    # The theme-surface semantics (no hardcoded color): the panel surface +
    # border + the metric label color reference the theme's core tokens.
    assert ref.ref_panel_surface().name ≡ "ref.panel.surface"
    assert ref.ref_panel_surface().value ≡ "var(--surface-panel)"
    assert ref.ref_panel_border().value ≡ "var(--border-default)"
    assert ref.ref_panel_radius().value ≡ "0.5rem"
    assert ref.ref_badge_size().name ≡ "ref.badge.size"
    assert ref.ref_badge_size().value ≡ "0.75rem"
    assert ref.ref_metric_label_muted().name ≡ "ref.metric.label.muted"
    assert ref.ref_metric_label_muted().value ≡ "var(--text-muted)"
    assert ref.ref_metric_value_size().value ≡ "1.5rem"
    assert ref.ref_metric_value_weight().value ≡ "600"
    # Every token name passes the kernel lexical predicate (fail-closed).
    assert tela.token_name_valid(ref.ref_panel_surface().name)
    assert tela.token_name_valid(ref.ref_badge_radius().name)
    assert tela.token_name_valid(ref.ref_metric_value_weight().name)
    const list<tela.Token> collectio_u3 ← ref.reference_tokens()
    assert collectio_u3.length() ≡ 46

    # =====================================================================
    # Stage 5 U4 — the table family (the benchmark table grammar).
    # =====================================================================

    # --- table: the semantic composite with a caption ---------------------
    # <table> → <caption> (the accessible name) → <thead> (a single <tr> of
    # <th scope="col"> header cells) → <tbody> (one <tr> per data row, a
    # <td> per cell). The NATIVE semantics ARE the a11y structure (screen
    # readers expose the grid natively — no ARIA duplication); the header
    # association rides th[scope]; the caption provides the accessible
    # name. The identity scheme: ref-table-<name> root +
    # ref-table-<name>-header-<i> + ref-table-<name>-cell-<r>-<c> (stable
    # focus targets for the declared consumer-plan navigation interaction).
    assert tela.html_view(ref.table(ref.table_props("scores", "Scores", ["Player", "Score"], [
        ref.table_row(["Ada", "42"]),
        ref.table_row(["Lin", "37"])
    ]))) coalesce "" ≡ «<table data-tela="ref-table-scores"><caption>Scores</caption><thead><tr><th scope="col" data-tela="ref-table-scores-header-0">Player</th><th scope="col" data-tela="ref-table-scores-header-1">Score</th></tr></thead><tbody><tr><td data-tela="ref-table-scores-cell-0-0">Ada</td><td data-tela="ref-table-scores-cell-0-1">42</td></tr><tr><td data-tela="ref-table-scores-cell-1-0">Lin</td><td data-tela="ref-table-scores-cell-1-1">37</td></tr></tbody></table>»

    # --- table: no caption → no <caption> element -------------------------
    # The accessible-name contract: the component NEVER fabricates a name —
    # the app supplies the recorded equivalent (an aria-label/off-screen
    # equivalent is an app choice, documented in the module header).
    assert tela.html_view(ref.table(ref.table_props("plain", "", ["A", "B"], [
        ref.table_row(["1", "2"])
    ]))) coalesce "" ≡ «<table data-tela="ref-table-plain"><thead><tr><th scope="col" data-tela="ref-table-plain-header-0">A</th><th scope="col" data-tela="ref-table-plain-header-1">B</th></tr></thead><tbody><tr><td data-tela="ref-table-plain-cell-0-0">1</td><td data-tela="ref-table-plain-cell-0-1">2</td></tr></tbody></table>»

    # --- the table style bundle (prefix-keyed, --ref-* tokens) ------------
    const string css_table ← tela.css(ref.table_style())
    assert css_table ≡ "[data-tela^='ref-table-'] { border-collapse: collapse; width: 100%; }\n[data-tela^='ref-table-'] th { border: 1px solid var(--ref-table-border); padding: var(--ref-table-padding); text-align: left; font-weight: var(--ref-table-header-weight); }\n[data-tela^='ref-table-'] td { border: 1px solid var(--ref-table-border); padding: var(--ref-table-padding); text-align: left; }\n[data-tela^='ref-table-'] caption { color: var(--ref-table-caption-muted); text-align: left; }\n"

    # --- the ref.table.* tokens (theme-surface — border + caption color
    # reference the theme's core tokens, no hardcoded color) ---------------
    assert ref.ref_table_border().name ≡ "ref.table.border"
    assert ref.ref_table_border().value ≡ "var(--border-default)"
    assert ref.ref_table_padding().name ≡ "ref.table.padding"
    assert ref.ref_table_padding().value ≡ "0.5rem 0.75rem"
    assert ref.ref_table_header_weight().value ≡ "600"
    assert ref.ref_table_caption_muted().name ≡ "ref.table.caption.muted"
    assert ref.ref_table_caption_muted().value ≡ "var(--text-muted)"
    # Every token name passes the kernel lexical predicate (fail-closed).
    assert tela.token_name_valid(ref.ref_table_border().name)
    assert tela.token_name_valid(ref.ref_table_caption_muted().name)
    const list<tela.Token> collectio_u4 ← ref.reference_tokens()
    assert collectio_u4.length() ≡ 46

    # =====================================================================
    # Stage 5 U5 — the segmented-control family (the Stage 3 control
    # re-homed).
    # =====================================================================

    # --- segmented control: the a11y structure byte-exact -----------------
    # The group: role="radiogroup" + aria-label (the accessible name) +
    # data-tela="ref-seg-<name>". The segments: role="radio" +
    # aria-selected true/false + the roving tabindex (ONE tab stop as a
    # whole — the selected segment is tabindex="0", the others '-1') +
    # data-tela="ref-seg-<name>-<i>". The control-owned declared live
    # region (role="status" + aria-live="polite", data-tela="ref-seg-live",
    # §1.5 — the no-op rule lives in the consumer plan).
    assert tela.html_view(ref.segmented_control(ref.segmented_props("control", "segmented control", ["One", "Two", "Three"], "ref-seg-control-1"))) coalesce "" ≡ «<div role="radiogroup" aria-label="segmented control" data-tela="ref-seg-control"><button role="radio" aria-selected="true" tabindex="0" data-tela="ref-seg-control-1">One</button><button role="radio" aria-selected="false" tabindex="-1" data-tela="ref-seg-control-2">Two</button><button role="radio" aria-selected="false" tabindex="-1" data-tela="ref-seg-control-3">Three</button><div role="status" aria-live="polite" data-tela="ref-seg-live"></div></div>»
    # The selected state + the roving tabindex follow the selection: the
    # second segment selected → its aria-selected flips true + it becomes
    # the tab stop; the first segment flips false + leaves the tab
    # sequence. The live region identity is stable.
    assert tela.html_view(ref.segmented_control(ref.segmented_props("control", "segmented control", ["One", "Two", "Three"], "ref-seg-control-2"))) coalesce "" ≡ «<div role="radiogroup" aria-label="segmented control" data-tela="ref-seg-control"><button role="radio" aria-selected="false" tabindex="-1" data-tela="ref-seg-control-1">One</button><button role="radio" aria-selected="true" tabindex="0" data-tela="ref-seg-control-2">Two</button><button role="radio" aria-selected="false" tabindex="-1" data-tela="ref-seg-control-3">Three</button><div role="status" aria-live="polite" data-tela="ref-seg-live"></div></div>»
    # The identity scheme is per-control-name (ref-seg-<name>): a second
    # control with a different name keys distinct identities.
    assert tela.html_view(ref.segmented_control(ref.segmented_props("sort", "sort", ["A", "B"], "ref-seg-sort-1"))) coalesce "" ≡ «<div role="radiogroup" aria-label="sort" data-tela="ref-seg-sort"><button role="radio" aria-selected="true" tabindex="0" data-tela="ref-seg-sort-1">A</button><button role="radio" aria-selected="false" tabindex="-1" data-tela="ref-seg-sort-2">B</button><div role="status" aria-live="polite" data-tela="ref-seg-live"></div></div>»

    # --- the segmented-control style bundle (role-scoped, --ref-* tokens)
    const string css_seg ← tela.css(ref.segmented_style())
    assert css_seg ≡ «[data-tela^='ref-seg-'][role='radiogroup'] { display: flex; gap: var(--ref-seg-gap); border-radius: var(--ref-seg-radius); }\n[data-tela^='ref-seg-'][role='radio'] { font-size: var(--ref-seg-size); padding: var(--ref-seg-padding); border: 1px solid var(--ref-seg-border); }\n[data-tela^='ref-seg-'][role='radio'][aria-selected="true"] { border-color: var(--ref-seg-selected-border); }\n»

    # --- the ref.seg.* tokens (the border color references the theme's
    # core tokens — the selected state is SEMANTIC (aria-selected), the
    # accent border is decorative emphasis; no hardcoded color) -----------
    assert ref.ref_seg_gap().name ≡ "ref.seg.gap"
    assert ref.ref_seg_gap().value ≡ "0.25rem"
    assert ref.ref_seg_radius().name ≡ "ref.seg.radius"
    assert ref.ref_seg_radius().value ≡ "0.375rem"
    assert ref.ref_seg_size().value ≡ "0.875rem"
    assert ref.ref_seg_padding().value ≡ "0.5rem 0.75rem"
    assert ref.ref_seg_border().name ≡ "ref.seg.border"
    assert ref.ref_seg_border().value ≡ "var(--border-default)"
    assert ref.ref_seg_selected_border().name ≡ "ref.seg.selected.border"
    assert ref.ref_seg_selected_border().value ≡ "var(--accent-primary)"
    # Every token name passes the kernel lexical predicate (fail-closed).
    assert tela.token_name_valid(ref.ref_seg_gap().name)
    assert tela.token_name_valid(ref.ref_seg_selected_border().name)
    const list<tela.Token> collectio_u5 ← ref.reference_tokens()
    assert collectio_u5.length() ≡ 46

    # =====================================================================
    # Stage 5 U6 — the button family (the first behavior component).
    # =====================================================================

    # --- button: native semantics — the accessible name + the keyboard
    # contract + the disabled state ----------------------------------------
    # The element is a NATIVE <button> (no ARIA role — a role would
    # duplicate the native semantics; the keyboard contract — Space/Enter
    # activate — rides the native semantics). The accessible name is the
    # label text (native) or the declared aria-label override. The
    # disabled state is the native `disabled` attribute (no activation,
    # the state exposed). The variant (the visual treatment, token-keyed
    # — never semantic) rides the data-ref-variant attribute.
    # Attribute author order: aria-label (when present) → disabled (when
    # disabled) → data-ref-variant → data-tela.
    assert tela.html_view(ref.button(ref.button_props("save", "Save", "primary", "enabled", "click", ""))) coalesce "" ≡ «<button data-ref-variant="primary" data-tela="ref-button-save">Save</button>»
    # The aria-label override (the declared accessible name — the visible
    # label can differ) + the disabled attribute (the native disabled
    # state: removed from the tab sequence, no activation, the state
    # exposed to AT).
    assert tela.html_view(ref.button(ref.button_props("delete", "Delete", "primary", "disabled", "click", "Delete permanently"))) coalesce "" ≡ «<button aria-label="Delete permanently" disabled="" data-ref-variant="primary" data-tela="ref-button-delete">Delete</button>»
    # The variant treatments: secondary + ghost emit their
    # data-ref-variant (the visual treatment rides the attribute, never
    # the semantic).
    assert tela.html_view(ref.button(ref.button_props("cancel", "Cancel", "secondary", "enabled", "click", ""))) coalesce "" ≡ «<button data-ref-variant="secondary" data-tela="ref-button-cancel">Cancel</button>»
    assert tela.html_view(ref.button(ref.button_props("link", "Ghost", "ghost", "enabled", "click", ""))) coalesce "" ≡ «<button data-ref-variant="ghost" data-tela="ref-button-link">Ghost</button>»
    # No ARIA role duplication: the native <button> carries no role
    # attribute (the native semantics ARE the role).
    assert not (tela.html_view(ref.button(ref.button_props("save", "Save", "primary", "enabled", "click", ""))) coalesce "").contains("role=")
    # The declared event surface (the activation event the plan binds).
    assert ref.button_event() ≡ "click"

    # --- the button style bundle (prefix + variant + state selectors) ----
    # The visible-focus rule (:focus-visible — the campaign §8 visible
    # focus; the indicator from the ref.button.focus token, never
    # removed) + the disabled rule (:disabled — the visual dim; the
    # SEMANTIC state rides the native attribute).
    const string css_button ← tela.css(ref.button_style())
    assert css_button ≡ "[data-tela^='ref-button-'] { display: inline-block; font-size: var(--ref-button-size); padding: var(--ref-button-padding); border: 1px solid var(--ref-button-border); border-radius: var(--ref-button-radius); color: var(--ref-button-text); }\n[data-tela^='ref-button-'][data-ref-variant='primary'] { background: var(--ref-button-primary-background); color: var(--ref-button-primary-text); }\n[data-tela^='ref-button-'][data-ref-variant='secondary'] { background: var(--ref-button-secondary-background); }\n[data-tela^='ref-button-'][data-ref-variant='ghost'] { background: var(--ref-button-ghost-background); }\n[data-tela^='ref-button-']:focus-visible { outline: 2px solid var(--ref-button-focus); outline-offset: 2px; }\n[data-tela^='ref-button-']:disabled { opacity: var(--ref-button-disabled-opacity); cursor: not-allowed; }\n"

    # --- the ref.button.* tokens (theme-surface — the color-bearing
    # tokens reference the theme's core tokens, no hardcoded color) ------
    assert ref.ref_button_size().name ≡ "ref.button.size"
    assert ref.ref_button_size().value ≡ "0.875rem"
    assert ref.ref_button_padding().name ≡ "ref.button.padding"
    assert ref.ref_button_padding().value ≡ "0.5rem 1rem"
    assert ref.ref_button_radius().value ≡ "0.25rem"
    assert ref.ref_button_border().name ≡ "ref.button.border"
    assert ref.ref_button_border().value ≡ "var(--border-default)"
    assert ref.ref_button_text().value ≡ "var(--text-primary)"
    assert ref.ref_button_primary_background().name ≡ "ref.button.primary.background"
    assert ref.ref_button_primary_background().value ≡ "var(--accent-primary)"
    assert ref.ref_button_primary_text().value ≡ "var(--surface-canvas)"
    assert ref.ref_button_secondary_background().value ≡ "var(--surface-panel)"
    assert ref.ref_button_ghost_background().name ≡ "ref.button.ghost.background"
    assert ref.ref_button_ghost_background().value ≡ "transparent"
    assert ref.ref_button_focus().name ≡ "ref.button.focus"
    assert ref.ref_button_focus().value ≡ "var(--accent-primary)"
    assert ref.ref_button_disabled_opacity().name ≡ "ref.button.disabled.opacity"
    assert ref.ref_button_disabled_opacity().value ≡ "0.6"
    # Every token name passes the kernel lexical predicate (fail-closed).
    assert tela.token_name_valid(ref.ref_button_focus().name)
    assert tela.token_name_valid(ref.ref_button_primary_background().name)
    assert tela.token_name_valid(ref.ref_button_disabled_opacity().name)
    const list<tela.Token> collectio_u6 ← ref.reference_tokens()
    assert collectio_u6.length() ≡ 46

    # =====================================================================
    # Stage 5 U7 — the field family (the Stage 4 formslib field contract
    # re-homed — the forms split half 1, STATIC).
    # =====================================================================

    # --- field: native semantics — the accessible name + the
    # aria-invalid/aria-describedby surface -------------------------------
    # The element is a NATIVE <input type="text"> (no ARIA role — a role
    # would duplicate the native semantics; the native input is natively
    # focusable — Tab reaches it). The accessible name is aria-label = the
    # label prop. The aria-invalid surface is DERIVED from the error prop
    # (non-empty error → "true"). The aria-describedby → the error
    # identity (form-error-<name>) rides ONLY when invalid. The value
    # attribute emits when non-empty. Attribute author order: type →
    # aria-label → aria-invalid → aria-describedby (when invalid) →
    # value (when non-empty) → disabled (when disabled) → data-tela.
    assert tela.html_view(ref.field_input(ref.field_input_props("name", "Name", "Ada", "", "enabled"))) coalesce "" ≡ «<input type="text" aria-label="Name" aria-invalid="false" value="Ada" data-tela="form-field-name">»
    # Invalid: aria-invalid="true" + aria-describedby → form-error-name;
    # the value is empty → no value attribute.
    assert tela.html_view(ref.field_input(ref.field_input_props("name", "Name", "", "Required", "enabled"))) coalesce "" ≡ «<input type="text" aria-label="Name" aria-invalid="true" aria-describedby="form-error-name" data-tela="form-field-name">»
    # Disabled: the native disabled attribute (removed from the tab
    # sequence, no entry, the state exposed to AT).
    assert tela.html_view(ref.field_input(ref.field_input_props("name", "Name", "Ada", "", "disabled"))) coalesce "" ≡ «<input type="text" aria-label="Name" aria-invalid="false" value="Ada" disabled="" data-tela="form-field-name">»
    # No ARIA role duplication: the native input carries no role attribute.
    assert not (tela.html_view(ref.field_input(ref.field_input_props("name", "Name", "Ada", "", "enabled"))) coalesce "").contains("role=")

    # --- the error/live-region association structure ----------------------
    # The error node (role="alert", form-error-<name>) is the identity the
    # field's aria-describedby references; the error text rides the node
    # when present (empty error → an empty node — the association is
    # stable). The declared live region (role="status" + aria-live="polite",
    # form-live) is field-own; the announcement policy is U8.
    assert tela.html_view(ref.field_error_region("name", "Required")) coalesce "" ≡ «<div role="alert" data-tela="form-error-name">Required</div>»
    assert tela.html_view(ref.field_error_region("name", "")) coalesce "" ≡ «<div role="alert" data-tela="form-error-name"></div>»
    assert tela.html_view(ref.field_live_region()) coalesce "" ≡ «<div role="status" aria-live="polite" data-tela="form-live"></div>»
    # The field_control group (form-control-<name>): the association
    # surface — the field + its error node under one identity.
    assert tela.html_view(ref.field_control(ref.field_input_props("name", "Name", "Ada", "Required", "enabled"))) coalesce "" ≡ «<div data-tela="form-control-name"><input type="text" aria-label="Name" aria-invalid="true" aria-describedby="form-error-name" value="Ada" data-tela="form-field-name"><div role="alert" data-tela="form-error-name">Required</div></div>»
    # The derived aria-invalid mapping (the formslib error_present
    # precedent, re-homed).
    assert ref.field_invalid(ref.field_input_props("name", "Name", "", "Required", "enabled")) ≡ "true"
    assert ref.field_invalid(ref.field_input_props("name", "Name", "Ada", "", "enabled")) ≡ "false"

    # --- the field style bundle (form-* identities, --form-* tokens) -----
    # The invalid border-bottom + the focus ring + the error color + the
    # live-region emphasis come from the form.* tokens; the disabled dim
    # is the visual treatment — the SEMANTIC state rides the native
    # attribute (never a color-only signal).
    const string css_field ← tela.css(ref.field_style())
    assert css_field ≡ "[data-tela^='form-field-'] { border-bottom: 2px solid var(--form-field-invalid); color: var(--form-field-valid); }\n[data-tela^='form-field-']:focus { outline: 2px solid var(--form-focus); }\n[data-tela^='form-error-'] { color: var(--form-field-invalid); font-size: 0.875rem; }\n[data-tela='form-live'] { font-weight: 600; color: var(--form-field-valid); }\n[data-tela^='form-field-']:disabled { opacity: 0.6; cursor: not-allowed; }\n"

    # --- the form.* tokens (the Stage 4 namespaced-token surface, re-homed
    # with the identical names + values — the canary themes dedup) --------
    assert ref.field_invalid_token().name ≡ "form.field.invalid"
    assert ref.field_invalid_token().value ≡ "#dc2626"
    assert ref.field_valid_token().name ≡ "form.field.valid"
    assert ref.field_valid_token().value ≡ "#16a34a"
    assert ref.field_focus_token().name ≡ "form.focus"
    assert ref.field_focus_token().value ≡ "#2563eb"
    # Every token name passes the kernel lexical predicate (fail-closed).
    assert tela.token_name_valid(ref.field_invalid_token().name)
    assert tela.token_name_valid(ref.field_valid_token().name)
    assert tela.token_name_valid(ref.field_focus_token().name)
    const list<tela.Token> collectio_u7 ← ref.reference_tokens()
    assert collectio_u7.length() ≡ 46

    print "reference catalog exempla ready (layout + typography + panel + badge + metric + table + segmented-control + button + field; tela-s5-u2/u3/u4/u5/u6/u7)"
}
