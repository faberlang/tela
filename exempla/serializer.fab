+++
term = "serializer"
kind = "keyword"
category = "library"
locale = "en"
+++

# tela/exempla/serializer.fab — Stage 1 U3 exempla for the deterministic
# HTML + CSS serializers and the fail-closed boundary in src/tela.fab.
# Covers every case from U3 done_when (g): text/attribute/identity escaping
# with special characters; void emission (br, img); svg xmlns; fragment
# no-wrapper; data-tela emission; fail-closed rejection (invalid input never
# emits markup — the serializer returns null); CSS emission; plus an
# empirical determinism assert (identical input → identical bytes).
#
# The HTML renderer verb is tela.html_visus (G5 workaround spelling — see
# the tela.fab module header); css is the exact policy (b) verb.

import from "tela:tela" private tela

main {
    # --- (g) text escaping: & < > escaped; quotes pass through (text set) --
    # The bare double-quote is spelled via ascii-literal interpolation
    # ("§"('"')) rather than the \" escape — the TS emitter double-escapes a
    # `\"` payload (see the escape note in tela.fab), and this spelling keeps
    # the exempla runtime-correct in both lanes.
    const string text_esc ← tela.html_visus(tela.text_view("a&b<c>d" + "§"('"') + "e'f")) coalesce ""
    assert text_esc ≡ "a&amp;b&lt;c&gt;d" + "§"('"') + "e'f"

    # --- (g) attribute escaping: & < > " escaped; ' is literal (double-quote delimiters) ----
    const string attr_esc ← tela.html_visus(tela.element_full(
        null,
        tela.html_space(),
        "div",
        [ tela.Attribute { name = "title", value = "a&b<c>d" + "§"('"') + "e'f" } ],
        [],
        []
    )) coalesce ""
    assert attr_esc ≡ «<div title="a&amp;b&lt;c&gt;d&quot;e'f"></div>»

    # --- (g) identity escaping: value flows through the SAME attr escape ----
    const string id_esc ← tela.html_visus(tela.element_full(
        tela.new_identity("a'b" + "§"('"') + "c&"),
        tela.html_space(),
        "div",
        [],
        [],
        []
    )) coalesce ""
    assert id_esc ≡ «<div data-tela="a'b&quot;c&amp;"></div>»

    # --- (b) data-tela emission per policy (d) — the spike baseline form ---
    const string id_plain ← tela.html_visus(tela.element_full(
        tela.new_identity("contator-app"),
        tela.html_space(),
        "div",
        [],
        [],
        [ tela.text_view("contator") ]
    )) coalesce ""
    assert id_plain ≡ «<div data-tela="contator-app">contator</div>»

    # --- (b) HTML void emission: no closing tag (void set from valida) ----
    const string br_out ← tela.html_visus(tela.element_view(tela.html_space(), "br", [])) coalesce ""
    assert br_out ≡ "<br>"
    const string img_out ← tela.html_visus(tela.element_view(tela.html_space(), "img", [])) coalesce ""
    assert img_out ≡ "<img>"
    const string nonvoid_out ← tela.html_visus(tela.element_view(tela.html_space(), "div", [])) coalesce ""
    assert nonvoid_out ≡ "<div></div>"

    # --- (b) svg xmlns on svg-namespace elements (spike baseline) ----------
    const string svg_out ← tela.html_visus(tela.element_view(tela.svg_space(), "svg", [
        tela.element_view(tela.svg_space(), "circle", [])
    ])) coalesce ""
    assert svg_out ≡ «<svg xmlns="http://www.w3.org/2000/svg"><circle xmlns="http://www.w3.org/2000/svg"></circle></svg>»

    # --- (b) Fragment emits no wrapper (campaign §2) ---------------------
    const string frag_out ← tela.html_visus(tela.fragment_view([
        tela.text_view("a"),
        tela.text_view("b")
    ])) coalesce ""
    assert frag_out ≡ "ab"

    # --- (f) fail-closed rejection: invalid input NEVER emits markup ------
    # Mechanism (documented in tela.fab): the serializer returns null (no
    # output at all) when any U2 lexical/namespace/void check fails — never
    # partial markup.
    # Void element carrying children is an impossible structure.
    const string ∪ null bad_void ← tela.html_visus(tela.element_view(tela.html_space(), "br", [ tela.text_view("x") ]))
    assert bad_void ≡ null
    # Markup delimiter in a tag name fails the lexical tag predicate.
    const string ∪ null bad_tag ← tela.html_visus(tela.element_view(tela.html_space(), "di<v", []))
    assert bad_tag ≡ null
    # SVG-only name under the html context is namespace misuse.
    const string ∪ null bad_ns ← tela.html_visus(tela.element_view(tela.html_space(), "circle", []))
    assert bad_ns ≡ null
    # '=' in an attribute name fails the lexical attribute predicate.
    const string ∪ null bad_attr ← tela.html_visus(tela.element_full(
        null,
        tela.html_space(),
        "div",
        [ tela.Attribute { name = "a=b", value = "x" } ],
        [],
        []
    ))
    assert bad_attr ≡ null
    # A nested invalid element rejects the WHOLE tree — no partial output.
    const string ∪ null bad_nested ← tela.html_visus(tela.fragment_view([
        tela.text_view("ok"),
        tela.element_view(tela.html_space(), "img", [ tela.text_view("nope") ])
    ]))
    assert bad_nested ≡ null

    # --- (g) CSS emission: deterministic, author order preserved ----------
    const tela.Style style ← tela.Style {
        rules = [
            tela.Rule {
                selector = "[data-tela='contator-app']",
                declarations = [
                    tela.Declaration { name = "display", value = "grid" },
                    tela.Declaration { name = "gap", value = "0.5rem" }
                ]
            },
            tela.Rule {
                selector = "x-metric",
                declarations = [
                    tela.Declaration { name = "color", value = "var(--chart-axis-muted)" }
                ]
            }
        ]
    }
    const string css_out ← tela.css(style)
    assert css_out ≡ "[data-tela='contator-app'] { display: grid; gap: 0.5rem; }\nx-metric { color: var(--chart-axis-muted); }\n"

    # --- (f) determinism: identical input → identical bytes ---------------
    const string css_b ← tela.css(style)
    assert css_b ≡ css_out
    const string ∪ null det_arbor ← tela.html_visus(tela.element_view(tela.html_space(), "x-metric", [
        tela.text_view("value"),
        tela.element_view(tela.html_space(), "x-bar", [ tela.text_view("fill") ])
    ]))
    const string ∪ null det_b ← tela.html_visus(tela.element_view(tela.html_space(), "x-metric", [
        tela.text_view("value"),
        tela.element_view(tela.html_space(), "x-bar", [ tela.text_view("fill") ])
    ]))
    assert det_b ≡ det_arbor

    print "serializer exempla ready"
}
