+++
term = "serializer"
kind = "keyword"
category = "library"
locale = "en"
+++

# tela/exempla/serializer.fab — Stage 1 U3 exempla for the deterministic
# HTML + CSS serializers and the fail-closed boundary in src/tela.fab.
# Covers every case from U3 done_when (g): text/attribute/identity escaping
# with special characters; void emission (br, img); svg xmlns; fragment
# no-wrapper; data-tela emission; fail-closed rejection (invalid input never
# emits markup — the serializer returns null); CSS emission; plus an
# empirical determinism assert (identical input → identical bytes).
#
# The HTML renderer verb is tela.html_visus (G5 workaround spelling — see
# the tela.fab module header); css is the exact policy (b) verb.

import from "tela:tela" private tela

main {
    # --- (g) text escaping: & < > escaped; quotes pass through (text set) --
    # The bare double-quote is spelled via ascii-literal interpolation
    # ("§"('"')) rather than the \" escape — the TS emitter double-escapes a
    # `\"` payload (see the escapa note in tela.fab), and this spelling keeps
    # the exempla runtime-correct in both lanes.
    const string text_esc ← tela.html_visus(tela.textus_view("a&b<c>d" + "§"('"') + "e'f")) coalesce ""
    assert text_esc ≡ "a&amp;b&lt;c&gt;d" + "§"('"') + "e'f"

    # --- (g) attribute escaping: & < > " ' all escaped (attribute set) ----
    const string attr_esc ← tela.html_visus(tela.elementum_omne(
        null,
        tela.html_spatium(),
        "div",
        [ tela.Attributum { nomen = "title", valor = "a&b<c>d" + "§"('"') + "e'f" } ],
        [],
        []
    )) coalesce ""
    assert attr_esc ≡ "<div title='a&amp;b&lt;c&gt;d&quot;e&#39;f'></div>"

    # --- (g) identity escaping: valor flows through the SAME attr escape ----
    const string id_esc ← tela.html_visus(tela.elementum_omne(
        tela.nova_identitas("a'b" + "§"('"') + "c&"),
        tela.html_spatium(),
        "div",
        [],
        [],
        []
    )) coalesce ""
    assert id_esc ≡ "<div data-tela='a&#39;b&quot;c&amp;'></div>"

    # --- (b) data-tela emission per policy (d) — the spike baseline form ---
    const string id_plain ← tela.html_visus(tela.elementum_omne(
        tela.nova_identitas("contator-app"),
        tela.html_spatium(),
        "div",
        [],
        [],
        [ tela.textus_view("contator") ]
    )) coalesce ""
    assert id_plain ≡ "<div data-tela='contator-app'>contator</div>"

    # --- (b) HTML void emission: no closing tag (void set from valida) ----
    const string br_out ← tela.html_visus(tela.elementum_view(tela.html_spatium(), "br", [])) coalesce ""
    assert br_out ≡ "<br>"
    const string img_out ← tela.html_visus(tela.elementum_view(tela.html_spatium(), "img", [])) coalesce ""
    assert img_out ≡ "<img>"
    const string nonvoid_out ← tela.html_visus(tela.elementum_view(tela.html_spatium(), "div", [])) coalesce ""
    assert nonvoid_out ≡ "<div></div>"

    # --- (b) svg xmlns on svg-namespace elements (spike baseline) ----------
    const string svg_out ← tela.html_visus(tela.elementum_view(tela.svg_spatium(), "svg", [
        tela.elementum_view(tela.svg_spatium(), "circle", [])
    ])) coalesce ""
    assert svg_out ≡ "<svg xmlns='http://www.w3.org/2000/svg'><circle xmlns='http://www.w3.org/2000/svg'></circle></svg>"

    # --- (b) Fragmentum emits no wrapper (campaign §2) ---------------------
    const string frag_out ← tela.html_visus(tela.fragmentum_view([
        tela.textus_view("a"),
        tela.textus_view("b")
    ])) coalesce ""
    assert frag_out ≡ "ab"

    # --- (f) fail-closed rejection: invalid input NEVER emits markup ------
    # Mechanism (documented in tela.fab): the serializer returns null (no
    # output at all) when any U2 lexical/namespace/void check fails — never
    # partial markup.
    # Void element carrying children is an impossible structure.
    const string ∪ null bad_void ← tela.html_visus(tela.elementum_view(tela.html_spatium(), "br", [ tela.textus_view("x") ]))
    assert bad_void ≡ null
    # Markup delimiter in a tag name fails the lexical tag predicate.
    const string ∪ null bad_tag ← tela.html_visus(tela.elementum_view(tela.html_spatium(), "di<v", []))
    assert bad_tag ≡ null
    # SVG-only name under the html context is namespace misuse.
    const string ∪ null bad_ns ← tela.html_visus(tela.elementum_view(tela.html_spatium(), "circle", []))
    assert bad_ns ≡ null
    # '=' in an attribute name fails the lexical attribute predicate.
    const string ∪ null bad_attr ← tela.html_visus(tela.elementum_omne(
        null,
        tela.html_spatium(),
        "div",
        [ tela.Attributum { nomen = "a=b", valor = "x" } ],
        [],
        []
    ))
    assert bad_attr ≡ null
    # A nested invalid element rejects the WHOLE tree — no partial output.
    const string ∪ null bad_nested ← tela.html_visus(tela.fragmentum_view([
        tela.textus_view("ok"),
        tela.elementum_view(tela.html_spatium(), "img", [ tela.textus_view("nope") ])
    ]))
    assert bad_nested ≡ null

    # --- (g) CSS emission: deterministic, author order preserved ----------
    const tela.Stilum stilum ← tela.Stilum {
        regulae = [
            tela.Regula {
                selector = "[data-tela='contator-app']",
                declarationes = [
                    tela.Declaratio { nomen = "display", valor = "grid" },
                    tela.Declaratio { nomen = "gap", valor = "0.5rem" }
                ]
            },
            tela.Regula {
                selector = "x-metric",
                declarationes = [
                    tela.Declaratio { nomen = "color", valor = "var(--chart-axis-muted)" }
                ]
            }
        ]
    }
    const string css_out ← tela.css(stilum)
    assert css_out ≡ "[data-tela='contator-app'] { display: grid; gap: 0.5rem; }\nx-metric { color: var(--chart-axis-muted); }\n"

    # --- (f) determinism: identical input → identical bytes ---------------
    const string css_b ← tela.css(stilum)
    assert css_b ≡ css_out
    const string ∪ null det_arbor ← tela.html_visus(tela.elementum_view(tela.html_spatium(), "x-metric", [
        tela.textus_view("value"),
        tela.elementum_view(tela.html_spatium(), "x-bar", [ tela.textus_view("fill") ])
    ]))
    const string ∪ null det_b ← tela.html_visus(tela.elementum_view(tela.html_spatium(), "x-metric", [
        tela.textus_view("value"),
        tela.elementum_view(tela.html_spatium(), "x-bar", [ tela.textus_view("fill") ])
    ]))
    assert det_b ≡ det_arbor

    print "serializer exempla parata"
}
