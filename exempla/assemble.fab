+++
term = "assemble"
kind = "concept"
category = "library"
locale = "en"
+++

# tela/exempla/assemble.fab — Stage 2 U2 exempla for product assembly +
# cascade ordering in src/tela.fab. Covers every U2 done_when (f) case:
# bundle dedup (two identical bundles → one); topo order (a depends-on-b →
# b precedes a); stable-identity tie-break (unrelated packages ordered
# lexicographically); cycle rejection; duplicate-identity-different-content
# rejection; cascade layer order (reset → tokens → components → libraries →
# application) with and without a reset bundle; invalid rule rejection;
# duplicate token identity with different content rejection (the shared
# token-layer rule).
#
# fix:<id> markers: none applied beyond the kernel's — the assemble verb is
# not reserved (fix:g5 — NONE); fix:codegen001 — the Rust emit-across-imports
# block persists, the TS lane is the proven lane.

import from "tela:tela" private tela

main {
    # The base theme (full core baseline; the token layer is identical across
    # every assembly below).
    const tela.Theme solaris ← tela.theme("solaris", [
        tela.token("surface.canvas", "#ffffff"),
        tela.token("surface.panel", "#f9fafb"),
        tela.token("text.primary", "#111827"),
        tela.token("text.muted", "#6b7280"),
        tela.token("border.default", "#e5e7eb"),
        tela.token("accent.primary", "#2563eb"),
        tela.token("state.positive", "#16a34a"),
        tela.token("state.caution", "#d97706")
    ])
    const string tokens_css ← ":root { --surface-canvas: #ffffff; --surface-panel: #f9fafb; --text-primary: #111827; --text-muted: #6b7280; --border-default: #e5e7eb; --accent-primary: #2563eb; --state-positive: #16a34a; --state-caution: #d97706; }\n"

    # --- (f) bundle dedup: two identical bundles → one --------------------
    const tela.Bundle panel ← tela.bundle("panel", tela.Style {
        rules = [
            tela.Rule {
                selector = ".panel",
                declarations = [ tela.Declaration { name = "color", value = "var(--text-primary)" } ]
            }
        ]
    })
    const tela.Style ∪ null dedup_result ← tela.assemble(solaris, null, [panel, panel], [], [], null)
    assert not (dedup_result ≡ null)
    const string dedup_css ← tela.css(tela.Style { rules = dedup_result!.rules }) coalesce ""
    assert dedup_css ≡ tokens_css + ".panel { color: var(--text-primary); }\n"

    # --- (f) topo order: a depends-on-b → b precedes a --------------------
    const tela.Bundle lib_a ← tela.bundle("a", tela.Style {
        rules = [
            tela.Rule {
                selector = ".a",
                declarations = [ tela.Declaration { name = "display", value = "grid" } ]
            }
        ]
    })
    const tela.Bundle lib_b ← tela.bundle("b", tela.Style {
        rules = [
            tela.Rule {
                selector = ".b",
                declarations = [ tela.Declaration { name = "display", value = "block" } ]
            }
        ]
    })
    const tela.Style ∪ null topo_result ← tela.assemble(
        solaris,
        null,
        [],
        [ tela.order("a", ["b"]), tela.order("b", []) ],
        [lib_a, lib_b],
        null
    )
    const string topo_css ← tela.css(tela.Style { rules = topo_result!.rules }) coalesce ""
    assert topo_css ≡ tokens_css + ".b { display: block; }\n.a { display: grid; }\n"

    # --- (f) tie-break: unrelated packages ordered by stable identity -----
    const tela.Bundle lib_zeta ← tela.bundle("zeta", tela.Style {
        rules = [
            tela.Rule {
                selector = ".zeta",
                declarations = [ tela.Declaration { name = "color", value = "red" } ]
            }
        ]
    })
    const tela.Bundle lib_alpha ← tela.bundle("alpha", tela.Style {
        rules = [
            tela.Rule {
                selector = ".alpha",
                declarations = [ tela.Declaration { name = "color", value = "blue" } ]
            }
        ]
    })
    const tela.Style ∪ null tie_result ← tela.assemble(
        solaris,
        null,
        [],
        [ tela.order("zeta", []), tela.order("alpha", []) ],
        [lib_zeta, lib_alpha],
        null
    )
    const string tie_css ← tela.css(tela.Style { rules = tie_result!.rules }) coalesce ""
    assert tie_css ≡ tokens_css + ".alpha { color: blue; }\n.zeta { color: red; }\n"

    # --- (f) cycle rejection (fail-closed) --------------------------------
    const tela.Style ∪ null cycle_result ← tela.assemble(
        solaris,
        null,
        [],
        [ tela.order("a", ["b"]), tela.order("b", ["a"]) ],
        [lib_a, lib_b],
        null
    )
    assert cycle_result ≡ null

    # --- (f) duplicate-identity-different-content rejection ---------------
    const tela.Bundle panel_altera ← tela.bundle("panel", tela.Style {
        rules = [
            tela.Rule {
                selector = ".panel",
                declarations = [ tela.Declaration { name = "color", value = "blue" } ]
            }
        ]
    })
    const tela.Style ∪ null conflict_result ← tela.assemble(solaris, null, [panel, panel_altera], [], [], null)
    assert conflict_result ≡ null

    # --- (f) cascade layer order WITH a reset bundle ----------------------
    const tela.Style reset ← tela.Style {
        rules = [
            tela.Rule {
                selector = "*",
                declarations = [ tela.Declaration { name = "margin", value = "0" } ]
            }
        ]
    }
    const tela.Bundle app ← tela.bundle("app", tela.Style {
        rules = [
            tela.Rule {
                selector = ".app",
                declarations = [ tela.Declaration { name = "gap", value = "1rem" } ]
            }
        ]
    })
    const tela.Style ∪ null full_result ← tela.assemble(
        solaris,
        reset,
        [panel],
        [ tela.order("a", ["b"]), tela.order("b", []) ],
        [lib_a, lib_b],
        app
    )
    const string full_css ← tela.css(tela.Style { rules = full_result!.rules }) coalesce ""
    assert full_css ≡ "* { margin: 0; }\n" + tokens_css + ".panel { color: var(--text-primary); }\n.b { display: block; }\n.a { display: grid; }\n.app { gap: 1rem; }\n"

    # --- (f) cascade layer order WITHOUT a reset bundle -------------------
    const tela.Style ∪ null no_reset_result ← tela.assemble(
        solaris,
        null,
        [panel],
        [ tela.order("a", ["b"]), tela.order("b", []) ],
        [lib_a, lib_b],
        app
    )
    const string no_reset_css ← tela.css(tela.Style { rules = no_reset_result!.rules }) coalesce ""
    assert no_reset_css ≡ tokens_css + ".panel { color: var(--text-primary); }\n.b { display: block; }\n.a { display: grid; }\n.app { gap: 1rem; }\n"

    # --- (f) invalid rule rejection (empty selector) ----------------------
    const tela.Bundle malum ← tela.bundle("malum", tela.Style {
        rules = [
            tela.Rule {
                selector = "",
                declarations = [ tela.Declaration { name = "color", value = "red" } ]
            }
        ]
    })
    const tela.Style ∪ null invalid_result ← tela.assemble(solaris, null, [malum], [], [], null)
    assert invalid_result ≡ null

    # --- (d) duplicate token identity with different content rejects ------
    const tela.Theme gemina ← tela.theme("gemina", [
        tela.token("surface.canvas", "#ffffff"),
        tela.token("surface.panel", "#f9fafb"),
        tela.token("text.primary", "#111827"),
        tela.token("text.muted", "#6b7280"),
        tela.token("border.default", "#e5e7eb"),
        tela.token("accent.primary", "#2563eb"),
        tela.token("state.positive", "#16a34a"),
        tela.token("state.caution", "#d97706"),
        tela.token("state.caution", "#000000")
    ])
    const tela.Style ∪ null token_dup_result ← tela.assemble(gemina, null, [], [], [], null)
    assert token_dup_result ≡ null
}
