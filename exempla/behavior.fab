+++
term = "behavior"
kind = "concept"
category = "library"
locale = "en"
+++

# tela/exempla/behavior.fab — Stage 3 U1 exempla for the behavior carriers
# in src/tela.fab. Covers every U1 done_when (e) case: event-name
# construction; every effect variant; an update result carrying a view +
# effects; pure-carrier composition; the no-closure property (carriers are
# plain values — construct, combine, read fields, render; no behavior
# smuggled in).
#
# The carrier shapes match behavior-design §1/§3.2: EventName (typed event
# name), Effect (the three declarative host effects — focus restoration,
# focus movement, scroll anchoring — keyed by stable identity), Update
# (the update result carrying the next view + effects).
#
# PARTIAL (CTO Q2 bar, compile-level): carrier construction + composition
# are fully proven here (radix check + the TS lane + the runtime gate). The
# BEHAVIORAL EXECUTION of the effects (mount/replace/dispose, hydration,
# host effect execution) is deferred to U2 (browser mount) + U3 (the
# segmented-interactive proof). No f64 arithmetic in the carriers — no f64
# oracle pins apply.
#
# fix:<id> markers: none applied beyond the kernel's — the carrier verbs +
# variant names probed collision-free on in-tree radix 0.80.0 (fix:g5 —
# NONE); fix:codegen001 — the Rust emit-across-imports block persists, the
# TS lane is the proven lane.

import from "tela:tela" private tela

main {
    # --- event-name construction (the typed event value) -------------------
    const tela.EventName event ← tela.event_name("segment-select")
    assert event.name ≡ "segment-select"

    # --- every effect variant (declarative host effects keyed by identity)
    # Focus restoration — restore focus to the pre-replacement focused node.
    const tela.Effect restore ← tela.restore("tela-seg-2")
    assert tela.effect_identity(restore) ≡ "tela-seg-2"
    # Focus movement — to a declared target identity.
    const tela.Effect move ← tela.direct("tela-seg-3")
    assert tela.effect_identity(move) ≡ "tela-seg-3"
    # Scroll anchoring — scroll-preservation intent for the region.
    const tela.Effect anchor ← tela.anchor("tela-control")
    assert tela.effect_identity(anchor) ≡ "tela-control"

    # --- an update result carrying a view + effects ------------------------
    const tela.View tree ← tela.element_view(
        tela.html_space(),
        "div",
        [ tela.text_view("segment") ]
    )
    const tela.Update update ← tela.update(tree, [restore, move, anchor])
    assert update.effects.longitudo() ≡ 3
    const string rendered ← tela.html_visus(update.view) coalesce ""
    assert rendered ≡ "<div>segment</div>"

    # --- pure-carrier composition: combine effects into an update result ---
    const tela.Update combined ← tela.update(tree, [anchor, restore])
    assert combined.effects.longitudo() ≡ 2

    # --- the no-closure property: carriers are plain values ---------------
    # Construct, combine, read fields, render — every carrier is a plain
    # value (no function/closure field exists anywhere in the three shapes).
    const tela.EventName another ← tela.event_name("pointer-down")
    assert another.name ≠ event.name
    const string rendered_combined ← tela.html_visus(combined.view) coalesce ""
    assert rendered_combined ≡ "<div>segment</div>"
}
