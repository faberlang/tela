#!/usr/bin/env bash
# tela/scripta/check-forms-proof — the Stage 4 fire-9 package-test harness
# (tela-s4-u5-tests-harness-determinism). Validates the formslib proof
# package + the consumer under the benchmark library home — the OFFICIAL
# package test surface (fire-9 norm, stage-4-discovery.md §2).
#
#   1. radix check — the package src, the package exempla (exempla-mode,
#      `+++` frontmatter), and the consumer (canary-app) under the
#      benchmark libhome.
#   2. TS lane A — the PACKAGE EXEMPLA GATE: emit valida/tela/forms + the
#      exempla into the TS module graph, then `tsc` + `node` — the exempla's
#      byte-exact static + ARIA assertions EXECUTE (fail-closed: any assertion
#      failure or non-zero exit FAILS the check).
#   3. TS lane B — the CONSUMER ASSEMBLY GATE: emit valida/tela/extension/
#      forms/main, assemble, `tsc --noEmit`, then `node` — the three-
#      package assembly + ordering + dedup + fail-closed regressions + the
#      U4 pure behavior-plan assertions EXECUTE (fail-closed).
#
# The package exempla cannot consume the `→ tela.View` component fns
# through the provider interface (fix:g4 — WARN014 export-skip, recorded);
# the byte-exact proof rides the G4-safe string-returning `*_html` helpers.
# The consumer assembly is consumed through the harness-assembly path
# (fix:g4 — the WARN014 skip does not apply at runtime).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SCRATCH="$(mktemp -d "${TMPDIR:-/tmp}/tela-u5-forms-proof.XXXXXX")"
trap 'rm -rf "$SCRATCH"' EXIT

if [[ -n "${RADIX_ROOT:-}" ]]; then
  RADIX="$RADIX_ROOT"
elif [[ -d "$ROOT/../radix/crates/radix" ]]; then
  RADIX="$ROOT/../radix"
else
  RADIX="$ROOT/../../../radix"
fi

if [[ ! -d "$RADIX/crates/radix" ]]; then
  echo "check-forms-proof: missing radix checkout at $RADIX" >&2
  exit 1
fi

RADIX_BIN="$RADIX/target/debug/radix"
if [[ ! -x "$RADIX_BIN" ]]; then
  (cd "$RADIX" && cargo build -q -p radix-cli --bin radix)
fi

export FABER_LIBRARY_HOME="$ROOT/proof/benchmark/libhome"

echo "check-forms-proof: radix check the proof package + the consumer (benchmark libhome)"
"$RADIX_BIN" check --locale en "$ROOT/proof/extension-forms/src/forms.fab"
"$RADIX_BIN" check --locale en "$ROOT/proof/extension-forms/exempla/forms.fab"
"$RADIX_BIN" check --locale en "$ROOT/proof/benchmark/canary-app/src/main.fab"

# ---- TS lane: module-graph assembly --------------------------------------
# The radix TS emit is an import-based module graph (modules carry
# `import * as <ns> from "./tela-<module>.js"` specifiers and
# namespace-qualified type positions). The lane places every emitted module
# at its specifier path with an export surface and runs the two entries
# through tsc/node — the exempla assertions and the consumer behavior-plan
# assertions EXECUTE (fail-closed).
echo "check-forms-proof: TS emit the module graph"
INTRINSICS='Number|String|Boolean|Object|Array|Function|Symbol'
seam_normalize() {
  perl -pi -e 's/value\.__faberValorTag/(value as { __faberValorTag?: unknown }).__faberValorTag/g' "$1"
}
emit_module() { # <fab path> <specifier file name>
  "$RADIX_BIN" emit -t ts --locale en "$1" -o "$SCRATCH/$2" >/dev/null
  perl -0pi -e "s/^interface ($INTRINSICS) \\{\n(.*?)^\\}\n/declare global {\ninterface \$1 {\n\$2}\n}\n/ms" "$SCRATCH/$2"
  seam_normalize "$SCRATCH/$2"
  local names
  names="$(grep -E '^(function|class|interface|type|const|let|var|enum) [A-Za-z_$]' "$SCRATCH/$2" \
    | sed -E 's/^(function|class|interface|type|const|let|var|enum) ([A-Za-z_$][A-Za-z0-9_$]*).*/\2/' \
    | sort -u | grep -vE "^($INTRINSICS)$" | paste -sd, - | sed 's/,/, /g')"
  if [[ -n "$names" ]]; then
    printf '\nexport { %s };\n' "$names" >> "$SCRATCH/$2"
  else
    printf '\nexport {};\n' >> "$SCRATCH/$2"
  fi
}
emit_module "$ROOT/src/validate.fab" "tela-validate.ts"
emit_module "$ROOT/src/tela.fab" "tela-tela.ts"
emit_module "$ROOT/src/dom.fab" "tela-dom.ts"
emit_module "$ROOT/src/browser.fab" "tela-browser.ts"
emit_module "$ROOT/src/reference.fab" "tela-reference.ts"
emit_module "$ROOT/proof/benchmark/extension-lib/src/extension.fab" "extensionlib-extension.ts"
emit_module "$ROOT/proof/extension-forms/src/forms.fab" "formslib-forms.ts"
"$RADIX_BIN" emit -t ts --locale en "$ROOT/proof/extension-forms/exempla/forms.fab" -o "$SCRATCH/exempla-forms.ts" >/dev/null
seam_normalize "$SCRATCH/exempla-forms.ts"
"$RADIX_BIN" emit -t ts --locale en "$ROOT/proof/benchmark/canary-app/src/main.fab" -o "$SCRATCH/main.ts" >/dev/null
seam_normalize "$SCRATCH/main.ts"

# The @faber/runtime package seam (display + exact).
mkdir -p "$SCRATCH/node_modules/@faber/runtime"
cat > "$SCRATCH/node_modules/@faber/runtime/package.json" <<'RUNTIME_PKG'
{ "name": "@faber/runtime", "type": "module", "main": "./index.js", "types": "./index.d.ts" }
RUNTIME_PKG
cat > "$SCRATCH/node_modules/@faber/runtime/index.d.ts" <<'RUNTIME_DTS'
export type DisplayHint =
  | "unknown" | "textus" | "ascii" | "numerus" | "fractus" | "bivalens"
  | "nihil" | "vacuum" | "valor" | "instans" | "regex"
  | { kind: "nullable"; inner: DisplayHint }
  | { kind: "lista"; element: DisplayHint }
  | { kind: "tensor"; element: DisplayHint }
  | { kind: "sparsa"; element: DisplayHint }
  | { kind: "map"; key: DisplayHint; value: DisplayHint }
  | { kind: "set"; element: DisplayHint };
export declare const display: { value(value: any, hint?: DisplayHint): string };
export declare const exact: { chk(v: number): number; add(a: number, b: number): number; sub(a: number, b: number): number; mul(a: number, b: number): number; div(a: number, b: number): number; mod(a: number, b: number): number; shl(a: number, n: number): number; shr(a: number, n: number): number; floatRem(a: number, b: number): number; neg(a: number): number; not(a: number): number; abs(a: number): number; pow(base: number, exponent: number): number; hi(a: number): number; lo(a: number): number; join(hi: number, lo: number): number; and(a: number, b: number): number; or(a: number, b: number): number; xor(a: number, b: number): number; store(v: number, lo: number, hi: number, ty: string, pos: string, extra: string): number; clamp(v: number, lo: number, hi: number): number; wrap(v: number, bits: number, signed: boolean): number; trueDiv(a: number, b: number): number; trueDivF32(a: number, b: number): number };
RUNTIME_DTS
RUNTIME_TS="${FABER_RUNTIME_TS:-$ROOT/../faber/runtime/typescript}"
if [[ ! -f "$RUNTIME_TS/exact.ts" ]]; then
  echo "check-forms-proof: missing faber runtime package at $RUNTIME_TS (set FABER_RUNTIME_TS)" >&2
  exit 1
fi
RUNTIME_TS="$(cd "$RUNTIME_TS" && pwd)"
cat > "$SCRATCH/node_modules/@faber/runtime/index.js" <<RUNTIME_JS
// exact is the authoritative Faber runtime module. Only display is a
// string-carrier harness shim; it is not involved in arithmetic assertions.
export * as exact from "$RUNTIME_TS/exact.ts";
export const display = {
  value(value, hint = "unknown") {
    if (value === null || value === undefined) {
      return hint === "vacuum" ? "vacuum" : "nihil";
    }
    if (hint === "bivalens") {
      return value ? "verum" : "falsum";
    }
    return String(value);
  },
};
RUNTIME_JS
printf '{ "type": "module" }\n' > "$SCRATCH/package.json"

echo "check-forms-proof: exempla gate — tsc --outDir + node (byte-exact static + ARIA)"
tsc --strict --target ES2020 --module ESNext --moduleResolution bundler --skipLibCheck --outDir "$SCRATCH/dist-a" "$SCRATCH/exempla-forms.ts"
node "$SCRATCH/dist-a/exempla-forms.js" >/dev/null

echo "check-forms-proof: consumer assembly gate — tsc --outDir + node (assembly + plan assertions)"
tsc --strict --target ES2020 --module ESNext --moduleResolution bundler --skipLibCheck --outDir "$SCRATCH/dist-b" "$SCRATCH/main.ts"
node "$SCRATCH/dist-b/main.js" >/dev/null

echo "check-forms-proof: green (package exempla gate + consumer assembly gate; node exit 0)"
