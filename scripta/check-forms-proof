#!/usr/bin/env bash
# tela/scripta/check-forms-proof — the Stage 4 fire-9 package-test harness
# (tela-s4-u5-tests-harness-determinism). Validates the formslib proof
# package + the consumer under the benchmark library home — the OFFICIAL
# package test surface (fire-9 norm, stage-4-discovery.md §2).
#
#   1. radix check — the package src, the package exempla (exempla-mode,
#      `+++` frontmatter), and the consumer (canary-app) under the
#      benchmark libhome.
#   2. TS lane A — the PACKAGE EXEMPLA GATE: emit valida/tela/forms + the
#      exempla, assemble ONE self-contained file (strip + namespace
#      bindings — the check-exempla mechanics), `tsc --noEmit`, then
#      `node` — the exempla's byte-exact static + ARIA assertions EXECUTE
#      (fail-closed: any assertion failure or non-zero exit FAILS the
#      check).
#   3. TS lane B — the CONSUMER ASSEMBLY GATE: emit valida/tela/extension/
#      forms/main, assemble, `tsc --noEmit`, then `node` — the three-
#      package assembly + ordering + dedup + fail-closed regressions + the
#      U4 pure behavior-plan assertions EXECUTE (fail-closed).
#
# The package exempla cannot consume the `→ tela.View` component fns
# through the provider interface (fix:g4 — WARN014 export-skip, recorded);
# the byte-exact proof rides the G4-safe string-returning `*_html` helpers.
# The consumer assembly is consumed through the harness-assembly path
# (fix:g4 — the WARN014 skip does not apply at runtime).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SCRATCH="$(mktemp -d "${TMPDIR:-/tmp}/tela-u5-forms-proof.XXXXXX")"
trap 'rm -rf "$SCRATCH"' EXIT

if [[ -n "${RADIX_ROOT:-}" ]]; then
  RADIX="$RADIX_ROOT"
elif [[ -d "$ROOT/../radix/crates/radix" ]]; then
  RADIX="$ROOT/../radix"
else
  RADIX="$ROOT/../../../radix"
fi

if [[ ! -d "$RADIX/crates/radix" ]]; then
  echo "check-forms-proof: missing radix checkout at $RADIX" >&2
  exit 1
fi

RADIX_BIN="$RADIX/target/debug/radix"
if [[ ! -x "$RADIX_BIN" ]]; then
  (cd "$RADIX" && cargo build -q -p radix --bin radix)
fi

export FABER_LIBRARY_HOME="$ROOT/proof/benchmark/libhome"

echo "check-forms-proof: radix check the proof package + the consumer (benchmark libhome)"
"$RADIX_BIN" check --locale en "$ROOT/proof/extension-forms/src/forms.fab"
"$RADIX_BIN" check --locale en "$ROOT/proof/extension-forms/exempla/forms.fab"
"$RADIX_BIN" check --locale en "$ROOT/proof/benchmark/canary-app/src/main.fab"

echo "check-forms-proof: TS emit valida / tela / forms / browser / dom / exempla / extension / main"
"$RADIX_BIN" emit -t ts --locale en "$ROOT/src/validate.fab" -o "$SCRATCH/valida.ts" >/dev/null
"$RADIX_BIN" emit -t ts --locale en "$ROOT/src/tela.fab" -o "$SCRATCH/tela.ts" >/dev/null
"$RADIX_BIN" emit -t ts --locale en "$ROOT/proof/extension-forms/src/forms.fab" -o "$SCRATCH/forms.ts" >/dev/null
"$RADIX_BIN" emit -t ts --locale en "$ROOT/proof/extension-forms/exempla/forms.fab" -o "$SCRATCH/exempla-forms.ts" >/dev/null
"$RADIX_BIN" emit -t ts --locale en "$ROOT/proof/benchmark/extension-lib/src/extension.fab" -o "$SCRATCH/extension.ts" >/dev/null
"$RADIX_BIN" emit -t ts --locale en "$ROOT/proof/benchmark/canary-app/src/main.fab" -o "$SCRATCH/main.ts" >/dev/null
# Stage 4 U7: the canary-app imports tela:browser + tela:dom (the real
# seam — web-surface-import U4 re-points it from faber-web's web:dom).
# The consumer assembly binds the browser module + the emitted tela:dom
# provider module (types + inert stubs — the main IIFE never calls the seam
# at load here; the interactive gate check-forms-interactive binds the real
# tela runtime over the actual bindings/ts.toml mapping).
"$RADIX_BIN" emit -t ts --locale en "$ROOT/src/browser.fab" -o "$SCRATCH/browser.ts" >/dev/null
# Stage 5 U9: the reference catalog module (the canary's consumer assembly
# references tela:reference — the pre-existing staleness that left this
# gate RED since U5 is repaired at this boundary).
"$RADIX_BIN" emit -t ts --locale en "$ROOT/src/reference.fab" -o "$SCRATCH/reference.ts" >/dev/null
"$RADIX_BIN" emit -t ts --locale en "$ROOT/src/dom.fab" -o "$SCRATCH/dom.ts" >/dev/null

# Assemble a self-contained TS file: drop the radix header (2 lines) and
# every `import ... from "…"` line, then bind the imported namespaces as
# plain const objects (the emitted modules declare their top-level bindings
# without exports).
strip() { sed '1,2d' "$1" | grep -v '^import .* from "'; }
# The emitted tela:dom provider module's preamble (FaberDisplayHint + the
# __faberDisplay helpers) and its `Element` genus are renamed so they do not
# collide with the tela module's own preamble / the DOM lib's `Element`.
strip_dom() { sed '1,2d' "$1" | grep -v '^import .* from "' | sed -e 's/\bFaberResult\b/FaberResultDom/g' -e 's/\bFaberDisplayHint\b/FaberDisplayHintDom/g' -e 's/\b__faberDisplayFractus\b/__faberDisplayDomFractus/g' -e 's/\b__faberDisplayList\b/__faberDisplayDomList/g' -e 's/\b__faberDisplayTensor\b/__faberDisplayDomTensor/g' -e 's/\b__faberDisplaySparsa\b/__faberDisplayDomSparsa/g' -e 's/\b__faberDisplayMap\b/__faberDisplayDomMap/g' -e 's/\b__faberDisplayValor\b/__faberDisplayDomValor/g' -e 's/\b__faberDisplayTaggedValor\b/__faberDisplayDomTaggedValor/g' -e 's/\b__faberDisplay\b/__faberDisplayDom/g' -e 's/\bElement\b/DomElement/g'; }

VALIDA_NS="const validate = { valid_space, valid_tag_name, valid_attribute_name, valid_name_in_space, valid_void_html, valid_void_structure };"
TELA_NS="const tela = { html_visus, css, theme_css, theme_style, theme, token, core_tokens, token_property_name, token_name_valid, theme_has_core_tokens, theme_has_token, assemble, bundle, order, deduplicated_bundles, topological_order, style_valid, unclean_style_text, bundle_for, in_list, dependencies_met, text_view, fragment_view, new_identity, html_space, svg_space, element_view, element_full, event_name, restore, direct, anchor, update, effect_identity, Attribute, Property, Identity, Declaration, Rule, Style, Token, Theme, Bundle, Order, EventName, Update };"
EXT_NS="const ext = { chart_axis_muted, chart_axis_muted_dark, chart_grid_muted, chart_grid_muted_dark, chart_tokens, chart_tokens_dark, bar_meter, chart_style };"
BROWSER_NS="const browser = { region_root, event_subscription, binding, parse_identities, element_tag, count_occurrences, duplicate_identities, tag_name, tag_at, identities_from_nodes, tags_from_nodes, binding_status, hydration_diagnostics, mount, replace, dispose, focus_held, focus_target };"
# The U7 seam surface: the emitted provider's OWN stub fns (the consumer's
# main IIFE never calls the seam at load — inert here). The en tela:dom
# module renames the value READ fn to `input_value` (fix:sem005-renamed —
# the en type keyword `value`; the `value` route key is gone with the la
# module, recorded).
DOM_NS="const dom = { scope, query, require, all, snapshot, text_set, attr_set, attr_remove, class_add, class_remove, class_toggle, on, unsubscribe, input_value, value_set, on_input, on_submit, on_frame, on_resize, on_keyboard, on_pointer, on_focus, pointer_lock_state, request_pointer_lock, exit_pointer_lock, on_pointer_lock, prevent_default, fetch_text };"
FORMS_NS="const forms = { field_props, checkbox_props, select_props, field, checkbox, select, error_region, form_live_region, field_group, form_field_invalid, form_field_valid, form_focus, form_tokens, form_style, field_event, change_event, submit_event, click_event, invalid_state, error_present };"
# Stage 5 U9: the reference catalog namespace (the canary's runner
# references tela:reference types + fns).
REF_NS="const ref = { layout_stack, layout_grid, layout_prose, stack_props, grid_props, layout_prose_props, typography_heading, typography_prose, typography_emphasis, typography_scale, heading_props, prose_props, emphasis_props, scale_props, clamped_level, layout_style, typography_style, panel, badge, metric, panel_props, badge_props, metric_props, panel_style, badge_style, metric_style, table, table_row, table_props, table_style, segmented_control, segmented_props, segmented_option, segmented_options, segmented_live_region, selected_text, active_tabindex, segmented_style, button, button_props, button_event, button_style, field_input, field_input_props, field_invalid, field_error_region, field_live_region, field_control, field_style, field_input_event, field_error_for_value, field_announcement, ref_layout_gap, ref_layout_prose_measure, ref_type_scale_xs, ref_type_scale_sm, ref_type_scale_md, ref_type_scale_lg, ref_type_scale_xl, ref_type_heading_weight, ref_type_heading_margin, ref_type_prose_line_height, ref_type_prose_margin, ref_panel_surface, ref_panel_border, ref_panel_radius, ref_panel_padding, ref_badge_size, ref_badge_padding, ref_badge_radius, ref_metric_label_size, ref_metric_label_muted, ref_metric_value_size, ref_metric_value_weight, ref_table_border, ref_table_padding, ref_table_header_weight, ref_table_caption_muted, ref_seg_gap, ref_seg_radius, ref_seg_size, ref_seg_padding, ref_seg_border, ref_seg_selected_border, ref_button_size, ref_button_padding, ref_button_radius, ref_button_border, ref_button_text, ref_button_primary_background, ref_button_primary_text, ref_button_secondary_background, ref_button_ghost_background, ref_button_focus, ref_button_disabled_opacity, field_invalid_token, field_valid_token, field_focus_token, reference_tokens, StackProps, GridProps, LayoutProseProps, HeadingProps, ProseProps, EmphasisProps, ScaleProps, PanelProps, BadgeProps, MetricProps, TableProps, TableRow, SegmentedProps, ButtonProps, FieldInputProps };"
REF_ALIAS="const reference = ref;"

# ---- TS lane A: the package exempla gate (byte-exact static + ARIA) ------
{
  strip "$SCRATCH/valida.ts"
  echo "$VALIDA_NS"
  strip "$SCRATCH/tela.ts"
  echo "$TELA_NS"
  strip "$SCRATCH/forms.ts"
  echo "$FORMS_NS"
  strip "$SCRATCH/exempla-forms.ts"
} > "$SCRATCH/exempla.ts"

echo "check-forms-proof: exempla gate — tsc --noEmit"
tsc --noEmit --strict --target ES2020 --module ESNext --moduleResolution bundler --skipLibCheck "$SCRATCH/exempla.ts"

echo "check-forms-proof: exempla gate — node (the byte-exact assertions execute; fail-closed)"
node "$SCRATCH/exempla.ts" >/dev/null

# ---- TS lane B: the consumer assembly gate (assembly + ordering + dedup +
# fail-closed regressions + the U4 pure behavior plan) ---------------------
{
  strip "$SCRATCH/valida.ts"
  echo "$VALIDA_NS"
  strip "$SCRATCH/tela.ts"
  echo "$TELA_NS"
  strip_dom "$SCRATCH/dom.ts"
  echo "$DOM_NS"
  strip "$SCRATCH/browser.ts"
  echo "$BROWSER_NS"
  strip "$SCRATCH/extension.ts"
  echo "$EXT_NS"
  strip "$SCRATCH/forms.ts"
  echo "$FORMS_NS"
  strip "$SCRATCH/reference.ts"
  echo "$REF_NS"
  echo "$REF_ALIAS"
  strip "$SCRATCH/main.ts"
} > "$SCRATCH/consumer.ts"

echo "check-forms-proof: consumer assembly gate — tsc --noEmit"
tsc --noEmit --strict --target ES2020 --module ESNext --moduleResolution bundler --skipLibCheck "$SCRATCH/consumer.ts"

echo "check-forms-proof: consumer assembly gate — node (assembly + ordering + dedup + fail-closed + behavior assertions execute; fail-closed)"
node "$SCRATCH/consumer.ts" >/dev/null

echo "check-forms-proof: green (package exempla gate + consumer assembly gate; node exit 0)"
