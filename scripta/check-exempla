#!/usr/bin/env bash
# tela/scripta/check-exempla — exempla surface (Stage 1 U6 + Stage 2 U5 +
# Stage 3 U4). radix check every exempla/*.fab, then the TS lane: emit the
# import-free kernel-side modules + assemble each exempla into ONE
# self-contained file (single-file emits of the import-bearing exempla are
# not self-contained — they keep `provider:module` imports and bare type
# references), then `tsc --noEmit` (strict) AND execute the assembled file
# under `node` (Stage 2 U5 runtime gate — residual R1 closed: assertions
# run, so a wrong expected value or a real emitter/source defect fails the
# check instead of being implementer-claimed). A development-time runtime
# run in U6 surfaced a U2 defect (valida.fab's html-only name set omitted
# `img`) — fixed by the Stage 1 closeout repair; the runtime gate now owns
# this class of defect (the Stage 2 U5 gate caught a real U2 assemble hole:
# components/library bundles were not rule-shape validated — fixed in the
# U5 closeout).
#
# Stage 3 U4: the `behavior` (U1 carriers) + `browser` (U2 mount surface)
# wiring cases are added — the `*)` default must have NO unknown cases
# after. The `browser` case binds the dom-shim namespace (export keywords
# removed) + the U2 mount-proof driver, so the assembled browser exempla
# executes the full mount proof under `node` (empty mount / hydration /
# mismatch / duplicate / replace effects / dispose) — the harness-assembly
# path.
#
# Stage 4 U6 (seam restoration): the browser case also binds the DOM_NS
# const over the dom-shim runtime (the fake-DOM Node host env; the bare
# Scope/Nodus types come from the shim — the emitted provider module's
# `class Element` would collide with the DOM lib). The driver constructs
# the scope through the provider seam (webDomScope); mount reads the
# planted pre-existing markup through webDomSnapshot (the real provider
# route shape). fix:g4 / fix:web-dom-locale are REMOVED.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ -n "${RADIX_ROOT:-}" ]]; then
  RADIX="$RADIX_ROOT"
elif [[ -d "$ROOT/../radix/crates/radix" ]]; then
  RADIX="$ROOT/../radix"
else
  RADIX="$ROOT/../../../radix"
fi

if [[ ! -d "$RADIX/crates/radix" ]]; then
  echo "check-exempla: missing radix checkout at $RADIX" >&2
  exit 1
fi

RADIX_BIN="$RADIX/target/debug/radix"
if [[ ! -x "$RADIX_BIN" ]]; then
  (cd "$RADIX" && cargo build -q -p radix --bin radix)
fi

export FABER_LIBRARY_HOME="${FABER_LIBRARY_HOME:-$ROOT/..}"

echo "check-exempla: radix check every exempla/*.fab"
for f in "$ROOT"/exempla/*.fab; do
  echo "check-exempla: parsing $(basename "$f")"
  "$RADIX_BIN" check --locale en "$f"
done

SCRATCH="$(mktemp -d "${TMPDIR:-/tmp}/tela-u6-exempla.XXXXXX")"
trap 'rm -rf "$SCRATCH"' EXIT

# Assemble a self-contained TS file from emitted modules: drop the radix
# header (2 lines) and every `import ... from "…"` line, then bind the
# imported namespaces as plain const objects (the emitted modules declare
# their top-level bindings without exports).
strip() { sed '1,2d' "$1" | grep -v '^import .* from "'; }

VALIDA_NS="const valida = { valida_spatium, valida_nomen_tag, valida_nomen_attributi, valida_nomen_in_spatio, valida_void_html, valida_void_structura };"
TELA_NS="const tela = { html_visus, css, thema_css, thema_stilum, thema, scopulum, scopuli_core, nomen_scopuli_proprietas, nomen_scopuli_validum, thema_scopuli_core_parati, thema_habet_scopulum, assemble, codicillus, ordo, codicilli_dedupata, ordine_ordinata, stilum_validum, stilum_textus_immundus, codicillus_ex, in_lista, pendeant_parata, textus_view, fragmentum_view, nova_identitas, html_spatium, svg_spatium, elementum_view, elementum_omne, eventum, restitue, dirige, ancora, renovatio, effectus_identitas, Attributum, Proprietas, Declaratio, Regula, Stilum, Scopulum, Thema, Codicillus, Ordo };"
# Stage 4 U6: the web:dom namespace binds the DOM-SHIM's runtime surface
# (the fake-DOM Node host env). The bare Scope/Nodus types come from the
# shim itself (the emitted provider module's `class Element` would collide
# with the DOM lib). The `snapshot` binding is widened (the harness
# boundary is any-typed — the shim's webDomSnapshot expects the runtime
# scope with `root`; the emitted Scope type carries only `selector`).
DOM_NS="const dom = { scope: webDomScope, snapshot: ((scope: any): Array<Nodus> | null => webDomSnapshot(scope)), query: webDomQuery, require: webDomRequire, all: webDomAll, value: webDomValue };"
BROWSER_NS="const browser = { radiculum, subscriptio, ligamen, parse_identitates, elementum_tag, quotiens, identitates_duplicatae, nomen_tagi, tag_at, identitates_ex_nodis, tags_ex_nodis, ligamen_status, diagnosia_hydrationis, mount, replace, dispose, focus_tenet, focus_optata };"

# The U2 mount-proof driver glue: calls executeMountProof (dom-shim) with
# the assembled browser exempla's scenario inputs — the runtime gate for
# the browser exempla's DOM-level assertions. The scope is constructed
# through the provider seam (webDomScope); mount reads the planted
# pre-existing markup via webDomSnapshot.
BROWSER_DRIVER="
const domProofApi = {
  mount: browser.mount,
  replace: browser.replace,
  dispose: browser.dispose,
  focus_tenet: browser.focus_tenet,
  focus_optata: browser.focus_optata,
  scopus: webDomScope,
  html_visus: tela.html_visus,
  effectus_identitas: tela.effectus_identitas,
  arbor: arbor_controlli,
  arbor_extensa: arbor_controlli_extensa,
  arbor_duplicata: arbor_duplicata,
  thema: thema_probe,
  textus_arboris: textus_arboris,
  praesens_hydrationis: praesens_hydrationis,
  praesens_mismatch: praesens_mismatch,
  praesens_duplicata: praesens_duplicata,
  praesens_extranea: praesens_extranea
};
executeMountProof(domProofApi);
"

echo "check-exempla: TS lane (emit + assemble + tsc --noEmit + node runtime gate)"
"$RADIX_BIN" emit -t ts --locale en "$ROOT/src/valida.fab" -o "$SCRATCH/valida.ts" >/dev/null
"$RADIX_BIN" emit -t ts --locale en "$ROOT/src/tela.fab" -o "$SCRATCH/tela.ts" >/dev/null
"$RADIX_BIN" emit -t ts --locale en "$ROOT/src/browser.fab" -o "$SCRATCH/browser.ts" >/dev/null

for f in "$ROOT"/exempla/*.fab; do
  name="$(basename "$f" .fab)"
  # Emit the exempla to a name-suffixed scratch file: exempla/browser.fab
  # emits `browser.ts` too, which must not clobber the browser module emit.
  "$RADIX_BIN" emit -t ts --locale en "$f" -o "$SCRATCH/${name}-exempla.ts" >/dev/null
  case "$name" in
    validation)
      # exempla/validation.fab imports tela:valida
      {
        strip "$SCRATCH/valida.ts"
        echo "$VALIDA_NS"
        strip "$SCRATCH/validation-exempla.ts"
      } > "$SCRATCH/${name}-joined.ts"
      ;;
    serializer)
      # exempla/serializer.fab imports tela:tela (which imports tela:valida)
      {
        strip "$SCRATCH/valida.ts"
        echo "$VALIDA_NS"
        strip "$SCRATCH/tela.ts"
        echo "$TELA_NS"
        strip "$SCRATCH/serializer-exempla.ts"
      } > "$SCRATCH/${name}-joined.ts"
      ;;
    thema)
      # exempla/thema.fab imports tela:tela (Stage 2 U1 theme/token surface)
      {
        strip "$SCRATCH/valida.ts"
        echo "$VALIDA_NS"
        strip "$SCRATCH/tela.ts"
        echo "$TELA_NS"
        strip "$SCRATCH/thema-exempla.ts"
      } > "$SCRATCH/${name}-joined.ts"
      ;;
    assemble)
      # exempla/assemble.fab imports tela:tela (Stage 2 U2 assembly surface)
      {
        strip "$SCRATCH/valida.ts"
        echo "$VALIDA_NS"
        strip "$SCRATCH/tela.ts"
        echo "$TELA_NS"
        strip "$SCRATCH/assemble-exempla.ts"
      } > "$SCRATCH/${name}-joined.ts"
      ;;
    behavior)
      # exempla/behavior.fab imports tela:tela (Stage 3 U1 behavior carriers)
      {
        strip "$SCRATCH/valida.ts"
        echo "$VALIDA_NS"
        strip "$SCRATCH/tela.ts"
        echo "$TELA_NS"
        strip "$SCRATCH/behavior-exempla.ts"
      } > "$SCRATCH/${name}-joined.ts"
      ;;
    browser)
      # exempla/browser.fab imports tela:tela + tela:browser + web:dom. The
      # DOM_NS const binds the dom-shim's runtime surface (the fake-DOM
      # Node host env — the bare Scope/Nodus types come from the shim); the
      # dom-shim + the mount-proof driver execute the FULL mount proof
      # under node — mount reads the planted pre-existing markup through
      # the snapshot (the real provider route shape).
      {
        strip "$SCRATCH/valida.ts"
        echo "$VALIDA_NS"
        strip "$SCRATCH/tela.ts"
        echo "$TELA_NS"
        echo "$DOM_NS"
        strip "$SCRATCH/browser.ts"
        echo "$BROWSER_NS"
        # The shim precedes the exempla so its `class Nodus`/`class Scope`
        # declarations are in scope before the exempla's `new Nodus()`.
        sed 's/^export //' "$ROOT/scripta/dom-shim.ts"
        strip "$SCRATCH/browser-exempla.ts"
        echo ""
        echo "$BROWSER_DRIVER"
      } > "$SCRATCH/${name}-joined.ts"
      ;;
    *)
      echo "check-exempla: exempla module ${name} has no assembly wiring (add it)" >&2
      exit 1
      ;;
  esac
  joined="$SCRATCH/${name}-joined.ts"
  echo "check-exempla: ${name}: tsc --noEmit"
  tsc --noEmit --strict --target ES2020 --module ESNext --moduleResolution bundler --skipLibCheck "$joined"
  # Stage 2 U5 runtime gate (residual R1 closed): the assembled exempla
  # EXECUTES under node — every `assert` runs, so a wrong expectation or a
  # real source/emitter defect fails the check (node exit != 0).
  echo "check-exempla: ${name}: node (runtime gate — assertions execute)"
  node "$joined" >/dev/null
done

echo "check-exempla: green"
