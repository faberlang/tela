#!/usr/bin/env bash
# tela/scripta/check-exempla — exempla surface (Stage 1 U6 + Stage 2 U5 +
# Stage 3 U4). radix check every exempla/*.fab, then the TS lane: emit the
# kernel-side modules, assemble each exempla against the emitted
# import-based module graph, then `tsc` (strict) AND execute the compiled
# entry under `node` (Stage 2 U5 runtime gate — residual R1 closed:
# assertions run, so a wrong expected value or a real emitter/source
# defect fails the check instead of being implementer-claimed). A
# development-time runtime run in U6 surfaced a U2 defect (valida.fab's
# html-only name set omitted `img`) — fixed by the Stage 1 closeout
# repair; the runtime gate now owns this class of defect (the Stage 2 U5
# gate caught a real U2 assemble hole: components/library bundles were
# not rule-shape validated — fixed in the U5 closeout).
#
# Stage 3 U4: the `behavior` (U1 carriers) + `browser` (U2 mount surface)
# wiring cases are added — the `*)` default must have NO unknown cases
# after. The `browser` case binds the AUTHORED fake DOM (Stage 5 U9 —
# scripta/harness_dom.fab emitted to TS; the hand-written dom-shim is
# deleted) + the relocated mount-proof driver, so the browser exempla
# executes the full mount proof under `node` (empty mount / hydration /
# mismatch / duplicate / replace effects / dispose) — the
# harness-assembly path.
#
# Stage 4 U6 (seam restoration) + web-surface-import U4 (the tela:dom
# flip): the browser case binds the tela:dom namespace over the authored
# fake-DOM surface (the fake-DOM Node host env; the bare Scope/DomNode
# types come from the harness boundary — the emitted provider module's
# `class Element` would collide with the DOM lib). The driver constructs
# the scope through the provider seam (web_dom_scope); mount reads the
# planted pre-existing markup through web_dom_snapshot (the real provider
# route shape). fix:g4 / fix:web-dom-locale are REMOVED.
#
# TS-assembly redesign (cae90732): the radix TS emit is now an
# import-based module graph — modules carry `import * as <ns> from
# "./tela-<module>.js"` specifiers, namespace-qualified type positions
# (tela.Theme) and namespace constructors (new tela.Style()), and
# declare their top-level bindings WITHOUT export statements. The old
# single-file assembly (drop the imports, flatten each module into a
# hand-maintained const-object namespace) cannot carry those types or
# constructors. The lane now assembles the graph AS a module graph:
# every emitted module is placed at its specifier path with an export
# surface collected from its emitted top-level declarations, the two
# harness boundary seams are provided as real modules (the tela:dom
# provider shim; the @faber/runtime display package), and tsc + node
# resolve the imports natively (tsc bundler resolution maps the .js
# specifiers onto the .ts sources; the compiled graph runs as ESM).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ -n "${RADIX_ROOT:-}" ]]; then
  RADIX="$RADIX_ROOT"
elif [[ -d "$ROOT/../radix/crates/radix" ]]; then
  RADIX="$ROOT/../radix"
else
  RADIX="$ROOT/../../../radix"
fi

if [[ ! -d "$RADIX/crates/radix" ]]; then
  echo "check-exempla: missing radix checkout at $RADIX" >&2
  exit 1
fi

RADIX_BIN="$RADIX/target/debug/radix"
if [[ ! -x "$RADIX_BIN" ]]; then
  (cd "$RADIX" && cargo build -q -p radix-cli --bin radix)
fi

export FABER_LIBRARY_HOME="${FABER_LIBRARY_HOME:-$ROOT/..}"

echo "check-exempla: radix check every exempla/*.fab"
for f in "$ROOT"/exempla/*.fab; do
  echo "check-exempla: parsing $(basename "$f")"
  "$RADIX_BIN" check --locale en "$f"
done

SCRATCH="$(mktemp -d "${TMPDIR:-/tmp}/tela-u6-exempla.XXXXXX")"
trap 'rm -rf "$SCRATCH"' EXIT

# ---------------------------------------------------------------------------
# Module-graph assembly.
#
# The emitted modules declare their top-level bindings without exports
# (the emitter emits plain declarations; the consuming package layer owns
# export wiring), and the import-free modules use the SCRIPT form of the
# intrinsic-augmentation preamble (bare `interface Number`), which is
# only legal in a script file. The assembly seam does both conversions:
# wrap the bare augmentation in `declare global` and append the module's
# export surface, collected from the emitted column-0 declarations
# (excluding the intrinsic-augmentation interfaces themselves).
# ---------------------------------------------------------------------------

# Intrinsic-augmentation interfaces bridge the runtime-contract method
# surface (potentia) onto the JS built-ins; they augment the global scope
# and are never part of a module's export surface.
INTRINSICS='Number|String|Boolean|Object|Array|Function|Symbol'

# The emitter's `est` variant check probes the runtime-contract valor tag
# (`typeof value.__faberValorTag`) on the value's STATIC type — runtime-
# correct (guarded object probe with a tag fallback), but strict TS
# rejects the property access on a type that does not declare the tag.
# The seam narrows every probe through an inline tag-carrier view: a
# compile-time cast only, the emitted runtime expression is unchanged.
seam_normalize() {
  perl -pi -e 's/value\.__faberValorTag/(value as { __faberValorTag?: unknown }).__faberValorTag/g' "$1"
}

emit_module() { # <fab path> <scratch file name>
  "$RADIX_BIN" emit -t ts --locale en "$1" -o "$SCRATCH/$2" >/dev/null
  perl -0pi -e "s/^interface ($INTRINSICS) \\{\n(.*?)^\\}\n/declare global {\ninterface \$1 {\n\$2}\n}\n/ms" "$SCRATCH/$2"
  seam_normalize "$SCRATCH/$2"
  local names
  names="$(grep -E '^(function|class|interface|type|const|let|var|enum) [A-Za-z_$]' "$SCRATCH/$2" \
    | sed -E 's/^(function|class|interface|type|const|let|var|enum) ([A-Za-z_$][A-Za-z0-9_$]*).*/\2/' \
    | sort -u \
    | grep -vE "^($INTRINSICS)$" \
    | paste -sd, - \
    | sed 's/,/, /g')"
  if [[ -n "$names" ]]; then
    printf '\nexport { %s };\n' "$names" >> "$SCRATCH/$2"
  else
    printf '\nexport {};\n' >> "$SCRATCH/$2"
  fi
}

# The library modules, at the specifier paths the emitted imports name
# (tela-tela.js imports ./tela-validate.js; the exempla emits import
# ./tela-<module>.js for every tela:<module> provider they consume).
emit_module "$ROOT/src/validate.fab" "tela-validate.ts"
emit_module "$ROOT/src/tela.fab" "tela-tela.ts"
emit_module "$ROOT/src/browser.fab" "tela-browser.ts"
emit_module "$ROOT/src/reference.fab" "tela-reference.ts"
# Stage 5 U9: the AUTHORED fake DOM (Faber source -> the emitted module;
# the browser case assembles it as the node host environment).
emit_module "$ROOT/scripta/harness_dom.fab" "tela-harness-dom.ts"

# The tela:dom provider seam at the harness boundary: the emitted provider
# module (src/dom.fab) is deliberately NOT assembled (its class Element
# collides with the DOM lib), so the bare provider types the browser
# module + exempla consume (dom.Scope, dom.DomNode) are declared here and
# dom.snapshot reads through the authored fake DOM.
cat > "$SCRATCH/tela-dom.ts" <<'DOM_SEAM'
// Harness boundary: the bare tela:dom provider types + the snapshot read
// over the authored fake DOM (tela-harness-dom). The emitted provider
// module is not assembled — its class Element collides with the DOM lib.
import { web_dom_snapshot, type FakeNodus } from "./tela-harness-dom.js";

export class Scope {
    selector!: string;
}
export class DomNode {
    identity!: string;
    tag!: string;
}
export function snapshot(scope: any): Array<FakeNodus> | null {
    return web_dom_snapshot(scope);
}
DOM_SEAM

# The @faber/runtime display package: the emitted `print` surface imports
# __faberDisplay from the package instead of inlining it. The exempla gate
# prints only string carriers; the harness stand-in mirrors the package
# contract for those (faber/runtime/typescript/index.ts is the authority).
mkdir -p "$SCRATCH/node_modules/@faber/runtime"
cat > "$SCRATCH/node_modules/@faber/runtime/package.json" <<'RUNTIME_PKG'
{ "name": "@faber/runtime", "type": "module", "main": "./index.js", "types": "./index.d.ts" }
RUNTIME_PKG
cat > "$SCRATCH/node_modules/@faber/runtime/index.d.ts" <<'RUNTIME_DTS'
export type FaberDisplayHint =
  | "unknown" | "textus" | "ascii" | "numerus" | "fractus" | "bivalens"
  | "nihil" | "vacuum" | "valor" | "instans" | "regex";
export declare function __faberDisplay(value: any, hint?: FaberDisplayHint): string;
RUNTIME_DTS
cat > "$SCRATCH/node_modules/@faber/runtime/index.js" <<'RUNTIME_JS'
// Harness stand-in for @faber/runtime (mirrors the string-carrier
// contract; the full hint family lives in faber/runtime/typescript).
export function __faberDisplay(value, hint = "unknown") {
  if (value === null || value === undefined) {
    return hint === "vacuum" ? "vacuum" : "nihil";
  }
  if (hint === "bivalens") {
    return value ? "verum" : "falsum";
  }
  return String(value);
}
RUNTIME_JS

# The compiled module graph runs as ESM under node.
printf '{ "type": "module" }\n' > "$SCRATCH/package.json"

# The U9 mount-proof driver glue: the browser exempla assembles the driver
# IN ITS OWN MODULE (the driver reads the exempla's top-level fixtures and
# its tela/browser namespace imports) and declares its harness-DOM
# dependencies as real imports from the emitted fake-DOM module. The scope
# is constructed through the provider seam (web_dom_scope); mount reads
# the planted pre-existing markup via the dom.snapshot seam. The bare
# Scope/DomNode provider types live in the tela-dom seam module; the
# global fake-DOM installation stays at the driver boundary.
cat > "$SCRATCH/browser-driver.ts" <<'BROWSER_DRIVER'

import {
  bind_region_subscriptions,
  doc_focus_node,
  doc_query_all,
  element_attr_set,
  element_append_child,
  element_clear_children,
  element_dispatch,
  element_text,
  execute_mount_plan,
  fake_document,
  fake_element,
  fake_event,
  parse_fragment,
  resolve_region,
  web_dom_scope,
  web_dom_unsubscribe,
} from "./tela-harness-dom.js";
import type { FakeDocument, FakeElement, MountedLike } from "./tela-harness-dom.js";

// The global installation stays at the driver boundary (hardening lane).
const installFakeDom = (): FakeDocument => {
  const doc = fake_document();
  const root = fake_element("div");
  element_attr_set(root, "id", "root");
  element_append_child(doc.body, root);
  globalThis.document = doc as unknown as Document;
  globalThis.window = { addEventListener() {}, removeEventListener() {} } as unknown as Window & typeof globalThis;
  globalThis.requestAnimationFrame = (cb: (t: number) => void) => setTimeout(() => cb(Date.now()), 16);
  globalThis.cancelAnimationFrame = (id: unknown) => clearTimeout(id as any);
  globalThis.fetch = () => Promise.reject(new Error("no fetch in the exempla gate"));
  return doc;
};

interface RenovatioLike {
  view: unknown;
  effects: unknown[];
}

interface MountProofApi {
  // The api fn params are any-typed (bounded harness typing): the emitted
  // browser.fab functions carry concrete Scope/View/Theme types declared in
  // the assembled file. The RETURN types stay structural so the driver
  // reads real plan fields.
  mount: (scope: any, view: any, theme: any) => MountedLike | null;
  replace: (mounted: any, view: any) => RenovatioLike | null;
  dispose: (mounted: any) => void;
  focus_held: (mounted: any, identity: string) => any;
  focus_target: (mounted: any, identity: string) => any;
  scope: (selector: string) => any;
  html_visus: (view: any) => string | null;
  effect_identity: (effects: any) => string;
  tree: () => any;
  extended_tree: () => any;
  duplicate_tree: () => any;
  theme: () => any;
  tree_markup: () => string;
  hydration_present: () => string;
  mismatch_present: () => string;
  duplicate_present: () => string;
  foreign_present: () => string;
}

// The Stage 3 U2 mount proof: executes the real mount/replace/dispose
// lifecycle (emitted from browser.fab via the api) against the AUTHORED
// fake DOM and asserts every done_when (g) DOM-level outcome. The driver
// rides the emitted function surface (U9). Called after the modules load.
const executeMountProof = (doc: FakeDocument, api: MountProofApi): void => {
  const assert = (cond: boolean, msg: string): void => {
    if (!cond) {
      throw new Error(`dom-shim assert failed: ${msg}`);
    }
  };
  const identityNodes = (): FakeElement[] => doc_query_all(doc, "[data-tela]");
  const byIdentity = (id: string): FakeElement | undefined => identityNodes().find((n) => n.data_tela === id);
  const textOf = (id: string): string => {
    const n = byIdentity(id);
    return n === undefined ? "" : element_text(n);
  };
  // Each scenario owns a fresh region (sequential scenarios on one DOM).
  const resetRegion = (selector: string): FakeElement => {
    const region = resolve_region(doc, selector);
    element_clear_children(region);
    doc_focus_node(doc, null);
    return region;
  };
  // The driver plants the pre-existing markup into the fake DOM (the real
  // provider route reads it via web_dom_snapshot), then mount reads it.
  const preRenderRegion = (selector: string, markup: string): void => {
    const region = resetRegion(selector);
    for (const node of parse_fragment(markup)) {
      element_append_child(region, node);
    }
  };

  // --- scenario 1: mount onto an EMPTY scope ------------------------------
  {
    resetRegion("#root");
    const mounted = api.mount(api.scope("#root"), api.tree(), api.theme());
    assert(mounted !== null, "mount onto an empty scope returns a plan");
    const m = mounted as MountedLike;
    assert(m.markup === api.tree_markup(), "plan markup is the serialized View");
    assert(m.diagnostics.length === 0, "clean mount: no diagnostics");
    assert(m.bindings.every((l) => l.status === "create"), "clean mount: every identity creates");
    execute_mount_plan(doc, "#root", m, true);
    const ids = identityNodes();
    assert(ids.length === 3, "three identity nodes mounted");
    assert(byIdentity("tela-control")?.tagName === "div", "group node is a div");
    assert(textOf("tela-seg-1") === "One", "seg-1 text mounted");
    assert(textOf("tela-seg-2") === "Two", "seg-2 text mounted");
    assert(byIdentity("tela-seg-1")?.token === "fresh", "empty mount: nodes are fresh");
  }

  // --- scenario 2: hydration binds matching nodes (never recreated) ------
  {
    const present = api.hydration_present();
    preRenderRegion("#root", present);
    const mounted = api.mount(api.scope("#root"), api.tree(), api.theme());
    assert(mounted !== null, "hydration mount returns a plan");
    const m = mounted as MountedLike;
    assert(m.diagnostics.length === 0, "hydration: no diagnostics");
    assert(m.bindings.every((l) => l.status === "bind"), "hydration: every identity binds");
    execute_mount_plan(doc, "#root", m, true);
    const ids = identityNodes();
    assert(ids.length === 3, "hydration: three identity nodes present");
    assert(
      byIdentity("tela-control")?.token === "original" &&
        byIdentity("tela-seg-1")?.token === "original" &&
        byIdentity("tela-seg-2")?.token === "original",
      "hydration: matching nodes bound, not recreated",
    );
  }

  // --- scenario 3: mismatch → diagnose + replace (never a silent bind) ---
  {
    const present = api.mismatch_present();
    preRenderRegion("#root", present);
    const mounted = api.mount(api.scope("#root"), api.tree(), api.theme());
    assert(mounted !== null, "mismatch mount returns a plan");
    const m = mounted as MountedLike;
    assert(m.diagnostics.includes("changed:tela-seg-2"), "mismatch diagnosed");
    assert(m.bindings.find((l) => l.identity === "tela-seg-2")?.status === "create", "mismatch node re-creates");
    execute_mount_plan(doc, "#root", m, true);
    assert(byIdentity("tela-seg-2")?.token !== "original", "mismatch node replaced (not silently bound)");
    assert(textOf("tela-seg-2") === "Two", "mismatch node replaced from the View");
    assert(byIdentity("tela-control")?.token === "original", "matching group node still bound");
    assert(byIdentity("tela-seg-1")?.token === "original", "matching seg-1 still bound");
  }

  // --- scenario 4: duplicate identity → diagnosed + resolved --------------
  {
    const present = api.duplicate_present();
    preRenderRegion("#root", present);
    const mounted = api.mount(api.scope("#root"), api.duplicate_tree(), api.theme());
    assert(mounted !== null, "duplicate mount returns a plan");
    const m = mounted as MountedLike;
    assert(m.diagnostics.includes("duplicate:tela-dup"), "duplicate identity diagnosed");
    assert(m.bindings.find((l) => l.identity === "tela-dup")?.status === "create", "duplicate identity re-creates");
    execute_mount_plan(doc, "#root", m, true);
    const dups = doc_query_all(doc, "[data-tela='tela-dup']");
    assert(dups.length === 1, "duplicate nodes collapsed to one (no silent double-bind)");
    assert(dups[0] !== undefined && element_text(dups[0]) === "x", "the surviving node is the View's node");
  }

  // --- scenario 5: replace → declarative effects execute ------------------
  {
    resetRegion("#root");
    const mounted = api.mount(api.scope("#root"), api.tree(), api.theme());
    assert(mounted !== null, "replace scenario: mount returns a plan");
    const m = mounted as MountedLike;
    execute_mount_plan(doc, "#root", m, true);
    // Model the pre-replacement focus; the fake DOM mirrors it.
    const seg2 = byIdentity("tela-seg-2");
    assert(seg2 !== undefined, "seg-2 node present before replace");
    doc_focus_node(doc, seg2!);
    const mFocus = api.focus_held(m, "tela-seg-2");
    const update = api.replace(mFocus, api.tree());
    assert(update !== null, "replace returns the update result");
    const r = update as RenovatioLike;
    const keys = r.effects.map((e) => api.effect_identity(e));
    assert(keys.length === 2, "replace derives two effects");
    assert(keys[0] === "tela-seg-2" && keys[1] === "#root", "effects are restore(seg-2) + anchor(#root)");
    // Execute the replacement (rebuild the region from the next View).
    const nextMarkup = api.html_visus(r.view) ?? "";
    const nextPlan: MountedLike = {
      ...m,
      markup: nextMarkup,
      bindings: m.identities.map((id) => ({ identity: id, status: "create" })),
    };
    execute_mount_plan(doc, "#root", nextPlan, false);
    // Execute the declarative effects after replacement (focus restore by
    // stable identity; scroll-anchor intent for the region).
    for (const e of r.effects) {
      const key = api.effect_identity(e);
      const target = identityNodes().find((n) => n.data_tela === key);
      if (target !== undefined) {
        doc_focus_node(doc, target);
      }
    }
    assert(doc.active_element?.data_tela === "tela-seg-2", "focus restored to the pre-replacement identity");
    assert(byIdentity("tela-control") !== undefined, "region present after replacement");
  }

  // --- scenario 5b: declared focus movement adds Direct ------------------
  {
    resetRegion("#root");
    const mounted = api.mount(api.scope("#root"), api.tree(), api.theme());
    assert(mounted !== null, "movement scenario: mount returns a plan");
    const m = mounted as MountedLike;
    execute_mount_plan(doc, "#root", m, true);
    const mFocus = api.focus_held(m, "tela-seg-2");
    const mMove = api.focus_target(mFocus, "tela-seg-3");
    const update = api.replace(mMove, api.extended_tree());
    assert(update !== null, "movement replace returns the update result");
    const r = update as RenovatioLike;
    const keys = r.effects.map((e) => api.effect_identity(e));
    assert(keys.length === 3, "movement replace derives three effects");
    assert(
      keys[0] === "tela-seg-2" && keys[1] === "tela-seg-3" && keys[2] === "#root",
      "effects are restore + direct + anchor",
    );
    const nextMarkup = api.html_visus(r.view) ?? "";
    const extIds = m.identities.concat("tela-seg-3");
    const nextPlan: MountedLike = {
      ...m,
      markup: nextMarkup,
      bindings: extIds.map((id) => ({ identity: id, status: "create" })),
    };
    execute_mount_plan(doc, "#root", nextPlan, false);
    for (const e of r.effects) {
      const key = api.effect_identity(e);
      const target = identityNodes().find((n) => n.data_tela === key);
      if (target !== undefined) {
        doc_focus_node(doc, target);
      }
    }
    assert(doc.active_element?.data_tela === "tela-seg-3", "focus moved to the declared target identity");
  }

  // --- scenario 6: dispose unsubscribes + clears the region --------------
  {
    resetRegion("#root");
    const mounted = api.mount(api.scope("#root"), api.tree(), api.theme());
    assert(mounted !== null, "dispose scenario: mount returns a plan");
    const m = mounted as MountedLike;
    assert(m.subscriptions.length === 3, "one subscription descriptor per View identity");
    execute_mount_plan(doc, "#root", m, false);
    // Bind the region-bind subscriptions (web_dom* surface) with an
    // observable counter; the app's real handlers are app-typed in U3.
    let dispatched = 0;
    const subscriptions = bind_region_subscriptions(doc, "#root", m, () => {
      dispatched += 1;
    });
    const preNode = byIdentity("tela-seg-1");
    assert(preNode !== undefined, "seg-1 node present before dispose");
    element_dispatch(preNode!, fake_event("tela:binding"));
    assert(dispatched === 1, "subscription is live before dispose");
    // dispose: the harness executes the unsubscribe plan + clears the region.
    api.dispose(m);
    for (const sub of subscriptions) {
      web_dom_unsubscribe(doc, sub);
    }
    const region = resolve_region(doc, "#root");
    element_clear_children(region);
    // A post-dispose dispatch does nothing (listeners removed).
    element_dispatch(preNode!, fake_event("tela:binding"));
    assert(dispatched === 1, "post-dispose dispatch is a no-op (unsubscribed)");
    assert(identityNodes().length === 0, "region cleared after dispose");
  }

  assert(identityNodes().length === 0, "proof scenarios leave no residue");
};

const doc = installFakeDom();
const domProofApi = {
  mount: browser.mount,
  replace: browser.replace,
  dispose: browser.dispose,
  focus_held: browser.focus_held,
  focus_target: browser.focus_target,
  scope: (selector: string): any => web_dom_scope(doc, selector),
  html_visus: tela.html_view,
  effect_identity: tela.effect_identity,
  tree: control_tree,
  extended_tree: extended_control_tree,
  duplicate_tree: duplicate_tree,
  theme: theme_probe,
  tree_markup: tree_markup,
  hydration_present: hydration_present,
  mismatch_present: mismatch_present,
  duplicate_present: duplicate_present,
  foreign_present: foreign_present,
};
executeMountProof(doc, domProofApi);
BROWSER_DRIVER

echo "check-exempla: TS lane (emit + module-graph assembly + tsc + node runtime gate)"
for f in "$ROOT"/exempla/*.fab; do
  name="$(basename "$f" .fab)"
  # Emit the exempla to its own module file: exempla/browser.fab emits
  # ./tela-*.js imports too, which must not clobber the library modules.
  "$RADIX_BIN" emit -t ts --locale en "$f" -o "$SCRATCH/exempla-$name.ts" >/dev/null
  seam_normalize "$SCRATCH/exempla-$name.ts"
  case "$name" in
    browser)
      # exempla/browser.fab imports tela:tela + tela:browser + tela:dom.
      # The driver rides IN the exempla module (it reads the exempla's
      # top-level fixtures + namespace imports); its harness-DOM surface
      # arrives as real imports from the emitted fake-DOM module; dom.*
      # resolves through the tela-dom seam module.
      cat "$SCRATCH/browser-driver.ts" >> "$SCRATCH/exempla-$name.ts"
      ;;
    validation|serializer|thema|assemble|behavior|reference)
      # The exempla emit's import graph (tela:validate / tela:tela /
      # tela:reference) resolves against the assembled library modules.
      ;;
    *)
      echo "check-exempla: exempla module ${name} has no assembly wiring (add it)" >&2
      exit 1
      ;;
  esac
  joined="$SCRATCH/exempla-$name.ts"
  echo "check-exempla: ${name}: tsc (module-graph typecheck + emit)"
  rm -rf "$SCRATCH/dist"
  tsc --strict --target ES2020 --module ESNext --moduleResolution bundler --skipLibCheck --outDir "$SCRATCH/dist" "$joined"
  # Stage 2 U5 runtime gate (residual R1 closed): the assembled exempla
  # EXECUTES under node — every `assert` runs, so a wrong expectation or a
  # real source/emitter defect fails the check (node exit != 0).
  echo "check-exempla: ${name}: node (runtime gate — assertions execute)"
  node "$SCRATCH/dist/exempla-$name.js" >/dev/null
done

echo "check-exempla: green"
