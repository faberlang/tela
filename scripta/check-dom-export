#!/usr/bin/env bash
# Prove the exported subset of tela:dom and that the nine handler-typed
# functions (on, on_input, on_submit, on_frame, on_resize, on_keyboard,
# on_pointer, on_focus, on_pointer_lock) export and can be called by a
# consumer. They were once skipped at export (WARN014, fix:g4 in src/dom.fab);
# a regression back to a skip must turn this gate red.
#
# Usage: ./scripta/check-dom-export
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PROOF="$ROOT/proof/dom-export/probe.fab"
HANDLERS="$ROOT/proof/dom-export/handlers-exported.fab"

if [[ -n "${RADIX_ROOT:-}" ]]; then
  RADIX="$RADIX_ROOT"
elif [[ -d "$ROOT/../radix/crates/radix" ]]; then
  RADIX="$ROOT/../radix"
else
  RADIX="$ROOT/../../../radix"
fi

if [[ ! -d "$RADIX/crates/radix" ]]; then
  echo "check-dom-export: missing radix checkout at $RADIX" >&2
  exit 1
fi

# `faber check`/`faber emit` own package-aware analysis and resolve sibling
# provider imports through --library-home; `radix check`/`radix emit` are
# single-file only and have no library home, so a file that imports a sibling
# module (tela:validate, tela:dom, …) fails there. The retired
# FABER_LIBRARY_HOME env branch is not read, so the flag is passed explicitly.
FABER_BIN="${FABER_BIN:-$RADIX/target/debug/faber}"
if [[ ! -x "$FABER_BIN" ]]; then
  (cd "$RADIX" && cargo build -q -p faber)
fi
RADIX_BIN="$FABER_BIN"

export FABER_LIBRARY_HOME="${FABER_LIBRARY_HOME:-$ROOT/..}"
if [[ ! -f "$ROOT/src/dom.fab" ]]; then
  echo "check-dom-export: missing $ROOT/src/dom.fab" >&2
  exit 1
fi
for proof in "$PROOF" "$HANDLERS"; do
  if [[ ! -f "$proof" ]]; then
    echo "check-dom-export: missing $proof" >&2
    exit 1
  fi
done

echo "check-dom-export: radix=$RADIX_BIN"
echo "check-dom-export: FABER_LIBRARY_HOME=$FABER_LIBRARY_HOME"

out="$("$FABER_BIN" check --library-home "$FABER_LIBRARY_HOME" --locale en "$PROOF" 2>&1)" || {
  echo "$out" >&2
  echo "check-dom-export: radix check failed on $PROOF" >&2
  exit 1
}

if grep -E 'SEM006|import_module_private' <<<"$out"; then
  echo "$out" >&2
  echo "check-dom-export: SEM006 on live tela:dom surface" >&2
  exit 1
fi

if ! grep -q "^ok:" <<<"$out"; then
  echo "$out" >&2
  echo "check-dom-export: missing ok: line on $PROOF" >&2
  exit 1
fi

echo "$out"
echo "check-dom-export: exported subset checks"

handlers_out="$("$FABER_BIN" check --library-home "$FABER_LIBRARY_HOME" --locale en "$HANDLERS" 2>&1)" || {
  echo "$handlers_out" >&2
  echo "check-dom-export: the handler-typed tela:dom functions no longer check for a consumer" >&2
  exit 1
}
if ! grep -q "^ok:" <<<"$handlers_out"; then
  echo "$handlers_out" >&2
  echo "check-dom-export: missing ok: line on $HANDLERS" >&2
  exit 1
fi
if grep -q "file_interface_export_skipped" <<<"$handlers_out"; then
  echo "$handlers_out" >&2
  echo "check-dom-export: a tela:dom export is skipped again (WARN014)" >&2
  exit 1
fi
echo "check-dom-export: nine handler-typed exports called by a consumer: on, on_input, on_submit, on_frame, on_resize, on_keyboard, on_pointer, on_focus, on_pointer_lock"
echo "check-dom-export: GREEN (exported subset + nine handler exports)"
