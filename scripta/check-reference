// --- 7. the table family mounts + the semantic/a11y structure -----------
// The native <table>/<caption>/<thead>/<th scope='col'>/<tbody>/<tr>/<td>
// markup IS the a11y structure (screen readers expose the grid natively —
// no ARIA duplication); the header association rides th[scope]; the
// caption provides the accessible name.
const tableMarkup = tela.html_visus(table_composition()) ?? "";
plantRegion("#root", tableMarkup);
const tb = mount_table("#root") as Mounted;
assert(tb !== null, "table mount returns a plan");
assert(tb.identities.length === 10, "table identities: wrapper + table + 2 header cells + 6 body cells");
assert(tb.bindings.every((l) => l.status === "bind"), "hydration: every table identity binds");
const tableNode = byIdentity("ref-table-services");
assert(tableNode !== undefined && tableNode!.tagName === "table", "table root is a native table");
assert(tableNode!.children.length === 3, "table children: caption + thead + tbody");
