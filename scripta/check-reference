// --- 8. the declared table interaction case (the consumer plan, D1) ------
// The table itself is STATELESS — it declares no behavior (D1 recorded in
// the reference.fab module header: a declared keyboard/sort interaction
// stays in the consumer plan). This case executes the CONSUMER's scripted
// row-navigation plan against the mounted table: ArrowDown/ArrowUp move
// focus to the next/previous row in the same column (keyed to the
// ref-table-* cell identities); an unmapped key is a silent no-op; the
// plan restores focus by identity (deterministic focus restoration,
// campaign §8). Synchronous-only, fail-closed.
const cellId = (r: number, c: number): string => `ref-table-services-cell-${r}-${c}`;
const tableRows = 3;
const navPlan = (focusedId: string, key: string): string => {
  const m = /^ref-table-services-cell-(\d+)-(\d+)$/.exec(focusedId);
  if (!m) return focusedId;
  const r = parseInt(m[1], 10);
  const c = parseInt(m[2], 10);
  if (key === "ArrowDown" && r + 1 < tableRows) return cellId(r + 1, c);
  if (key === "ArrowUp" && r - 1 >= 0) return cellId(r - 1, c);
  return focusedId; // off-grid / unmapped keys keep focus (the documented no-op)
};
const runPath = (startId: string, keys: string[]): string[] => {
  const visited: string[] = [startId];
  let cur = startId;
  for (const k of keys) { cur = navPlan(cur, k); visited.push(cur); }
  return visited;
};
const headerCell = byIdentity("ref-table-services-header-0");
assert(headerCell !== undefined && headerCell!.tagName === "th", "the header cell is a th (the navigation structure)");
const path = runPath(cellId(0, 0), ["ArrowDown", "ArrowDown", "ArrowDown", "ArrowUp", "End"]);
assert(path[0] === "ref-table-services-cell-0-0" && path[1] === "ref-table-services-cell-1-0" && path[2] === "ref-table-services-cell-2-0", "ArrowDown moves focus to the next row in the same column");
assert(path[3] === "ref-table-services-cell-2-0", "ArrowDown at the last row keeps focus (the documented boundary)");
assert(path[4] === "ref-table-services-cell-1-0", "ArrowUp moves focus to the previous row");
assert(path[5] === "ref-table-services-cell-1-0", "an unmapped key is a silent no-op (focus unchanged)");
for (const id of path) { assert(byIdentity(id) !== undefined, `navigation target present: ${id}`); }
// The plan restores focus by identity (the pre-navigation focused cell) —
// deterministic focus restoration, campaign §8.
doc.focusNode(byIdentity(path[path.length - 1])!);
assert(doc.activeElement === byIdentity("ref-table-services-cell-1-0"), "focus restoration targets the declared identity");

// --- 9. the segmented-control family mounts + the interaction case -------
// The Stage 3 control re-homed in the catalog (tela:reference, Stage 5
// U5). The a11y structure: role=radiogroup + the accessible name on the
// group; role=radio + aria-selected + the roving tabindex (ONE tab stop
// as a whole, §1.3) on the segments; the control-owned declared live
// region (role=status + aria-live=polite, §1.5). The behavior plan is
// APP-TYPED (D1): the canary's plan (Message/EventBinding/update_control/
// key_message/announcement/control_bindings/segment_order — emitted in
// this assembly) re-targets the ref-seg-* identities. Scripted sequence
// (the Stage 3 §5 shape): pointer select → announce once; pointer no-op →
// silent; arrows/Home/End → focus only (silent); Space/Enter → select +
// announce; focus restoration across a replace (the effects read through
// tela.effect_identity). Synchronous-only, fail-closed.
const segMarkup = tela.html_visus(segmented_composition()) ?? "";
plantRegion("#root", segMarkup);
const sm = mount_segmented("#root") as Mounted;
assert(sm !== null, "segmented mount returns a plan");
assert(sm.identities.length === 6, "segmented identities: wrapper + group + 3 segments + live region");
assert(sm.bindings.every((l) => l.status === "bind"), "hydration: every segmented identity binds");
const segGroup = byIdentity("ref-seg-control");
assert(segGroup !== undefined && segGroup.getAttribute("role") === "radiogroup", "the group is a radiogroup");
assert(segGroup!.getAttribute("aria-label") === "segmented control", "the group accessible name");
const segOne = byIdentity("ref-seg-control-1");
assert(segOne !== undefined && segOne!.getAttribute("role") === "radio", "a segment is a radio");
assert(segOne!.getAttribute("aria-selected") === "true", "the selected segment carries aria-selected=true");
assert(segOne!.getAttribute("tabindex") === "0", "the roving tabindex: the selected segment is the tab stop");
assert(byIdentity("ref-seg-control-2")!.getAttribute("tabindex") === "-1", "unselected segments are out of the tab sequence");
const segLive = byIdentity("ref-seg-live");
assert(segLive !== undefined && segLive!.getAttribute("role") === "status" && segLive!.getAttribute("aria-live") === "polite", "the control-owned declared live region");

// The app-typed plan (D1) + the scripted interaction sequence.
// The faber-web runtime's webDom* surface is typed against the DOM lib's
// Element (WebDomElement = Element); the harness's fake nodes are
// FakeElement — the harness boundary widens the node type (the DOM_NS
// snapshot binding already widens to any; same class of harness widening).
const toEl = (n: FakeElement): Element => n as unknown as Element;
let segModel = "ref-seg-control-1";
let segFocused = "ref-seg-control-1";
let segAnnouncements = 0;
const segProps = control_props();
let segSubs: WebDomSubscription[] = [];
const segClearSubs = (): void => {
  for (const s of segSubs) {
    webDomUnsubscribe(s);
  }
  segSubs = [];
};
const segMoveFocus = (identity: string): void => {
  segFocused = identity;
  for (const id of segment_order()) {
    const node = byIdentity(id);
    if (node !== undefined) {
      webDomAttrSet(toEl(node), "tabindex", id === identity ? "0" : "-1");
    }
  }
  const target = byIdentity(identity);
  assert(target !== undefined, `focus target present: ${identity}`);
  doc.focusNode(target!);
};
const segReplace = (): void => {
  const r = browser.replace(sm, reference.segmented_control(selected_props(segProps, segModel)));
  assert(r !== null, "replace returns the update result");
  const segUpdate: Update = r!;
  const nextMarkup = tela.html_visus(segUpdate.view) ?? "";
  plantRegion("#root", nextMarkup);
  // Execute the declarative effects after replacement (focus by identity).
  for (const e of segUpdate.effects) {
    const key = tela.effect_identity(e);
    const target = byIdentity(key);
    if (target !== undefined) {
      doc.focusNode(target);
    }
  }
  segAnnouncements += 1;
  const liveNow = byIdentity("ref-seg-live");
  assert(liveNow !== undefined, "live region present after replacement");
  webDomTextSet(toEl(liveNow!), announcement(segProps, segModel));
  // Re-attach the subscriptions to the fresh nodes (the app re-attaches).
  segClearSubs();
  segBind();
};
const segApply = (msg: Message): void => {
  const next = update_control(segModel, msg);
  if (next === segModel) {
    return; // silent no-op (the already-selected click) — §1.5
  }
  segModel = next;
  segReplace();
};
const segBind = (): void => {
  for (const v of control_bindings()) {
    const node = byIdentity(v.identity);
    assert(node !== undefined, `binding target present: ${v.identity}`);
    const handler = (): void => {
      segApply(v.message(tela.event_name(v.identity)));
    };
    segSubs.push(webDomOn(toEl(node!), v.event_name, handler));
  }
  for (const id of segment_order()) {
    const node = byIdentity(id);
    assert(node !== undefined, `keyboard target present: ${id}`);
    segSubs.push(webDomOnKeyboard(toEl(node!), "keydown", (state) => {
      const msg = key_message(segFocused, state.key as string);
      if (msg.tag === "Selected") {
        segApply(msg);
      } else {
        segMoveFocus(msg.identity);
      }
    }));
  }
