btnBind();

// 10a. click on the enabled save button: activates the message.
byIdentity("ref-button-save")!.dispatchEvent(new FakeEvent("click"));
assert(btnModel.presses === 1 && btnModel.last === "ref-button-save", "click activates the save button (the Pressed message fires)");
// 10b. Space on the focused save button: the native keyboard → click
