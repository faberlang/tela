const btnFocusKeys = btnUpdateFocus.effects.map((e) => tela.effect_identity(e));
assert(btnFocusKeys.length === 2 && btnFocusKeys[0] === "ref-button-cancel" && btnFocusKeys[1] === "#root", "effects are restore(ref-button-cancel) + anchor(#root)");
plantRegion("#root", tela.html_visus(btnUpdateFocus.view) ?? "");
for (const e of btnUpdateFocus.effects) {
  const key = tela.effect_identity(e);
  const target = byIdentity(key);
  if (target !== undefined) {
    doc.focusNode(target);
  }
}
assert(doc.activeElement?.dataTela === "ref-button-cancel", "focus restored to the pre-replacement identity");

