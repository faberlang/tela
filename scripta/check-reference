byIdentity("ref-button-save")!.dispatchEvent(new FakeEvent("keydown", { key: "Enter" }));
assert(btnModel.presses === 3 && btnModel.last === "ref-button-save", "Enter activates the focused button (native semantics)");
// 10d. the disabled button: click no-ops (no subscription — the plan
// binds only enabled buttons; the native disabled semantics).
byIdentity("ref-button-delete")!.dispatchEvent(new FakeEvent("click"));
assert(btnModel.presses === 3 && btnModel.last === "ref-button-save", "disabled click no-ops (the model is unchanged)");
// 10e. replace across the region: focus restoration by identity.
const btnFocus = browser.focus_held(btm, "ref-button-cancel");
const btnRestore = browser.replace(btnFocus, button_composition());
assert(btnRestore !== null, "focus-restoration replace returns the update result");
