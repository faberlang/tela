    btnSubs.push(webDomOn(toEl(node!), v.event_name, handler));
  }
  // The NATIVE keyboard contract: Space/Enter on a focused native button
  // fire a click (the host models the browser-native behavior — the plan
  // binds only the activation event). The disabled button is not in the
  // tab sequence and carries no keyboard target.
  for (const id of button_order()) {
    const node = byIdentity(id);
    assert(node !== undefined, `keyboard target present: ${id}`);
    btnSubs.push(webDomOnKeyboard(toEl(node!), "keydown", (state) => {
      const key = state.key as string;
      if (key === "Space" || key === "Enter") {
        node!.dispatchEvent(new FakeEvent("click"));
      }
    }));
