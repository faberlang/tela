segBind();

// 9a. pointer select on the unselected seg-2: select + announce once.
byIdentity("ref-seg-control-2")!.dispatchEvent(new FakeEvent("click"));
assert(segModel === "ref-seg-control-2", "pointer click selects seg-2");
assert(byIdentity("ref-seg-control-2")!.getAttribute("aria-selected") === "true", "seg-2 aria-selected flips true");
assert(byIdentity("ref-seg-control-1")!.getAttribute("aria-selected") === "false", "seg-1 aria-selected flips false");
assert(segAnnouncements === 1, "announcement fires once");
assert(byIdentity("ref-seg-live")!.textContent === "Two selected", "live region reads Two selected");
// 9b. click on the already-selected seg-2: silent no-op (§1.5).
byIdentity("ref-seg-control-2")!.dispatchEvent(new FakeEvent("click"));
assert(segModel === "ref-seg-control-2", "no-op click keeps the model");
assert(segAnnouncements === 1, "no announcement on the no-op (silent)");
assert(byIdentity("ref-seg-live")!.textContent === "Two selected", "live region unchanged");
// 9c. arrows: focus only, selection unchanged, silent.
segMoveFocus("ref-seg-control-2");
byIdentity("ref-seg-control-2")!.dispatchEvent(new FakeEvent("keydown", { key: "ArrowRight" }));
assert(doc.activeElement?.dataTela === "ref-seg-control-3", "ArrowRight moves focus to seg-3");
assert(segModel === "ref-seg-control-2", "selection unchanged after ArrowRight");
assert(segAnnouncements === 1, "arrow move is silent");
segMoveFocus("ref-seg-control-1");
byIdentity("ref-seg-control-1")!.dispatchEvent(new FakeEvent("keydown", { key: "ArrowLeft" }));
assert(doc.activeElement?.dataTela === "ref-seg-control-3", "ArrowLeft from seg-1 wraps to the last segment");
assert(segModel === "ref-seg-control-2", "selection unchanged after the wrap");
// 9d. Home/End: focus only.
segMoveFocus("ref-seg-control-3");
byIdentity("ref-seg-control-3")!.dispatchEvent(new FakeEvent("keydown", { key: "Home" }));
assert(doc.activeElement?.dataTela === "ref-seg-control-1", "Home moves focus to the first segment");
assert(segModel === "ref-seg-control-2", "selection unchanged after Home");
byIdentity("ref-seg-control-1")!.dispatchEvent(new FakeEvent("keydown", { key: "End" }));
assert(doc.activeElement?.dataTela === "ref-seg-control-3", "End moves focus to the last segment");
assert(segModel === "ref-seg-control-2", "selection unchanged after End");
assert(segAnnouncements === 1, "Home/End are silent");
// 9e. Space on the focused seg-1: select + announce.
segMoveFocus("ref-seg-control-1");
byIdentity("ref-seg-control-1")!.dispatchEvent(new FakeEvent("keydown", { key: "Space" }));
assert(segModel === "ref-seg-control-1", "Space selects the focused seg-1");
assert(segAnnouncements === 2, "second announcement");
assert(byIdentity("ref-seg-live")!.textContent === "One selected", "live region reads One selected");
// 9f. Enter on the focused seg-3: select + announce.
segMoveFocus("ref-seg-control-3");
byIdentity("ref-seg-control-3")!.dispatchEvent(new FakeEvent("keydown", { key: "Enter" }));
assert(segModel === "ref-seg-control-3", "Enter selects the focused seg-3");
assert(segAnnouncements === 3, "third announcement");
assert(byIdentity("ref-seg-live")!.textContent === "Three selected", "live region reads Three selected");
// 9g. replace across the region: focus restoration by identity.
const segFocus = browser.focus_held(sm, "ref-seg-control-2");
const segRestore = browser.replace(segFocus, reference.segmented_control(selected_props(segProps, "ref-seg-control-2")));
assert(segRestore !== null, "focus-restoration replace returns the update result");
const segUpdateFocus: Update = segRestore!;
const segFocusKeys = segUpdateFocus.effects.map((e) => tela.effect_identity(e));
assert(segFocusKeys.length === 2 && segFocusKeys[0] === "ref-seg-control-2" && segFocusKeys[1] === "#root", "effects are restore(seg-2) + anchor(#root)");
plantRegion("#root", tela.html_visus(segUpdateFocus.view) ?? "");
for (const e of segUpdateFocus.effects) {
  const key = tela.effect_identity(e);
  const target = byIdentity(key);
  if (target !== undefined) {
    doc.focusNode(target);
  }
}
assert(doc.activeElement?.dataTela === "ref-seg-control-2", "focus restored to the pre-replacement identity");

// --- 10. the button family mounts + the scripted interaction case --------
// The FIRST catalog behavior component (tela:reference, Stage 5 U6). The
// a11y structure: NATIVE <button> semantics (no ARIA role — no
// duplication), the accessible name (the label text / the aria-label
// override), the native keyboard contract (Space/Enter activate — the
// host models the browser-native key → click; the plan binds only the
// activation event), the visible focus (the bundle's :focus-visible
// rule), the native disabled attribute (no activation, the state
// exposed). The behavior plan is APP-TYPED (D1): the canary's plan
// (ButtonMessage/ButtonBinding/ButtonState/update_button/
// button_bindings/button_order — emitted in this assembly) binds ONLY
// the enabled buttons' declared activation event. Scripted sequence:
// click activates the message; Space/Enter activate (the native
// semantics); the disabled click no-ops; focus restores across a replace
// (the effects read through tela.effect_identity). Synchronous-only,
// fail-closed.
const buttonMarkup = tela.html_visus(button_composition()) ?? "";
plantRegion("#root", buttonMarkup);
const btm = mount_button("#root") as Mounted;
assert(btm !== null, "button mount returns a plan");
assert(btm.identities.length === 4, "button identities: wrapper + save + cancel + delete");
assert(btm.bindings.every((l) => l.status === "bind"), "hydration: every button identity binds");
const saveBtn = byIdentity("ref-button-save");
assert(saveBtn !== undefined && saveBtn!.tagName === "button", "the button is a native button element (native semantics)");
assert(saveBtn!.getAttribute("role") === null, "no ARIA role (native button semantics — no duplication)");
assert(saveBtn!.textContent === "Save", "the accessible name is the label text (native)");
assert(saveBtn!.getAttribute("aria-label") === null, "no aria-label when the label IS the name");
assert(saveBtn!.getAttribute("data-ref-variant") === "primary", "the primary variant treatment is declared");
const cancelBtn = byIdentity("ref-button-cancel");
assert(cancelBtn !== undefined && cancelBtn!.getAttribute("data-ref-variant") === "secondary", "the secondary variant treatment is declared");
const deleteBtn = byIdentity("ref-button-delete");
assert(deleteBtn !== undefined && deleteBtn!.getAttribute("disabled") !== null, "the disabled button carries the native disabled attribute (no activation, state exposed)");
assert(deleteBtn!.getAttribute("aria-label") === "Delete permanently", "the aria-label override supplies the accessible name");
assert(deleteBtn!.textContent === "Delete", "the disabled button label is present");

// The app-typed plan (D1) + the scripted interaction sequence.
let btnModel = button_state(0, "");
let btnSubs: WebDomSubscription[] = [];
const btnClearSubs = (): void => {
  for (const s of btnSubs) {
    webDomUnsubscribe(s);
  }
  btnSubs = [];
};
const btnApply = (msg: ButtonMessage): void => {
  btnModel = update_button(btnModel, msg);
};
const btnBind = (): void => {
  for (const v of button_bindings()) {
    const node = byIdentity(v.identity);
    assert(node !== undefined, `binding target present: ${v.identity}`);
    const handler = (): void => {
      btnApply(v.message(tela.event_name(v.identity)));
