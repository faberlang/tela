#!/usr/bin/env bash
# tela/scripta/check-reference — the Stage 5 U2/U3/U4/U5/U6/U7/U8 browser-proof
# gate for the reference catalog (tela:reference — the layout + typography
# families, U2; the panel + badge + metric families, U3; the table family,
# U4; the segmented-control family, U5; the button family, U6; the field
# family, U7 + the field BEHAVIOR case, U8).
#
# The Stage 4 interactive-seam mechanics (the check-forms-interactive
# pattern): assembles the canary-app's REAL-IMPORT composition (web:dom
# en→la + tela:browser + tela:reference + formslib + extensionlib — all
# through the NORMAL package interface) and executes the mount +
# structure/a11y proof against the DOCUMENTED faber-web host binding — the
# ACTUAL route:
#
#   web:dom import → the generated provider reference (the emitted faber-web
#   web:dom module — the bare Scope/Nodus types) → the bindings/ts.toml
#   mapping (web:dom.snapshot → webDomSnapshot, …) → the runtime/dom.ts
#   implementation (faber-web's ACTUAL runtime source, included verbatim,
#   export keywords stripped).
#
# Each family mounts through tela.browser.mount (the app's own seam fns
# mount_layout / mount_typography — dom.scope + browser.mount) against the
# host binding; the structure/a11y asserts hold (node exit 0, fail-closed,
# synchronous-only — the routed async-gap boundary). The U4 table case also
# executes the DECLARED consumer-plan interaction case: the table is
# stateless (D1 — a declared keyboard/sort interaction stays in the
# consumer plan), so the host driver runs the consumer's scripted
# row-navigation plan (ArrowDown/ArrowUp focus movement across the
# ref-table-* cell identities + deterministic focus restoration),
# fail-closed. A third case mounts a composition that REUSES the static
# ref-typography-prose identity and asserts the documented
# duplicate-identity diagnosis (never a silent bind, identity-hydration.md
# §6).
#
# Stage 5 U5: the segmented-control case mounts the RE-HOMED catalog
# control (ref-seg-* identities) through the app's seam fn (mount_segmented)
# and executes the SCRIPTED INTERACTION case (the Stage 3 §5 sequence
# shape): pointer select → announce once, pointer no-op → silent (the §1.5
# no-op rule), arrows/Home/End → focus only (silent), Space/Enter →
# select + announce, focus restoration across a replace (the effects read
# through tela.effect_identity). The behavior plan is the canary's
# APP-TYPED plan (D1 — re-targeted to the ref-seg-* identities, emitted in
# this assembly). Note: the canary-app imports tela:reference under the
# alias `reference` (the `ref` alias is a reserved en keyword (the `de`
# keyword's EN spelling) — qualified TYPE references under it fail
# PARSE001; the alias const `reference` aliases the REF_NS binding).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SCRATCH="$(mktemp -d "${TMPDIR:-/tmp}/tela-u2-reference.XXXXXX")"
trap 'rm -rf "$SCRATCH"' EXIT

if [[ -n "${RADIX_ROOT:-}" ]]; then
  RADIX="$RADIX_ROOT"
elif [[ -d "$ROOT/../radix/crates/radix" ]]; then
  RADIX="$ROOT/../radix"
else
  RADIX="$ROOT/../../../radix"
fi

if [[ ! -d "$RADIX/crates/radix" ]]; then
  echo "check-reference: missing radix checkout at $RADIX" >&2
  exit 1
fi

RADIX_BIN="$RADIX/target/debug/radix"
if [[ ! -x "$RADIX_BIN" ]]; then
  (cd "$RADIX" && cargo build -q -p radix --bin radix)
fi

export FABER_LIBRARY_HOME="$ROOT/proof/benchmark/libhome"

echo "check-reference: radix check the real-import composition (benchmark libhome)"
"$RADIX_BIN" check --locale en "$ROOT/proof/benchmark/canary-app/src/main.fab"
"$RADIX_BIN" check --locale en "$ROOT/src/reference.fab"

echo "check-reference: TS emit valida / tela / dom / browser / extension / forms / reference / main"
"$RADIX_BIN" emit -t ts --locale en "$ROOT/src/validate.fab" -o "$SCRATCH/valida.ts" >/dev/null
"$RADIX_BIN" emit -t ts --locale en "$ROOT/src/tela.fab" -o "$SCRATCH/tela.ts" >/dev/null
"$RADIX_BIN" emit -t ts --locale en "$ROOT/src/browser.fab" -o "$SCRATCH/browser.ts" >/dev/null
"$RADIX_BIN" emit -t ts --locale en "$ROOT/proof/benchmark/extension-lib/src/extension.fab" -o "$SCRATCH/extension.ts" >/dev/null
"$RADIX_BIN" emit -t ts --locale en "$ROOT/proof/extension-forms/src/forms.fab" -o "$SCRATCH/forms.ts" >/dev/null
"$RADIX_BIN" emit -t ts --locale en "$ROOT/src/reference.fab" -o "$SCRATCH/reference.ts" >/dev/null
"$RADIX_BIN" emit -t ts --locale en "$ROOT/proof/benchmark/canary-app/src/main.fab" -o "$SCRATCH/main.ts" >/dev/null
# Stage 5 U9: the AUTHORED fake DOM (Faber source -> the emitted module).
"$RADIX_BIN" emit -t ts --locale en "$ROOT/scripta/harness_dom.fab" -o "$SCRATCH/harness_dom.ts" >/dev/null
# The generated provider reference: the emitted web:dom module (the bare
# Scope/Nodus/… type declarations — the la locale emit is the package's own
# reader).
"$RADIX_BIN" emit -t ts --locale la "$ROOT/../faber-web/src/dom.fab" -o "$SCRATCH/dom.ts" >/dev/null

strip() { sed '1,2d' "$1" | grep -v '^import .* from "'; }
# The emitted harness_dom module is self-contained (no imports) and emits
# NO FaberDisplay preamble (the authored surface uses no display helpers);
# plain header strip is the whole strip.
strip_hdom() { sed '1,2d' "$1"; }
# The emitted web:dom provider module's preamble (FaberDisplayHint + the
# __faberDisplay helpers) and its `Element` genus are renamed so they do not
# collide with the tela module's own preamble / the DOM lib's `Element`.
strip_dom() { sed '1,2d' "$1" | grep -v '^import .* from "' | sed -e 's/\bFaberResult\b/FaberResultDom/g' -e 's/\bFaberDisplayHint\b/FaberDisplayHintDom/g' -e 's/\b__faberDisplayFractus\b/__faberDisplayDomFractus/g' -e 's/\b__faberDisplayList\b/__faberDisplayDomList/g' -e 's/\b__faberDisplayTensor\b/__faberDisplayDomTensor/g' -e 's/\b__faberDisplaySparsa\b/__faberDisplayDomSparsa/g' -e 's/\b__faberDisplayMap\b/__faberDisplayDomMap/g' -e 's/\b__faberDisplayValor\b/__faberDisplayDomValor/g' -e 's/\b__faberDisplayTaggedValor\b/__faberDisplayDomTaggedValor/g' -e 's/\b__faberDisplay\b/__faberDisplayDom/g' -e 's/\bElement\b/DomElement/g'; }
# The host runtime: faber-web's ACTUAL runtime/dom.ts implementation,
# included verbatim (export keywords stripped). tsc type-checks it here
# against the DOM lib (its own source typing); node runs it against the
# installed fake DOM.
strip_runtime() { sed 's/^export //' "$1"; }

VALIDA_NS="const validate = { valid_space, valid_tag_name, valid_attribute_name, valid_name_in_space, valid_void_html, valid_void_structure };"
TELA_NS="const tela = { html_visus, css, theme_css, theme_style, theme, token, core_tokens, token_property_name, token_name_valid, theme_has_core_tokens, theme_has_token, assemble, bundle, order, deduplicated_bundles, topological_order, style_valid, unclean_style_text, bundle_for, in_list, dependencies_met, text_view, fragment_view, new_identity, html_space, svg_space, element_view, element_full, event_name, restore, direct, anchor, update, effect_identity, Attribute, Property, Identity, Declaration, Rule, Style, Token, Theme, Bundle, Order, EventName, Update };"
BROWSER_NS="const browser = { region_root, event_subscription, binding, parse_identities, element_tag, count_occurrences, duplicate_identities, tag_name, tag_at, identities_from_nodes, tags_from_nodes, binding_status, hydration_diagnostics, mount, replace, dispose, focus_held, focus_target };"
EXT_NS="const ext = { chart_axis_muted, chart_axis_muted_dark, chart_grid_muted, chart_grid_muted_dark, chart_tokens, chart_tokens_dark, bar_meter, chart_style };"
FORMS_NS="const forms = { field_props, checkbox_props, select_props, field, checkbox, select, error_region, form_live_region, field_group, form_field_invalid, form_field_valid, form_focus, form_tokens, form_style, field_event, change_event, submit_event, click_event, invalid_state, error_present };"
# The reference catalog namespace (every tela:reference export — the
# layout + typography families (U2), the panel + badge + metric families
# (U3), the table family (U4), the segmented-control family (U5), the
# button family (U6), the bundles, the ref.* token accessors).
REF_NS="const ref = { layout_stack, layout_grid, layout_prose, stack_props, grid_props, layout_prose_props, typography_heading, typography_prose, typography_emphasis, typography_scale, heading_props, prose_props, emphasis_props, scale_props, clamped_level, layout_style, typography_style, panel, badge, metric, panel_props, badge_props, metric_props, panel_style, badge_style, metric_style, table, table_row, table_props, table_style, segmented_control, segmented_props, segmented_option, segmented_options, segmented_live_region, selected_text, active_tabindex, segmented_style, button, button_props, button_event, button_style, field_input, field_input_props, field_invalid, field_error_region, field_live_region, field_control, field_style, field_input_event, field_error_for_value, field_announcement, ref_layout_gap, ref_layout_prose_measure, ref_type_scale_xs, ref_type_scale_sm, ref_type_scale_md, ref_type_scale_lg, ref_type_scale_xl, ref_type_heading_weight, ref_type_heading_margin, ref_type_prose_line_height, ref_type_prose_margin, ref_panel_surface, ref_panel_border, ref_panel_radius, ref_panel_padding, ref_badge_size, ref_badge_padding, ref_badge_radius, ref_metric_label_size, ref_metric_label_muted, ref_metric_value_size, ref_metric_value_weight, ref_table_border, ref_table_padding, ref_table_header_weight, ref_table_caption_muted, ref_seg_gap, ref_seg_radius, ref_seg_size, ref_seg_padding, ref_seg_border, ref_seg_selected_border, ref_button_size, ref_button_padding, ref_button_radius, ref_button_border, ref_button_text, ref_button_primary_background, ref_button_primary_text, ref_button_secondary_background, ref_button_ghost_background, ref_button_focus, ref_button_disabled_opacity, field_invalid_token, field_valid_token, field_focus_token, reference_tokens, StackProps, GridProps, LayoutProseProps, HeadingProps, ProseProps, EmphasisProps, ScaleProps, PanelProps, BadgeProps, MetricProps, TableProps, TableRow, SegmentedProps, ButtonProps, FieldInputProps };"
# Stage 5 U5: the canary-app imports tela:reference under the alias
# `reference` (the `ref` alias is a reserved en keyword (the `de` keyword's
# EN spelling) — qualified TYPE references under it fail PARSE001; the
# module is the same, so the emitted `reference.*` calls bind through this
# alias const).
REF_ALIAS="const reference = ref;"
# The table namespace additions: the table family's exported fns
# (table/table_row/table_props/table_style + the TableProps/TableRow
# prop classes) and the ref.table.* token accessors.
# The DOM_NS: the ACTUAL bindings/ts.toml mapping (web:dom.<fn> →
# webDom<Fn>) over faber-web's runtime/dom.ts implementation. The snapshot
# binding is widened at the harness boundary (the emitted Scope type carries
# only `selector`; the runtime scope also carries `root`).
DOM_NS="const dom = { scope: webDomScope, query: webDomQuery, require: webDomRequire, all: webDomAll, snapshot: ((scope: any): Array<Nodus> | null => webDomSnapshot(scope)), text_set: webDomTextSet, attr_set: webDomAttrSet, attr_remove: webDomAttrRemove, class_add: webDomClassAdd, class_remove: webDomClassRemove, class_toggle: webDomClassToggle, on: webDomOn, unsubscribe: webDomUnsubscribe, value: webDomValue, value_set: webDomValueSet, on_input: webDomOnInput, on_submit: webDomOnSubmit, on_frame: webDomOnFrame, on_resize: webDomOnResize, on_keyboard: webDomOnKeyboard, on_pointer: webDomOnPointer, on_focus: webDomOnFocus, pointer_lock_state: webDomPointerLockState, request_pointer_lock: webDomRequestPointerLock, exit_pointer_lock: webDomExitPointerLock, on_pointer_lock: webDomOnPointerLock, prevent_default: webDomPreventDefault, fetch_text: webDomFetchText };"

cat > "$SCRATCH/host-driver.ts" <<'HOST_DRIVER'
// ---- node host environment (Stage 5 U9: the AUTHORED fake DOM) ---------
// The fake DOM is Faber source (scripta/harness_dom.fab emitted to TS) —
// the embedded fake-DOM classes are REMOVED at U9. The driver rides the
// emitted function surface (web_dom_*, element_*, doc_*, fake_event_*,
// execute_mount_plan). The faber-web runtime/dom.ts (assembled verbatim
// above, TS by contract) calls the METHOD bridge on the fake nodes — the
// authored genus methods (querySelector/querySelectorAll/getAttribute) +
// the tagName field satisfy it. The global installation stays at the
// driver boundary.
const installFakeDom = (): FakeDocument => {
  const doc = fake_document();
  const root = fake_element("div");
  element_attr_set(root, "id", "root");
  element_append_child(doc.body, root);
  globalThis.document = doc as unknown as Document;
  globalThis.window = { addEventListener() {}, removeEventListener() {}, innerWidth: 800, innerHeight: 600, devicePixelRatio: 1 } as unknown as Window & typeof globalThis;
  globalThis.requestAnimationFrame = (cb: (t: number) => void) => setTimeout(() => cb(Date.now()), 16);
  globalThis.cancelAnimationFrame = (id: unknown) => clearTimeout(id as any);
  globalThis.fetch = () => Promise.reject(new Error("no fetch in the reference gate"));
  return doc;
};

// ---- scripted mount + structure/a11y driver (the check-reference gate) ---
const assert = (cond: boolean, msg: string): void => { if (!cond) throw new Error(`check-reference assert failed: ${msg}`); };
const doc = installFakeDom();
const identityNodes = (): FakeElement[] => doc_query_all(doc, "[data-tela]");
const byIdentity = (id: string): FakeElement | undefined => identityNodes().find((n) => n.data_tela === id);
const plantRegion = (selector: string, markup: string): void => {
  const region = doc_query_selector(doc, selector)!;
  element_clear_children(region);
  for (const node of parse_fragment(markup)) element_append_child(region, node);
};
const textOf = (id: string): string => {
  const n = byIdentity(id);
  return n === undefined ? "" : element_text(n);
};

// --- 1. the layout family mounts through tela.browser.mount --------------
// Hydration: the region is pre-rendered with the SAME composition — the
// typed snapshot read (webDomSnapshot) makes every matching identity bind.
const layoutMarkup = tela.html_visus(layout_composition()) ?? "";
plantRegion("#root", layoutMarkup);
const lm = mount_layout("#root") as Mounted;
assert(lm !== null, "layout mount returns a plan");
assert(lm.identities.length === 5, "layout identities: wrapper + stack + grid + prose + paragraph");
assert(lm.bindings.every((l) => l.status === "bind"), "hydration: every layout identity binds (the dom.snapshot read)");
// The semantic containers + the structure (campaign §8 — the documented
// layout structure): the stack carries the rows' text, the grid carries
// the columns' text (text views serialize as one contiguous text run — no
// wrappers), the prose measure wraps a paragraph.
assert(byIdentity("ref-layout-stack") !== undefined, "stack container present");
assert(textOf("ref-layout-stack") === "row onerow two", "stack carries the two rows' text");
assert(byIdentity("ref-layout-grid") !== undefined, "grid container present");
assert(textOf("ref-layout-grid") === "column onecolumn two", "grid carries the two columns' text");
assert(byIdentity("ref-layout-prose") !== undefined, "prose measure present");
assert(byIdentity("ref-layout-prose")!.children.length === 1 && byIdentity("ref-layout-prose")!.children[0].tagName === "p", "prose measure wraps a paragraph (prose semantics)");

// --- 2. the typography family mounts + the a11y structure holds ----------
const typographyMarkup = tela.html_visus(typography_composition()) ?? "";
plantRegion("#root", typographyMarkup);
const tm = mount_typography("#root") as Mounted;
assert(tm !== null, "typography mount returns a plan");
assert(tm.identities.length === 7, "typography identities: wrapper + h1 + h2 + prose + strong + lg + xs");
assert(tm.bindings.every((l) => l.status === "bind"), "hydration: every typography identity binds");
// The heading hierarchy: the rank is the native tag (h1/h2 — screen
// readers expose the hierarchy; never color-only communication).
assert(byIdentity("ref-typography-heading-1")?.tagName === "h1", "heading-1 is a native h1 (hierarchy)");
assert(byIdentity("ref-typography-heading-2")?.tagName === "h2", "heading-2 is a native h2 (hierarchy)");
// Prose semantics.
assert(byIdentity("ref-typography-prose")?.tagName === "p", "prose is a native p");
// Semantic emphasis — never color-only communication: the meaning rides
// the semantic strong tag; no color/state-carrying attribute exists.
const strong = byIdentity("ref-typography-emphasis-strong");
assert(strong !== undefined && strong.tagName === "strong", "emphasis is a semantic strong");
assert(element_text(strong!) === "emphasis", "emphasis text present");
assert(element_attr_get(strong!, "style") === null && element_attr_get(strong!, "class") === null, "emphasis carries no style/class (the meaning is the markup)");
// The type scale: decorative sizing spans at the documented steps.
assert(byIdentity("ref-typography-scale-lg")?.tagName === "span", "scale-lg is a span");
assert(byIdentity("ref-typography-scale-xs")?.tagName === "span", "scale-xs is a span");

// --- 3. the duplicate-identity policy on a reused catalog component ------
// The static ref-typography-prose identity reused twice is DIAGNOSED (the
// browser lifecycle's ambiguity policy, identity-hydration.md §6) — never
// a silent bind: the binding status for the duplicated identity is
// "create".
const dupMarkup = tela.html_visus(duplicate_prose_composition()) ?? "";
plantRegion("#root", dupMarkup);
const dm = browser.mount(web_dom_scope(doc, "#root"), duplicate_prose_composition(), reference_theme()) as Mounted;
assert(dm !== null, "duplicate case: mount returns a plan");
assert(dm.diagnostics.includes("duplicate:ref-typography-prose"), "reuse of the static identity is diagnosed (never a silent bind)");
const dupBinding = dm.bindings.find((b) => b.identity === "ref-typography-prose");
assert(dupBinding !== undefined && dupBinding.status === "create", "the duplicated identity creates (never silently binds)");

// --- 4. the panel family mounts + the region-landmark structure ----------
// Theme-surface semantics: the panel is a region landmark with an
// accessible name (aria-label); the surface color comes from the tokens
// (never a hardcoded color in the rendered bytes).
const panelMarkup = tela.html_visus(panel_composition()) ?? "";
plantRegion("#root", panelMarkup);
const pm = mount_panel("#root") as Mounted;
assert(pm !== null, "panel mount returns a plan");
assert(pm.identities.length === 3, "panel identities: wrapper + panel + prose paragraph");
assert(pm.bindings.every((l) => l.status === "bind"), "hydration: every panel identity binds");
const panelNode = byIdentity("ref-panel-status");
assert(panelNode !== undefined && element_attr_get(panelNode, "role") === "region", "panel is a region landmark");
assert(element_attr_get(panelNode!, "aria-label") === "Status panel", "panel accessible name (aria-label)");
// No hardcoded color in the panel bytes: the surface is a var() reference
// to the --ref-panel-surface token (theme-surface semantics).
assert(element_attr_get(panelNode!, "style") === null, "panel carries no inline style (the surface rides the tokens)");
assert(textOf("ref-typography-prose") === "all systems operational", "panel content (prose) present");

// --- 5. the badge family mounts + the textual-status structure -----------
// A badge's meaning is TEXTUAL: role=status + aria-label carries the
// status word + the label; no color-only communication.
const badgeMarkup = tela.html_visus(badge_composition()) ?? "";
plantRegion("#root", badgeMarkup);
const bm = mount_badge("#root") as Mounted;
assert(bm !== null, "badge mount returns a plan");
assert(bm.identities.length === 3, "badge identities: wrapper + two badges");
assert(bm.bindings.every((l) => l.status === "bind"), "hydration: every badge identity binds");
const badgeNew = byIdentity("ref-badge-new");
assert(badgeNew !== undefined && element_attr_get(badgeNew, "role") === "status", "badge carries role=status");
assert(element_attr_get(badgeNew!, "aria-label") === "New: 3 messages", "badge accessible name carries the status word + the label (meaning never color alone)");
assert(element_text(badgeNew!) === "3 messages", "badge visible label present");
const badgeOk = byIdentity("ref-badge-ok");
assert(badgeOk !== undefined && element_attr_get(badgeOk!, "aria-label") === "Ok: all checks passed", "second badge accessible name");

// --- 6. the metric family mounts + the definition-list structure ---------
// The benchmark grammar's dl/dt/dd pattern: label + value (+ optional
// delta) — the textual form preserved.
const metricMarkup = tela.html_visus(metric_composition()) ?? "";
plantRegion("#root", metricMarkup);
const mm = mount_metric("#root") as Mounted;
assert(mm !== null, "metric mount returns a plan");
assert(mm.identities.length === 4, "metric identities: wrapper + three metrics");
assert(mm.bindings.every((l) => l.status === "bind"), "hydration: every metric identity binds");
const metricUptime = byIdentity("ref-metric-uptime");
assert(metricUptime !== undefined && metricUptime!.tagName === "dl", "metric is a dl (the definition-list pattern)");
assert(metricUptime!.children.length === 2, "metric uptime: label + value rows only (no delta)");
assert(metricUptime!.children[0].tagName === "dt" && element_text(metricUptime!.children[0]) === "uptime", "metric dt = the label");
assert(metricUptime!.children[1].tagName === "dd" && element_text(metricUptime!.children[1]) === "99.9%", "metric dd = the value");
const metricRequests = byIdentity("ref-metric-requests");
assert(metricRequests !== undefined && metricRequests!.children.length === 3, "metric requests: label + value + delta rows");
assert(metricRequests!.children[2].tagName === "dd" && element_text(metricRequests!.children[2]) === "+3.1%", "the optional delta row is a dd");
assert(element_attr_get(metricUptime!, "style") === null, "metric carries no inline style (the typography rides the tokens)");

// --- 7. the table family mounts + the semantic/a11y structure -----------
// The native <table>/<caption>/<thead>/<th scope='col'>/<tbody>/<tr>/<td>
// markup IS the a11y structure (screen readers expose the grid natively —
// no ARIA duplication); the header association rides th[scope]; the
// caption provides the accessible name.
const tableMarkup = tela.html_visus(table_composition()) ?? "";
plantRegion("#root", tableMarkup);
const tb = mount_table("#root") as Mounted;
assert(tb !== null, "table mount returns a plan");
assert(tb.identities.length === 10, "table identities: wrapper + table + 2 header cells + 6 body cells");
assert(tb.bindings.every((l) => l.status === "bind"), "hydration: every table identity binds");
const tableNode = byIdentity("ref-table-services");
assert(tableNode !== undefined && tableNode!.tagName === "table", "table root is a native table");
assert(tableNode!.children.length === 3, "table children: caption + thead + tbody");
assert(tableNode!.children[0].tagName === "caption" && element_text(tableNode!.children[0]) === "Services", "caption is the first child (the accessible name)");
const tableHead = tableNode!.children[1];
assert(tableHead.tagName === "thead", "thead follows the caption");
const tableHeaderRow = tableHead.children[0];
assert(tableHeaderRow.tagName === "tr" && tableHeaderRow.children.length === 2, "thead carries a header row of two cells");
assert(tableHeaderRow.children[0].tagName === "th" && element_attr_get(tableHeaderRow.children[0], "scope") === "col", "header cell is a th with scope='col' (the column association)");
assert(element_text(tableHeaderRow.children[0]) === "Service", "first header cell text");
assert(tableHeaderRow.children[1].tagName === "th" && element_attr_get(tableHeaderRow.children[1], "scope") === "col", "second header cell scope");
const tableBody = tableNode!.children[2];
assert(tableBody.tagName === "tbody", "tbody follows thead");
assert(tableBody.children.length === 3, "three body rows");
assert(tableBody.children[0].tagName === "tr" && tableBody.children[0].children.length === 2, "body row of two td cells");
assert(tableBody.children[0].children[0].tagName === "td" && element_text(tableBody.children[0].children[0]) === "gateway", "body cell is a td with the cell text");
assert(element_attr_get(tableNode!, "style") === null, "table carries no inline style (the borders ride the tokens)");

// --- 8. the declared table interaction case (the consumer plan, D1) ------
// The table itself is STATELESS — it declares no behavior (D1 recorded in
// the reference.fab module header: a declared keyboard/sort interaction
// stays in the consumer plan). This case executes the CONSUMER's scripted
// row-navigation plan against the mounted table: ArrowDown/ArrowUp move
// focus to the next/previous row in the same column (keyed to the
// ref-table-* cell identities); an unmapped key is a silent no-op; the
// plan restores focus by identity (deterministic focus restoration,
// campaign §8). Synchronous-only, fail-closed.
const cellId = (r: number, c: number): string => `ref-table-services-cell-${r}-${c}`;
const tableRows = 3;
const navPlan = (focusedId: string, key: string): string => {
  const m = /^ref-table-services-cell-(\d+)-(\d+)$/.exec(focusedId);
  if (!m) return focusedId;
  const r = parseInt(m[1], 10);
  const c = parseInt(m[2], 10);
  if (key === "ArrowDown" && r + 1 < tableRows) return cellId(r + 1, c);
  if (key === "ArrowUp" && r - 1 >= 0) return cellId(r - 1, c);
  return focusedId; // off-grid / unmapped keys keep focus (the documented no-op)
};
const runPath = (startId: string, keys: string[]): string[] => {
  const visited: string[] = [startId];
  let cur = startId;
  for (const k of keys) { cur = navPlan(cur, k); visited.push(cur); }
  return visited;
};
const headerCell = byIdentity("ref-table-services-header-0");
assert(headerCell !== undefined && headerCell!.tagName === "th", "the header cell is a th (the navigation structure)");
