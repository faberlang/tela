#!/usr/bin/env bash
# tela/scripta/check-reference — the Stage 5 U2/U3/U4/U5/U6 browser-proof
# gate for the reference catalog (tela:reference — the layout + typography
# families, U2; the panel + badge + metric families, U3; the table family,
# U4; the segmented-control family, U5; the button family, U6).
#
# The Stage 4 interactive-seam mechanics (the check-forms-interactive
# pattern): assembles the canary-app's REAL-IMPORT composition (web:dom
# en→la + tela:browser + tela:reference + formslib + extensionlib — all
# through the NORMAL package interface) and executes the mount +
# structure/a11y proof against the DOCUMENTED faber-web host binding — the
# ACTUAL route:
#
#   web:dom import → the generated provider reference (the emitted faber-web
#   web:dom module — the bare Scope/Nodus types) → the bindings/ts.toml
#   mapping (web:dom.snapshot → webDomSnapshot, …) → the runtime/dom.ts
#   implementation (faber-web's ACTUAL runtime source, included verbatim,
#   export keywords stripped).
#
# Each family mounts through tela.browser.mount (the app's own seam fns
# mount_layout / mount_typography — dom.scope + browser.mount) against the
# host binding; the structure/a11y asserts hold (node exit 0, fail-closed,
# synchronous-only — the routed async-gap boundary). The U4 table case also
# executes the DECLARED consumer-plan interaction case: the table is
# stateless (D1 — a declared keyboard/sort interaction stays in the
# consumer plan), so the host driver runs the consumer's scripted
# row-navigation plan (ArrowDown/ArrowUp focus movement across the
# ref-table-* cell identities + deterministic focus restoration),
# fail-closed. A third case mounts a composition that REUSES the static
# ref-typography-prose identity and asserts the documented
# duplicate-identity diagnosis (never a silent bind, identity-hydration.md
# §6).
#
# Stage 5 U5: the segmented-control case mounts the RE-HOMED catalog
# control (ref-seg-* identities) through the app's seam fn (mount_segmented)
# and executes the SCRIPTED INTERACTION case (the Stage 3 §5 sequence
# shape): pointer select → announce once, pointer no-op → silent (the §1.5
# no-op rule), arrows/Home/End → focus only (silent), Space/Enter →
# select + announce, focus restoration across a replace (the effects read
# through tela.effect_identity). The behavior plan is the canary's
# APP-TYPED plan (D1 — re-targeted to the ref-seg-* identities, emitted in
# this assembly). Note: the canary-app imports tela:reference under the
# alias `reference` (the `ref` alias is a reserved en keyword (the `de`
# keyword's EN spelling) — qualified TYPE references under it fail
# PARSE001; the alias const `reference` aliases the REF_NS binding).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SCRATCH="$(mktemp -d "${TMPDIR:-/tmp}/tela-u2-reference.XXXXXX")"
trap 'rm -rf "$SCRATCH"' EXIT

if [[ -n "${RADIX_ROOT:-}" ]]; then
  RADIX="$RADIX_ROOT"
elif [[ -d "$ROOT/../radix/crates/radix" ]]; then
  RADIX="$ROOT/../radix"
else
  RADIX="$ROOT/../../../radix"
fi

if [[ ! -d "$RADIX/crates/radix" ]]; then
  echo "check-reference: missing radix checkout at $RADIX" >&2
  exit 1
fi

RADIX_BIN="$RADIX/target/debug/radix"
if [[ ! -x "$RADIX_BIN" ]]; then
  (cd "$RADIX" && cargo build -q -p radix --bin radix)
fi

export FABER_LIBRARY_HOME="$ROOT/proof/benchmark/libhome"

echo "check-reference: radix check the real-import composition (benchmark libhome)"
"$RADIX_BIN" check --locale en "$ROOT/proof/benchmark/canary-app/src/main.fab"
"$RADIX_BIN" check --locale en "$ROOT/src/reference.fab"

echo "check-reference: TS emit valida / tela / dom / browser / extension / forms / reference / main"
"$RADIX_BIN" emit -t ts --locale en "$ROOT/src/validate.fab" -o "$SCRATCH/valida.ts" >/dev/null
"$RADIX_BIN" emit -t ts --locale en "$ROOT/src/tela.fab" -o "$SCRATCH/tela.ts" >/dev/null
"$RADIX_BIN" emit -t ts --locale en "$ROOT/src/browser.fab" -o "$SCRATCH/browser.ts" >/dev/null
"$RADIX_BIN" emit -t ts --locale en "$ROOT/proof/benchmark/extension-lib/src/extension.fab" -o "$SCRATCH/extension.ts" >/dev/null
"$RADIX_BIN" emit -t ts --locale en "$ROOT/proof/extension-forms/src/forms.fab" -o "$SCRATCH/forms.ts" >/dev/null
"$RADIX_BIN" emit -t ts --locale en "$ROOT/src/reference.fab" -o "$SCRATCH/reference.ts" >/dev/null
"$RADIX_BIN" emit -t ts --locale en "$ROOT/proof/benchmark/canary-app/src/main.fab" -o "$SCRATCH/main.ts" >/dev/null
# The generated provider reference: the emitted web:dom module (the bare
# Scope/Nodus/… type declarations — the la locale emit is the package's own
# reader).
"$RADIX_BIN" emit -t ts --locale la "$ROOT/../faber-web/src/dom.fab" -o "$SCRATCH/dom.ts" >/dev/null

strip() { sed '1,2d' "$1" | grep -v '^import .* from "'; }
# The emitted web:dom provider module's preamble (FaberDisplayHint + the
# __faberDisplay helpers) and its `Element` genus are renamed so they do not
# collide with the tela module's own preamble / the DOM lib's `Element`.
strip_dom() { sed '1,2d' "$1" | grep -v '^import .* from "' | sed -e 's/\bFaberResult\b/FaberResultDom/g' -e 's/\bFaberDisplayHint\b/FaberDisplayHintDom/g' -e 's/\b__faberDisplayFractus\b/__faberDisplayDomFractus/g' -e 's/\b__faberDisplayList\b/__faberDisplayDomList/g' -e 's/\b__faberDisplayTensor\b/__faberDisplayDomTensor/g' -e 's/\b__faberDisplaySparsa\b/__faberDisplayDomSparsa/g' -e 's/\b__faberDisplayMap\b/__faberDisplayDomMap/g' -e 's/\b__faberDisplayValor\b/__faberDisplayDomValor/g' -e 's/\b__faberDisplayTaggedValor\b/__faberDisplayDomTaggedValor/g' -e 's/\b__faberDisplay\b/__faberDisplayDom/g' -e 's/\bElement\b/DomElement/g'; }
# The host runtime: faber-web's ACTUAL runtime/dom.ts implementation,
# included verbatim (export keywords stripped). tsc type-checks it here
# against the DOM lib (its own source typing); node runs it against the
# installed fake DOM.
strip_runtime() { sed 's/^export //' "$1"; }

VALIDA_NS="const validate = { valid_space, valid_tag_name, valid_attribute_name, valid_name_in_space, valid_void_html, valid_void_structure };"
TELA_NS="const tela = { html_visus, css, theme_css, theme_style, theme, token, core_tokens, token_property_name, token_name_valid, theme_has_core_tokens, theme_has_token, assemble, bundle, order, deduplicated_bundles, topological_order, style_valid, unclean_style_text, bundle_for, in_list, dependencies_met, text_view, fragment_view, new_identity, html_space, svg_space, element_view, element_full, event_name, restore, direct, anchor, update, effect_identity, Attribute, Property, Identity, Declaration, Rule, Style, Token, Theme, Bundle, Order, EventName, Update };"
BROWSER_NS="const browser = { region_root, event_subscription, binding, parse_identities, element_tag, count_occurrences, duplicate_identities, tag_name, tag_at, identities_from_nodes, tags_from_nodes, binding_status, hydration_diagnostics, mount, replace, dispose, focus_held, focus_target };"
EXT_NS="const ext = { chart_axis_muted, chart_axis_muted_dark, chart_grid_muted, chart_grid_muted_dark, chart_tokens, chart_tokens_dark, bar_meter, chart_style };"
