#!/usr/bin/env bash
# tela/scripta/check-determinism — determinism gate (Stage 1 U6 + Stage 2 U5
# + Stage 3 U4). Builds the benchmark composition static output TWICE and
# byte-compares. A diff FAILS the check (fail-closed); identical builds
# print sha256 hashes and write build/static-1.txt, build/static-2.txt,
# build/hashes.txt.
#
# Stage 2 U5: the double-build input is the TWO-THEME composition runner
# (canary-app, U3 ee2abb0) — the output is the single theme-independent HTML
# plus the full cascade CSS under both themes (lumen/tenebrae). The gate
# byte-compares the whole runner output twice.
#
# Stage 3 U3/U4: the runner (canary-app main.fab, 27aa181) now ALSO prints
# the segmented-control static render (initial HTML — role=radiogroup /
# role=radio / aria-selected / the roving tabindex / the declared live
# region) and the app-owned control cascade rule. The double-build input is
# therefore the full Stage 3 static/mount-time serialization; the sha
# supersedes the Stage 2 record (3d22b9c7…8340a) and the U3 informational
# sha (d23a62bb…c74c) — see stage-3-mount-determinism.md.
#
# Stage 4 U3/U4 (tela-s4-u3/u4): the runner (canary-app main.fab, 689e87d)
# now ALSO prints the forms family static render (field/checkbox/select +
# error/live bytes via the G4-safe *_html helpers) and the U4 behavior-plan
# status line. The double-build input is therefore the full THREE-PACKAGE
# composition (extensionlib → formslib → canary-app): the theme-independent
# HTML, the full cascade under both themes (incl. the formslib bundle rules
# + the --form-* token layer), the forms static render, the segmented-
# control static render, and the behavior-plan marker. The sha supersedes
# the Stage 3 record (77516916…e5490) — see stage-4-extension-proof.md.
#
# Stage 5 U10 (tela-s5-u10-tests-determinism-evidence — the OFFICIAL Stage
# 5 evidence boundary): the double-build input is the FINAL composition —
# tela kernel (valida + tela) + reference + formslib + extension-lib +
# canary-app (the U9 composition, incl. the emitted tela:dom seam — the
# web-surface-import U4 flip — + the tela:browser binding). The official
# sha re-records here — the U9 record's
# sha (6927187ec0…) STANDS as the official Stage 5 sha (U10 authored no
# product code; the supersession chain 8dfcb143 → 6927187ec0 holds) — see
# stage-5-evidence.md. The Rust primary path is ATTEMPTED first; the
# recorded CODEGEN001 defect is re-recorded when it fires (R2: when the
# Rust path lands, its capture must equal the TS-lane capture — sha
# equality — and the Rust primary path activates automatically, no harness
# change).
#
# Web-surface-import U4 (the browser flip): the dom emit source flips from
# faber-web's la web:dom module to tela's en tela:dom module (the en
# surface — DomNode/identity/input_value). The runner's STATIC output is
# UNCHANGED by the flip (the same Views render the same bytes; only the
# emitted module sources + assembly change) — no sha supersession is
# expected (DELIVERY §5.4 point 7); if the output differs, the diff is
# recorded + flagged honestly.
#
# Web-surface-import U6 (web-import-u6-evidence — the OFFICIAL WSI evidence
# boundary, hand-5 2026-08-11): re-records the sha at the post-flip full-
# surface boundary (seven harnesses + the two ported tests). The double-
# build input is UNCHANGED from Stage 5 U9 / WSI-U4 — the official sha
# 6927187ec0… STANDS (no supersession; U6 authored no product code —
# EVIDENCE.md + this header + goal Status only). See
# docs/factory/web-surface-import/EVIDENCE.md. Rust primary path ATTEMPTED
# first; fix:codegen001 re-recorded; R2 sha-equality note restated.
#
# Determinism posture: determinism applies to STATIC/MOUNT-TIME
# serialization ONLY (the segmented control's initial HTML + the forms
# static render + the full cascade); interactive state is time-variant —
# recorded, not claimed. The interaction sequence is a scripted
# deterministic assertion sequence under check-mount, not a racy timing
# test.
#
# Lanes:
#   Primary (Rust): emit canary-app to Rust -> scratch crate OUTSIDE the
#     shared workspace -> cargo run twice -> capture HTML/CSS. BLOCKED today:
#     Rust emit of any import-bearing file fails CODEGEN001 (provider modules
#     re-analyzed without the en reader locale — the recorded
#     provider-module locale-propagation defect, U3/U5 escalation,
#     stage-1-benchmark-static.md §3). The path is ATTEMPTED first and the
#     defect is recorded when it fires; the gate is NOT weakened to pass.
#     R2 (recorded in stage-2-determinism.md): when CODEGEN001 lands, the
#     Rust-lane capture must equal the TS-lane capture (sha equality) and
#     the Rust primary path activates automatically — no harness change.
#   Fallback (TS-lane composition, the proven lane): emit valida/tela/
#     extension/main, assemble into ONE self-contained file (single-module
#     shape, no runtime imports), run twice, byte-compare.
#   TS lane analog: double-emit the kernel and byte-compare the emitted
#     files; tsc --noEmit on the assembled composition.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BUILD="$ROOT/build"
SCRATCH="$(mktemp -d "${TMPDIR:-/tmp}/tela-u6-det.XXXXXX")"
trap 'rm -rf "$SCRATCH"' EXIT
mkdir -p "$BUILD"

if [[ -n "${RADIX_ROOT:-}" ]]; then
  RADIX="$RADIX_ROOT"
elif [[ -d "$ROOT/../radix/crates/radix" ]]; then
  RADIX="$ROOT/../radix"
else
  RADIX="$ROOT/../../../radix"
fi

if [[ ! -d "$RADIX/crates/radix" ]]; then
  echo "check-determinism: missing radix checkout at $RADIX" >&2
  exit 1
fi

RADIX_BIN="$RADIX/target/debug/radix"
if [[ ! -x "$RADIX_BIN" ]]; then
  (cd "$RADIX" && cargo build -q -p radix --bin radix)
fi

sha256() {
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  else
    sha256sum "$1" | awk '{print $1}'
  fi
}

export FABER_LIBRARY_HOME="$ROOT/proof/benchmark/libhome"

echo "== check-determinism: benchmark composition double-build =="

# ---- Rust path (primary; currently BLOCKED by the recorded defect) -------
RUST_RUN_OK=0
if "$RADIX_BIN" emit -t rust --locale en "$ROOT/proof/benchmark/canary-app/src/main.fab" -o "$SCRATCH/main.rs" >"$SCRATCH/rust-emit.log" 2>&1; then
  CRATE="$SCRATCH/crate"
  mkdir -p "$CRATE/src"
  cp "$SCRATCH/main.rs" "$CRATE/src/main.rs"
  cat > "$CRATE/Cargo.toml" <<EOF
[package]
name = "tela-u6-det"
version = "0.0.0"
edition = "2021"

[dependencies]
faber = { package = "faber-runtime", path = "$ROOT/../faber-runtime" }

[workspace]
EOF
  echo "Rust path: emitting + cargo run (build 1/2)"
  (cd "$CRATE" && cargo run -q) > "$BUILD/static-1.txt" 2>&1
  (cd "$CRATE" && cargo run -q) > "$BUILD/static-2.txt" 2>&1
  RUST_RUN_OK=1
  echo "Rust path: green (composition built twice via scratch cargo run)"
else
  BLOCK_REASON="$(grep -m1 'error\[' "$SCRATCH/rust-emit.log" || tail -1 "$SCRATCH/rust-emit.log")"
  echo "Rust path: BLOCKED — ${BLOCK_REASON}"
  echo "  (recorded radix-lane defect: provider modules re-analyzed without"
  echo "  the en reader locale -> CODEGEN001; U3/U5 escalation,"
  echo "  stage-1-benchmark-static.md §3. Falling back to the proven TS-lane"
  echo "  composition lane per spec U6 (e); the determinism gate is NOT"
  echo "  weakened.)"
fi

# ---- TS-lane composition lane (proven fallback; U5 evidence shape) -------
echo "TS lane: emitting valida / tela / extension / forms / browser / dom / main"
"$RADIX_BIN" emit -t ts --locale en "$ROOT/src/validate.fab" -o "$SCRATCH/valida.ts" >/dev/null
"$RADIX_BIN" emit -t ts --locale en "$ROOT/src/tela.fab" -o "$SCRATCH/tela.ts" >/dev/null
"$RADIX_BIN" emit -t ts --locale en "$ROOT/proof/benchmark/extension-lib/src/extension.fab" -o "$SCRATCH/extension.ts" >/dev/null
"$RADIX_BIN" emit -t ts --locale en "$ROOT/proof/extension-forms/src/forms.fab" -o "$SCRATCH/forms.ts" >/dev/null
"$RADIX_BIN" emit -t ts --locale en "$ROOT/proof/benchmark/canary-app/src/main.fab" -o "$SCRATCH/main.ts" >/dev/null
# Stage 4 U7: the canary-app imports tela:browser + tela:dom (the real
# seam — web-surface-import U4 re-points it from faber-web's web:dom).
# The composition assembly binds the browser module + the emitted tela:dom
# provider module (types + inert stubs — the main IIFE never calls the seam
# at load here).
"$RADIX_BIN" emit -t ts --locale en "$ROOT/src/browser.fab" -o "$SCRATCH/browser.ts" >/dev/null
# Stage 5 U9: the reference catalog module (the canary's runner
# references tela:reference — the pre-existing staleness that left this
# gate RED since U5 is repaired at this boundary).
"$RADIX_BIN" emit -t ts --locale en "$ROOT/src/reference.fab" -o "$SCRATCH/reference.ts" >/dev/null
"$RADIX_BIN" emit -t ts --locale en "$ROOT/src/dom.fab" -o "$SCRATCH/dom.ts" >/dev/null

echo "TS lane: double-emit byte-identity (kernel + forms package)"
"$RADIX_BIN" emit -t ts --locale en "$ROOT/src/tela.fab" -o "$SCRATCH/tela-b.ts" >/dev/null
if ! cmp -s "$SCRATCH/tela.ts" "$SCRATCH/tela-b.ts"; then
  echo "FAIL: double-emit of the kernel is not byte-identical" >&2
  exit 1
fi
"$RADIX_BIN" emit -t ts --locale en "$ROOT/proof/extension-forms/src/forms.fab" -o "$SCRATCH/forms-b.ts" >/dev/null
if ! cmp -s "$SCRATCH/forms.ts" "$SCRATCH/forms-b.ts"; then
  echo "FAIL: double-emit of the forms package is not byte-identical" >&2
  exit 1
fi

# Assemble into one self-contained file (single-module shape, no runtime
# imports): drop the radix header (2 lines) and import lines, bind the
# imported namespaces as const objects.
strip() { sed '1,2d' "$1" | grep -v '^import .* from "'; }
# The emitted tela:dom provider module's preamble + `Element` genus are
# renamed so they do not collide with the tela module's own preamble / the
# DOM lib's `Element`.
strip_dom() { sed '1,2d' "$1" | grep -v '^import .* from "' | sed -e 's/\bFaberResult\b/FaberResultDom/g' -e 's/\bFaberDisplayHint\b/FaberDisplayHintDom/g' -e 's/\b__faberDisplayFractus\b/__faberDisplayDomFractus/g' -e 's/\b__faberDisplayList\b/__faberDisplayDomList/g' -e 's/\b__faberDisplayTensor\b/__faberDisplayDomTensor/g' -e 's/\b__faberDisplaySparsa\b/__faberDisplayDomSparsa/g' -e 's/\b__faberDisplayMap\b/__faberDisplayDomMap/g' -e 's/\b__faberDisplayValor\b/__faberDisplayDomValor/g' -e 's/\b__faberDisplayTaggedValor\b/__faberDisplayDomTaggedValor/g' -e 's/\b__faberDisplay\b/__faberDisplayDom/g' -e 's/\bElement\b/DomElement/g'; }
{
  strip "$SCRATCH/valida.ts"
  echo "const validate = { valid_space, valid_tag_name, valid_attribute_name, valid_name_in_space, valid_void_html, valid_void_structure };"
  strip "$SCRATCH/tela.ts"
  echo "const tela = { html_visus, css, theme_css, theme_style, theme, token, core_tokens, token_property_name, token_name_valid, theme_has_core_tokens, theme_has_token, assemble, bundle, order, deduplicated_bundles, topological_order, style_valid, unclean_style_text, bundle_for, in_list, dependencies_met, text_view, fragment_view, new_identity, html_space, svg_space, element_view, element_full, event_name, restore, direct, anchor, update, effect_identity, Attribute, Property, Identity, Declaration, Rule, Style, Token, Theme, Bundle, Order, EventName, Update };"
  strip_dom "$SCRATCH/dom.ts"
  # The tela:dom stub surface: the en module renames the value READ fn to
  # `input_value` (fix:sem005-renamed — the en type keyword `value`), so
  # the DOM_NS const binds the en spelling (the `value` route key is gone
  # with the la module; the emitted main never calls it at load).
  echo "const dom = { scope, query, require, all, snapshot, text_set, attr_set, attr_remove, class_add, class_remove, class_toggle, on, unsubscribe, input_value, value_set, on_input, on_submit, on_frame, on_resize, on_keyboard, on_pointer, on_focus, pointer_lock_state, request_pointer_lock, exit_pointer_lock, on_pointer_lock, prevent_default, fetch_text };"
  strip "$SCRATCH/browser.ts"
  echo "const browser = { region_root, event_subscription, binding, parse_identities, element_tag, count_occurrences, duplicate_identities, tag_name, tag_at, identities_from_nodes, tags_from_nodes, binding_status, hydration_diagnostics, mount, replace, dispose, focus_held, focus_target };"
  strip "$SCRATCH/extension.ts"
  echo "const ext = { chart_axis_muted, chart_axis_muted_dark, chart_grid_muted, chart_grid_muted_dark, chart_tokens, chart_tokens_dark, bar_meter, chart_style };"
  strip "$SCRATCH/forms.ts"
  echo "const forms = { field_props, checkbox_props, select_props, field, checkbox, select, error_region, form_live_region, field_group, form_field_invalid, form_field_valid, form_focus, form_tokens, form_style, field_event, change_event, submit_event, click_event, invalid_state, error_present };"
  strip "$SCRATCH/reference.ts"
  echo "const ref = { layout_stack, layout_grid, layout_prose, stack_props, grid_props, layout_prose_props, typography_heading, typography_prose, typography_emphasis, typography_scale, heading_props, prose_props, emphasis_props, scale_props, clamped_level, layout_style, typography_style, panel, badge, metric, panel_props, badge_props, metric_props, panel_style, badge_style, metric_style, table, table_row, table_props, table_style, segmented_control, segmented_props, segmented_option, segmented_options, segmented_live_region, selected_text, active_tabindex, segmented_style, button, button_props, button_event, button_style, field_input, field_input_props, field_invalid, field_error_region, field_live_region, field_control, field_style, field_input_event, field_error_for_value, field_announcement, ref_layout_gap, ref_layout_prose_measure, ref_type_scale_xs, ref_type_scale_sm, ref_type_scale_md, ref_type_scale_lg, ref_type_scale_xl, ref_type_heading_weight, ref_type_heading_margin, ref_type_prose_line_height, ref_type_prose_margin, ref_panel_surface, ref_panel_border, ref_panel_radius, ref_panel_padding, ref_badge_size, ref_badge_padding, ref_badge_radius, ref_metric_label_size, ref_metric_label_muted, ref_metric_value_size, ref_metric_value_weight, ref_table_border, ref_table_padding, ref_table_header_weight, ref_table_caption_muted, ref_seg_gap, ref_seg_radius, ref_seg_size, ref_seg_padding, ref_seg_border, ref_seg_selected_border, ref_button_size, ref_button_padding, ref_button_radius, ref_button_border, ref_button_text, ref_button_primary_background, ref_button_primary_text, ref_button_secondary_background, ref_button_ghost_background, ref_button_focus, ref_button_disabled_opacity, field_invalid_token, field_valid_token, field_focus_token, reference_tokens, StackProps, GridProps, LayoutProseProps, HeadingProps, ProseProps, EmphasisProps, ScaleProps, PanelProps, BadgeProps, MetricProps, TableProps, TableRow, SegmentedProps, ButtonProps, FieldInputProps };"
  echo "const reference = ref;"
  strip "$SCRATCH/main.ts"
} > "$SCRATCH/composition.ts"

if [[ "$RUST_RUN_OK" -ne 1 ]]; then
  echo "TS lane: running the assembled composition (build 1/2)"
  node "$SCRATCH/composition.ts" > "$BUILD/static-1.txt" 2>&1
  node "$SCRATCH/composition.ts" > "$BUILD/static-2.txt" 2>&1
fi

# ---- fail-closed byte comparison -----------------------------------------
if ! cmp -s "$BUILD/static-1.txt" "$BUILD/static-2.txt"; then
  echo "FAIL: static output differs between the two builds (fail-closed)" >&2
  exit 1
fi

H1="$(sha256 "$BUILD/static-1.txt")"
H2="$(sha256 "$BUILD/static-2.txt")"
{
  echo "static-1 sha256: $H1"
  echo "static-2 sha256: $H2"
  echo "byte-identical: yes"
} > "$BUILD/hashes.txt"
cat "$BUILD/hashes.txt"

echo "TS lane: tsc --noEmit on the assembled composition"
tsc --noEmit --strict --target ES2020 --module ESNext --moduleResolution bundler --skipLibCheck "$SCRATCH/composition.ts"

echo "check-determinism: green (byte-identical double build; build/ has the evidence)"
