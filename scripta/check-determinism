#!/usr/bin/env bash
# tela/scripta/check-determinism — determinism gate (Stage 1 U6 + Stage 2 U5
# + Stage 3 U4). Builds the benchmark composition static output TWICE and
# byte-compares. A diff FAILS the check (fail-closed); identical builds
# print sha256 hashes and write build/static-1.txt, build/static-2.txt,
# build/hashes.txt.
#
# Stage 2 U5: the double-build input is the TWO-THEME composition runner
# (canary-app, U3 ee2abb0) — the output is the single theme-independent HTML
# plus the full cascade CSS under both themes (lumen/tenebrae). The gate
# byte-compares the whole runner output twice.
#
# Stage 3 U3/U4: the runner (canary-app main.fab, 27aa181) now ALSO prints
# the segmented-control static render (initial HTML — role=radiogroup /
# role=radio / aria-selected / the roving tabindex / the declared live
# region) and the app-owned control cascade rule. The double-build input is
# therefore the full Stage 3 static/mount-time serialization; the sha
# supersedes the Stage 2 record (3d22b9c7…8340a) and the U3 informational
# sha (d23a62bb…c74c) — see stage-3-mount-determinism.md.
#
# Stage 4 U3/U4 (tela-s4-u3/u4): the runner (canary-app main.fab, 689e87d)
# now ALSO prints the forms family static render (field/checkbox/select +
# error/live bytes via the G4-safe *_html helpers) and the U4 behavior-plan
# status line. The double-build input is therefore the full THREE-PACKAGE
# composition (extensionlib → formslib → canary-app): the theme-independent
# HTML, the full cascade under both themes (incl. the formslib bundle rules
# + the --form-* token layer), the forms static render, the segmented-
# control static render, and the behavior-plan marker. The sha supersedes
# the Stage 3 record (77516916…e5490) — see stage-4-extension-proof.md.
#
# Stage 5 U10 (tela-s5-u10-tests-determinism-evidence — the OFFICIAL Stage
# 5 evidence boundary): the double-build input is the FINAL composition —
# tela kernel (valida + tela) + reference + formslib + extension-lib +
# canary-app (the U9 composition, incl. the emitted tela:dom seam — the
# web-surface-import U4 flip — + the tela:browser binding). The official
# sha re-records here — the U9 record's
# sha (6927187ec0…) STANDS as the official Stage 5 sha (U10 authored no
# product code; the supersession chain 8dfcb143 → 6927187ec0 holds) — see
# stage-5-evidence.md. The Rust primary path is ATTEMPTED first; the
# recorded CODEGEN001 defect is re-recorded when it fires (R2: when the
# Rust path lands, its capture must equal the TS-lane capture — sha
# equality — and the Rust primary path activates automatically, no harness
# change).
#
# Web-surface-import U4 (the browser flip): the dom emit source flips from
# faber-web's la web:dom module to tela's en tela:dom module (the en
# surface — DomNode/identity/input_value). The runner's STATIC output is
# UNCHANGED by the flip (the same Views render the same bytes; only the
# emitted module sources + assembly change) — no sha supersession is
# expected (DELIVERY §5.4 point 7); if the output differs, the diff is
# recorded + flagged honestly.
#
# Web-surface-import U6 (web-import-u6-evidence — the OFFICIAL WSI evidence
# boundary, hand-5 2026-08-11): re-records the sha at the post-flip full-
# surface boundary (seven harnesses + the two ported tests). The double-
# build input is UNCHANGED from Stage 5 U9 / WSI-U4 — the official sha
# 6927187ec0… STANDS (no supersession; U6 authored no product code —
# EVIDENCE.md + this header + goal Status only). See
# docs/factory/web-surface-import/EVIDENCE.md. Rust primary path ATTEMPTED
# first; fix:codegen001 re-recorded; R2 sha-equality note restated.
#
# Stage 6 admission condition 3 (the post-WSI re-run, test-1 2026-08-11 —
# the admission-condition evidence boundary): FRESH re-record of the sha at
# the post-WSI boundary (the seven Stage 5 gates + the two ported tests run
# green once in the test-lane packet at tela main 4d95bf9). The double-
# build input is UNCHANGED from Stage 5 U9 / WSI-U4/U6 — the re-recorded
# sha 6927187ec0… STANDS (no supersession; the post-WSI composition
# produces identical bytes — the honest flag, as at U10/WSI-U6). The
# re-record is the fresh determinism baseline for Stage 6. See
# docs/factory/mvp/stage-6-admission-condition-3-evidence.md. Rust primary
# path ATTEMPTED first; fix:codegen001 re-recorded; R2 sha-equality note
# restated.
#
# Determinism posture: determinism applies to STATIC/MOUNT-TIME
# serialization ONLY (the segmented control's initial HTML + the forms
# static render + the full cascade); interactive state is time-variant —
# recorded, not claimed. The interaction sequence is a scripted
# deterministic assertion sequence under check-mount, not a racy timing
# test.
#
# Lanes:
#   Primary (Rust): emit canary-app to Rust -> scratch crate OUTSIDE the
#     shared workspace -> cargo run twice -> capture HTML/CSS. BLOCKED today:
#     Rust emit of any import-bearing file fails CODEGEN001 (provider modules
#     re-analyzed without the en reader locale — the recorded
#     provider-module locale-propagation defect, U3/U5 escalation,
#     stage-1-benchmark-static.md §3). The path is ATTEMPTED first and the
#     defect is recorded when it fires; the gate is NOT weakened to pass.
#     R2 (recorded in stage-2-determinism.md): when CODEGEN001 lands, the
#     Rust-lane capture must equal the TS-lane capture (sha equality) and
#     the Rust primary path activates automatically — no harness change.
#   Fallback (TS-lane composition, the proven lane): emit valida/tela/
#     extension/main, assemble into ONE self-contained file (single-module
#     shape, no runtime imports), run twice, byte-compare.
#   TS lane analog: double-emit the kernel and byte-compare the emitted
#     files; tsc --noEmit on the assembled composition.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BUILD="$ROOT/build"
SCRATCH="$(mktemp -d "${TMPDIR:-/tmp}/tela-u6-det.XXXXXX")"
trap 'rm -rf "$SCRATCH"' EXIT
mkdir -p "$BUILD"

if [[ -n "${RADIX_ROOT:-}" ]]; then
  RADIX="$RADIX_ROOT"
elif [[ -d "$ROOT/../radix/crates/radix" ]]; then
  RADIX="$ROOT/../radix"
else
  RADIX="$ROOT/../../../radix"
fi

if [[ ! -d "$RADIX/crates/radix" ]]; then
  echo "check-determinism: missing radix checkout at $RADIX" >&2
  exit 1
fi

RADIX_BIN="$RADIX/target/debug/radix"
if [[ ! -x "$RADIX_BIN" ]]; then
  (cd "$RADIX" && cargo build -q -p radix --bin radix)
fi

sha256() {
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  else
    sha256sum "$1" | awk '{print $1}'
  fi
}

export FABER_LIBRARY_HOME="$ROOT/proof/benchmark/libhome"

echo "== check-determinism: benchmark composition double-build =="

# ---- Rust path (primary; currently BLOCKED by the recorded defect) -------
RUST_RUN_OK=0
if "$RADIX_BIN" emit -t rust --locale en "$ROOT/proof/benchmark/canary-app/src/main.fab" -o "$SCRATCH/main.rs" >"$SCRATCH/rust-emit.log" 2>&1; then
  CRATE="$SCRATCH/crate"
  mkdir -p "$CRATE/src"
  cp "$SCRATCH/main.rs" "$CRATE/src/main.rs"
  cat > "$CRATE/Cargo.toml" <<EOF
[package]
name = "tela-u6-det"
version = "0.0.0"
edition = "2021"

[dependencies]
faber = { path = "$ROOT/../faber/runtime/rust" }

[workspace]
EOF
  echo "Rust path: emitting + cargo run (build 1/2)"
  if (cd "$CRATE" && cargo run -q) > "$BUILD/static-1.txt" 2>&1 \
    && (cd "$CRATE" && cargo run -q) > "$BUILD/static-2.txt" 2>&1; then
    RUST_RUN_OK=1
    echo "Rust path: green (composition built twice via scratch cargo run)"
  else
    BLOCK_REASON="$(grep -m1 'error\[' "$BUILD/static-1.txt" || tail -1 "$BUILD/static-1.txt")"
    echo "Rust path: BLOCKED at cargo — ${BLOCK_REASON}"
    echo "  (the emitted Rust does not compile under the runtime crate; the"
    echo "  recorded codegen defect class. Falling back to the proven TS-lane"
    echo "  composition lane per spec U6 (e); the determinism gate is NOT"
    echo "  weakened.)"
  fi
else
  BLOCK_REASON="$(grep -m1 'error\[' "$SCRATCH/rust-emit.log" || tail -1 "$SCRATCH/rust-emit.log")"
  echo "Rust path: BLOCKED — ${BLOCK_REASON}"
  echo "  (recorded radix-lane defect: provider modules re-analyzed without"
  echo "  the en reader locale -> CODEGEN001; U3/U5 escalation,"
  echo "  stage-1-benchmark-static.md §3. Falling back to the proven TS-lane"
  echo "  composition lane per spec U6 (e); the determinism gate is NOT"
  echo "  weakened.)"
fi

# ---- TS-lane composition lane (proven fallback; U5 evidence shape) -------
# The radix TS emit is an import-based module graph: emitted modules carry
# `import * as <ns> from "./tela-<module>.js"` specifiers and
# namespace-qualified type positions (tela.View). The lane assembles the
# graph AS a module graph — every emitted module is placed at its specifier
# path with an export surface collected from its emitted top-level
# declarations, and the @faber/runtime package seam is provided as a real
# module. (The former single-file const-object flattening cannot carry the
# emitted namespace-qualified types or constructors.)
echo "TS lane: emitting the module graph (valida/tela/browser/reference/dom + extension/formslib + main)"

INTRINSICS='Number|String|Boolean|Object|Array|Function|Symbol'
# The emitter's est-variant probe reads `value.__faberValorTag` on the static
# type; strict TS rejects the property access on a type that does not declare
# it. The seam narrows through an inline tag-carrier view (compile-time cast
# only; the emitted runtime expression is unchanged).
seam_normalize() {
  perl -pi -e 's/value\.__faberValorTag/(value as { __faberValorTag?: unknown }).__faberValorTag/g' "$1"
}
emit_module() { # <fab path> <specifier file name>
  "$RADIX_BIN" emit -t ts --locale en "$1" -o "$SCRATCH/$2" >/dev/null
  # Intrinsic-augmentation interfaces are script-only; wrap in `declare global`.
  perl -0pi -e "s/^interface ($INTRINSICS) \\{\n(.*?)^\\}\n/declare global {\ninterface \$1 {\n\$2}\n}\n/ms" "$SCRATCH/$2"
  seam_normalize "$SCRATCH/$2"
  local names
  names="$(grep -E '^(function|class|interface|type|const|let|var|enum) [A-Za-z_$]' "$SCRATCH/$2" \
    | sed -E 's/^(function|class|interface|type|const|let|var|enum) ([A-Za-z_$][A-Za-z0-9_$]*).*/\2/' \
    | sort -u \
    | grep -vE "^($INTRINSICS)$" \
    | paste -sd, - \
    | sed 's/,/, /g')"
  if [[ -n "$names" ]]; then
    printf '\nexport { %s };\n' "$names" >> "$SCRATCH/$2"
  else
    printf '\nexport {};\n' >> "$SCRATCH/$2"
  fi
}

emit_module "$ROOT/src/validate.fab" "tela-validate.ts"
emit_module "$ROOT/src/tela.fab" "tela-tela.ts"
emit_module "$ROOT/src/browser.fab" "tela-browser.ts"
emit_module "$ROOT/src/reference.fab" "tela-reference.ts"
emit_module "$ROOT/src/dom.fab" "tela-dom.ts"
emit_module "$ROOT/proof/benchmark/extension-lib/src/extension.fab" "extensionlib-extension.ts"
emit_module "$ROOT/proof/extension-forms/src/forms.fab" "formslib-forms.ts"
"$RADIX_BIN" emit -t ts --locale en "$ROOT/proof/benchmark/canary-app/src/main.fab" -o "$SCRATCH/main.ts" >/dev/null

# The @faber/runtime package seam: the emitted modules import
# `{ display, exact }` from the package instead of inlining the family.
# `display` mirrors the string-carrier contract (the full hint family is
# authoritative at faber/runtime/typescript/display.ts); `exact` is the
# package's own arithmetic module, stood in here.
mkdir -p "$SCRATCH/node_modules/@faber/runtime"
cat > "$SCRATCH/node_modules/@faber/runtime/package.json" <<'RUNTIME_PKG'
{ "name": "@faber/runtime", "type": "module", "main": "./index.js", "types": "./index.d.ts" }
RUNTIME_PKG
cat > "$SCRATCH/node_modules/@faber/runtime/index.d.ts" <<'RUNTIME_DTS'
export type DisplayHint =
  | "unknown" | "textus" | "ascii" | "numerus" | "fractus" | "bivalens"
  | "nihil" | "vacuum" | "valor" | "instans" | "regex"
  | { kind: "nullable"; inner: DisplayHint }
  | { kind: "lista"; element: DisplayHint }
  | { kind: "tensor"; element: DisplayHint }
  | { kind: "sparsa"; element: DisplayHint }
  | { kind: "map"; key: DisplayHint; value: DisplayHint }
  | { kind: "set"; element: DisplayHint };
export declare const display: {
  value(value: any, hint?: DisplayHint): string;
};
export declare const exact: {
  chk(v: number): number;
  add(a: number, b: number): number;
  sub(a: number, b: number): number;
  mul(a: number, b: number): number;
  div(a: number, b: number): number;
  mod(a: number, b: number): number;
  shl(a: number, n: number): number;
  shr(a: number, n: number): number;
  floatRem(a: number, b: number): number;
  neg(a: number): number;
  not(a: number): number;
  abs(a: number): number;
  pow(base: number, exponent: number): number;
  hi(a: number): number;
  lo(a: number): number;
  join(hi: number, lo: number): number;
  and(a: number, b: number): number;
  or(a: number, b: number): number;
  xor(a: number, b: number): number;
  store(v: number, lo: number, hi: number, ty: string, pos: string, extra: string): number;
  clamp(v: number, lo: number, hi: number): number;
  wrap(v: number, bits: number, signed: boolean): number;
  trueDiv(a: number, b: number): number;
  trueDivF32(a: number, b: number): number;
};
RUNTIME_DTS
cat > "$SCRATCH/node_modules/@faber/runtime/index.js" <<'RUNTIME_JS'
// Harness stand-in for @faber/runtime (string carriers only; the full hint
// family lives in faber/runtime/typescript/display.ts).
export const display = {
  value(value, hint = "unknown") {
    if (value === null || value === undefined) {
      return hint === "vacuum" ? "vacuum" : "nihil";
    }
    if (hint === "bivalens") {
      return value ? "verum" : "falsum";
    }
    return String(value);
  },
};
export const exact = {
  chk: (v) => v, add: (a, b) => a + b, sub: (a, b) => a - b, mul: (a, b) => a * b,
  div: (a, b) => Math.trunc(a / b), mod: (a, b) => a % b,
  shl: (a, n) => a * 2 ** n, shr: (a, n) => Math.floor(a / 2 ** n),
  floatRem: (a, b) => a % b, neg: (a) => -a, not: (a) => ~a, abs: (a) => Math.abs(a),
  pow: (base, exponent) => base ** exponent, hi: () => 0, lo: () => 0,
  join: (hi) => hi, and: (a, b) => a & b, or: (a, b) => a | b, xor: (a, b) => a ^ b,
  store: (v) => v, clamp: (v, lo, hi) => Math.min(Math.max(v, lo), hi),
  wrap: (v) => v, trueDiv: (a, b) => a / b, trueDivF32: (a, b) => a / b,
};
RUNTIME_JS
printf '{ "type": "module" }\n' > "$SCRATCH/package.json"

echo "TS lane: double-emit byte-identity (kernel + forms package)"
"$RADIX_BIN" emit -t ts --locale en "$ROOT/src/tela.fab" -o "$SCRATCH/tela-ident-1.ts" >/dev/null
"$RADIX_BIN" emit -t ts --locale en "$ROOT/src/tela.fab" -o "$SCRATCH/tela-ident-2.ts" >/dev/null
if ! cmp -s "$SCRATCH/tela-ident-1.ts" "$SCRATCH/tela-ident-2.ts"; then
  echo "FAIL: double-emit of the kernel is not byte-identical" >&2
  exit 1
fi
"$RADIX_BIN" emit -t ts --locale en "$ROOT/proof/extension-forms/src/forms.fab" -o "$SCRATCH/forms-ident-1.ts" >/dev/null
"$RADIX_BIN" emit -t ts --locale en "$ROOT/proof/extension-forms/src/forms.fab" -o "$SCRATCH/forms-ident-2.ts" >/dev/null
if ! cmp -s "$SCRATCH/forms-ident-1.ts" "$SCRATCH/forms-ident-2.ts"; then
  echo "FAIL: double-emit of the forms package is not byte-identical" >&2
  exit 1
fi

if [[ "$RUST_RUN_OK" -ne 1 ]]; then
  echo "TS lane: compiling + running the assembled composition (build 1/2)"
  tsc --strict --target ES2020 --module ESNext --moduleResolution bundler --skipLibCheck --outDir "$SCRATCH/dist" "$SCRATCH/main.ts"
  node "$SCRATCH/dist/main.js" > "$BUILD/static-1.txt" 2>&1
  node "$SCRATCH/dist/main.js" > "$BUILD/static-2.txt" 2>&1
fi

# ---- fail-closed byte comparison -----------------------------------------
if ! cmp -s "$BUILD/static-1.txt" "$BUILD/static-2.txt"; then
  echo "FAIL: static output differs between the two builds (fail-closed)" >&2
  exit 1
fi

H1="$(sha256 "$BUILD/static-1.txt")"
H2="$(sha256 "$BUILD/static-2.txt")"
{
  echo "static-1 sha256: $H1"
  echo "static-2 sha256: $H2"
  echo "byte-identical: yes"
} > "$BUILD/hashes.txt"
cat "$BUILD/hashes.txt"

echo "check-determinism: green (byte-identical double build; build/ has the evidence)"
