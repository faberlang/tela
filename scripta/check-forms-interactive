#!/usr/bin/env bash
# tela/scripta/check-forms-interactive — the Stage 4 U7 interactive
# provider-seam gate (the CTO10-3 interactive claim).
#
# Assembles the canary-app's REAL-IMPORT composition (tela:dom +
# tela:browser + formslib — all through the NORMAL package interface) and
# executes the scripted interaction sequence against the DOCUMENTED
# tela host binding — the ACTUAL route (web-surface-import U4: the flip
# re-points the seam from faber-web's web:dom to tela's own tela:dom):
#
#   tela:dom import (the emitted app/browser code references dom.scope /
#   dom.snapshot / …) → the generated provider reference (the emitted
#   tela:dom module — the bare Scope/DomNode/… types) → the
#   bindings/ts.toml mapping (tela:dom.snapshot → webDomSnapshot, …) → the
#   runtime/dom.ts implementation (tela's ACTUAL runtime source — the
#   faber-web runtime copy adapted to the en `identity` field, included
#   verbatim, export keywords stripped).
#
# The node host environment is the AUTHORED fake DOM (Stage 5 U9 —
# scripta/harness_dom.fab emitted to TS; the embedded fake DOM is removed);
# no same-named webDom* globals and NO tela-side shim is used for this
# claim (head-cto fire-13): the tela:dom surface is tela/runtime/dom.ts
# itself. The driver rides the emitted function surface (web_dom_*,
# element_*, doc_*, fake_event_*); the global installation stays at the
# driver boundary.
#
# Fail-closed: every scripted assertion runs under node; any assertion
# failure or non-zero exit FAILS the gate. Synchronous-only (the routed
# async-gap boundary — no @ futura, no fetch claims).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT/scripta/graph.sh"
source "$ROOT/scripta/runtime-link.sh"
SCRATCH="$(mktemp -d "${TMPDIR:-/tmp}/tela-u7-interactive.XXXXXX")"
trap 'rm -rf "$SCRATCH"' EXIT

if [[ -n "${RADIX_ROOT:-}" ]]; then
  RADIX="$RADIX_ROOT"
elif [[ -d "$ROOT/../radix/crates/radix" ]]; then
  RADIX="$ROOT/../radix"
else
  RADIX="$ROOT/../../../radix"
fi

if [[ ! -d "$RADIX/crates/radix" ]]; then
  echo "check-forms-interactive: missing radix checkout at $RADIX" >&2
  exit 1
fi

# `faber check`/`faber emit` own package-aware analysis and resolve sibling
# provider imports through --library-home; `radix check`/`radix emit` are
# single-file only and have no library home, so a file that imports a sibling
# module (tela:validate, tela:dom, …) fails there. The retired
# FABER_LIBRARY_HOME env branch is not read, so the flag is passed explicitly.
FABER_BIN="${FABER_BIN:-$RADIX/target/debug/faber}"
if [[ ! -x "$FABER_BIN" ]]; then
  (cd "$RADIX" && cargo build -q -p faber)
fi
RADIX_BIN="$FABER_BIN"

export FABER_LIBRARY_HOME="$ROOT/proof/benchmark/libhome"

echo "check-forms-interactive: radix check the real-import composition (benchmark libhome)"
"$FABER_BIN" check --library-home "$FABER_LIBRARY_HOME" --locale en "$ROOT/proof/benchmark/canary-app/src/main.fab"

echo "check-forms-interactive: TS emit the module graph (valida / tela / browser / extension / forms / reference / harness dom / main + the tela:dom seam)"
emit_module "$ROOT/src/validate.fab" "tela-validate.ts"
emit_module "$ROOT/src/tela.fab" "tela-tela.ts"
emit_module "$ROOT/src/browser.fab" "tela-browser.ts"
emit_module "$ROOT/proof/benchmark/extension-lib/src/extension.fab" "extensionlib-extension.ts"
emit_module "$ROOT/proof/extension-forms/src/forms.fab" "formslib-forms.ts"
emit_module "$ROOT/src/reference.fab" "tela-reference.ts"
# Stage 5 U9: the AUTHORED fake DOM (Faber source -> the emitted module).
emit_module "$ROOT/scripta/harness_dom.fab" "tela-harness-dom.ts"
emit_module "$ROOT/proof/benchmark/canary-app/src/main.fab" "main.ts"
# The tela:dom seam: the bindings/ts.toml mapping over tela's ACTUAL host
# runtime (runtime/dom.ts), resolved by the graph's `./tela-dom.js` import.
write_dom_seam
link_faber_runtime check-forms-interactive "$RADIX" "$SCRATCH"
printf '{ "type": "module" }\n' > "$SCRATCH/package.json"

{
  # The driver rides IN the canary-app module (it reads the app's top-level
  # seam fns and its namespace imports); the fake DOM and the host runtime
  # arrive as real imports.
  echo
  echo "import { $(module_import_names tela-harness-dom.ts) } from \"./tela-harness-dom.js\";"
  echo 'import { webDomValue, webDomSnapshot } from "./tela-dom-runtime.js";'
  echo 'type Mounted = browser.Mounted;'
  echo 'type Update = tela.Update;'
} > "$SCRATCH/host-driver.ts"
cat >> "$SCRATCH/host-driver.ts" <<'HOST_DRIVER'
// ---- node host environment (Stage 5 U9: the AUTHORED fake DOM) ----------
// The fake DOM is Faber source (scripta/harness_dom.fab emitted to TS) —
// the embedded fake-DOM classes are REMOVED at U9. The driver rides the
// emitted function surface (web_dom_*, element_*, doc_*, fake_event_*).
// The global installation stays at the driver boundary.
const installFakeDom = (): FakeDocument => {
  const doc = fake_document();
  const root = fake_element("div");
  element_attr_set(root, "id", "root");
  element_append_child(doc.body, root);
  globalThis.document = doc as unknown as Document;
  globalThis.window = { addEventListener() {}, removeEventListener() {}, innerWidth: 800, innerHeight: 600, devicePixelRatio: 1 } as unknown as Window & typeof globalThis;
  globalThis.requestAnimationFrame = (cb: (t: number) => void) => setTimeout(() => cb(Date.now()), 16);
  globalThis.cancelAnimationFrame = (id: unknown) => clearTimeout(id as any);
  globalThis.fetch = () => Promise.reject(new Error("no fetch in the interactive gate"));
  return doc;
};

// ---- scripted interaction driver (the host executing the app's plan) -----
const assert = (cond: boolean, msg: string): void => { if (!cond) throw new Error(`check-forms-interactive assert failed: ${msg}`); };
const doc = installFakeDom();
const identityNodes = (): FakeElement[] => doc_query_all(doc, "[data-tela]");
const byIdentity = (id: string): FakeElement | undefined => identityNodes().find((n) => n.data_tela === id);
const textOf = (id: string): string => {
  const n = byIdentity(id);
  return n === undefined ? "" : element_text(n);
};
const plantRegion = (selector: string, markup: string): void => {
  const region = doc_query_selector(doc, selector)!;
  element_clear_children(region);
  for (const node of parse_fragment(markup)) element_append_child(region, node);
};
const syncRegion = (selector: string, view: unknown): void => {
  const html = tela.html_view(view as any) ?? "";
  plantRegion(selector, html);
};

// --- app state (the update loop's model) ----------------------------------
let model: FieldState = field_state("form-field-name", "", "");
let agree: boolean = false;
let tone: string = "Light";
let announcements = 0;

let m: Mounted;
const applyMessage = (msg: FormMessage): string => {
  const next = update_field(model, msg);
  const announced = form_announcement(model, next);
  if (msg.tag === "CheckboxToggle") agree = msg.selected;
  if (msg.tag === "SelectChange") tone = msg.selected;
  model = next;
  const nextVisus = forms_composition_from_state(model, agree, tone);
  const r = browser.replace(m, nextVisus) as Update;
  syncRegion("#root", nextVisus);
  if (announced !== "") {
    const live = byIdentity("form-live");
    assert(live !== undefined, "live region present");
    web_dom_text_set(live!, announced);
    announcements += 1;
  }
  return announced;
};

// --- 1. hydration: mount onto a scope pre-rendered with the SAME composition
const presentMarkup = tela.html_view(forms_composition()) ?? "";
plantRegion("#root", presentMarkup);
m = mount_forms("#root") as Mounted;
assert(m !== null, "mount returns a plan");
assert(m.bindings.length === 7, "seven binding-plan entries (forma + field group + field + error + checkbox + select + live)");
assert(m.bindings.every((l) => l.status === "bind"), "hydration: every matching identity binds (the dom.snapshot read)");
assert(byIdentity("form-field-name") !== undefined, "field node present from the present");

// --- 2. field input → empty → invalid transition ---------------------------
{
  const announced = applyMessage(field_text_message("form-field-name", ""));
  assert(announced === "form-field-name invalid: Required", "invalid transition announces");
  assert(announcements === 1, "announced once");
  const field = byIdentity("form-field-name");
  assert(field !== undefined && element_attr_get(field, "aria-invalid") === "true", "aria-invalid flips true");
  assert(field !== undefined && element_attr_get(field, "aria-describedby") === "form-error-name", "describedby wired to the error identity");
  assert(textOf("form-error-name") === "Required", "error text written");
  assert(textOf("form-live") === "form-field-name invalid: Required", "live region announces");
}

// --- 3. field input → valid → cleared --------------------------------------
{
  const announced = applyMessage(field_text_message("form-field-name", "Ada"));
  assert(announced === "form-field-name valid", "valid transition announces");
  assert(announcements === 2, "announced once");
  const field = byIdentity("form-field-name");
  assert(field !== undefined && element_attr_get(field, "aria-invalid") === "false", "aria-invalid clears");
  assert(field !== undefined && element_attr_get(field, "aria-describedby") === null, "describedby removed");
  assert(textOf("form-error-name") === "", "error text cleared");
}

// --- 4. no-op input (same value) → silent ----------------------------------
{
  const announced = applyMessage(field_text_message("form-field-name", "Ada"));
  assert(announced === "", "the no-op rule: silent");
  assert(announcements === 2, "no announcement on the no-op");
}

// --- 5. checkbox toggle flips aria-checked ---------------------------------
{
  applyMessage(checkbox_toggle_message("form-checkbox-agree", true));
  assert(announcements === 3, "the toggle announces once");
  const box = byIdentity("form-checkbox-agree");
  assert(box !== undefined && element_attr_get(box, "aria-checked") === "true", "aria-checked flips true");
  assert(agree, "the app model tracks the checkbox state");
}

// --- 6. select change updates the model ------------------------------------
{
  applyMessage(select_change_message("form-select-tone", "Dark"));
  assert(model.value === "Dark", "select change updates the model");
  assert(tone === "Dark", "the app model tracks the select state");
}

// --- 7. replace across the region: focus restoration + scroll anchor -------
{
  const mFocused = browser.focus_held(m, "form-field-name");
  const r = browser.replace(mFocused, forms_composition_from_state(model, agree, tone)) as Update;
  const keys = r.effects.map((e) => tela.effect_identity(e));
  assert(keys.length === 2 && keys[0] === "form-field-name" && keys[1] === "#root",
    "effects are Restore(form-field-name) + Anchor(#root)");
  const target = byIdentity("form-field-name");
  assert(target !== undefined, "focus target present");
  doc_focus_node(doc, target!);
  assert(doc.active_element?.data_tela === "form-field-name", "focus restored by identity");
}

// --- 8. dispose: subscriptions live before, gone after ---------------------
{
  const node = byIdentity("form-field-name");
  assert(node !== undefined, "binding target present");
  let clicks = 0;
  const sub = web_dom_on(doc, node!, "click", () => { clicks += 1; });
  element_dispatch(node!, fake_event("click"));
  assert(clicks === 1, "subscription live before dispose");
  browser.dispose(m);
  web_dom_unsubscribe(doc, sub);
  element_dispatch(node!, fake_event("click"));
  assert(clicks === 1, "post-dispose dispatch no-ops (unsubscribed)");
}

console.log("forms interactive provider-seam gate green (scripted sequence; tela-s4-u7)");
HOST_DRIVER

cat "$SCRATCH/host-driver.ts" >> "$SCRATCH/main.ts"

echo "check-forms-interactive: tsc (strict; the DOM lib hosts the tela runtime typing)"
rm -rf "$SCRATCH/dist"
tsc --strict --target ES2020 --lib ES2020,DOM --module ESNext --moduleResolution bundler --skipLibCheck --outDir "$SCRATCH/dist" "$SCRATCH/main.ts"

echo "check-forms-interactive: node — the scripted interaction gate (fail-closed)"
node "$SCRATCH/dist/main.js"

echo "check-forms-interactive: green (real provider seam; scripted sequence; node exit 0)"
