#!/usr/bin/env bash
# tela/scripta/check-compile — Stage 1 U6 compile surface.
# `faber check` every src/*.fab (kernel + validation under the container
# library home) and both benchmark packages (under the benchmark libhome).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ -n "${RADIX_ROOT:-}" ]]; then
  RADIX="$RADIX_ROOT"
elif [[ -d "$ROOT/../radix/crates/radix" ]]; then
  RADIX="$ROOT/../radix"
else
  RADIX="$ROOT/../../../radix"
fi

if [[ ! -d "$RADIX/crates/radix" ]]; then
  echo "check-compile: missing radix checkout at $RADIX" >&2
  exit 1
fi

# `faber check` owns package-aware analysis and resolves the sibling provider
# imports (tela:validate, tela:dom, extensionlib:extension, …) through
# --library-home. `radix check` is single-file only and has no library home,
# so an importing file fails there; the retired FABER_LIBRARY_HOME env branch
# is not read.
FABER_BIN="${FABER_BIN:-$RADIX/target/debug/faber}"
if [[ ! -x "$FABER_BIN" ]]; then
  (cd "$RADIX" && cargo build -q -p faber)
fi

# The tela package reads English (faber.toml `[reader] locale = "en"`); the
# CLI defaults to Latin for an untagged input, so the en reader locale is
# passed explicitly with `--locale en`.

echo "check-compile: kernel + validation + reference + dom + canvas2d + web modules (container library home)"
KERNEL_HOME="${FABER_LIBRARY_HOME:-$ROOT/..}"
# Stage 5 U2: the reference catalog module joins the compile surface.
# Web-surface-import U4: the tela:dom + tela:canvas2d modules join (the
# browser flip's imported seam — U1/U3 landed the sources).
# Web-to-tela-consumer-migration U1: the tela:web annotation module joins
# (the WebController packaging entry contract).
for mod in tela validate reference dom canvas2d web browser; do
  echo "check-compile: parsing src/${mod}.fab"
  "$FABER_BIN" check --library-home "$KERNEL_HOME" --locale en "$ROOT/src/${mod}.fab"
done

echo "check-compile: benchmark packages (benchmark library home)"
BENCH_HOME="$ROOT/proof/benchmark/libhome"
echo "check-compile: parsing proof/benchmark/extension-lib/src/extension.fab"
"$FABER_BIN" check --library-home "$BENCH_HOME" --locale en "$ROOT/proof/benchmark/extension-lib/src/extension.fab"
echo "check-compile: parsing proof/benchmark/canary-app/src/main.fab"
"$FABER_BIN" check --library-home "$BENCH_HOME" --locale en "$ROOT/proof/benchmark/canary-app/src/main.fab"

echo "check-compile: green"
