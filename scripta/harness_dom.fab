# tela/scripta/harness_dom.fab — harness fake DOM, authored as Faber and
# emitted to TypeScript. check-mount / check-exempla / check-forms-interactive
# / check-reference assemble the emitted module. The document is an explicit
# parameter; globalThis.document/window wiring stays in the TS drivers.
#
# Authoring constraints:
#   - Runtime-contract method names on the fake nodes (runtime/dom.ts):
#     getAttribute, querySelector, querySelectorAll, tagName, and
#     classList add/remove/toggle/has. Methods delegate to the free
#     functions below.
#   - fix:copia-iteration — copia has no iteration/read-back (repro:
#     spike/defects/d4-copia-iteration.fab). Set semantics use a tabula
#     store: keys() insertion order, has() membership, contains() listener
#     dedup.
#   - fix:codegen002 — TS emitter rejects `≡` whose RHS variable is named
#     `value` (repro: spike/defects/d5-rhs-value-equality.fab). The local
#     is spelled attr_value.
#   - No else-if (nested if/else). No ternaries. No regexes (string-scanning
#     parser + selector matcher).
#   - Mutable fields: `var` copy of the record + `←` (SEM020).
#   - Nullable reads: bind + `is null` guard + copy-narrow.
#   - No `\"` string payloads (the TS emitter double-escapes them — see
#     tela.fab escape notes): the double-quote comes from the ascii § hole
#     ("§"('"')), the documented convention.

# ---------------------------------------------------------------------------
# Records (the fake DOM node model).
# ---------------------------------------------------------------------------

# The class-list set. Set semantics (presence + insertion-ordered
# read-back) backed by a tabula — see fix:copia-iteration.
class FakeClassList {
    mut map<string, bool> classes = empty

    # The runtime-contract method bridge (faber-web runtime/dom.ts —
    # webDomClassAdd/Remove/Toggle call the classList method surface).
    fn add(string cls) → void {
        class_list_add(self, cls)
    }
    fn remove(string cls) → void {
        class_list_remove(self, cls)
    }
    fn toggle(string cls) → bool {
        return class_list_toggle(self, cls)
    }
    fn has(string cls) → bool {
        return class_list_has(self, cls)
    }
}

# The fake event: a plain carrier with the keyboard/pointer field surface
# the webDom* handler-typed bindings read. default_prevented mirrors the
# shim's mutable flag.
class FakeEvent {
    mut string kind
    mut bool default_prevented = false
    mut string key = ""
    mut string code = ""
    mut bool repeat = false
    mut bool alt_key = false
    mut bool ctrl_key = false
    mut bool shift_key = false
    mut bool meta_key = false
    mut int client_x = 0
    mut int client_y = 0
    mut int movement_x = 0
    mut int movement_y = 0
    mut int button = 0
    mut bool primary = false
}

# The fake element. The shim's getters (textContent, dataTela) become
# functions over the record (element_text / element_text_set / the
# maintained data_tela field); the mutable maps stay tabula/list fields.
class FakeElement {
    mut list<FakeElement> children = empty
    mut FakeElement ∪ none parent = null
    # The runtime contract reads `tagName` (webDomSnapshot -> el.tagName);
    # the field is spelled tagName so the emitted class satisfies it.
    mut string tagName = ""
    mut string value = ""
    mut FakeClassList class_list
    # The parsed data-tela identity ("" when the node carries none) —
    # maintained by element_attr_set / element_attr_remove.
    mut string data_tela = ""
    # Hydration stamp: "original" when the node was bound (not recreated).
    mut string token = ""
    mut map<string, string> attrs = empty
    # Listener sets per event kind (Set-dedup via contains() before append).
    mut map<string, list<(FakeEvent) → void>> listeners = empty
    mut string own_text = ""

    # Runtime-contract methods: webDomSnapshot reads getAttribute + tagName
    # on every data-tela descendant; webDomScope/webDomQuery read
    # querySelector / querySelectorAll on the scoped root.
    fn getAttribute(string name) → string ∪ none {
        return element_attr_get(self, name)
    }
    fn querySelector(string selector) → FakeElement ∪ none {
        return element_query_selector(self, selector)
    }
    fn querySelectorAll(string selector) → list<FakeElement> {
        return element_query_all(self, selector)
    }
}

# The fake document: the tree root (children = [body]) + focus tracking +
# the subscription registry (the shim's module-global activeSubscriptions
# lives on the document — the explicit-parameter posture).
class FakeDocument {
    mut list<FakeElement> children = empty
    mut FakeElement body
    mut FakeElement ∪ none active_element = null
    mut int next_subscription_id = 1
    mut map<int, SubscriptionRecord> active_subscriptions = empty

    # The runtime-contract method bridge (webDomScope reads
    # document.querySelector; webDomSnapshot reads scope.root.querySelectorAll
    # — when the scope root is the document).
    fn querySelector(string selector) → FakeElement ∪ none {
        return doc_query_selector(self, selector)
    }
    fn querySelectorAll(string selector) → list<FakeElement> {
        return doc_query_all(self, selector)
    }
}

# The webDom* scope (root + selector) — the runtime's WebDomScope shape.
class FakeScope {
    mut FakeElement root
    mut string selector
}

# The webDom* subscription handle — an id into the document registry.
class FakeSubscription {
    mut int id
}

# The typed hydration snapshot node (identity + tag name per data-tela
# descendant) — the dom.DomNode equivalent (web-surface-import U4: the
# en surface field spelling, renamed from identitas).
class FakeNodus {
    mut string identity
    mut string tag
}

# The registry record: the listener + the element to remove it from.
class SubscriptionRecord {
    mut FakeElement element
    mut string event_name
    mut (FakeEvent) → void handler
}

# The bounded-parser result (a parsed node + the next scan position).
class ParseResult {
    mut FakeElement node
    mut int next
}

# The binding-plan carrier shapes (the shim's MountedLike surface).
class BindingLike {
    mut string identity
    mut string status
}
class SubscriptionLike {
    mut string identity
    mut string event_name
}
class MountedLike {
    mut string markup
    mut list<BindingLike> bindings
    mut list<SubscriptionLike> subscriptions
    mut list<string> identities
    mut list<string> diagnostics = empty
}

# The handler-state carriers (the keyboard/pointer/focus states the
# handler-typed bindings produce).
class FakeKeyboardState {
    mut string kind
    mut string key
    mut string code
    mut bool repeat
    mut bool alt
    mut bool ctrl
    mut bool shift
    mut bool meta
}
class FakePointerState {
    mut string kind
    mut int x
    mut int y
    mut int movement_x
    mut int movement_y
    mut int button
    mut bool primary
}
class FakeFocusState {
    mut bool focused
}
class FakeSubmitOptions {
    mut bool prevent_default = true
}

# ---------------------------------------------------------------------------
# ClassList functions.
# ---------------------------------------------------------------------------

fn fake_class_list() → FakeClassList {
    return FakeClassList { classes = empty }
}

fn class_list_add(FakeClassList cl, string name) → void {
    cl.classes.put(name, true)
}

fn class_list_remove(FakeClassList cl, string name) → void {
    cl.classes.delete(name)
}

fn class_list_toggle(FakeClassList cl, string name) → bool {
    if cl.classes.has(name) {
        cl.classes.delete(name)
        return false
    } else {
        cl.classes.put(name, true)
        return true
    }
}

fn class_list_has(FakeClassList cl, string name) → bool {
    return cl.classes.has(name)
}

# Insertion-ordered read-back (the Set's classNames()).
fn class_list_names(FakeClassList cl) → list<string> {
    return cl.classes.keys()
}

# ---------------------------------------------------------------------------
# Event functions.
# ---------------------------------------------------------------------------

fn fake_event(string kind) → FakeEvent {
    return FakeEvent { kind = kind }
}

fn fake_event_key(string kind, string key) → FakeEvent {
    return FakeEvent { kind = kind, key = key }
}

fn event_prevent_default(mut FakeEvent event) → FakeEvent {
    event.default_prevented ← true
    return event
}

# ---------------------------------------------------------------------------
# Element functions.
# ---------------------------------------------------------------------------

fn fake_element(string tag) → FakeElement {
    return FakeElement { tagName = tag, class_list = fake_class_list() }
}

fn make_text_node(string text) → FakeElement {
    mut FakeElement node ← fake_element("#text")
    element_text_set(mut node, text)
    return node
}

# Real-DOM semantics: an element's textContent is the concatenated text of
# its subtree; a #text node's is its own text.
fn element_text(FakeElement el) → string {
    if el.tagName ≡ "#text" {
        return el.own_text
    }
    mut string accum ← el.own_text
    mut int i ← 0
    while i ≺ el.children.length() {
        accum ← accum + element_text(el.children[i])
        i ← i + 1
    }
    return accum
}

# Setting textContent replaces the children (webDomTextSet behaviour).
fn element_text_set(mut FakeElement el, string value) → void {
    el.own_text ← value
    if el.tagName ≢ "#text" {
        el.children ← empty
    }
}

fn element_attr_get(FakeElement el, string name) → string ∪ none {
    return el.attrs.get(name)
}

# String(value) coercion is identity for the harness's string call sites.
fn element_attr_set(mut FakeElement el, string name, string value) → void {
    el.attrs.put(name, value)
    if name ≡ "data-tela" {
        el.data_tela ← value
    }
}

fn element_attr_remove(mut FakeElement el, string name) → void {
    el.attrs.delete(name)
    if name ≡ "data-tela" {
        el.data_tela ← ""
    }
}

fn element_attr_has(FakeElement el, string name) → bool {
    return el.attrs.has(name)
}

# Serialized attribute shape (insertion order) — the open-tag compare.
fn element_attribute_shape(FakeElement el) → string {
    mut string accum ← ""
    let list<string> names ← el.attrs.keys()
    mut int i ← 0
    while i ≺ names.length() {
        let string ∪ none maybe_value ← el.attrs.get(names[i])
        if maybe_value not is none {
            let string value ← maybe_value
            accum ← accum + " " + names[i] + "='" + value + "'"
        }
        i ← i + 1
    }
    return accum
}

# Selector matching (string-scanning re-author of the shim's regexes):
# [data-tela] (non-empty identity), #id, .class, [name] / [name=value] /
# [name='value'] / [name="value"], and bare tag equality.
fn element_matches(FakeElement el, string selector) → bool {
    let string q ← "§"('"')
    if selector ≡ "[data-tela]" {
        return el.data_tela ≢ ""
    }
    if selector.length() ≻ 0 and selector.slice(0, 1) ≡ "#" {
        let string ∪ none id ← element_attr_get(el, "id")
        if id not is none {
            let string certain ← id
            return certain ≡ selector.slice(1, selector.length())
        }
        return false
    }
    if selector.length() ≻ 0 and selector.slice(0, 1) ≡ "." {
        return class_list_has(el.class_list, selector.slice(1, selector.length()))
    }
    if selector.length() ≥ 2 and selector.slice(0, 1) ≡ "[" and selector.slice(selector.length() - 1, selector.length()) ≡ "]" {
        let string inner ← selector.slice(1, selector.length() - 1)
        let int eq ← index_of(inner, "=", 0)
        if eq ≺ 0 {
            return element_attr_has(el, inner)
        }
        mut string name ← inner.slice(0, eq)
        # fix:codegen002 — the TS emitter rejects equality comparisons whose
        # RHS variable is named `value` (a codegen helper-name collision;
        # minimized repro tela/spike/defects/d5-rhs-value-equality.fab). The
        # local is spelled attr_value in this module.
        mut string attr_value ← inner.slice(eq + 1, inner.length())
        if attr_value.length() ≥ 2 {
            let string first ← attr_value.slice(0, 1)
            if first ≡ "'" or first ≡ q {
                if attr_value.slice(attr_value.length() - 1, attr_value.length()) ≡ first {
                    attr_value ← attr_value.slice(1, attr_value.length() - 1)
                }
            }
        }
        let string ∪ none actual ← element_attr_get(el, name)
        if actual not is none {
            let string certain ← actual
            return certain ≡ attr_value
        }
        return false
    }
    return el.tagName ≡ selector
}

fn element_query_selector(FakeElement el, string selector) → FakeElement ∪ none {
    let list<FakeElement> all ← element_query_all(el, selector)
    if all.length() ≡ 0 {
        return null
    }
    return all[0]
}

fn element_query_all(FakeElement el, string selector) → list<FakeElement> {
    return query_all_into(el.children, selector)
}

fn query_all_into(list<FakeElement> children, string selector) → list<FakeElement> {
    mut list<FakeElement> out ← empty
    mut int i ← 0
    while i ≺ children.length() {
        let FakeElement child ← children[i]
        if element_matches(child, selector) {
            out ← out.added(child)
        }
        let list<FakeElement> tail ← query_all_into(child.children, selector)
        mut int j ← 0
        while j ≺ tail.length() {
            out ← out.added(tail[j])
            j ← j + 1
        }
        i ← i + 1
    }
    return out
}

fn element_append_child(FakeElement parent, mut FakeElement child) → void {
    parent.children.append(child)
    child.parent ← parent
}

fn element_remove(mut FakeElement child) → void {
    mut FakeElement ∪ none parent ← child.parent
    if parent not is none {
        mut FakeElement certain ← parent
        mut list<FakeElement> kept ← empty
        # A `mut` parameter does not compare against an element (SEM010);
        # the const name is the same node, so the identity test reads it.
        let FakeElement removed ← child
        mut int i ← 0
        while i ≺ certain.children.length() {
            if certain.children[i] ≢ removed {
                kept.append(certain.children[i])
            }
            i ← i + 1
        }
        certain.children ← kept
        child.parent ← null
    }
}

fn element_clear_children(mut FakeElement el) → void {
    el.children ← empty
}

fn element_add_listener(FakeElement el, string kind, (FakeEvent) → void handler) → void {
    if not el.listeners.has(kind) {
        el.listeners.put(kind, empty)
    }
    let list<(FakeEvent) → void> ∪ none maybe ← el.listeners.get(kind)
    if maybe not is none {
        mut list<(FakeEvent) → void> handlers ← copy maybe
        # Set-dedup the same handler (fix:copia-iteration: contains()
        # stands in for copia membership).
        if not handlers.contains(handler) {
            handlers.append(handler)
        }
        el.listeners.put(kind, handlers)
    }
}

fn element_remove_listener(FakeElement el, string kind, (FakeEvent) → void handler) → void {
    if el.listeners.has(kind) {
        let list<(FakeEvent) → void> ∪ none maybe ← el.listeners.get(kind)
        if maybe not is none {
            let list<(FakeEvent) → void> handlers ← maybe
            mut list<(FakeEvent) → void> kept ← empty
            mut int i ← 0
            while i ≺ handlers.length() {
                if handlers[i] ≢ handler {
                    kept.append(handlers[i])
                }
                i ← i + 1
            }
            el.listeners.put(kind, kept)
        }
    }
}

fn element_dispatch(FakeElement el, FakeEvent event) → bool {
    if el.listeners.has(event.kind) {
        let list<(FakeEvent) → void> ∪ none maybe ← el.listeners.get(event.kind)
        if maybe not is none {
            let list<(FakeEvent) → void> handlers ← maybe
            mut int i ← 0
            while i ≺ handlers.length() {
                let (FakeEvent) → void h ← handlers[i]
                h(event)
                i ← i + 1
            }
        }
    }
    return not event.default_prevented
}

# ---------------------------------------------------------------------------
# Document functions.
# ---------------------------------------------------------------------------

fn fake_document() → FakeDocument {
    let FakeElement body ← fake_element("body")
    return FakeDocument { body = body, children = [body] }
}

fn doc_has_focus(FakeDocument doc) → bool {
    return true
}

fn doc_focus_node(mut FakeDocument doc, FakeElement ∪ none node) → void {
    doc.active_element ← node
}

fn doc_query_selector(FakeDocument doc, string selector) → FakeElement ∪ none {
    let list<FakeElement> all ← doc_query_all(doc, selector)
    if all.length() ≡ 0 {
        return null
    }
    return all[0]
}

fn doc_query_all(FakeDocument doc, string selector) → list<FakeElement> {
    return query_all_into(doc.children, selector)
}

# Build a region root for a selector (e.g. "#root") under the body.
fn resolve_region(FakeDocument doc, string selector) → FakeElement {
    let FakeElement ∪ none existing ← doc_query_selector(doc, selector)
    if existing not is none {
        let FakeElement certain ← existing
        return certain
    }
    mut FakeElement region ← fake_element("div")
    element_attr_set(mut region, "id", selector.slice(1, selector.length()))
    element_append_child(doc.body, mut region)
    return region
}

# ---------------------------------------------------------------------------
# The bounded HTML parser for the tela serializer's markup shape.
# ---------------------------------------------------------------------------

fn is_void_tag(string name) → bool {
    if name ≡ "area" { return true }
    if name ≡ "base" { return true }
    if name ≡ "br" { return true }
    if name ≡ "col" { return true }
    if name ≡ "embed" { return true }
    if name ≡ "hr" { return true }
    if name ≡ "img" { return true }
    if name ≡ "input" { return true }
    if name ≡ "link" { return true }
    if name ≡ "meta" { return true }
    if name ≡ "param" { return true }
    if name ≡ "source" { return true }
    if name ≡ "track" { return true }
    if name ≡ "wbr" { return true }
    return false
}

fn unescape_html(string text) → string {
    let string q ← "§"('"')
    mut string accum ← ""
    mut int i ← 0
    while i ≺ text.length() {
        mut string fragment ← text.slice(i, i + 1)
        mut int step ← 1
        if not (i + 5 ≻ text.length()) and text.slice(i, i + 5) ≡ "&quot;" {
            fragment ← q
            step ← 5
        }
        if not (i + 5 ≻ text.length()) and text.slice(i, i + 5) ≡ "&#39;" {
            fragment ← "'"
            step ← 5
        }
        if not (i + 4 ≻ text.length()) and text.slice(i, i + 4) ≡ "&amp;" {
            fragment ← "&"
            step ← 4
        }
        if not (i + 4 ≻ text.length()) and text.slice(i, i + 4) ≡ "&lt;" {
            fragment ← "<"
            step ← 4
        }
        if not (i + 4 ≻ text.length()) and text.slice(i, i + 4) ≡ "&gt;" {
            fragment ← ">"
            step ← 4
        }
        accum ← accum + fragment
        i ← i + step
    }
    return accum
}

fn index_of(string text, string needle, int start) → int {
    if needle.length() ≡ 0 {
        return start
    }
    mut int i ← start
    while i ≤ text.length() - needle.length() {
        if text.slice(i, i + needle.length()) ≡ needle {
            return i
        }
        i ← i + 1
    }
    return -1
}

# Parse one element open-tag + subtree; null when the scan position does
# not open an element (name empty or a closing tag). Mirrors the shim's
# recursive-descent parseElement.
fn parse_element(string html, int start) → ParseResult ∪ none {
    let string q ← "§"('"')
    mut int j ← start + 1
    mut string name ← ""
    mut bool name_scan ← true
    while j ≺ html.length() and name_scan {
        let string ch ← html.slice(j, j + 1)
        if ch ≡ " " or ch ≡ ">" {
            name_scan ← false
        } else {
            name ← name + ch
            j ← j + 1
        }
    }
    if name.length() ≡ 0 {
        return null
    }
    if name.slice(0, 1) ≡ "/" {
        return null
    }
    mut FakeElement node ← fake_element(name)
    # Attribute scan (single/double-quoted or bare values; boolean attrs).
    mut bool in_tag ← true
    while j ≺ html.length() and in_tag {
        if html.slice(j, j + 1) ≡ ">" {
            j ← j + 1
            in_tag ← false
        } else {
            if html.slice(j, j + 1) ≡ " " {
                j ← j + 1
            } else {
                mut string attr_name ← ""
                mut bool reading_name ← true
                while j ≺ html.length() and reading_name {
                    let string ch ← html.slice(j, j + 1)
                    if ch ≡ "=" or ch ≡ ">" or ch ≡ " " {
                        reading_name ← false
                    } else {
                        attr_name ← attr_name + ch
                        j ← j + 1
                    }
                }
                mut bool skipping ← true
                while j ≺ html.length() and skipping {
                    if html.slice(j, j + 1) ≡ " " {
                        j ← j + 1
                    } else {
                        skipping ← false
                    }
                }
                if j ≺ html.length() and html.slice(j, j + 1) ≡ "=" {
                    j ← j + 1
                    mut bool skipping2 ← true
                    while j ≺ html.length() and skipping2 {
                        if html.slice(j, j + 1) ≡ " " {
                            j ← j + 1
                        } else {
                            skipping2 ← false
                        }
                    }
                    if j ≺ html.length() and (html.slice(j, j + 1) ≡ "'" or html.slice(j, j + 1) ≡ q) {
                        let string quote ← html.slice(j, j + 1)
                        j ← j + 1
                        mut string val ← ""
                        mut bool reading_val ← true
                        while j ≺ html.length() and reading_val {
                            let string ch ← html.slice(j, j + 1)
                            if ch ≡ quote {
                                reading_val ← false
                            }
                            if not (ch ≡ quote) {
                                val ← val + ch
                            }
                            j ← j + 1
                        }
                        element_attr_set(mut node, attr_name, unescape_html(val))
                    } else {
                        mut string val ← ""
                        mut bool reading_bare ← true
                        while j ≺ html.length() and reading_bare {
                            let string ch ← html.slice(j, j + 1)
                            if ch ≡ " " or ch ≡ ">" {
                                reading_bare ← false
                            } else {
                                val ← val + ch
                                j ← j + 1
                            }
                        }
                        element_attr_set(mut node, attr_name, unescape_html(val))
                    }
                } else {
                    element_attr_set(mut node, attr_name, "")
                }
            }
        }
    }
    if is_void_tag(name) {
        return ParseResult { node = node, next = j }
    }
    mut bool closed ← false
    while j ≺ html.length() and not closed {
        if j + name.length() + 3 ≤ html.length() and html.slice(j, j + name.length() + 3) ≡ "</" + name + ">" {
            j ← j + name.length() + 3
            closed ← true
        } else {
            if html.slice(j, j + 1) ≡ "<" {
                mut ParseResult ∪ none child ← parse_element(html, j)
                if child not is none {
                    mut ParseResult certain ← child
                    element_append_child(node, mut certain.node)
                    j ← certain.next
                } else {
                    j ← j + 1
                }
            } else {
                let int end ← index_of(html, "<", j)
                if end ≺ 0 {
                    let string text ← html.slice(j, html.length())
                    if text.length() ≻ 0 {
                        mut FakeElement text_node ← make_text_node(text)
                        element_append_child(node, mut text_node)
                    }
                    j ← html.length()
                } else {
                    let string text ← html.slice(j, end)
                    if text.length() ≻ 0 {
                        mut FakeElement text_node ← make_text_node(text)
                        element_append_child(node, mut text_node)
                    }
                    j ← end
                }
            }
        }
    }
    return ParseResult { node = node, next = j }
}

# Parse a serializer-shaped markup string into top-level nodes.
fn parse_fragment(string html) → list<FakeElement> {
    mut list<FakeElement> nodes ← empty
    mut int i ← 0
    while i ≺ html.length() {
        if html.slice(i, i + 1) ≡ "<" {
            let ParseResult ∪ none parsed ← parse_element(html, i)
            if parsed not is none {
                let ParseResult certain ← parsed
                nodes.append(certain.node)
                i ← certain.next
            } else {
                i ← i + 1
            }
        } else {
            let int end ← index_of(html, "<", i)
            if end ≺ 0 {
                let string text ← html.slice(i, html.length())
                if text.length() ≻ 0 {
                    nodes.append(make_text_node(text))
                }
                i ← html.length()
            } else {
                let string text ← html.slice(i, end)
                if text.length() ≻ 0 {
                    nodes.append(make_text_node(text))
                }
                i ← end
            }
        }
    }
    return nodes
}

# ---------------------------------------------------------------------------
# The webDom* runtime-binding surface (mirrors faber-web/runtime/dom.ts;
# operates against the fake document passed explicitly).
# ---------------------------------------------------------------------------

fn scoped_require(FakeDocument doc, string selector) → FakeElement {
    let FakeElement ∪ none element ← doc_query_selector(doc, selector)
    if element not is none {
        let FakeElement certain ← element
        return certain
    }
    panic "dom-shim: required selector not found: " + selector
}

fn web_dom_scope(FakeDocument doc, string selector) → FakeScope {
    if selector.length() ≡ 0 {
        # The shim's empty-selector default roots the scope at the document.
        # The document's tree IS the body subtree (children = [body]), so a
        # scope rooted at the body is query-equivalent for the harness.
        return FakeScope { root = doc.body, selector = selector }
    }
    let FakeElement root ← scoped_require(doc, selector)
    return FakeScope { root = root, selector = selector }
}

fn web_dom_query(FakeScope scope, string selector) → FakeElement ∪ none {
    return element_query_selector(scope.root, selector)
}

fn web_dom_require(FakeScope scope, string selector) → FakeElement {
    let FakeElement ∪ none element ← element_query_selector(scope.root, selector)
    if element not is none {
        let FakeElement certain ← element
        return certain
    }
    panic "dom-shim: required selector not found: " + selector
}

fn web_dom_all(FakeScope scope, string selector) → list<FakeElement> {
    return element_query_all(scope.root, selector)
}

# The typed hydration snapshot read: one FakeNodus per data-tela descendant
# of the scoped root (identity + tag name). Null only for a null scope.
fn web_dom_snapshot(FakeScope ∪ none scope) → list<FakeNodus> ∪ none {
    if scope is none {
        return null
    }
    let FakeScope certain ← scope
    let list<FakeElement> nodes ← element_query_all(certain.root, "[data-tela]")
    mut list<FakeNodus> out ← empty
    mut int i ← 0
    while i ≺ nodes.length() {
        out.append(FakeNodus { identity = nodes[i].data_tela, tag = nodes[i].tagName.lowercase() })
        i ← i + 1
    }
    return out
}

fn web_dom_text_set(mut FakeElement element, string value) → void {
    element_text_set(mut element, value)
}

fn web_dom_attr_set(mut FakeElement element, string name, string value) → void {
    element_attr_set(mut element, name, value)
}

fn web_dom_attr_remove(mut FakeElement element, string name) → void {
    element_attr_remove(mut element, name)
}

fn web_dom_class_add(FakeElement element, string class_name) → void {
    class_list_add(element.class_list, class_name)
}

fn web_dom_class_remove(FakeElement element, string class_name) → void {
    class_list_remove(element.class_list, class_name)
}

fn web_dom_class_toggle(FakeElement element, string class_name) → bool {
    return class_list_toggle(element.class_list, class_name)
}

fn web_dom_on(mut FakeDocument doc, FakeElement element, string event_name, (FakeEvent) → void handler) → FakeSubscription {
    element_add_listener(element, event_name, handler)
    doc.active_subscriptions.put(doc.next_subscription_id, SubscriptionRecord { element = element, event_name = event_name, handler = handler })
    doc.next_subscription_id ← doc.next_subscription_id + 1
    return FakeSubscription { id = doc.next_subscription_id - 1 }
}

fn web_dom_unsubscribe(FakeDocument doc, FakeSubscription subscription) → void {
    let SubscriptionRecord ∪ none record ← doc.active_subscriptions.get(subscription.id)
    if record not is none {
        let SubscriptionRecord certain ← record
        element_remove_listener(certain.element, certain.event_name, certain.handler)
    }
    doc.active_subscriptions.delete(subscription.id)
}

fn web_dom_value(FakeElement element) → string {
    return element.value
}

fn web_dom_value_set(mut FakeElement element, string value) → void {
    element.value ← value
}

fn web_dom_on_input(mut FakeDocument doc, FakeElement element, (FakeElement, string) → void handler) → FakeSubscription {
    return web_dom_on(mut doc, element, "input", FakeEvent event → void ∴ handler(element, web_dom_value(element)))
}

fn submit_dispatch(mut FakeEvent event, FakeElement form, FakeSubmitOptions options, (FakeElement) → void handler) → void {
    if options.prevent_default {
        event_prevent_default(mut event)
    }
    handler(form)
}

fn web_dom_on_submit(mut FakeDocument doc, FakeElement form, FakeSubmitOptions options, (FakeElement) → void handler) → FakeSubscription {
    return web_dom_on(mut doc, form, "submit", FakeEvent event → void ∴ submit_dispatch(mut event, form, options, handler))
}

fn web_dom_on_keyboard(mut FakeDocument doc, FakeElement element, string event_name, (FakeKeyboardState) → void handler) → FakeSubscription {
    return web_dom_on(mut doc, element, event_name, FakeEvent event → void ∴ handler(FakeKeyboardState { kind = event.kind, key = event.key, code = event.code, repeat = event.repeat, alt = event.alt_key, ctrl = event.ctrl_key, shift = event.shift_key, meta = event.meta_key }))
}

fn web_dom_on_pointer(mut FakeDocument doc, FakeElement element, string event_name, (FakePointerState) → void handler) → FakeSubscription {
    return web_dom_on(mut doc, element, event_name, FakeEvent event → void ∴ handler(FakePointerState { kind = event.kind, x = event.client_x, y = event.client_y, movement_x = event.movement_x, movement_y = event.movement_y, button = event.button, primary = event.primary }))
}

fn web_dom_on_focus(mut FakeDocument doc, FakeElement element, string event_name, (FakeFocusState) → void handler) → FakeSubscription {
    let bool focused ← doc_has_focus(doc)
    let FakeSubscription subscription ← web_dom_on(mut doc, element, event_name, FakeEvent event → void ∴ handler(FakeFocusState { focused = focused }))
    handler(FakeFocusState { focused = focused })
    return subscription
}

fn web_dom_prevent_default(mut FakeEvent event) → FakeEvent {
    return event_prevent_default(mut event)
}

# ---------------------------------------------------------------------------
# The mount-plan executor + the region subscription binder.
# ---------------------------------------------------------------------------

fn find_child_by_identity(list<FakeElement> children, string identity) → FakeElement ∪ none {
    mut int i ← 0
    while i ≺ children.length() {
        if children[i].data_tela ≡ identity {
            return children[i]
        }
        i ← i + 1
    }
    return null
}

fn stamp_subtree(mut FakeElement node, string token) → void {
    if node.data_tela ≢ "" {
        node.token ← token
    }
    mut int i ← 0
    while i ≺ node.children.length() {
        stamp_subtree(mut node.children[i], token)
        i ← i + 1
    }
}

fn open_tag_equals(FakeElement a, FakeElement b) → bool {
    if a.tagName ≢ b.tagName {
        return false
    }
    if a.tagName ≡ "#text" {
        return element_text(a) ≡ element_text(b)
    }
    return element_attribute_shape(a) ≡ element_attribute_shape(b) and a.data_tela ≡ b.data_tela
}

fn clone_node(FakeElement node) → FakeElement {
    mut FakeElement clone ← fake_element(node.tagName)
    if node.tagName ≡ "#text" {
        element_text_set(mut clone, element_text(node))
        return clone
    }
    clone.value ← node.value
    clone.data_tela ← node.data_tela
    let list<string> names ← node.attrs.keys()
    mut int i ← 0
    while i ≺ names.length() {
        let string ∪ none maybe_value ← node.attrs.get(names[i])
        if maybe_value not is none {
            let string value ← maybe_value
            element_attr_set(mut clone, names[i], value)
        }
        i ← i + 1
    }
    let list<string> class_names ← class_list_names(node.class_list)
    mut int j ← 0
    while j ≺ class_names.length() {
        class_list_add(clone.class_list, class_names[j])
        j ← j + 1
    }
    clone.token ← node.token
    mut int k ← 0
    while k ≺ node.children.length() {
        mut FakeElement kid ← clone_node(node.children[k])
        element_append_child(clone, mut kid)
        k ← k + 1
    }
    return clone
}

fn find_match(list<FakeElement> children, string t_id, int k) → FakeElement ∪ none {
    if t_id ≢ "" {
        return find_child_by_identity(children, t_id)
    }
    if k ≺ children.length() {
        return children[k]
    }
    return null
}

# The region sync: rebuild the parent's children from the target list.
# "bind" identities keep the matched existing node (stamped "original" when
# stamping; recursed); everything else is a fresh clone of the View's node.
# Foreign + duplicate identity nodes are excluded by construction (the
# rebuild carries exactly the target's nodes — the shim's removal pass is
# the same result when the target order matches the present order, which
# holds for the proof corpus; recorded).
fn sync_region(mut FakeElement parent, list<FakeElement> target, map<string, string> plan, bool stamp) → void {
    mut list<FakeElement> rebuilt ← empty
    mut int k ← 0
    while k ≺ target.length() {
        let FakeElement t ← target[k]
        let string t_id ← t.data_tela
        mut FakeElement ∪ none match ← find_match(parent.children, t_id, k)
        mut string status ← "create"
        if t_id ≢ "" and plan.has(t_id) {
            let string ∪ none s ← plan.get(t_id)
            if s not is none {
                let string certain ← s
                status ← certain
            }
        }
        if match not is none {
            mut FakeElement certain_match ← match
            if status ≡ "bind" and open_tag_equals(certain_match, t) {
                if stamp {
                    certain_match.token ← "original"
                }
                sync_region(mut certain_match, t.children, plan, stamp)
                rebuilt.append(certain_match)
            } else {
                mut FakeElement fresh ← clone_node(t)
                if stamp {
                    stamp_subtree(mut fresh, "fresh")
                }
                rebuilt.append(fresh)
            }
        } else {
            mut FakeElement fresh ← clone_node(t)
            if stamp {
                stamp_subtree(mut fresh, "fresh")
            }
            rebuilt.append(fresh)
        }
        k ← k + 1
    }
    parent.children ← rebuilt
}

# Execute a mount plan against the installed fake DOM. Node-level policy
# follows the module's binding plan (bindings): "bind" identities bind to
# the existing matching node (stamped "original" when `stamp` is set);
# "create" identities are created/replaced from the View.
fn execute_mount_plan(FakeDocument doc, string selector, MountedLike mounted, bool stamp) → void {
    mut FakeElement root ← resolve_region(doc, selector)
    let list<FakeElement> target ← parse_fragment(mounted.markup)
    mut map<string, string> plan ← empty
    mut int i ← 0
    while i ≺ mounted.bindings.length() {
        plan.put(mounted.bindings[i].identity, mounted.bindings[i].status)
        i ← i + 1
    }
    sync_region(mut root, target, plan, stamp)
}

# Bind a webDom subscription per Mounted descriptor onto the identity node.
fn bind_region_subscriptions(mut FakeDocument doc, string selector, MountedLike mounted, (FakeEvent) → void handler) → list<FakeSubscription> {
    let FakeElement root ← resolve_region(doc, selector)
    let list<FakeElement> nodes ← element_query_all(root, "[data-tela]")
    mut list<FakeSubscription> subs ← empty
    mut int i ← 0
    while i ≺ mounted.subscriptions.length() {
        let FakeElement ∪ none node ← find_child_by_identity(nodes, mounted.subscriptions[i].identity)
        if node not is none {
            let FakeElement certain ← node
            subs.append(web_dom_on(mut doc, certain, mounted.subscriptions[i].event_name, handler))
        } else {
            panic "dom-shim: subscription target missing: " + mounted.subscriptions[i].identity
        }
        i ← i + 1
    }
    return subs
}
