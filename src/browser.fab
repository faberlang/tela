# tela/src/browser.fab — tela:browser — the browser mount/update/dispose lifecycle.
#
# Stage 3 U2 (browser-mount) + Stage 4 U6 (seam restoration). The host seam
# is web:dom (faber-web — la locale, ts-only). The CTO10-3 gate is OPEN:
# cds-u5 (cross-package locale propagation, radix e32397630) + cds-u6
# (file-interface-exports, radix 2103f8a7f) landed, and the hydration
# snapshot op landed in faber-web (0d79f5b — web:dom.snapshot →
# webDomSnapshot). This module now consumes web:dom DIRECTLY through the
# documented host seam — the spec-locked shape
# `mount(dom.Scope, Visus, Thema)` per browser-lifecycle.md §1. The en→la
# import + the WARN014 export-skip removal predicates are re-verified live
# (never assumed); the opaque fallback carriers + the harness-level webDom*
# binding posture are REMOVED — the marker records flip to removed in
# browser-lifecycle.md §11 (grep-verified: no live marker site in tela/src).
#
# MODULE SHAPE (locked):
#   - FLAT: public signatures reference tela:tela types + the web:dom seam
#     types (dom.Scope/dom.Nodus) — the cross-package export skip no longer
#     applies (cds-u6: imported-sibling signatures export).
#   - PURE: mount/replace/dispose are PURE PLANNERS over the host seam —
#     they compute the render plan (serialized markup, theme cascade,
#     identity index, hydration diagnostics, binding plan, effect list);
#     the host executes the plan against the DOM. Deterministic bytes over
#     author order.
#   - HYDRATION VIA THE TYPED SNAPSHOT (head-cto fire-13 + the U6 seam
#     discovery): mount derives the pre-existing identity set + the
#     per-identity tag names from `dom.snapshot(scope)` — a TYPED read
#     (identity + tag per data-tela descendant; NO textual DOM parse). The
#     bind-vs-create + muta comparison normalizes BOTH sides to TAG NAMES:
#     the view side extracts the tag name from the serializer's open tag,
#     the praesens side uses the snapshot's typed tag. Tag names carry no
#     quotes, so the serializer's single-quote vs the real DOM's
#     double-quote serialization never enters the comparison (the
#     discovery's quote-style finding resolved at the comparison level).
#
# fix:<id> markers:
#   (the web:dom locale-gap workaround — REMOVED by cds-u5; the WARN014
#   export-skip workaround — REMOVED by cds-u6; both marker rows flip to
#   removed in browser-lifecycle.md §11 — grep-verified: no live marker
#   site remains in tela/src).
#   fix:codegen001 — PARTIAL: the provider-module locale-propagation half
#     is fixed (cds-u5); browser.fab remains ts-only because web:dom is
#     ts-only (Rust emit of a web:dom-importing module is doubly out) —
#     recorded, never the gate.
#   fix:prim-nullable — extended observation: a `lista<X> ∪ nihil` cannot
#     call methods directly in an en fn body on this radix (the non-null /
#     optional chain Member resolution does not route to list methods).
#     Workaround (landed): bind the ∪ null, check `is null`, then narrow
#     inside `if nodi not is null { … }` to a non-null copy (the triga
#     `vp_result![k]` precedent extended); method calls run on the copy.
#   fix:g5 — NONE: mount/replace/dispose/radiculum/subscriptio/ligamen/
#     focus_tenet/focus_optata/parse_identitates/elementum_tag/nomen_tagi/
#     tag_at/identitates_ex_nodis/tags_ex_nodis probed collision-free on
#     in-tree radix 0.80.0 (a free fn may share a class name — G5's
#     collision is enum-member-specific).
#   fix:snapshot-nomen-collision — the carrier names avoid kernel type
#     names (Eventum/Effectus/Renovatio/Visus/…) AND the web:dom genus
#     names (Scope/Element/Nodus/DomEvent/… — the seam types are imported,
#     never re-declared).

import from "tela:tela" public * ut tela
import from "web:dom" public * ut dom

# ---------------------------------------------------------------------------
# Mounted-region carriers (the locked Mounted state shape — plain value
# carriers, not DOM seam handles; the seam handle IS dom.Scope).
# ---------------------------------------------------------------------------

# A mounted region root handle (the region this mount owns — the scope
# selector doubles as the region identity for scroll-anchor intent).
class Radiculum {
    string identitas
}

# A live subscription handle; the host maps identitas → the bound
# web:dom subscription on the node (data-tela='identitas').
class Subscriptio {
    string identitas
    string nomen_eventi
}

# One binding-plan entry: a view identity + its hydration status.
# status "ligare" = bind the existing matching node (hydration);
# status "creare" = create/replace the node from the View.
class Ligamen {
    string identitas
    string status
}

# Mounted — the mount state carrier (delivery U2 done_when (b)): host
# state (scope + root + subscriptions), current Visus + active Thema, the
# render plan (markup + css), the identity index, the hydration
# diagnostics, and the modeled focus state.
class Mounted {
    dom.Scope scopus
    Radiculum radix
    tela.Visus visus
    tela.Thema thema
    string textus_markup
    string textus_css
    list<string> identitates
    list<string> diagnosia
    list<Ligamen> ligamina
    list<Subscriptio> subscriptiones
    string identitas_focus
    string identitas_focus_optata
}

# Kernel-owned constructors (G3 posture — ordinary functions over the same
# public values, like the Stage 1/2/3-U1 kernel constructors). The scope is
# constructed by the CALLER via the provider seam (`dom.scope(selector)`).
fn radiculum(string identitas) → Radiculum {
    return Radiculum { identitas = identitas }
}

fn subscriptio(string identitas, string nomen_eventi) → Subscriptio {
    return Subscriptio { identitas = identitas, nomen_eventi = nomen_eventi }
}

fn ligamen(string identitas, string status) → Ligamen {
    return Ligamen { identitas = identitas, status = status }
}

# ---------------------------------------------------------------------------
# The serializer's identity marker (policy (d) emission form). The kernel
# always emits " data-tela='<escaped valor>'" — the leading space makes the
# marker distinguishable from the string appearing mid-text.
# ---------------------------------------------------------------------------

fn nota_identitatis() → string {
    return " data-tela='"
}

# ---------------------------------------------------------------------------
# Identity parsing over serialized Tela markup. Returns every data-tela
# identity in document order (escaped form unescaped). Bounded fidelity:
# text/attributes embedding the exact marker string are out of the proof
# corpus (recorded). Operates on the VIEW markup ONLY (tela's own serializer
# output) — the praesens identity set comes from the typed snapshot.
# ---------------------------------------------------------------------------

fn unescape(string textus) → string {
    var string accum ← ""
    var int i ← 0
    while i < textus.longitudo() {
        var string fragment ← textus.sectio(i, i + 1)
        var int step ← 1
        if not (i + 5 > textus.longitudo()) and textus.sectio(i, i + 5) ≡ "&quot;" {
            fragment ← "§"('"')
            step ← 5
        }
        if not (i + 5 > textus.longitudo()) and textus.sectio(i, i + 5) ≡ "&#39;" {
            fragment ← "'"
            step ← 5
        }
        if not (i + 4 > textus.longitudo()) and textus.sectio(i, i + 4) ≡ "&amp;" {
            fragment ← "&"
            step ← 4
        }
        if not (i + 4 > textus.longitudo()) and textus.sectio(i, i + 4) ≡ "&lt;" {
            fragment ← "<"
            step ← 4
        }
        if not (i + 4 > textus.longitudo()) and textus.sectio(i, i + 4) ≡ "&gt;" {
            fragment ← ">"
            step ← 4
        }
        accum ← accum + fragment
        i ← i + step
    }
    return accum
}

fn parse_identitates(string textus) → list<string> {
    var list<string> identitates ← vacua
    var int i ← 0
    while i < textus.longitudo() {
        if not (i + 12 > textus.longitudo()) and textus.sectio(i, i + 12) ≡ nota_identitatis() {
            var string raw ← ""
            var int j ← i + 12
            var bool terminatum ← false
            while j < textus.longitudo() and not terminatum {
                const string ch ← textus.sectio(j, j + 1)
                if ch ≡ "'" {
                    terminatum ← true
                }
                if not (ch ≡ "'") {
                    raw ← raw + ch
                }
                j ← j + 1
            }
            if terminatum {
                identitates.appende(unescape(raw))
                i ← j
            }
            if not terminatum {
                i ← i + 1
            }
        } else {
            i ← i + 1
        }
    }
    return identitates
}

# The open-tag shape of the element carrying the given identity (from the
# previous '<' to the next '>') in the VIEW markup, or null when the
# identity is absent or the element is malformed.
fn elementum_tag(string textus, string identitas) → string ∪ null {
    var int i ← 0
    while i < textus.longitudo() {
        if not (i + 12 > textus.longitudo()) and textus.sectio(i, i + 12) ≡ nota_identitatis() {
            var string raw ← ""
            var int j ← i + 12
            var bool terminatum ← false
            while j < textus.longitudo() and not terminatum {
                const string ch ← textus.sectio(j, j + 1)
                if ch ≡ "'" {
                    terminatum ← true
                }
                if not (ch ≡ "'") {
                    raw ← raw + ch
                }
                j ← j + 1
            }
            if terminatum and unescape(raw) ≡ identitas {
                var int a ← i
                var bool inventum ← false
                while a > 0 and not inventum {
                    const string ch ← textus.sectio(a - 1, a)
                    if ch ≡ "<" {
                        inventum ← true
                    }
                    if not (ch ≡ "<") {
                        a ← a - 1
                    }
                }
                var int b ← j
                var bool clausum ← false
                while b < textus.longitudo() and not clausum {
                    const string ch ← textus.sectio(b, b + 1)
                    if ch ≡ ">" {
                        clausum ← true
                    }
                    if not (ch ≡ ">") {
                        b ← b + 1
                    }
                }
                if inventum and clausum then return textus.sectio(a - 1, b + 1)
                return null
            }
            i ← j
        } else {
            i ← i + 1
        }
    }
    return null
}

# The TAG NAME of an open-tag string ("<button role='radio' …>" →
# "button") — the first token after '<'. The hydration comparison
# normalizes both sides to tag names: the view side extracts the tag name
# from the serializer's open tag; the praesens side uses the typed tag name
# from the hydration snapshot. Tag names carry no quotes, so the
# serializer's single-quote vs the real DOM's double-quote serialization
# never enters the comparison (the U6 discovery's quote-style finding).
fn nomen_tagi(string tag) → string {
    var string result ← ""
    var int i ← 1
    var bool finitum ← false
    while i < tag.longitudo() and not finitum {
        const string ch ← tag.sectio(i, i + 1)
        if ch ≡ " " or ch ≡ ">" {
            finitum ← true
        }
        if not (ch ≡ " ") and not (ch ≡ ">") {
            result ← result + ch
        }
        i ← i + 1
    }
    return result
}

# Occurrence count of an identity in a list.
fn quotiens(list<string> collatio, string nomen) → int {
    var int quotiens ← 0
    var int i ← 0
    while i < collatio.longitudo() {
        if collatio[i] ≡ nomen {
            quotiens ← quotiens + 1
        }
        i ← i + 1
    }
    return quotiens
}

# Distinct identities appearing more than once (the ambiguity set).
fn identitates_duplicatae(list<string> collatio) → list<string> {
    var list<string> duplicatae ← vacua
    var int i ← 0
    while i < collatio.longitudo() {
        const string identitas ← collatio[i]
        if quotiens(collatio, identitas) > 1 and not duplicatae.continet(identitas) {
            duplicatae.appende(identitas)
        }
        i ← i + 1
    }
    return duplicatae
}

# ---------------------------------------------------------------------------
# The G4-safe tag-index adapters (the U6 discovery's item 4): consume the
# provider's TYPED hydration snapshot (web:dom.snapshot → lista<Nodus> ∪
# nihil — identity + tag name per data-tela descendant) and produce the two
# parallel string lists the pure policy fns take — the pre-existing
# identity set + the aligned per-identity tag names. No textual DOM parse:
# the identity set + tags arrive typed from the snapshot. A null snapshot
# (the runtime returns null only for a null scope) narrows to empty.
# ---------------------------------------------------------------------------

fn identitates_ex_nodis(list<dom.Nodus> ∪ null nodi) → list<string> {
    var list<dom.Nodus> certa ← vacua
    if nodi not is null {
        certa ← nodi
    }
    var list<string> result ← vacua
    var int i ← 0
    while i < certa.longitudo() {
        result.appende(certa[i].identitas)
        i ← i + 1
    }
    return result
}

fn tags_ex_nodis(list<dom.Nodus> ∪ null nodi) → list<string> {
    var list<dom.Nodus> certa ← vacua
    if nodi not is null {
        certa ← nodi
    }
    var list<string> result ← vacua
    var int i ← 0
    while i < certa.longitudo() {
        result.appende(certa[i].tag)
        i ← i + 1
    }
    return result
}

# The tag name for a pre-existing identity: the aligned tag-index lookup
# ("" when the identity is absent from the praesens set).
fn tag_at(string identitas, list<string> identitates, list<string> tags) → string {
    var int i ← 0
    while i < identitates.longitudo() {
        if identitates[i] ≡ identitas {
            return tags[i]
        }
        i ← i + 1
    }
    return ""
}

# ---------------------------------------------------------------------------
# The hydration policy, exposed as pure string/list functions (G4-safe —
# these signatures carry NO imported types, so they stay on the exported
# file interface; mount composes them). The exempla + the assembled driver
# both consume them: the check-time exempla asserts the policy decisions,
# the runtime driver executes the plan.
# ---------------------------------------------------------------------------

# The binding-status decision for one View identity: "ligare" (bind the
# existing matching node — hydration) only when the identity is unique in
# both markups AND the VIEW element's tag name equals the PRAESENS node's
# typed tag name (from the hydration snapshot); "creare" (create/replace
# the node from the View) otherwise — including every ambiguous/mismatched
# case (duplicated identity, out-of-shape tag, missing node).
fn ligamen_status(
    string identitas,
    list<string> identitates_view,
    list<string> identitates_praesentes,
    string markup,
    list<string> tags_praesentes
) → string {
    var bool ligare ← false
    if quotiens(identitates_praesentes, identitas) ≡ 1 and quotiens(identitates_view, identitas) ≡ 1 {
        const string tag_view ← nomen_tagi(elementum_tag(markup, identitas) coalesce "")
        const string tag_praesens ← tag_at(identitas, identitates_praesentes, tags_praesentes)
        if not (tag_view ≡ "") and not (tag_praesens ≡ "") and tag_view ≡ tag_praesens {
            ligare ← true
        }
    }
    if ligare then return "ligare"
    return "creare"
}

# The hydration diagnostics for a mount, in deterministic order:
#   duplicata:<id> — the identity appears more than once in the View markup
#     or in the pre-existing markup (identity-hydration.md §6 ambiguity —
#     never a silent bind);
#   extranea:<id> — a pre-existing identity absent from the View (mismatch
#     → the region is replaced from the View);
#   muta:<id> — the identity is present in both, unique in both, but the
#     element TAG NAMES differ (out-of-shape node → replaced from the View;
#     the fidelity is the snapshot's tag-name surface — the landed
#     web:dom.snapshot carries identity + tag name, recorded in
#     browser-lifecycle.md).
fn diagnosia_hydrationis(
    string markup,
    list<string> identitates_view,
    list<string> identitates_praesentes,
    list<string> tags_praesentes
) → list<string> {
    var list<string> diagnosia ← vacua
    const list<string> duplicatae_view ← identitates_duplicatae(identitates_view)
    var int di ← 0
    while di < duplicatae_view.longitudo() {
        diagnosia.appende("duplicata:" + duplicatae_view[di])
        di ← di + 1
    }
    const list<string> duplicatae_praesentes ← identitates_duplicatae(identitates_praesentes)
    var int dj ← 0
    while dj < duplicatae_praesentes.longitudo() {
        diagnosia.appende("duplicata:" + duplicatae_praesentes[dj])
        dj ← dj + 1
    }
    var int ek ← 0
    while ek < identitates_praesentes.longitudo() {
        const string identitas ← identitates_praesentes[ek]
        if not identitates_view.continet(identitas) {
            diagnosia.appende("extranea:" + identitas)
        }
        ek ← ek + 1
    }
    var int mi ← 0
    while mi < identitates_view.longitudo() {
        const string identitas ← identitates_view[mi]
        if quotiens(identitates_praesentes, identitas) ≡ 1 and quotiens(identitates_view, identitas) ≡ 1 {
            const string tag_view ← nomen_tagi(elementum_tag(markup, identitas) coalesce "")
            const string tag_praesens ← tag_at(identitas, identitates_praesentes, tags_praesentes)
            if not (tag_view ≡ "") and not (tag_praesens ≡ "") and tag_view ≠ tag_praesens {
                diagnosia.appende("muta:" + identitas)
            }
        }
        mi ← mi + 1
    }
    return diagnosia
}

# ---------------------------------------------------------------------------
# The mount lifecycle. Pure planner over the host seam: renders the View
# into the scope (serialized markup), applies the theme cascade, and
# hydrates — the pre-existing identity set + per-identity tag names come
# from the provider's TYPED hydration snapshot (dom.snapshot — no textual
# DOM parse); matching data-tela nodes bind instead of being recreated;
# mismatch diagnoses + replaces the mismatched region from the View
# (declared policy); duplicate data-tela values are diagnosed, never a
# silent bind (identity-hydration.md §6).
# ---------------------------------------------------------------------------

fn mount(dom.Scope scopus, tela.Visus visus, tela.Thema thema) → Mounted ∪ null {
    # Fail-closed: an invalid View (html_visus null), an invalid Theme
    # (thema_css null), or a null hydration snapshot (the runtime returns
    # null only for a null scope) never mounts — no partial region. The
    # nullable checks run against the call / the bound nullable
    # (fix:prim-nullable workaround).
    if tela.html_visus(visus) is null then return null
    const string markup ← tela.html_visus(visus) coalesce ""
    if tela.thema_css(thema) is null then return null
    const string css ← tela.thema_css(thema) coalesce ""

    const list<string> identitates_view ← parse_identitates(markup)

    # The typed hydration read (head-cto fire-13 + the U6 discovery): the
    # provider's snapshot per data-tela descendant → the parallel string
    # lists the policy fns consume. The Scope.textus_praesens carrier is
    # GONE — the pre-existing state is READ from the DOM, never carried.
    const list<dom.Nodus> ∪ null nodi ← dom.snapshot(scopus)
    if nodi is null then return null
    const list<string> identitates_praesentes ← identitates_ex_nodis(nodi)
    const list<string> tags_praesentes ← tags_ex_nodis(nodi)

    # The hydration policy (diagnose + bind) lives in the exposed pure
    # functions above — mount composes them into the plan.
    const list<string> diagnosia ← diagnosia_hydrationis(markup, identitates_view, identitates_praesentes, tags_praesentes)

    # Binding plan: per View identity in order (ligamen_status decides).
    var list<Ligamen> ligamina ← vacua
    var int li ← 0
    while li < identitates_view.longitudo() {
        const string status ← ligamen_status(identitates_view[li], identitates_view, identitates_praesentes, markup, tags_praesentes)
        ligamina.appende(ligamen(identitates_view[li], status))
        li ← li + 1
    }

    # Region-bind subscriptions: one per View identity (the U2 dispose
    # proof surface; the app's event bindings are app-typed in U3). The
    # host binds a web:dom on(node, "tela:ligamen") per descriptor.
    var list<Subscriptio> subscriptiones ← vacua
    var int sub ← 0
    while sub < identitates_view.longitudo() {
        subscriptiones.appende(subscriptio(identitates_view[sub], "tela:ligamen"))
        sub ← sub + 1
    }

    return Mounted {
        scopus = scopus,
        radix = radiculum(scopus.selector),
        visus = visus,
        thema = thema,
        textus_markup = markup,
        textus_css = css,
        identitates = identitates_view,
        diagnosia = diagnosia,
        ligamina = ligamina,
        subscriptiones = subscriptiones,
        identitas_focus = "",
        identitas_focus_optata = ""
    }
}

# ---------------------------------------------------------------------------
# The replace lifecycle. Rerenders/replaces the explicitly mounted region
# with the next View and returns the update result (Renovatio) whose
# declarative effects are derived from the before/after state
# (behavior-design §3.1/§3.2): focus restoration to the pre-replacement
# focused identity (modeled via focus_tenet), declared focus movement
# (modeled via focus_optata), and scroll-anchor intent for the region.
# The host executes the effects after replacement — declarative on the
# update result, never imperative post-update user-code calls.
# ---------------------------------------------------------------------------

fn replace(Mounted m, tela.Visus visus) → tela.Renovatio ∪ null {
    if tela.html_visus(visus) is null then return null
    var list<tela.Effectus> effectus ← vacua
    if not (m.identitas_focus ≡ "") {
        effectus.appende(tela.restitue(m.identitas_focus))
    }
    if not (m.identitas_focus_optata ≡ "") {
        effectus.appende(tela.dirige(m.identitas_focus_optata))
    }
    effectus.appende(tela.ancora(m.radix.identitas))
    return tela.renovatio(visus, effectus)
}

# The dispose lifecycle. Unsubscribes every active subscription and clears
# the region. Pure marker here (the host executes the unsubscribe plan —
# the web:dom surface binds through the documented provider seam).
fn dispose(Mounted m) → void {
}

# --- modeled focus state (before/after state for effect derivation) ------

# Model: the pre-replacement focused identity (→ Restitue on replace).
# The host mirrors the model onto the actual DOM focus at execution.
fn focus_tenet(Mounted m, string identitas) → Mounted {
    return Mounted {
        scopus = m.scopus,
        radix = m.radix,
        visus = m.visus,
        thema = m.thema,
        textus_markup = m.textus_markup,
        textus_css = m.textus_css,
        identitates = m.identitates,
        diagnosia = m.diagnosia,
        ligamina = m.ligamina,
        subscriptiones = m.subscriptiones,
        identitas_focus = identitas,
        identitas_focus_optata = m.identitas_focus_optata
    }
}

# Model: a declared focus-movement target identity (→ Dirige on replace).
fn focus_optata(Mounted m, string identitas) → Mounted {
    return Mounted {
        scopus = m.scopus,
        radix = m.radix,
        visus = m.visus,
        thema = m.thema,
        textus_markup = m.textus_markup,
        textus_css = m.textus_css,
        identitates = m.identitates,
        diagnosia = m.diagnosia,
        ligamina = m.ligamina,
        subscriptiones = m.subscriptiones,
        identitas_focus = m.identitas_focus,
        identitas_focus_optata = identitas
    }
}
