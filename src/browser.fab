# tela/src/browser.fab — tela:browser — the browser mount/update/dispose lifecycle.
#
# Stage 3 U2 (browser-mount) + Stage 4 U6 (seam restoration) +
# web-surface-import U4 (browser-flip-harness-rewire, the tela:dom flip).
# The host seam is tela:dom (tela-owned — the en conversion of the faber-web
# DOM contract, web-import-u1; the la `web:dom` provider dependency leaves
# tela/src at this boundary). The flip renames the seam type references:
# `dom.Nodus` → `dom.DomNode`, `.identitas` → `.identity` (DELIVERY §5.2).
# This module consumes tela:dom DIRECTLY through the documented host seam —
# the spec-locked shape `mount(dom.Scope, View, Theme)` per
# browser-lifecycle.md §1. The WARN014 export-skip predicates are
# re-verified live (never assumed); the opaque fallback carriers + the
# harness-level webDom* binding posture are REMOVED — the marker records
# flip to removed in browser-lifecycle.md §11 (grep-verified: no live
# marker site in tela/src).
#
# MODULE SHAPE (locked):
#   - FLAT: public signatures reference tela:tela types + the tela:dom seam
#     types (dom.Scope/dom.DomNode) — the cross-package export skip no
#     longer applies (cds-u6: imported-sibling signatures export).
#   - PURE: mount/replace/dispose are PURE PLANNERS over the host seam —
#     they compute the render plan (serialized markup, theme cascade,
#     identity index, hydration diagnostics, binding plan, effect list);
#     the host executes the plan against the DOM. Deterministic bytes over
#     author order.
#   - HYDRATION VIA THE TYPED SNAPSHOT (head-cto fire-13 + the U6 seam
#     discovery): mount derives the pre-existing identity set + the
#     per-identity tag names from `dom.snapshot(scope)` — a TYPED read
#     (identity + tag per data-tela descendant; NO textual DOM parse). The
#     bind-vs-create + changed comparison normalizes BOTH sides to TAG NAMES:
#     the view side extracts the tag name from the serializer's open tag,
#     the present side uses the snapshot's typed tag. Tag names carry no
#     quotes, so the serializer's single-quote vs the real DOM's
#     double-quote serialization never enters the comparison (the
#     discovery's quote-style finding resolved at the comparison level).
#
# fix:<id> markers:
#   (the web:dom locale-gap workaround — REMOVED by cds-u5 + the U4 flip;
#   the WARN014 export-skip workaround — REMOVED by cds-u6; both marker rows
#   flip to removed in browser-lifecycle.md §11 — grep-verified: no live
#   marker site remains in tela/src).
#   fix:codegen001 — PARTIAL: the provider-module locale-propagation half
#     is fixed (cds-u5); browser.fab remains ts-only because tela:dom is
#     ts-only (Rust emit of a tela:dom-importing module is doubly out) —
#     recorded, never the gate.
#   fix:prim-nullable — RESOLVED for the narrowed-list case (nn-u3b,
#     radix 255c4c8cf): `if nodes not is null { … }` flow-narrows the
#     union binding, so `nodes.length()` / `nodes[i].identity` call
#     directly on the narrowed receiver — the `certain` non-null copy
#     carrier is REMOVED (nn-revert-2). Remaining surface: a primitive
#     `T ∪ null` const/var annotation and a `!` unwrap of a primitive
#     nullable still do not parse in named fn bodies (PARSE030/PARSE001);
#     workaround kept at the mount sites (`coalesce ""` on the null-checked
#     calls).
#   fix:g5 — NONE: mount/replace/dispose/region_root/event_subscription/binding/
#     focus_held/focus_target/parse_identities/element_tag/tag_name/
#     tag_at/identities_from_nodes/tags_from_nodes probed collision-free on
#     in-tree radix 0.80.0 (a free fn may share a class name — G5's
#     collision is enum-member-specific).
#   fix:snapshot-name-collision — the carrier names avoid kernel type
#     names (EventName/Effect/Update/View/…) AND the tela:dom genus
#     names (Scope/Element/DomNode/DomEvent/… — the seam types are
#     imported, never re-declared).

import from "tela:tela" public * as tela
import from "tela:dom" public * as dom

# ---------------------------------------------------------------------------
# Mounted-region carriers (the locked Mounted state shape — plain value
# carriers, not DOM seam handles; the seam handle IS dom.Scope).
# ---------------------------------------------------------------------------

# A mounted region root handle (the region this mount owns — the scope
# selector doubles as the region identity for scroll-anchor intent).
class RegionRoot {
    string identity
}

# A live subscription handle; the host maps identity → the bound
# tela:dom subscription on the node (data-tela='identity').
class EventSubscription {
    string identity
    string event_name
}

# One binding-plan entry: a view identity + its hydration status.
# status "bind" = bind the existing matching node (hydration);
# status "create" = create/replace the node from the View.
class Binding {
    string identity
    string status
}

# Mounted — the mount state carrier (delivery U2 done_when (b)): host
# state (scope + root + subscriptions), current View + active Theme, the
# render plan (markup + css), the identity index, the hydration
# diagnostics, and the modeled focus state.
class Mounted {
    dom.Scope scope
    RegionRoot root
    tela.View view
    tela.Theme theme
    string markup
    string css_text
    list<string> identities
    list<string> diagnostics
    list<Binding> bindings
    list<EventSubscription> subscriptions
    string focused_identity
    string target_identity
}

# Kernel-owned constructors (G3 posture — ordinary functions over the same
# public values, like the Stage 1/2/3-U1 kernel constructors). The scope is
# constructed by the CALLER via the provider seam (`dom.scope(selector)`).
fn region_root(string identity) → RegionRoot {
    return RegionRoot { identity = identity }
}

fn event_subscription(string identity, string event_name) → EventSubscription {
    return EventSubscription { identity = identity, event_name = event_name }
}

fn binding(string identity, string status) → Binding {
    return Binding { identity = identity, status = status }
}

# ---------------------------------------------------------------------------
# The serializer's identity marker (policy (d) emission form). The kernel
# always emits ` data-tela="<escaped value>"` — the leading space makes the
# marker distinguishable from the string appearing mid-text.
# ---------------------------------------------------------------------------

fn identity_marker() → string {
    return " data-tela=§"('"')
}

# ---------------------------------------------------------------------------
# Identity parsing over serialized Tela markup. Returns every data-tela
# identity in document order (escaped form unescaped). Bounded fidelity:
# text/attributes embedding the exact marker string are out of the proof
# corpus (recorded). Operates on the VIEW markup ONLY (tela's own serializer
# output) — the present identity set comes from the typed snapshot.
# ---------------------------------------------------------------------------

fn unescape(string text) → string {
    var string accum ← ""
    var int i ← 0
    while i < text.length() {
        var string fragment ← text.slice(i, i + 1)
        var int step ← 1
        if not (i + 5 > text.length()) and text.slice(i, i + 5) ≡ "&quot;" {
            fragment ← "§"('"')
            step ← 5
        }
        if not (i + 5 > text.length()) and text.slice(i, i + 5) ≡ "&#39;" {
            fragment ← "'"
            step ← 5
        }
        if not (i + 4 > text.length()) and text.slice(i, i + 4) ≡ "&amp;" {
            fragment ← "&"
            step ← 4
        }
        if not (i + 4 > text.length()) and text.slice(i, i + 4) ≡ "&lt;" {
            fragment ← "<"
            step ← 4
        }
        if not (i + 4 > text.length()) and text.slice(i, i + 4) ≡ "&gt;" {
            fragment ← ">"
            step ← 4
        }
        accum ← accum + fragment
        i ← i + step
    }
    return accum
}

fn parse_identities(string text) → list<string> {
    var list<string> identities ← vacua
    var int i ← 0
    while i < text.length() {
        if not (i + 12 > text.length()) and text.slice(i, i + 12) ≡ identity_marker() {
            var string raw ← ""
            var int j ← i + 12
            var bool terminated ← false
            while j < text.length() and not terminated {
                const string ch ← text.slice(j, j + 1)
                if ch ≡ "§"('"') {
                    terminated ← true
                }
                if not (ch ≡ "§"('"')) {
                    raw ← raw + ch
                }
                j ← j + 1
            }
            if terminated {
                identities.append(unescape(raw))
                i ← j
            }
            if not terminated {
                i ← i + 1
            }
        } else {
            i ← i + 1
        }
    }
    return identities
}

# The open-tag shape of the element carrying the given identity (from the
# previous '<' to the next '>') in the VIEW markup, or null when the
# identity is absent or the element is malformed.
fn element_tag(string text, string identity) → string ∪ null {
    var int i ← 0
    while i < text.length() {
        if not (i + 12 > text.length()) and text.slice(i, i + 12) ≡ identity_marker() {
            var string raw ← ""
            var int j ← i + 12
            var bool terminated ← false
            while j < text.length() and not terminated {
                const string ch ← text.slice(j, j + 1)
                if ch ≡ "§"('"') {
                    terminated ← true
                }
                if not (ch ≡ "§"('"')) {
                    raw ← raw + ch
                }
                j ← j + 1
            }
            if terminated and unescape(raw) ≡ identity {
                var int a ← i
                var bool found ← false
                while a > 0 and not found {
                    const string ch ← text.slice(a - 1, a)
                    if ch ≡ "<" {
                        found ← true
                    }
                    if not (ch ≡ "<") {
                        a ← a - 1
                    }
                }
                var int b ← j
                var bool closed ← false
                while b < text.length() and not closed {
                    const string ch ← text.slice(b, b + 1)
                    if ch ≡ ">" {
                        closed ← true
                    }
                    if not (ch ≡ ">") {
                        b ← b + 1
                    }
                }
                if found and closed then return text.slice(a - 1, b + 1)
                return null
            }
            i ← j
        } else {
            i ← i + 1
        }
    }
    return null
}

# The TAG NAME of an open-tag string ("<button role='radio' …>" →
# "button") — the first token after '<'. The hydration comparison
# normalizes both sides to tag names: the view side extracts the tag name
# from the serializer's open tag; the present side uses the typed tag name
# from the hydration snapshot. Tag names carry no quotes, so the
# serializer's single-quote vs the real DOM's double-quote serialization
# never enters the comparison (the U6 discovery's quote-style finding).
fn tag_name(string tag) → string {
    var string result ← ""
    var int i ← 1
    var bool finished ← false
    while i < tag.length() and not finished {
        const string ch ← tag.slice(i, i + 1)
        if ch ≡ " " or ch ≡ ">" {
            finished ← true
        }
        if not (ch ≡ " ") and not (ch ≡ ">") {
            result ← result + ch
        }
        i ← i + 1
    }
    return result
}

# Occurrence count of an identity in a list.
fn count_occurrences(list<string> collection, string name) → int {
    var int count_occurrences ← 0
    var int i ← 0
    while i < collection.length() {
        if collection[i] ≡ name {
            count_occurrences ← count_occurrences + 1
        }
        i ← i + 1
    }
    return count_occurrences
}

# Distinct identities appearing more than once (the ambiguity set).
fn duplicate_identities(list<string> collection) → list<string> {
    var list<string> duplicates ← vacua
    var int i ← 0
    while i < collection.length() {
        const string identity ← collection[i]
        if count_occurrences(collection, identity) > 1 and not duplicates.contains(identity) {
            duplicates.append(identity)
        }
        i ← i + 1
    }
    return duplicates
}

# ---------------------------------------------------------------------------
# The G4-safe tag-index adapters (the U6 discovery's item 4): consume the
# provider's TYPED hydration snapshot (dom.snapshot → lista<DomNode> ∪
# nihil — identity + tag name per data-tela descendant) and produce the two
# parallel string lists the pure policy fns take — the pre-existing
# identity set + the aligned per-identity tag names. No textual DOM parse:
# the identity set + tags arrive typed from the snapshot. A null snapshot
# (the runtime returns null only for a null scope) narrows to empty.
# ---------------------------------------------------------------------------

fn identities_from_nodes(list<dom.DomNode> ∪ null nodes) → list<string> {
    var list<string> result ← vacua
    if nodes not is null {
        var int i ← 0
        while i < nodes.length() {
            result.append(nodes[i].identity)
            i ← i + 1
        }
    }
    return result
}

fn tags_from_nodes(list<dom.DomNode> ∪ null nodes) → list<string> {
    var list<string> result ← vacua
    if nodes not is null {
        var int i ← 0
        while i < nodes.length() {
            result.append(nodes[i].tag)
            i ← i + 1
        }
    }
    return result
}

# The tag name for a pre-existing identity: the aligned tag-index lookup
# ("" when the identity is absent from the present set).
fn tag_at(string identity, list<string> identities, list<string> tags) → string {
    var int i ← 0
    while i < identities.length() {
        if identities[i] ≡ identity {
            return tags[i]
        }
        i ← i + 1
    }
    return ""
}

# ---------------------------------------------------------------------------
# The hydration policy, exposed as pure string/list functions (G4-safe —
# these signatures carry NO imported types, so they stay on the exported
# file interface; mount composes them). The exempla + the assembled driver
# both consume them: the check-time exempla asserts the policy decisions,
# the runtime driver executes the plan.
# ---------------------------------------------------------------------------

# The binding-status decision for one View identity: "bind" (bind the
# existing matching node — hydration) only when the identity is unique in
# both markups AND the VIEW element's tag name equals the PRAESENS node's
# typed tag name (from the hydration snapshot); "create" (create/replace
# the node from the View) otherwise — including every ambiguous/mismatched
# case (duplicated identity, out-of-shape tag, missing node).
fn binding_status(
    string identity,
    list<string> view_identities,
    list<string> present_identities,
    string markup,
    list<string> present_tags
) → string {
    var bool bind ← false
    if count_occurrences(present_identities, identity) ≡ 1 and count_occurrences(view_identities, identity) ≡ 1 {
        const string tag_view ← tag_name(element_tag(markup, identity) coalesce "")
        const string tag_praesens ← tag_at(identity, present_identities, present_tags)
        if not (tag_view ≡ "") and not (tag_praesens ≡ "") and tag_view ≡ tag_praesens {
            bind ← true
        }
    }
    if bind then return "bind"
    return "create"
}

# The hydration diagnostics for a mount, in deterministic order:
#   duplicate:<id> — the identity appears more than once in the View markup
#     or in the pre-existing markup (identity-hydration.md §6 ambiguity —
#     never a silent bind);
#   foreign:<id> — a pre-existing identity absent from the View (mismatch
#     → the region is replaced from the View);
#   changed:<id> — the identity is present in both, unique in both, but the
#     element TAG NAMES differ (out-of-shape node → replaced from the View;
#     the fidelity is the snapshot's tag-name surface — the landed
#     dom.snapshot carries identity + tag name, recorded in
#     browser-lifecycle.md).
fn hydration_diagnostics(
    string markup,
    list<string> view_identities,
    list<string> present_identities,
    list<string> present_tags
) → list<string> {
    var list<string> diagnostics ← vacua
    const list<string> duplicatae_view ← duplicate_identities(view_identities)
    var int di ← 0
    while di < duplicatae_view.length() {
        diagnostics.append("duplicate:" + duplicatae_view[di])
        di ← di + 1
    }
    const list<string> duplicatae_praesentes ← duplicate_identities(present_identities)
    var int dj ← 0
    while dj < duplicatae_praesentes.length() {
        diagnostics.append("duplicate:" + duplicatae_praesentes[dj])
        dj ← dj + 1
    }
    var int ek ← 0
    while ek < present_identities.length() {
        const string identity ← present_identities[ek]
        if not view_identities.contains(identity) {
            diagnostics.append("foreign:" + identity)
        }
        ek ← ek + 1
    }
    var int mi ← 0
    while mi < view_identities.length() {
        const string identity ← view_identities[mi]
        if count_occurrences(present_identities, identity) ≡ 1 and count_occurrences(view_identities, identity) ≡ 1 {
            const string tag_view ← tag_name(element_tag(markup, identity) coalesce "")
            const string tag_praesens ← tag_at(identity, present_identities, present_tags)
            if not (tag_view ≡ "") and not (tag_praesens ≡ "") and tag_view ≠ tag_praesens {
                diagnostics.append("changed:" + identity)
            }
        }
        mi ← mi + 1
    }
    return diagnostics
}

# ---------------------------------------------------------------------------
# The mount lifecycle. Pure planner over the host seam: renders the View
# into the scope (serialized markup), applies the theme cascade, and
# hydrates — the pre-existing identity set + per-identity tag names come
# from the provider's TYPED hydration snapshot (dom.snapshot — no textual
# DOM parse); matching data-tela nodes bind instead of being recreated;
# mismatch diagnoses + replaces the mismatched region from the View
# (declared policy); duplicate data-tela values are diagnosed, never a
# silent bind (identity-hydration.md §6).
# ---------------------------------------------------------------------------

fn mount(dom.Scope scope, tela.View view, tela.Theme theme) → Mounted ∪ null {
    # Fail-closed: an invalid View (html_visus null), an invalid Theme
    # (theme_css null), or a null hydration snapshot (the runtime returns
    # null only for a null scope) never mounts — no partial region. The
    # nullable checks run against the call / the bound nullable
    # (fix:prim-nullable workaround).
    if tela.html_visus(view) is null then return null
    const string markup ← tela.html_visus(view) coalesce ""
    if tela.theme_css(theme) is null then return null
    const string css ← tela.theme_css(theme) coalesce ""

    const list<string> view_identities ← parse_identities(markup)

    # The typed hydration read (head-cto fire-13 + the U6 discovery): the
    # provider's snapshot per data-tela descendant → the parallel string
    # lists the policy fns consume. The Scope.textus_praesens carrier is
    # GONE — the pre-existing state is READ from the DOM, never carried.
    const list<dom.DomNode> ∪ null nodes ← dom.snapshot(scope)
    if nodes is null then return null
    const list<string> present_identities ← identities_from_nodes(nodes)
    const list<string> present_tags ← tags_from_nodes(nodes)

    # The hydration policy (diagnose + bind) lives in the exposed pure
    # functions above — mount composes them into the plan.
    const list<string> diagnostics ← hydration_diagnostics(markup, view_identities, present_identities, present_tags)

    # Binding plan: per View identity in order (binding_status decides).
    var list<Binding> bindings ← vacua
    var int li ← 0
    while li < view_identities.length() {
        const string status ← binding_status(view_identities[li], view_identities, present_identities, markup, present_tags)
        bindings.append(binding(view_identities[li], status))
        li ← li + 1
    }

    # Region-bind subscriptions: one per View identity (the U2 dispose
    # proof surface; the app's event bindings are app-typed in U3). The
    # host binds a tela:dom on(node, "tela:binding") per descriptor.
    var list<EventSubscription> subscriptions ← vacua
    var int sub ← 0
    while sub < view_identities.length() {
        subscriptions.append(event_subscription(view_identities[sub], "tela:binding"))
        sub ← sub + 1
    }

    return Mounted {
        scope = scope,
        root = region_root(scope.selector),
        view = view,
        theme = theme,
        markup = markup,
        css_text = css,
        identities = view_identities,
        diagnostics = diagnostics,
        bindings = bindings,
        subscriptions = subscriptions,
        focused_identity = "",
        target_identity = ""
    }
}

# ---------------------------------------------------------------------------
# The replace lifecycle. Rerenders/replaces the explicitly mounted region
# with the next View and returns the update result (Update) whose
# declarative effects are derived from the before/after state
# (behavior-design §3.1/§3.2): focus restoration to the pre-replacement
# focused identity (modeled via focus_held), declared focus movement
# (modeled via focus_target), and scroll-anchor intent for the region.
# The host executes the effects after replacement — declarative on the
# update result, never imperative post-update user-code calls.
# ---------------------------------------------------------------------------

fn replace(Mounted m, tela.View view) → tela.Update ∪ null {
    if tela.html_visus(view) is null then return null
    var list<tela.Effect> effects ← vacua
    if not (m.focused_identity ≡ "") {
        effects.append(tela.restore(m.focused_identity))
    }
    if not (m.target_identity ≡ "") {
        effects.append(tela.direct(m.target_identity))
    }
    effects.append(tela.anchor(m.root.identity))
    return tela.update(view, effects)
}

# The dispose lifecycle. Unsubscribes every active subscription and clears
# the region. Pure marker here (the host executes the unsubscribe plan —
# the tela:dom surface binds through the documented provider seam).
fn dispose(Mounted m) → void {
}

# --- modeled focus state (before/after state for effect derivation) ------

# Model: the pre-replacement focused identity (→ Restore on replace).
# The host mirrors the model onto the actual DOM focus at execution.
fn focus_held(Mounted m, string identity) → Mounted {
    return Mounted {
        scope = m.scope,
        root = m.root,
        view = m.view,
        theme = m.theme,
        markup = m.markup,
        css_text = m.css_text,
        identities = m.identities,
        diagnostics = m.diagnostics,
        bindings = m.bindings,
        subscriptions = m.subscriptions,
        focused_identity = identity,
        target_identity = m.target_identity
    }
}

# Model: a declared focus-movement target identity (→ Direct on replace).
fn focus_target(Mounted m, string identity) → Mounted {
    return Mounted {
        scope = m.scope,
        root = m.root,
        view = m.view,
        theme = m.theme,
        markup = m.markup,
        css_text = m.css_text,
        identities = m.identities,
        diagnostics = m.diagnostics,
        bindings = m.bindings,
        subscriptions = m.subscriptions,
        focused_identity = m.focused_identity,
        target_identity = identity
    }
}
