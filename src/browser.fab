# tela/src/browser.fab — tela:browser — the browser mount/update/dispose lifecycle.
#
# Stage 3 U2 (browser-mount). The host seam is web:dom (faber-web — la
# locale, ts-only, read-only). The en→la cross-package import is BLOCKED on
# in-tree radix 0.80.0: the provider-module locale-propagation defect (the
# CODEGEN001 mechanism) — PARSE001 at any real use of a dom.* value
# (call sites, type inference, construction) and SEM002 at qualified
# class-field types. ATTEMPTED (probe matrix, 2026-08-09) + recorded +
# escalated: fix:web-dom-locale.
#
# FALLBACK POSTURE (delivery U2 done_when (h)): the DOM surface binds at the
# HARNESS level — tela/scripta/dom-shim.ts implements the webDom* runtime-
# binding surface over a minimal in-memory DOM (WEB5 precedent
# examples/browser-app/tests/fake-dom.mjs + runtime-bridge.mjs), and the
# assembled runner binds it. This module carries its OWN opaque host seam
# carriers (Scope/Radiculum/Subscriptio) — the pinned seam call shape
# `mount(dom.Scope, Visus, Thema)` is preserved with tela:browser's Scope
# handle standing in for the blocked dom.Scope type; web:dom is NEVER
# re-authored inside tela and the contract is NEVER weakened.
#
# MODULE SHAPE (locked):
#   - FLAT + G4-safe: public signatures reference tela:tela types + this
#     module's own carriers ONLY. The cross-package snapshot-skip risk on
#     public web:dom-typed signatures (WARN014 — fix:g4) is avoided by
#     construction: no imported web:dom types appear anywhere.
#   - PURE: no web:dom calls in this module (blocked). mount/replace/dispose
#     are PURE PLANNERS over the host seam — they compute the render plan
#     (serialized markup, theme cascade, identity index, hydration
#     diagnostics, binding plan, effect list); the harness executes the plan
#     against the dom-shim. Deterministic bytes over author order.
#   - The scope's CURRENT markup rides the Scope carrier as data
#     (textus_praesens — the state model); the harness mirrors it onto the
#     actual DOM at execution time. Bounded fidelity: identity values are
#     parsed from the serializer's own data-tela emission; the proof corpus
#     avoids text/attributes embedding the exact marker string
#     ` data-tela='` (recorded).
#
# fix:<id> markers:
#   fix:web-dom-locale — en→la web:dom import blocked (PARSE001/SEM002);
#     fallback seam = this module's opaque carriers; the harness binds the
#     webDom* surface. Removal after the radix fix = the seam flips to
#     dom.Scope + the module consumes web:dom directly (grep-replace).
#   fix:g4 — WARN014 snapshot-skip family. The pinned seam fns
#     mount/replace carry imported sibling types (tela.Visus/Thema/Renovatio)
#     in their public signatures and are EXPORT-SKIPPED for consumers (the
#     WARN014 file-interface skip, observed at radix check on in-tree radix
#     0.80.0 — the recorded G4-family posture). Workaround: the G4-safe pure
#     policy fns (ligamen_status/diagnosia_hydrationis/parse_identitates —
#     string/list signatures only) stay on the exported interface for the
#     check-time exempla, and the harness-assembly workaround covers the
#     skipped fns (the snapshot does not apply at runtime — the driver calls
#     the emitted mount/replace directly). Removal after the radix fix =
#     grep-replace the WARN014 note.
#   fix:g5 — NONE: mount/replace/dispose/scopus/radiculum/subscriptio/
#     ligamen/focus_tenet/focus_optata/parse_identitates/elementum_tag
#     probed collision-free on in-tree radix 0.80.0 (a free fn may share a
#     class name — G5's collision is enum-member-specific).
#   fix:prim-nullable — NEW parser observation, 2026-08-09: a primitive
#     ∪ null const/var annotation and a `!` unwrap of a primitive nullable
#     do not parse inside named function bodies on in-tree radix 0.80.0
#     (PARSE030/PARSE001; the same annotations/unwraps work in `main`, and
#     class ∪ null annotations + unwraps work in fn bodies — the kernel's
#     thema_css pattern). Workaround held: null checks run against the CALL
#     expression (`if f(x) is null then …`), then the value binds via
#     `coalesce ""`; shape comparisons carry a boolean habet flag.
#     Escalated to the radix lane with the module (fix:prim-nullable).
#   fix:codegen001 — Rust emit-across-imports: browser.fab imports tela:tela,
#     so Rust emit re-analyzes the provider without the en reader pack
#     (PARSE001). web:dom is ts-only in any case — Rust emit of this module
#     is doubly out; the TS lane is the proven lane. Recorded, never the
#     gate.

import from "tela:tela" public * ut tela

# ---------------------------------------------------------------------------
# Host seam carriers (the fallback seam — opaque handles the harness
# resolves to web:dom values at runtime).
# ---------------------------------------------------------------------------

# The scoped host region handle. Mirrors the web:dom Scope genus by name;
# the harness resolves selector → a webDomScope at runtime.
# textus_praesens is the region's CURRENT Tela markup as the state model
# knows it ("" = empty); the harness derives it from the actual DOM.
class Scope {
    string selector
    string textus_praesens
}

# A mounted region root handle (the region this mount owns — the scope
# selector doubles as the region identity for scroll-anchor intent).
class Radiculum {
    string identitas
}

# A live subscription handle; the harness maps identitas → webDomSubscription
# on the bound node (data-tela='identitas').
class Subscriptio {
    string identitas
    string nomen_eventi
}

# One binding-plan entry: a view identity + its hydration status.
# status "ligare" = bind the existing matching node (hydration);
# status "creare" = create/replace the node from the View.
class Ligamen {
    string identitas
    string status
}

# Mounted — the mount state carrier (delivery U2 done_when (b)): host
# state (scope + root + subscriptions), current Visus + active Thema, the
# render plan (markup + css), the identity index, the hydration
# diagnostics, and the modeled focus state.
class Mounted {
    Scope scopus
    Radiculum radix
    tela.Visus visus
    tela.Thema thema
    string textus_markup
    string textus_css
    list<string> identitates
    list<string> diagnosia
    list<Ligamen> ligamina
    list<Subscriptio> subscriptiones
    string identitas_focus
    string identitas_focus_optata
}

# Kernel-owned constructors (G3 posture — ordinary functions over the same
# public values, like the Stage 1/2/3-U1 kernel constructors).
fn scopus(string selector, string textus_praesens) → Scope {
    return Scope { selector = selector, textus_praesens = textus_praesens }
}

fn radiculum(string identitas) → Radiculum {
    return Radiculum { identitas = identitas }
}

fn subscriptio(string identitas, string nomen_eventi) → Subscriptio {
    return Subscriptio { identitas = identitas, nomen_eventi = nomen_eventi }
}

fn ligamen(string identitas, string status) → Ligamen {
    return Ligamen { identitas = identitas, status = status }
}

# ---------------------------------------------------------------------------
# The serializer's identity marker (policy (d) emission form). The kernel
# always emits " data-tela='<escaped valor>'" — the leading space makes the
# marker distinguishable from the string appearing mid-text.
# ---------------------------------------------------------------------------

fn nota_identitatis() → string {
    return " data-tela='"
}

# ---------------------------------------------------------------------------
# Identity parsing over serialized Tela markup. Returns every data-tela
# identity in document order (escaped form unescaped). Bounded fidelity:
# text/attributes embedding the exact marker string are out of the proof
# corpus (recorded).
# ---------------------------------------------------------------------------

fn unescape(string textus) → string {
    var string accum ← ""
    var int i ← 0
    while i < textus.longitudo() {
        var string fragment ← textus.sectio(i, i + 1)
        var int step ← 1
        if not (i + 5 > textus.longitudo()) and textus.sectio(i, i + 5) ≡ "&quot;" {
            fragment ← "§"('"')
            step ← 5
        }
        if not (i + 5 > textus.longitudo()) and textus.sectio(i, i + 5) ≡ "&#39;" {
            fragment ← "'"
            step ← 5
        }
        if not (i + 4 > textus.longitudo()) and textus.sectio(i, i + 4) ≡ "&amp;" {
            fragment ← "&"
            step ← 4
        }
        if not (i + 4 > textus.longitudo()) and textus.sectio(i, i + 4) ≡ "&lt;" {
            fragment ← "<"
            step ← 4
        }
        if not (i + 4 > textus.longitudo()) and textus.sectio(i, i + 4) ≡ "&gt;" {
            fragment ← ">"
            step ← 4
        }
        accum ← accum + fragment
        i ← i + step
    }
    return accum
}

fn parse_identitates(string textus) → list<string> {
    var list<string> identitates ← vacua
    var int i ← 0
    while i < textus.longitudo() {
        if not (i + 12 > textus.longitudo()) and textus.sectio(i, i + 12) ≡ nota_identitatis() {
            var string raw ← ""
            var int j ← i + 12
            var bool terminatum ← false
            while j < textus.longitudo() and not terminatum {
                const string ch ← textus.sectio(j, j + 1)
                if ch ≡ "'" {
                    terminatum ← true
                }
                if not (ch ≡ "'") {
                    raw ← raw + ch
                }
                j ← j + 1
            }
            if terminatum {
                identitates.appende(unescape(raw))
                i ← j
            }
            if not terminatum {
                i ← i + 1
            }
        } else {
            i ← i + 1
        }
    }
    return identitates
}

# The open-tag shape of the element carrying the given identity (from the
# previous '<' to the next '>'), or null when the identity is absent or the
# element is malformed. Shape equality across the praesens markup and the
# View markup detects out-of-shape nodes (hydration diagnosis).
fn elementum_tag(string textus, string identitas) → string ∪ null {
    var int i ← 0
    while i < textus.longitudo() {
        if not (i + 12 > textus.longitudo()) and textus.sectio(i, i + 12) ≡ nota_identitatis() {
            var string raw ← ""
            var int j ← i + 12
            var bool terminatum ← false
            while j < textus.longitudo() and not terminatum {
                const string ch ← textus.sectio(j, j + 1)
                if ch ≡ "'" {
                    terminatum ← true
                }
                if not (ch ≡ "'") {
                    raw ← raw + ch
                }
                j ← j + 1
            }
            if terminatum and unescape(raw) ≡ identitas {
                var int a ← i
                var bool inventum ← false
                while a > 0 and not inventum {
                    const string ch ← textus.sectio(a - 1, a)
                    if ch ≡ "<" {
                        inventum ← true
                    }
                    if not (ch ≡ "<") {
                        a ← a - 1
                    }
                }
                var int b ← j
                var bool clausum ← false
                while b < textus.longitudo() and not clausum {
                    const string ch ← textus.sectio(b, b + 1)
                    if ch ≡ ">" {
                        clausum ← true
                    }
                    if not (ch ≡ ">") {
                        b ← b + 1
                    }
                }
                if inventum and clausum then return textus.sectio(a - 1, b + 1)
                return null
            }
            i ← j
        } else {
            i ← i + 1
        }
    }
    return null
}

# Occurrence count of an identity in a list.
fn quotiens(list<string> collatio, string nomen) → int {
    var int quotiens ← 0
    var int i ← 0
    while i < collatio.longitudo() {
        if collatio[i] ≡ nomen {
            quotiens ← quotiens + 1
        }
        i ← i + 1
    }
    return quotiens
}

# Distinct identities appearing more than once (the ambiguity set).
fn identitates_duplicatae(list<string> collatio) → list<string> {
    var list<string> duplicatae ← vacua
    var int i ← 0
    while i < collatio.longitudo() {
        const string identitas ← collatio[i]
        if quotiens(collatio, identitas) > 1 and not duplicatae.continet(identitas) {
            duplicatae.appende(identitas)
        }
        i ← i + 1
    }
    return duplicatae
}

# ---------------------------------------------------------------------------
# The hydration policy, exposed as pure string/list functions (G4-safe —
# these signatures carry NO imported types, so they stay on the exported
# file interface; mount composes them). The exempla + the assembled driver
# both consume them: the check-time exempla asserts the policy decisions,
# the runtime driver executes the plan.
# ---------------------------------------------------------------------------

# The binding-status decision for one View identity: "ligare" (bind the
# existing matching node — hydration) only when the identity is unique in
# both markups and the open-tag shapes match; "creare" (create/replace the
# node from the View) otherwise — including every ambiguous/mismatched
# case (duplicated identity, out-of-shape node, missing node).
fn ligamen_status(
    string identitas,
    list<string> identitates_view,
    list<string> identitates_praesentes,
    string markup,
    string praesens
) → string {
    var bool ligare ← false
    if quotiens(identitates_praesentes, identitas) ≡ 1 and quotiens(identitates_view, identitas) ≡ 1 {
        const bool tag_view_habet ← elementum_tag(markup, identitas) not is null
        const bool tag_praesens_habet ← elementum_tag(praesens, identitas) not is null
        const string tag_view ← elementum_tag(markup, identitas) coalesce ""
        const string tag_praesens ← elementum_tag(praesens, identitas) coalesce ""
        if tag_view_habet and tag_praesens_habet and tag_view ≡ tag_praesens {
            ligare ← true
        }
    }
    if ligare then return "ligare"
    return "creare"
}

# The hydration diagnostics for a mount, in deterministic order:
#   duplicata:<id> — the identity appears more than once in the View markup
#     or in the pre-existing markup (identity-hydration.md §6 ambiguity —
#     never a silent bind);
#   extranea:<id> — a pre-existing identity absent from the View (mismatch
#     → the region is replaced from the View);
#   muta:<id> — the identity is present in both, unique in both, but the
#     open-tag shapes differ (out-of-shape node → replaced from the View).
fn diagnosia_hydrationis(
    string markup,
    string praesens,
    list<string> identitates_view,
    list<string> identitates_praesentes
) → list<string> {
    var list<string> diagnosia ← vacua
    const list<string> duplicatae_view ← identitates_duplicatae(identitates_view)
    var int di ← 0
    while di < duplicatae_view.longitudo() {
        diagnosia.appende("duplicata:" + duplicatae_view[di])
        di ← di + 1
    }
    const list<string> duplicatae_praesentes ← identitates_duplicatae(identitates_praesentes)
    var int dj ← 0
    while dj < duplicatae_praesentes.longitudo() {
        diagnosia.appende("duplicata:" + duplicatae_praesentes[dj])
        dj ← dj + 1
    }
    var int ek ← 0
    while ek < identitates_praesentes.longitudo() {
        const string identitas ← identitates_praesentes[ek]
        if not identitates_view.continet(identitas) {
            diagnosia.appende("extranea:" + identitas)
        }
        ek ← ek + 1
    }
    var int mi ← 0
    while mi < identitates_view.longitudo() {
        const string identitas ← identitates_view[mi]
        if quotiens(identitates_praesentes, identitas) ≡ 1 and quotiens(identitates_view, identitas) ≡ 1 {
            const bool tag_view_habet ← elementum_tag(markup, identitas) not is null
            const bool tag_praesens_habet ← elementum_tag(praesens, identitas) not is null
            const string tag_view ← elementum_tag(markup, identitas) coalesce ""
            const string tag_praesens ← elementum_tag(praesens, identitas) coalesce ""
            if tag_view_habet and tag_praesens_habet and tag_view ≠ tag_praesens {
                diagnosia.appende("muta:" + identitas)
            }
        }
        mi ← mi + 1
    }
    return diagnosia
}

# ---------------------------------------------------------------------------
# The mount lifecycle. Pure planner over the host seam: renders the View
# into the scope (serialized markup), applies the theme cascade, and
# hydrates — matching data-tela nodes bind instead of being recreated;
# mismatch diagnoses + replaces the mismatched region from the View
# (declared policy); duplicate data-tela values are diagnosed, never a
# silent bind (identity-hydration.md §6).
# ---------------------------------------------------------------------------

fn mount(Scope scopus, tela.Visus visus, tela.Thema thema) → Mounted ∪ null {
    # Fail-closed: an invalid View (html_visus null) or an invalid Theme
    # (thema_css null) never mounts — no partial region. The nullable
    # checks run against the call (fix:prim-nullable workaround — primitive
    # ∪ null bindings do not parse in fn bodies).
    if tela.html_visus(visus) is null then return null
    const string markup ← tela.html_visus(visus) coalesce ""
    if tela.thema_css(thema) is null then return null
    const string css ← tela.thema_css(thema) coalesce ""

    const list<string> identitates_view ← parse_identitates(markup)
    const list<string> identitates_praesentes ← parse_identitates(scopus.textus_praesens)

    # The hydration policy (diagnose + bind) lives in the exposed pure
    # functions above — mount composes them into the plan.
    const list<string> diagnosia ← diagnosia_hydrationis(markup, scopus.textus_praesens, identitates_view, identitates_praesentes)

    # Binding plan: per View identity in order (ligamen_status decides).
    var list<Ligamen> ligamina ← vacua
    var int li ← 0
    while li < identitates_view.longitudo() {
        const string status ← ligamen_status(identitates_view[li], identitates_view, identitates_praesentes, markup, scopus.textus_praesens)
        ligamina.appende(ligamen(identitates_view[li], status))
        li ← li + 1
    }

    # Region-bind subscriptions: one per View identity (the U2 dispose
    # proof surface; the app's event bindings are app-typed in U3). The
    # harness binds a webDomOn(node, "tela:ligamen") per descriptor.
    var list<Subscriptio> subscriptiones ← vacua
    var int sub ← 0
    while sub < identitates_view.longitudo() {
        subscriptiones.appende(subscriptio(identitates_view[sub], "tela:ligamen"))
        sub ← sub + 1
    }

    return Mounted {
        scopus = scopus,
        radix = radiculum(scopus.selector),
        visus = visus,
        thema = thema,
        textus_markup = markup,
        textus_css = css,
        identitates = identitates_view,
        diagnosia = diagnosia,
        ligamina = ligamina,
        subscriptiones = subscriptiones,
        identitas_focus = "",
        identitas_focus_optata = ""
    }
}

# ---------------------------------------------------------------------------
# The replace lifecycle. Rerenders/replaces the explicitly mounted region
# with the next View and returns the update result (Renovatio) whose
# declarative effects are derived from the before/after state
# (behavior-design §3.1/§3.2): focus restoration to the pre-replacement
# focused identity (modeled via focus_tenet), declared focus movement
# (modeled via focus_optata), and scroll-anchor intent for the region.
# The harness executes the effects after replacement — declarative on the
# update result, never imperative post-update user-code calls.
# ---------------------------------------------------------------------------

fn replace(Mounted m, tela.Visus visus) → tela.Renovatio ∪ null {
    if tela.html_visus(visus) is null then return null
    var list<tela.Effectus> effectus ← vacua
    if not (m.identitas_focus ≡ "") {
        effectus.appende(tela.restitue(m.identitas_focus))
    }
    if not (m.identitas_focus_optata ≡ "") {
        effectus.appende(tela.dirige(m.identitas_focus_optata))
    }
    effectus.appende(tela.ancora(m.radix.identitas))
    return tela.renovatio(visus, effectus)
}

# The dispose lifecycle. Unsubscribes every active subscription and clears
# the region. Pure marker here (the harness executes the unsubscribe plan —
# the webDom* surface binds at the harness level under fix:web-dom-locale).
fn dispose(Mounted m) → void {
}

# --- modeled focus state (before/after state for effect derivation) ------

# Model: the pre-replacement focused identity (→ Restitue on replace).
# The harness mirrors the model onto the actual DOM focus at execution.
fn focus_tenet(Mounted m, string identitas) → Mounted {
    return Mounted {
        scopus = m.scopus,
        radix = m.radix,
        visus = m.visus,
        thema = m.thema,
        textus_markup = m.textus_markup,
        textus_css = m.textus_css,
        identitates = m.identitates,
        diagnosia = m.diagnosia,
        ligamina = m.ligamina,
        subscriptiones = m.subscriptiones,
        identitas_focus = identitas,
        identitas_focus_optata = m.identitas_focus_optata
    }
}

# Model: a declared focus-movement target identity (→ Dirige on replace).
fn focus_optata(Mounted m, string identitas) → Mounted {
    return Mounted {
        scopus = m.scopus,
        radix = m.radix,
        visus = m.visus,
        thema = m.thema,
        textus_markup = m.textus_markup,
        textus_css = m.textus_css,
        identitates = m.identitates,
        diagnosia = m.diagnosia,
        ligamina = m.ligamina,
        subscriptiones = m.subscriptiones,
        identitas_focus = m.identitas_focus,
        identitas_focus_optata = identitas
    }
}
