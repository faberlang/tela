# tela/src/tela.fab — the real tela library kernel (Branch B).
#
# Stage 1 U1 kernel contract: typed HTML/SVG view values + kernel-owned
# constructors. One FLAT module (G4-safe), stdlib-only — no
# norma/triga/faber-runtime dependency. The shape proven by the Stage 0
# U3 spike (spike/visus-b.fab) through all three lanes.
# (Import-free through U1; U3 adds ONE same-package sibling import —
# tela:valida — for the fail-closed glue, per the U3 write_scope.)
#
# Branch decision (frozen for Stage 1): Branch B — pure non-generic
# recursive Visus union + adjacent typed behavior plan. Branch A (generic
# Visus<Message>) remains the ideal end-state, blocked only by radix defect
# D1 (generic user-type construction does not instantiate type parameters;
# stage-0-branch-a-b-evidence.md §2/§4). If D1 lands, the Branch A re-spike
# is a DECISION POINT for a future stage — never a mid-stage switch.
#
# Policy locks applied (stage-0-protocol-policies.md):
#   (a) no raw-markup View variant — typed elements only, no RawHtml-style
#       escape in the ordinary path;
#   (b) Faber-Latin protocol spellings: nomen/valor/liberi/nomen_tag
#       (nomen_tag avoids the D2 TS discriminant collision);
#   (d) Identitas is an explicit typed field, never position-derived;
#       serialization into data-tela is the U3 serializer's job.
# Validation boundary: constructors stay open (no eager validation);
# fail-closed lexical/namespace checks land at the U2/U3 serializer edge.
#
# D2 re-check (2026-08-09, in-tree radix 0.80.0): TS emit +
# tsc --noEmit clean (exit 0) — nomen_tag emits with no discriminant
# collision against the TS `tag` discriminant. Workaround spelling kept.
# D3 re-check (2026-08-09, in-tree radix 0.80.0): Rust emit + scratch
# cargo check clean (Finished, exit 0) — nova_identitas routes the
# non-null identity through Identitas ∪ null and emits Some(...)
# correctly. Direct non-null construction into the nullable field is
# STILL the D3 defect; the radix D3 delivery has NOT landed, so the
# nova_identitas workaround is KEPT for Stage 1 (recorded either way).
#
# Stage 1 U3 (serializer) notes — this module now carries the escape
# function, the deterministic HTML/CSS serializers, and the fail-closed
# boundary; it gains ONE same-package sibling import (tela:valida) for the
# namespace glue (stage-1-delivery.md U3 write_scope; U2 done_when (f)
# non-goal: the glue lives in the kernel module, keeping valida.fab G4-safe).
#
# Central escaping (policy (a)2): escapa is the ONE escape path used by both
# text and attribute-value serialization. Escape sets: & < > for text;
# additionally " ' for attribute values (single-quote style per the Stage 0
# spike baseline). No serializer path concatenates an unescaped value; the
# identity valor flows through the same attribute-escape path (policy (d)).
#
# Fail-closed boundary (policy (a)2; U2 done_when (d)): before ANY emission
# the serializer runs the U2 lexical/namespace/void checks over the whole
# tree (valida_arbor). html_visus(Visus) → string ∪ null — null when any
# check fails, so invalid input NEVER emits markup (no partial output). The
# concrete mechanism (nullable result) is the implementing Hand's documented
# choice within the available Faber surface; exercised by exempla/serializer.fab.
#
# Proprietas static posture (spec decision Q3): Proprietas are carried in the
# tree as browser-lane DOM properties and are NOT serialized into static
# HTML in Stage 1. The spike's provisional data-prop: marker is SUPERSEDED.
# Recorded here for identity-hydration.md (U4).
#
# Emit-across-imports escalation (stage-1-delivery.md U3 done_when (g);
# coordination §2/§5): radix check resolves the tela:valida import, and the
# TS emit lane resolves it. The RUST emit lane re-analyzes the imported
# provider module WITHOUT the en reader pack (PARSE001 — provider-module
# locale propagation defect, reproduced with exempla/validation.fab on the
# in-tree radix 0.80.0) and fails CODEGEN001. Recorded + escalated to the
# radix lane. The contract remains covered by radix check + the import-free
# single-module proven lane (valida.fab, U2) + the TS lane; the exempla lane
# is not weakened.
#
# Verb collision (U3 done_when (h); G5/G6): `css` verified against the
# reserved-keyword registries — not reserved, kept verbatim (policy (b)).
# `html` COLLIDES with the Spatium.html enum-member top-level binding —
# the RECORDED G5 defect (stage-0-canary.md §5: "A `fn html()` collides with
# the Spatium.html member binding → SEM005.duplicate_definition. Naming
# constraint: prefix helpers (html_spatium)"). Applied workaround: the HTML
# renderer verb is html_visus — the `html_` prefix per the G5 recorded
# constraint; the policy (b) English stem is preserved, NOT silently renamed.
# ESCALATED To mind: the G5 radix-lane fix restores the exact `html` verb
# (repro: SEM005.duplicate_definition on fn html(Visus) with
# Spatium.html). fix:g5 — removal = grep-replace after the radix fix.
#
# Stage 2 U1 (theme/token protocol) — this module gains the kernel-owned
# theme/token value types (Scopulum/Thema), the core token baseline, and the
# fail-closed deterministic thema_css renderer. fix:<id> markers applied in
# this unit: fix:g5 — NONE (the theme verbs thema/scopulum/thema_css were
# probed collision-free on in-tree radix 0.80.0; a free fn may share a class
# name — G5's collision is enum-member-specific); fix:codegen001 — the Rust
# emit-across-imports block persists (provider-module locale propagation),
# the Rust lane is attempted + recorded, the TS lane is the proven runtime
# lane. See the Stage 2 U1 section header for the pinned core baseline.
#
# Stage 2 U2 (product assembly + cascade) — this module gains the kernel-owned
# Codicillus/Ordo carriers, bundle dedup by stable identity, the topo-ordering
# of library packages over the explicit ordines map (stable-identity
# tie-break), and the assemble(...) → Stilum ∪ null product assembler with
# cascade layers: tela.reset (opt-in; v1 ships none) → tela.tokens → tela.
# components → library packages (topo) → tela.applicatio (last). fix:<id>
# markers: fix:g5 — NONE (assemble verb not reserved, probed); fix:codegen001
# — Rust emit-across-imports block persists (attempted + recorded).
# enum Spatium { html, svg } in one module; in-tree radix 0.80.0,
# 2026-08-09).

import from "tela:valida" private valida

# Spatium: namespace enum (html | svg). The open element model keeps the
# tag itself an ordinary string, so custom elements and future-standard
# names stay open.
enum Spatium {
    html,
    svg
}

# Attributum: serialized attribute — an (nomen, valor) pair emitted into
# the tag.
class Attributum {
    string nomen
    string valor
}

# Proprietas: DOM property (value, checked, selection), modeled separately
# from serialized attributes because their semantics differ. Carried in
# the tree; not serialized into static HTML in Stage 1 (browser lane).
class Proprietas {
    string nomen
    string valor
}

# Identitas: stable identity. Explicit typed field — never inferred from
# array position. Serialized in one documented hydration-ready form
# (data-tela) by the U3 serializer.
class Identitas {
    string valor
}

# Visus: the recursive tagged union at the center of the protocol.
# Closure-free (Branch B): behavior lives in the adjacent typed plan
# (Stage 3), not inside view values. No raw-markup variant (policy (a)).
union Visus {
    Elementum {
        Identitas ∪ null identitas,
        Spatium spatium,
        string nomen_tag,
        list<Attributum> attributa,
        list<Proprietas> proprietates,
        list<Visus> liberi
    },
    Textus { string valor },
    Fragmentum { list<Visus> liberi }
}

# ---------------------------------------------------------------------------
# Kernel-owned constructors — ordinary functions over the same public view
# values. No compiler-known component kinds; helpers are not privileged
# syntax (policy: kernel owns constructors; G3 workaround).
# ---------------------------------------------------------------------------

fn textus_view(string valor) → Visus {
    return variant Textus { valor = valor } ∷ Visus
}

fn fragmentum_view(list<Visus> liberi) → Visus {
    return variant Fragmentum { liberi = liberi } ∷ Visus
}

# Typed stable identity via the nullable field. Routed through a helper
# that returns Identitas ∪ null: direct non-null construction into a
# nullable union field is a known Rust-emission defect (D3 — Some() wrap
# missing; stage-0-branch-a-b-evidence.md §4). Workaround KEPT until the
# radix D3 delivery lands.
fn nova_identitas(string v) → Identitas ∪ null {
    return Identitas { valor = v }
}

# Namespace values as plain helpers: enum-member access through an
# imported namespace does not resolve (gap G1), so the values are exposed
# as functions even inside the kernel module.
fn html_spatium() → Spatium {
    return Spatium.html
}

fn svg_spatium() → Spatium {
    return Spatium.svg
}

# Open-element shorthand: no identity, no attributes.
fn elementum_view(Spatium spatium, string nomen_tag, list<Visus> liberi) → Visus {
    return variant Elementum {
        identitas = null,
        spatium = spatium,
        nomen_tag = nomen_tag,
        attributa = [],
        proprietates = [],
        liberi = liberi
    } ∷ Visus
}

# Full open-element constructor: identity + serialized attributes + DOM
# properties. Cross-module variant construction does not resolve (gap G3),
# so consumers reach the full Elementum through this constructor.
fn elementum_omne(
    Identitas ∪ null identitas,
    Spatium spatium,
    string nomen_tag,
    list<Attributum> attributa,
    list<Proprietas> proprietates,
    list<Visus> liberi
) → Visus {
    return variant Elementum {
        identitas = identitas,
        spatium = spatium,
        nomen_tag = nomen_tag,
        attributa = attributa,
        proprietates = proprietates,
        liberi = liberi
    } ∷ Visus
}

# ---------------------------------------------------------------------------
# Central escaping (policy (a)2) — ONE escape path for text AND attribute
# values. in_attributo selects the attribute escape set: & < > for text,
# additionally " ' for attribute values (single-quote style per the Stage 0
# spike baseline). The identity valor flows through the same attribute-escape
# path (policy (d)). No serializer path concatenates an unescaped value.
# ---------------------------------------------------------------------------

fn escapa(string s, bool in_attributo) → string {
    var string accum ← ""
    var int i ← 0
    while i < s.longitudo() {
        const string c ← s.sectio(i, i + 1)
        # Sequential independent ifs (NOT an elif chain): the TS emitter
        # compiles elif chains whose bodies are single-statement assignments
        # into a returned conditional expression (undefined at runtime — a
        # NEW emitter observation, escalated to the radix lane). A single
        # character can match at most one branch, so the last match wins;
        # the sequential form is semantically identical and emits correctly
        # in both lanes (probe: escapa_elif vs escapa_seq, 2026-08-09).
        # The fragment starts as "" + c (NOT ← c): the Rust emitter moves a
        # String into a local via `let mut fragment: String = c;` while still
        # borrowing c below (E0382 — second NEW emitter observation,
        # escalated to the radix lane); "" + c emits a borrowing format!.
        var string fragment ← "" + c
        if c ≡ "&" then fragment ← "&amp;"
        if c ≡ "<" then fragment ← "&lt;"
        if c ≡ ">" then fragment ← "&gt;"
        # The quote comparison spells the double-quote via ascii-literal
        # interpolation ("§"('"')) rather than the \" escape: the TS emitter
        # double-escapes a `\"` string payload (emits `\\\"` → runtime
        # backslash+quote), so a bare-quote comparison written as "\"" never
        # matches at runtime (NEW emitter observation, escalated to the radix
        # lane; probe escapa on in-tree radix 0.80.0, 2026-08-09).
        if in_attributo and c ≡ "§"('"') then fragment ← "&quot;"
        if in_attributo and c ≡ "'" then fragment ← "&#39;"
        accum ← accum + fragment
        i ← i + 1
    }
    return accum
}

# ---------------------------------------------------------------------------
# Namespace glue (U3) — maps Spatium onto the U2 string surface and applies
# the fail-closed checks. valida.fab keeps its G4-safe string/bool surface.
# ---------------------------------------------------------------------------

fn spatium_textus(Spatium spatium) → string {
    match spatium {
        case Spatium.html {
            return "html"
        }
        case Spatium.svg {
            return "svg"
        }
    }
}

# Namespace emission: svg-namespace elements carry the xmlns declaration
# (spike baseline; required on the svg root for inline SVG, harmless on
# nested svg elements).
fn seri_ns(Spatium spatium) → string {
    match spatium {
        case Spatium.html {
            return ""
        }
        case Spatium.svg {
            return " xmlns='http://www.w3.org/2000/svg'"
        }
    }
}

# Fail-closed pre-pass: the U2 lexical/namespace/void checks over the whole
# tree, run BEFORE any emission. Text is escaped, never validated (any
# string is safe once escaped — policy (a)2). Invalid input NEVER emits
# markup: html_visus returns null (no output at all), never partial markup.
fn valida_arbor(Visus v) → bool {
    match v {
        case Textus const valor {
            return true
        }
        case Fragmentum const liberi {
            for from liberi const liber {
                if not valida_arbor(liber) then return false
            }
            return true
        }
        case Elementum const identitas, spatium, nomen_tag, attributa, proprietates, liberi {
            const string spatium_s ← spatium_textus(spatium)
            if not valida.valida_spatium(spatium_s) then return false
            if not valida.valida_nomen_in_spatio(nomen_tag, spatium_s) then return false
            for from attributa const attr {
                if not valida.valida_nomen_attributi(attr.nomen) then return false
            }
            const bool habet_liberi ← liberi.longitudo() > 0
            if not valida.valida_void_structura(nomen_tag, habet_liberi) then return false
            for from liberi const liber {
                if not valida_arbor(liber) then return false
            }
            return true
        }
    }
}

# ---------------------------------------------------------------------------
# HTML serializer — deterministic, pure, over ordered lists. Author order of
# attributa and liberi is preserved; no unordered/hash iteration, no
# timestamps. Identical input → identical bytes (empirically proven by U6).
# ---------------------------------------------------------------------------

# Attributes serialize as nomen='valor' — single quotes per the spike
# baseline; the valor is escaped through the attribute escape set.
fn seri_attributa(list<Attributum> attributa) → string {
    var string accum ← ""
    for from attributa const attr {
        accum ← accum + " " + attr.nomen + "='" + escapa(attr.valor, true) + "'"
    }
    return accum
}

# Identity: non-null Identitas emits data-tela='<escaped valor>' — the ONE
# documented hydration-ready serialization form (policy (d)); elements
# without identity emit nothing.
fn seri_identitas(Identitas ∪ null identitas) → string {
    match identitas {
        case null {
            return ""
        }
        default {
            return " data-tela='" + escapa(identitas?.valor coalesce "", true) + "'"
        }
    }
}

fn seri_visus(Visus v) → string {
    match v {
        case Textus const valor {
            return escapa(valor, false)
        }
        case Fragmentum const liberi {
            var string accum ← ""
            for from liberi const liber {
                accum ← accum + seri_visus(liber)
            }
            return accum
        }
        case Elementum const identitas, spatium, nomen_tag, attributa, proprietates, liberi {
            var string accum ← "<" + nomen_tag
            accum ← accum + seri_ns(spatium)
            accum ← accum + seri_attributa(attributa)
            accum ← accum + seri_identitas(identitas)
            # Proprietas are carried but NOT serialized into static HTML
            # (Stage 1 static posture; browser-lane DOM properties).
            var string inner ← ""
            for from liberi const liber {
                inner ← inner + seri_visus(liber)
            }
            if valida.valida_void_html(nomen_tag) then return accum + ">"
            return accum + ">" + inner + "</" + nomen_tag + ">"
        }
    }
}

# Public renderer verb (policy (b)). The G5 workaround spelling (html_visus,
# html_ prefix per stage-0-canary.md §5) carries the locked English `html`
# stem; the exact `html` verb is blocked by the Spatium.html enum-member
# top-level binding and is ESCALATED to the radix lane (see module header).
# Fail-closed: null = rejected, no markup ever emitted. Deterministic bytes
# over author order.
fn html_visus(Visus v) → string ∪ null {
    if not valida_arbor(v) then return null
    return seri_visus(v)
}

# ---------------------------------------------------------------------------
# Initial CSS — smallest honest model (policy (c); spike shape). Deterministic
# emission preserving author order of regulae and declarationes.
# ---------------------------------------------------------------------------

class Declaratio {
    string nomen
    string valor
}

class Regula {
    string selector
    list<Declaratio> declarationes
}

class Stilum {
    list<Regula> regulae
}

fn css(Stilum stilum) → string {
    var string accum ← ""
    for from stilum.regulae const regula {
        accum ← accum + regula.selector + " { "
        for from regula.declarationes const decl {
            accum ← accum + decl.nomen + ": " + decl.valor + "; "
        }
        accum ← accum + "}\n"
    }
    return accum
}

# ---------------------------------------------------------------------------
# Stage 2 U1 — Theme / token protocol (campaign §5; policies (b)/(c)).
#
# CORE TOKEN BASELINE (v1 subset, pinned here): surface.canvas, surface.panel,
# text.primary, text.muted, border.default, accent.primary, state.positive,
# state.caution — the interoperable required set from the campaign §5
# families surface.* / text.* / border.* / accent.* / state.*. The v1 subset
# deliberately excludes the space/radius/type/motion families (small + honest;
# future subsets add tokens, never a closed enum — campaign §5).
#
# RENDERING CONVENTION (locked): a token nomen is a dotted path
# (chart.axis.muted); the CSS custom property is `--` + nomen with `.` → `-`
# (--chart-axis-muted — the U5-consumed spelling). thema_css emits the
# resolved tokens as one Regula { selector = ":root", … } — the selected root
# (campaign §5) — rendered through the existing css(Stilum) serializer.
#
# FAIL-CLOSED (U1 done_when (d)): a theme missing a required core token
# → null (no output); an invalid token name (fails the lexical predicate)
# → null. Deterministic bytes over author order (no unordered iteration).
#
# fix:<id> markers applied in this unit:
#   fix:g5 — none applied: the theme verbs (thema, scopulum, thema_css) were
#            probed against the enum-member / reserved-keyword bindings on
#            in-tree radix 0.80.0 (a free fn may share a class name; G5's
#            collision is enum-member-specific) — no collision, no prefix
#            workaround needed. css stays the exact policy (b) verb.
#   fix:codegen001 — Rust emit-across-imports remains blocked (provider-module
#            locale propagation); the Rust lane is attempted + recorded; the
#            TS lane is the proven runtime lane. Never the gate, never
#            weakened.
# ---------------------------------------------------------------------------

# Scopulum: one named token — dotted path (chart.axis.muted) + resolved CSS
# value. U5-proven spelling (proof/benchmark/extension-lib declares the same
# shape).
class Scopulum {
    string nomen
    string valor
}

# Thema: a named theme — a token collection over the core baseline. Two
# materially different themes = two Thema values over the same component tree
# (campaign §5; variants are tokens, not new machinery).
class Thema {
    string nomen
    list<Scopulum> scopuli
}

# Kernel-owned constructors (G3 posture — ordinary functions over the same
# public values, like the Stage 1 kernel constructors).
fn scopulum(string nomen, string valor) → Scopulum {
    return Scopulum { nomen = nomen, valor = valor }
}

fn thema(string nomen, list<Scopulum> scopuli) → Thema {
    return Thema { nomen = nomen, scopuli = scopuli }
}

# The core token baseline — the required token set a theme must cover.
fn scopuli_core() → list<string> {
    return [
        "surface.canvas", "surface.panel",
        "text.primary", "text.muted",
        "border.default",
        "accent.primary",
        "state.positive", "state.caution"
    ]
}

# Dotted path → CSS custom property: `--` + nomen with `.` → `-`.
# Deterministic single-character scan (sequential independent ifs — the
# TS-emitter-safe pattern from escapa).
fn nomen_scopuli_proprietas(string nomen) → string {
    var string accum ← "--"
    var int i ← 0
    while i < nomen.longitudo() {
        const string c ← nomen.sectio(i, i + 1)
        if c ≡ "." then accum ← accum + "-"
        if c ≠ "." then accum ← accum + c
        i ← i + 1
    }
    return accum
}

# Token-name lexical shape: the dotted path must pass the U2 attribute-name
# predicate (letters/digits/-/_/. /:; rejects whitespace, =, quotes, < > /,
# and control characters). A token nomen is a dotted path, so the
# attribute-name charset covers it fail-closed.
fn nomen_scopuli_validum(string nomen) → bool {
    return valida.valida_nomen_attributi(nomen)
}

# Required-token coverage: every core baseline token name must be present in
# the theme's token collection.
fn thema_scopuli_core_parati(Thema thema) → bool {
    const list<string> core ← scopuli_core()
    var int i ← 0
    while i < core.longitudo() {
        if not thema_habet_scopulum(thema, core[i]) then return false
        i ← i + 1
    }
    return true
}

fn thema_habet_scopulum(Thema thema, string nomen) → bool {
    for from thema.scopuli const scopulus {
        if scopulus.nomen ≡ nomen then return true
    }
    return false
}

# Public theme renderer verb (policy (b)): emits the token layer as one
# :root Regula through the existing css(Stilum) serializer. Fail-closed:
# missing required core token, invalid token name, or duplicate token
# identity with different content → null (no output). Deterministic bytes
# over author order.
fn thema_css(Thema thema) → string ∪ null {
    const Stilum ∪ null stilum_result ← thema_stilum(thema)
    if stilum_result is null then return null
    return css(Stilum { regulae = stilum_result!.regulae })
}

# Token-layer builder shared by thema_css and the product assembler (U2):
# the :root Regula over the resolved tokens. Fail-closed: missing required
# core token → null; invalid token name → null; duplicate token identity —
# identical content dedups, different content rejects (policy (e); the
# stage-scope duplicate-token rule exercised here, the renderer surface).
# Deterministic bytes over author order.
fn thema_stilum(Thema thema) → Stilum ∪ null {
    if not thema_scopuli_core_parati(thema) then return null
    var list<Declaratio> declarationes ← vacua
    var int i ← 0
    while i < thema.scopuli.longitudo() {
        const Scopulum scopulus ← thema.scopuli[i]
        if not nomen_scopuli_validum(scopulus.nomen) then return null
        var bool duplicatum ← false
        var int j ← 0
        while j < i {
            const Scopulum prior ← thema.scopuli[j]
            if prior.nomen ≡ scopulus.nomen {
                if prior.valor ≠ scopulus.valor then return null
                duplicatum ← true
            }
            j ← j + 1
        }
        if not duplicatum {
            declarationes.appende(Declaratio {
                nomen = nomen_scopuli_proprietas(scopulus.nomen),
                valor = scopulus.valor
            })
        }
        i ← i + 1
    }
    return Stilum {
        regulae = [
            Regula { selector = ":root", declarationes = declarationes }
        ]
    }
}

# ---------------------------------------------------------------------------
# Stage 2 U2 — Product assembly + cascade ordering (campaign §4/§7; policy (e)).
#
# assemble(...) → Stilum ∪ null — a PURE function over explicit inputs:
#   thema       — the selected theme (renders the tela.tokens :root layer)
#   reset       — optional reset bundle (tela.reset layer; v1 ships NO reset
#                 by default — the layer emits only when a bundle is given)
#   componentes — component style bundles (tela.components layer, input order)
#   ordines     — the explicit package-order map (identity + dependency list;
#                 stdlib-only, no import introspection)
#   codicilli   — extension/library style bundles keyed by package identity
#                 (ordered by the ordines topo map)
#   applicatio  — the optional application style bundle (last layer)
#
# CASCADE LAYER ORDER (emission order — later rules win, the deterministic
# cascade guarantee): tela.reset (opt-in) → tela.tokens (rendered :root
# token layer) → tela.components → extension/library packages in topo order
# → tela.applicatio (last). @layer at-rule syntax is NOT modeled in v1
# (policy (c) growth; recorded deferred).
#
# BUNDLE DEDUP (policy (e)): stable-identity dedup — identical duplicates
# (same rendered css) collapse to one; duplicate identity with different
# content rejects (fail-closed).
#
# LIBRARY ORDERING: dependency-graph topological order over the explicit
# ordines map, then stable package identity as the deterministic
# content-independent tie-break (lexicographic via the list ordinata
# intrinsic). Cycles, unknown dependencies, and codicilli identities absent
# from the ordines map reject (fail-closed).
#
# FAIL-CLOSED (U2 done_when (d)): dependency cycles reject; duplicate bundle
# identities with different content reject; duplicate token identities with
# different content reject (thema_stilum); identical duplicates dedup;
# invalid rule/declaration output (empty selector/property/value or CSS
# structure-breaking characters) rejects before emission.
#
# fix:<id> markers applied in this unit:
#   fix:g5 — NONE: the assemble verb verified against the reserved-keyword /
#            enum-member bindings on in-tree radix 0.80.0 (not reserved; the
#            probe in U1 established that a free fn may share a class name).
#   fix:codegen001 — Rust emit-across-imports remains blocked (provider-module
#            locale propagation); the Rust lane is attempted + recorded; the
#            TS lane is the proven runtime lane.
#   The nullable-result consumption (field-copy reconstructions) follows the
#   established kernel pattern (binding/argument `!` unwrap is rejected by
#   the parser — the same workaround family as the U1 thema_css wrapper).
# ---------------------------------------------------------------------------

# A style bundle: stable identity + the Stilum it contributes. Stable
# identity = the locked package/bundle name (policy (e) — the deterministic
# tie-break basis).
class Codicillus {
    string identitas
    Stilum stilum
}

# One package-order entry: package identity + its dependency identities.
# The explicit package-order map — stdlib-only, no import introspection.
class Ordo {
    string identitas
    list<string> dependet
}

# Kernel-owned constructors (G3 posture).
fn codicillus(string identitas, Stilum stilum) → Codicillus {
    return Codicillus { identitas = identitas, stilum = stilum }
}

fn ordo(string identitas, list<string> dependet) → Ordo {
    return Ordo { identitas = identitas, dependet = dependet }
}

# Bundle dedup by stable identity (policy (e)): identical duplicates (same
# rendered css) collapse to one; duplicate identity with different content
# → null (fail-closed).
fn codicilli_dedupata(list<Codicillus> codicilli) → list<Codicillus> ∪ null {
    var list<Codicillus> unici ← vacua
    var int i ← 0
    while i < codicilli.longitudo() {
        const Codicillus codicillus ← codicilli[i]
        var bool duplicatum ← false
        var int j ← 0
        while j < i {
            const Codicillus prior ← codicilli[j]
            if prior.identitas ≡ codicillus.identitas {
                if css(prior.stilum) ≠ css(codicillus.stilum) then return null
                duplicatum ← true
            }
            j ← j + 1
        }
        if not duplicatum then unici.appende(codicillus)
        i ← i + 1
    }
    return unici
}

# Set membership over a string list.
fn in_lista(list<string> collatio, string nomen) → bool {
    for from collatio const item {
        if item ≡ nomen then return true
    }
    return false
}

# A package is ready when its declared dependencies are all already placed.
# An identity absent from the ordines map is never ready (its dependencies
# are unknowable) — the topo fails closed.
fn pendeant_parata(list<Ordo> ordines, string identitas, list<string> praeposita) → bool {
    var int i ← 0
    while i < ordines.longitudo() {
        const Ordo ordo ← ordines[i]
        if ordo.identitas ≡ identitas {
            var int j ← 0
            while j < ordo.dependet.longitudo() {
                if not in_lista(praeposita, ordo.dependet[j]) then return false
                j ← j + 1
            }
            return true
        }
        i ← i + 1
    }
    return false
}

# Topological order of the package identities over the explicit ordines map
# (policy (e)): dependencies precede dependents; among the ready packages the
# stable identity is the deterministic tie-break (lexicographic via the list
# ordinata intrinsic — content-independent). A cycle (no ready package while
# identities remain) or an unresolvable dependency → null (fail-closed).
fn ordine_ordinata(list<Ordo> ordines, list<string> identitates) → list<string> ∪ null {
    var list<string> ordinata ← vacua
    var list<string> reliqua ← identitates
    while reliqua.longitudo() > 0 {
        var list<string> parata ← vacua
        var int i ← 0
        while i < reliqua.longitudo() {
            if pendeant_parata(ordines, reliqua[i], ordinata) then parata.appende(reliqua[i])
            i ← i + 1
        }
        if parata.longitudo() ≡ 0 then return null
        parata ← parata.ordinata()
        const string electa ← parata[0]
        ordinata.appende(electa)
        var list<string> novae ← vacua
        var int j ← 0
        while j < reliqua.longitudo() {
            if reliqua[j] ≠ electa then novae.appende(reliqua[j])
            j ← j + 1
        }
        reliqua ← novae
    }
    return ordinata
}

# CSS-structure-breaking characters in selector / property / value text make
# the emitted rule invalid — fail-closed before emission.
fn stilum_textus_immundus(string textus) → bool {
    var int i ← 0
    while i < textus.longitudo() {
        const string c ← textus.sectio(i, i + 1)
        if c ≡ "{" then return true
        if c ≡ "}" then return true
        if c ≡ ";" then return true
        if c ≡ "\n" then return true
        i ← i + 1
    }
    return false
}

# Fail-closed rule/declaration shape: non-empty selector / property / value
# and no CSS-structure-breaking characters.
fn stilum_validum(Stilum stilum) → bool {
    for from stilum.regulae const regula {
        if regula.selector.longitudo() ≡ 0 then return false
        if stilum_textus_immundus(regula.selector) then return false
        for from regula.declarationes const decl {
            if decl.nomen.longitudo() ≡ 0 then return false
            if decl.valor.longitudo() ≡ 0 then return false
            if stilum_textus_immundus(decl.nomen) then return false
            if stilum_textus_immundus(decl.valor) then return false
        }
    }
    return true
}

# Find the Stilum a package identity contributes (the library-layer bundle
# lookup). Unknown identity → null (the topo already failed closed).
fn codicillus_ex(string identitas, list<Codicillus> codicilli) → Stilum ∪ null {
    for from codicilli const codicillus {
        if codicillus.identitas ≡ identitas then return codicillus.stilum
    }
    return null
}

# Public product-assembly verb (policy (b); campaign §7): one ordered Stilum
# grouped in cascade-layer order. Fail-closed (no output on any reject).
# Deterministic bytes over the explicit inputs.
fn assemble(
    Thema thema,
    Stilum ∪ null reset,
    list<Codicillus> componentes,
    list<Ordo> ordines,
    list<Codicillus> codicilli,
    Codicillus ∪ null applicatio
) → Stilum ∪ null {
    # tela.tokens — the rendered :root token layer (fail-closed).
    const Stilum ∪ null tokens_result ← thema_stilum(thema)
    if tokens_result is null then return null
    const Stilum tokens ← Stilum { regulae = tokens_result!.regulae }

    # tela.reset — validity only (emission order handled below); v1 ships no
    # reset by default, so the layer emits only when a bundle is provided.
    if reset not is null {
        if not stilum_validum(Stilum { regulae = reset!.regulae }) then return null
    }

    # tela.components — dedup + fail-closed rule shape, input order.
    const list<Codicillus> ∪ null componentes_unici ← codicilli_dedupata(componentes)
    if componentes_unici is null then return null
    const list<Codicillus> componente_vacua ← vacua
    const list<Codicillus> componentes_finales ← componentes_unici coalesce componente_vacua
    var int ci ← 0
    while ci < componentes_finales.longitudo() {
        if not stilum_validum(componentes_finales[ci].stilum) then return null
        ci ← ci + 1
    }

    # Library packages — dedup, rule shape, then topo order over the explicit
    # ordines map (every codicillus identity must appear in ordines).
    const list<Codicillus> ∪ null codicilli_unici ← codicilli_dedupata(codicilli)
    if codicilli_unici is null then return null
    const list<Codicillus> codicilli_vacui ← vacua
    const list<Codicillus> codicilli_finales ← codicilli_unici coalesce codicilli_vacui
    var int li ← 0
    while li < codicilli_finales.longitudo() {
        if not stilum_validum(codicilli_finales[li].stilum) then return null
        li ← li + 1
    }
    var list<string> identitates ← vacua
    var int m ← 0
    while m < codicilli_finales.longitudo() {
        identitates.appende(codicilli_finales[m].identitas)
        m ← m + 1
    }
    const list<string> ∪ null librariae_result ← ordine_ordinata(ordines, identitates)
    if librariae_result is null then return null
    const list<string> librariae_vacuae ← vacua
    const list<string> librariae ← librariae_result coalesce librariae_vacuae

    # tela.applicatio — the last layer; validity only.
    if applicatio not is null {
        if not stilum_validum(Stilum { regulae = applicatio!.stilum.regulae }) then return null
    }

    # Assemble the ordered Stilum — layer order IS emission order.
    var list<Regula> regulae ← vacua
    if reset not is null {
        for from reset!.regulae const regula {
            regulae.appende(regula)
        }
    }
    for from tokens.regulae const regula {
        regulae.appende(regula)
    }
    var int idx ← 0
    while idx < componentes_finales.longitudo() {
        for from componentes_finales[idx].stilum.regulae const regula {
            regulae.appende(regula)
        }
        idx ← idx + 1
    }
    var int ord ← 0
    while ord < librariae.longitudo() {
        const Stilum ∪ null stilum ← codicillus_ex(librariae[ord], codicilli_finales)
        if stilum is null then return null
        for from stilum!.regulae const regula {
            regulae.appende(regula)
        }
        ord ← ord + 1
    }
    if applicatio not is null {
        for from applicatio!.stilum.regulae const regula {
            regulae.appende(regula)
        }
    }
    return Stilum { regulae = regulae }
}
