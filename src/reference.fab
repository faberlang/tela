# tela/src/reference.fab — tela:reference — the reference catalog.
#
# Typed-props → tela.View components, style bundles, and namespaced
# tokens. One flat module; one same-package import (`tela:tela`). Public
# signatures stay on kernel types (G4-safe). Families: layout,
# typography, panel, badge, metric, table, segmented-control, button,
# field.
#
# Components are stateless. Message types, bindings, and update loops
# stay in the consumer (D1). Meaning rides markup, ARIA, or text —
# never color alone. Tokens are zero-arg `tela.Token` accessors;
# consumers collect them app-side into Theme and pass bundles to
# `tela.assemble`.
#
# Identities are data (kebab-case `data-tela` values, never renamed):
#   layout/typography:  ref-layout-stack|grid|prose,
#                       ref-typography-heading-<1..6>,
#                       ref-typography-prose,
#                       ref-typography-emphasis-<kind>,
#                       ref-typography-scale-<step>
#   panel/badge/metric: ref-panel-<name>, ref-badge-<name>,
#                       ref-metric-<name>
#   table:              ref-table-<name>,
#                       ref-table-<name>-header-<i> (0-based),
#                       ref-table-<name>-cell-<r>-<c> (0-based)
#   segmented:          ref-seg-<name>, ref-seg-<name>-<i> (1-based),
#                       ref-seg-live (control-owned singleton)
#   button:             ref-button-<name>
#   field:              form-field-<name>, form-error-<name>,
#                       form-control-<name>, form-live (singleton)
#
# Family contracts:
#   layout     — containers only; no ARIA roles.
#   typography — heading rank is the native h1..h6 tag (level clamped
#                1..6); emphasis is the tag (strong|em|code); unknown
#                kinds stay renderable (open-element); scale is
#                decorative sizing, never state.
#   panel      — role=region; aria-label = title when non-empty; surface
#                from ref.panel.* → theme core; no hardcoded color.
#   badge      — role=status; aria-label "<status>: <text>"; meaning is
#                never color alone.
#   metric     — dl/dt/dd; empty delta omits the second dd.
#   table      — native table/caption/thead/th[scope=col]/tbody/tr/td;
#                no ARIA; caption is the name source (the component
#                never fabricates one); keyboard/sort stay in the
#                consumer.
#   segmented  — radiogroup + radio; roving tabindex (selected = 0,
#                others = -1); aria-selected; live region polite;
#                announce only on selection change (consumer policy).
#   button     — native <button>, no role; Space/Enter activate natively
#                (button_event = "click"); native disabled; visible
#                :focus-visible from ref.button.focus, never removed.
#   field      — native <input type=text>, no role; aria-label = label;
#                aria-invalid from error; aria-describedby →
#                form-error-<name> when invalid; native disabled.
#                Pure helpers: field_input_event = "input";
#                field_error_for_value (empty → "Required");
#                field_announcement (silent when value and error are
#                unchanged).
#
# Shared-harness name locks (formslib top-level names share the
# check-exempla / check-reference assemblies — TS2393):
#   FieldInputProps not FieldProps; field_input / field_control /
#   field_error_region / field_live_region / field_style not the
#   formslib spellings; field_input_event not field_event;
#   field_*_token accessors not form_field_* / form_focus (token
#   *names* stay form.field.* / form.focus).
#
# fix:g6-value-position — `button_props` param is `variant_value`:
#   `variant` is a valid field/param name; the bare identifier as a
#   constructor VALUE fails PARSE001. Field stays `variant`; attribute
#   `data-ref-variant` stays "variant". Removal: grep-replace
#   `variant_value` → `variant` after an expression-position keyword
#   change lands.
# fix:codegen001 — Rust emit-across-imports still blocked; TS is the
#   proven runtime lane.
# fix:snapshot-name-collision — props classes avoid kernel and
#   browser/forms carrier names (see the formslib locks above).
# fix:verum-b — no verum/falsum identifiers.
# LOCALE002 advisory — BadgeProps.status is keyword-like; parses and
#   emits; no rename.

import from "tela:tela" public * as tela

# ===========================================================================
# LAYOUT family — semantic containers (ref-layout-*).
# ===========================================================================

@ public
class StackProps {
    list<tela.View> children
}

@ public
fn stack_props(list<tela.View> children) → StackProps {
    return StackProps { children = children }
}

@ public
fn layout_stack(StackProps props) → tela.View {
    return tela.element_full(
        tela.new_identity("ref-layout-stack"),
        tela.html_space(),
        "div",
        [],
        [],
        props.children
    )
}

@ public
class GridProps {
    list<tela.View> columns
}

@ public
fn grid_props(list<tela.View> columns) → GridProps {
    return GridProps { columns = columns }
}

# Two-column track is declared in layout_style, not on the view.
@ public
fn layout_grid(GridProps props) → tela.View {
    return tela.element_full(
        tela.new_identity("ref-layout-grid"),
        tela.html_space(),
        "div",
        [],
        [],
        props.columns
    )
}

@ public
class LayoutProseProps {
    list<tela.View> children
}

@ public
fn layout_prose_props(list<tela.View> children) → LayoutProseProps {
    return LayoutProseProps { children = children }
}

@ public
fn layout_prose(LayoutProseProps props) → tela.View {
    return tela.element_full(
        tela.new_identity("ref-layout-prose"),
        tela.html_space(),
        "div",
        [],
        [],
        props.children
    )
}

# ===========================================================================
# TYPOGRAPHY family — text semantics via markup (ref-typography-*).
# ===========================================================================

@ public
class HeadingProps {
    int level
    string text
}

@ public
fn heading_props(int level, string text) → HeadingProps {
    return HeadingProps { level = level, text = text }
}

# Fail-safe 1..6 — h0/h7 never emit (exempla-asserted).
@ public
fn clamped_level(int level) → int {
    if level < 1 then return 1
    if level > 6 then return 6
    return level
}

@ public
fn typography_heading(HeadingProps props) → tela.View {
    const int level ← clamped_level(props.level)
    return tela.element_full(
        tela.new_identity("ref-typography-heading-" + "§"(level)),
        tela.html_space(),
        "h" + "§"(level),
        [],
        [],
        [ tela.text_view(props.text) ]
    )
}

@ public
class ProseProps {
    list<tela.View> children
}

@ public
fn prose_props(list<tela.View> children) → ProseProps {
    return ProseProps { children = children }
}

@ public
fn typography_prose(ProseProps props) → tela.View {
    return tela.element_full(
        tela.new_identity("ref-typography-prose"),
        tela.html_space(),
        "p",
        [],
        [],
        props.children
    )
}

@ public
class EmphasisProps {
    string kind
    string text
}

@ public
fn emphasis_props(string kind, string text) → EmphasisProps {
    return EmphasisProps { kind = kind, text = text }
}

@ public
fn typography_emphasis(EmphasisProps props) → tela.View {
    return tela.element_full(
        tela.new_identity("ref-typography-emphasis-" + props.kind),
        tela.html_space(),
        props.kind,
        [],
        [],
        [ tela.text_view(props.text) ]
    )
}

@ public
class ScaleProps {
    string step
    string text
}

@ public
fn scale_props(string step, string text) → ScaleProps {
    return ScaleProps { step = step, text = text }
}

@ public
fn typography_scale(ScaleProps props) → tela.View {
    return tela.element_full(
        tela.new_identity("ref-typography-scale-" + props.step),
        tela.html_space(),
        "span",
        [],
        [],
        [ tela.text_view(props.text) ]
    )
}

# ===========================================================================
# PANEL family — theme-surface containers (ref-panel-*).
# ===========================================================================

@ public
class PanelProps {
    string name
    string title
    list<tela.View> children
}

@ public
fn panel_props(string name, string title, list<tela.View> children) → PanelProps {
    return PanelProps { name = name, title = title, children = children }
}

@ public
fn panel(PanelProps props) → tela.View {
    var list<tela.Attribute> attributes ← [
        tela.Attribute { name = "role", value = "region" }
    ]
    if not (props.title ≡ "") {
        attributes.append(tela.Attribute { name = "aria-label", value = props.title })
    }
    return tela.element_full(
        tela.new_identity("ref-panel-" + props.name),
        tela.html_space(),
        "div",
        attributes,
        [],
        props.children
    )
}

# ===========================================================================
# BADGE family — textual status indicators (ref-badge-*).
# ===========================================================================

@ public
class BadgeProps {
    string name
    string status
    string text
}

@ public
fn badge_props(string name, string status, string text) → BadgeProps {
    return BadgeProps { name = name, status = status, text = text }
}

@ public
fn badge(BadgeProps props) → tela.View {
    return tela.element_full(
        tela.new_identity("ref-badge-" + props.name),
        tela.html_space(),
        "span",
        [
            tela.Attribute { name = "role", value = "status" },
            tela.Attribute { name = "aria-label", value = props.status + ": " + props.text }
        ],
        [],
        [ tela.text_view(props.text) ]
    )
}

# ===========================================================================
# METRIC family — label + value (+ delta) pairs (ref-metric-*).
# ===========================================================================

@ public
class MetricProps {
    string name
    string label
    string value
    string delta
}

@ public
fn metric_props(string name, string label, string value, string delta) → MetricProps {
    return MetricProps { name = name, label = label, value = value, delta = delta }
}

@ public
fn metric(MetricProps props) → tela.View {
    var list<tela.View> children ← [
        tela.element_view(tela.html_space(), "dt", [ tela.text_view(props.label) ]),
        tela.element_view(tela.html_space(), "dd", [ tela.text_view(props.value) ])
    ]
    if not (props.delta ≡ "") {
        children.append(tela.element_view(tela.html_space(), "dd", [ tela.text_view(props.delta) ]))
    }
    return tela.element_full(
        tela.new_identity("ref-metric-" + props.name),
        tela.html_space(),
        "dl",
        [],
        [],
        children
    )
}

# ===========================================================================
# TABLE family — native table grammar (ref-table-*).
# ===========================================================================

@ public
class TableRow {
    list<string> cells
}

@ public
fn table_row(list<string> cells) → TableRow {
    return TableRow { cells = cells }
}

@ public
class TableProps {
    string name
    string caption
    list<string> headers
    list<TableRow> rows
}

@ public
fn table_props(string name, string caption, list<string> headers, list<TableRow> rows) → TableProps {
    return TableProps { name = name, caption = caption, headers = headers, rows = rows }
}

# 0-based identities ref-table-<name>-header-<i>; native th scope=col.
@ public
fn table_header_cells(string name, list<string> headers) → list<tela.View> {
    var list<tela.View> cells ← empty
    var int i ← 0
    while i < headers.length() {
        cells.append(tela.element_full(
            tela.new_identity("ref-table-" + name + "-header-" + "§"(i)),
            tela.html_space(),
            "th",
            [ tela.Attribute { name = "scope", value = "col" } ],
            [],
            [ tela.text_view(headers[i]) ]
        ))
        i ← i + 1
    }
    return cells
}

# 0-based identities ref-table-<name>-cell-<r>-<c>.
@ public
fn table_body_cells(string name, int row, list<string> cells) → list<tela.View> {
    var list<tela.View> tds ← empty
    var int i ← 0
    while i < cells.length() {
        tds.append(tela.element_full(
            tela.new_identity("ref-table-" + name + "-cell-" + "§"(row) + "-" + "§"(i)),
            tela.html_space(),
            "td",
            [],
            [],
            [ tela.text_view(cells[i]) ]
        ))
        i ← i + 1
    }
    return tds
}

@ public
fn table(TableProps props) → tela.View {
    var list<tela.View> children ← empty
    if not (props.caption ≡ "") {
        children.append(tela.element_view(
            tela.html_space(),
            "caption",
            [ tela.text_view(props.caption) ]
        ))
    }
    children.append(tela.element_view(
        tela.html_space(),
        "thead",
        [ tela.element_view(
            tela.html_space(),
            "tr",
            table_header_cells(props.name, props.headers)
        ) ]
    ))
    var list<tela.View> body_rows ← empty
    var int r ← 0
    while r < props.rows.length() {
        const TableRow row ← props.rows[r]
        body_rows.append(tela.element_view(
            tela.html_space(),
            "tr",
            table_body_cells(props.name, r, row.cells)
        ))
        r ← r + 1
    }
    children.append(tela.element_view(
        tela.html_space(),
        "tbody",
        body_rows
    ))
    return tela.element_full(
        tela.new_identity("ref-table-" + props.name),
        tela.html_space(),
        "table",
        [],
        [],
        children
    )
}

# ===========================================================================
# SEGMENTED-CONTROL family (ref-seg-*).
# ===========================================================================

@ public
class SegmentedProps {
    string name
    string label
    list<string> options
    string selected
}

@ public
fn segmented_props(string name, string label, list<string> options, string selected) → SegmentedProps {
    return SegmentedProps { name = name, label = label, options = options, selected = selected }
}

@ public
fn selected_text(bool selected) → string {
    if selected then return "true"
    return "false"
}

@ public
fn active_tabindex(bool selected) → string {
    if selected then return "0"
    return "-1"
}

@ public
fn segmented_option(string identity, string option, string tabindex, string selected) → tela.View {
    return tela.element_full(
        tela.new_identity(identity),
        tela.html_space(),
        "button",
        [
            tela.Attribute { name = "role", value = "radio" },
            tela.Attribute { name = "aria-selected", value = selected },
            tela.Attribute { name = "tabindex", value = tabindex }
        ],
        [],
        [ tela.text_view(option) ]
    )
}

@ public
fn segmented_live_region() → tela.View {
    return tela.element_full(
        tela.new_identity("ref-seg-live"),
        tela.html_space(),
        "div",
        [
            tela.Attribute { name = "role", value = "status" },
            tela.Attribute { name = "aria-live", value = "polite" }
        ],
        [],
        []
    )
}

# 1-based identities ref-seg-<name>-1..N, then the singleton live region.
@ public
fn segmented_options(SegmentedProps props) → list<tela.View> {
    var list<tela.View> options ← empty
    var int i ← 1
    while i ≤ props.options.length() {
        const string identity ← "ref-seg-" + props.name + "-" + "§"(i)
        const string option ← props.options[i - 1]
        const bool selected ← identity ≡ props.selected
        options.append(segmented_option(identity, option, active_tabindex(selected), selected_text(selected)))
        i ← i + 1
    }
    options.append(segmented_live_region())
    return options
}

@ public
fn segmented_control(SegmentedProps props) → tela.View {
    return tela.element_full(
        tela.new_identity("ref-seg-" + props.name),
        tela.html_space(),
        "div",
        [
            tela.Attribute { name = "role", value = "radiogroup" },
            tela.Attribute { name = "aria-label", value = props.label }
        ],
        [],
        segmented_options(props)
    )
}

# ===========================================================================
# BUTTON family (ref-button-*).
# ===========================================================================

@ public
class ButtonProps {
    string name
    string label
    string variant
    string state
    string event_name
    string aria_label
}

# fix:g6-value-position — variant as a constructor VALUE fails PARSE001.
@ public
fn button_props(string name, string label, string variant_value, string state, string event_name, string aria_label) → ButtonProps {
    return ButtonProps {
        name = name,
        label = label,
        variant = variant_value,
        state = state,
        event_name = event_name,
        aria_label = aria_label
    }
}

@ public
fn button_event() → string {
    return "click"
}

# Attribute author order: aria-label? → disabled? → data-ref-variant → data-tela.
@ public
fn button(ButtonProps props) → tela.View {
    var list<tela.Attribute> attributes ← empty
    if not (props.aria_label ≡ "") {
        attributes.append(tela.Attribute { name = "aria-label", value = props.aria_label })
    }
    if props.state ≡ "disabled" {
        attributes.append(tela.Attribute { name = "disabled", value = "" })
    }
    attributes.append(tela.Attribute { name = "data-ref-variant", value = props.variant })
    return tela.element_full(
        tela.new_identity("ref-button-" + props.name),
        tela.html_space(),
        "button",
        attributes,
        [],
        [ tela.text_view(props.label) ]
    )
}

# ===========================================================================
# FIELD family — static surface (form-*).
# ===========================================================================

@ public
class FieldInputProps {
    string name
    string label
    string value
    string error
    string disabled
}

@ public
fn field_input_props(string name, string label, string value, string error, string disabled) → FieldInputProps {
    return FieldInputProps {
        name = name,
        label = label,
        value = value,
        error = error,
        disabled = disabled
    }
}

# Non-empty error → aria-invalid "true"; otherwise "false".
@ public
fn field_invalid(FieldInputProps props) → string {
    if not (props.error ≡ "") then return "true"
    return "false"
}

# Attribute author order: type → aria-label → aria-invalid → describedby? → value? → disabled? → data-tela.
@ public
fn field_input(FieldInputProps props) → tela.View {
    var list<tela.Attribute> attributes ← empty
    attributes.append(tela.Attribute { name = "type", value = "text" })
    attributes.append(tela.Attribute { name = "aria-label", value = props.label })
    attributes.append(tela.Attribute { name = "aria-invalid", value = field_invalid(props) })
    if not (props.error ≡ "") {
        attributes.append(tela.Attribute { name = "aria-describedby", value = "form-error-" + props.name })
    }
    if not (props.value ≡ "") {
        attributes.append(tela.Attribute { name = "value", value = props.value })
    }
    if props.disabled ≡ "disabled" {
        attributes.append(tela.Attribute { name = "disabled", value = "" })
    }
    return tela.element_full(
        tela.new_identity("form-field-" + props.name),
        tela.html_space(),
        "input",
        attributes,
        [],
        []
    )
}

# Empty error still emits the node so the association structure stays stable.
@ public
fn field_error_region(string name, string error) → tela.View {
    var list<tela.View> children ← empty
    if not (error ≡ "") {
        children.append(tela.text_view(error))
    }
    return tela.element_full(
        tela.new_identity("form-error-" + name),
        tela.html_space(),
        "div",
        [ tela.Attribute { name = "role", value = "alert" } ],
        [],
        children
    )
}

@ public
fn field_live_region() → tela.View {
    return tela.element_full(
        tela.new_identity("form-live"),
        tela.html_space(),
        "div",
        [
            tela.Attribute { name = "role", value = "status" },
            tela.Attribute { name = "aria-live", value = "polite" }
        ],
        [],
        []
    )
}

@ public
fn field_control(FieldInputProps props) → tela.View {
    var list<tela.View> children ← empty
    children.append(field_input(props))
    children.append(field_error_region(props.name, props.error))
    return tela.element_full(
        tela.new_identity("form-control-" + props.name),
        tela.html_space(),
        "div",
        [],
        [],
        children
    )
}

# ===========================================================================
# FIELD family — pure behavior helpers.
# ===========================================================================

# fix:snapshot-name-collision — formslib `field_event` is taken in the shared harness.
@ public
fn field_input_event() → string {
    return "input"
}

# Empty value → "Required"; otherwise cleared.
@ public
fn field_error_for_value(string value) → string {
    if value ≡ "" then return "Required"
    return ""
}

# Silent when value and error are unchanged; otherwise identity + valid/invalid text.
@ public
fn field_announcement(FieldInputProps ante, FieldInputProps post) → string {
    if ante.value ≡ post.value and ante.error ≡ post.error {
        return ""
    }
    if not (post.error ≡ "") {
        return "form-field-" + post.name + " invalid: " + post.error
    }
    return "form-field-" + post.name + " valid"
}

# ===========================================================================
# STYLE BUNDLES — identity-keyed rules, --ref-* / --form-* custom properties.
# ===========================================================================

@ public
fn layout_style() → tela.Style {
    return tela.Style {
        rules = [
            tela.Rule {
                selector = "[data-tela='ref-layout-stack']",
                declarations = [
                    tela.Declaration { name = "display", value = "flex" },
                    tela.Declaration { name = "flex-direction", value = "column" },
                    tela.Declaration { name = "gap", value = "var(--ref-layout-gap)" }
                ]
            },
            tela.Rule {
                selector = "[data-tela='ref-layout-grid']",
                declarations = [
                    tela.Declaration { name = "display", value = "grid" },
                    tela.Declaration { name = "grid-template-columns", value = "repeat(2, 1fr)" },
                    tela.Declaration { name = "gap", value = "var(--ref-layout-gap)" }
                ]
            },
            tela.Rule {
                selector = "[data-tela='ref-layout-prose']",
                declarations = [
                    tela.Declaration { name = "max-width", value = "var(--ref-layout-prose-measure)" },
                    tela.Declaration { name = "margin", value = "0 auto" }
                ]
            }
        ]
    }
}

# Heading scale: h1→xl, h2→lg, h3→md, h4→sm, h5/h6→xs.
@ public
fn typography_style() → tela.Style {
    return tela.Style {
        rules = [
            tela.Rule {
                selector = "[data-tela='ref-typography-heading-1']",
                declarations = [
                    tela.Declaration { name = "font-size", value = "var(--ref-type-scale-xl)" },
                    tela.Declaration { name = "font-weight", value = "var(--ref-type-heading-weight)" },
                    tela.Declaration { name = "margin", value = "var(--ref-type-heading-margin)" }
                ]
            },
            tela.Rule {
                selector = "[data-tela='ref-typography-heading-2']",
                declarations = [
                    tela.Declaration { name = "font-size", value = "var(--ref-type-scale-lg)" },
                    tela.Declaration { name = "font-weight", value = "var(--ref-type-heading-weight)" },
                    tela.Declaration { name = "margin", value = "var(--ref-type-heading-margin)" }
                ]
            },
            tela.Rule {
                selector = "[data-tela='ref-typography-heading-3']",
                declarations = [
                    tela.Declaration { name = "font-size", value = "var(--ref-type-scale-md)" },
                    tela.Declaration { name = "font-weight", value = "var(--ref-type-heading-weight)" },
                    tela.Declaration { name = "margin", value = "var(--ref-type-heading-margin)" }
                ]
            },
            tela.Rule {
                selector = "[data-tela='ref-typography-heading-4']",
                declarations = [
                    tela.Declaration { name = "font-size", value = "var(--ref-type-scale-sm)" },
                    tela.Declaration { name = "font-weight", value = "var(--ref-type-heading-weight)" },
                    tela.Declaration { name = "margin", value = "var(--ref-type-heading-margin)" }
                ]
            },
            tela.Rule {
                selector = "[data-tela='ref-typography-heading-5']",
                declarations = [
                    tela.Declaration { name = "font-size", value = "var(--ref-type-scale-xs)" },
                    tela.Declaration { name = "font-weight", value = "var(--ref-type-heading-weight)" },
                    tela.Declaration { name = "margin", value = "var(--ref-type-heading-margin)" }
