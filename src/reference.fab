# tela/src/reference.fab — tela:reference — the reference catalog module.
#
# Stage 5 U2 (tela-s5-u2-layout-typography): the catalog STARTS — the
# **layout** family (stacked rows / two-column grid / prose measures) and
# the **typography** family (headings / prose / emphasis / scale), as
# ordinary component functions over typed props → tela.View with stable
# ref-layout-*/ref-typography-* data-tela identities, plus their style
# bundles → tela.Style keyed on the identities and the namespaced ref.*
# tokens (the kernel Token carrier pattern, MF-7). U3–U8 extend this one
# flat module — strictly sequential (delivery Coordination Constraint 3).
#
# Stage 5 U3 (tela-s5-u3-panel-badge-metric): the catalog EXTENDS with
# three families — **panel** (a surface container with theme-surface
# semantics: the surface/border come from the ref.panel.* tokens, which
# reference the theme's core surface.panel / border.default — no hardcoded
# color anywhere in the component), **badge** (a status/label indicator:
# textual label + role="status" + aria-label carrying the status word — a
# badge's meaning is never color alone, campaign §8), and **metric**
# (label + value + optional delta in the benchmark grammar's definition-list
# pattern — dl/dt/dd, the textual form preserved). Stable
# ref-panel-<name>/ref-badge-<name>/ref-metric-<name> identities; the
# style bundles key on the identity prefixes ([data-tela^='ref-panel-']
# — the variable-suffix form, the formslib precedent), referencing the
# namespaced ref.panel.* / ref.badge.* / ref.metric.* tokens.
#
# Stage 5 U4 (tela-s5-u4-table): the catalog EXTENDS with the **table**
# family — the benchmark table grammar as a composite component:
# headers + rows + cells + an optional caption, with the §8 table
# accessibility contract. Semantic structure: <table> → optional
# <caption> → <thead> (one <tr> of <th scope='col'> header cells) →
# <tbody> (one <tr> per data row, each a <td> per cell). The NATIVE
# table semantics ARE the a11y structure (screen readers expose the
# row/column/cell grid natively — no ARIA duplication); the header
# association rides the th[scope] markup; the caption (or the app's
# recorded equivalent) provides the accessible name. Identity scheme:
# ref-table-<name> on the table root, ref-table-<name>-header-<i> on
# each header cell, ref-table-<name>-cell-<r>-<c> on each body cell
# (stable focus targets for the declared consumer-plan navigation
# interaction). The style bundle keys on the identity prefix
# ([data-tela^='ref-table-'] — the variable-suffix form), referencing
# the namespaced ref.table.* tokens.
#
# THE TABLE ACCESSIBILITY CONTRACT (campaign §8 — table headers +
# textual equivalents; done_when (a)+(b)):
#   - SEMANTIC STRUCTURE: the native <table>/<caption>/<thead>/<th>/
#     <tbody>/<tr>/<td> markup IS the a11y structure — no ARIA roles
#     for the ordinary static table (ARIA would duplicate the native
#     semantics); screen readers expose the grid natively.
#   - HEADERS + SCOPE: every header cell is a <th> carrying
#     scope='col' — the column association is the native th[scope]
#     semantics (the §8 "table headers" contract).
#   - THE ACCESSIBLE NAME: the <caption> when present provides it. No
#     caption → the app supplies a recorded equivalent (an aria-label
#     on the table or an off-screen equivalent is an app choice — the
#     component never fabricates a name); the contract is: the table
#     ALWAYS has a name source.
#   - TEXTUAL EQUIVALENTS: headers + cells are text nodes (the §8
#     "textual equivalents for visual charts" contract — the table
#     never carries chart-only content).
#   - KEYBOARD/SORT SEMANTICS + THE D1 APP-TYPED PLAN BOUNDARY
#     (recorded): the table is STATELESS — it declares no behavior.
#     Row navigation / cell focus movement / sort interactions are
#     DECLARED in the consumer plan (D1 — the app-typed plan keyed to
#     the ref-table-* identities); the check-reference interaction
#     case proves the declared shape: the host driver executes the
#     consumer's scripted row-navigation plan, synchronous-only,
#     fail-closed. A sortable table's sort control is a consumer
#     component (a th > button + aria-sort + the app's update) —
#     never kernel/catalog behavior.
#
# Stage 5 U5 (tela-s5-u5-segmented-control-reference): the catalog
# EXTENDS with the **segmented-control** family — the Stage 3 segmented
# control RE-HOMED as a tela-owned reference component (the app's
# control leaves the consumer; the app keeps its D1 behavior plan and
# COMPOSES the reference control through normal qualified imports).
# Typed props (name/label/options/selected) → tela.View with the
# ref-seg-<name> group, the ref-seg-<name>-<i> segments (1-based, the
# Stage 3 index scheme), and the ref-seg-live declared live region.
#
# THE SEGMENTED-CONTROL ACCESSIBILITY CONTRACT (campaign §8 + the Stage 3
# §1.3/§1.4/§1.5 record; done_when (a)):
#   - ROLES: the group carries role='radiogroup' + aria-label = the
#     control's accessible name (the `label` prop); each segment
#     carries role='radio'.
#   - ROVING TABINDEX (one tab stop as a whole, §1.3): the selected
#     segment carries tabindex='0', the others tabindex='-1' — only the
#     selected segment is in the tab sequence; Tab leaves the control
#     as a unit. The roving moves with the selection (a replace
#     re-renders the roving tabindex).
#   - SELECTED STATE (§1.4): aria-selected='true'/'false' on the
#     segments.
#   - THE DECLARED LIVE REGION (§1.5): the control-owned
#     <div role='status' aria-live='polite' data-tela='ref-seg-live'>
#     — not an ambient page notification. THE NO-OP RULE: an
#     announcement fires ONLY when the selection CHANGES; a click or
#     keypress on the already-selected segment is SILENT.
#   - THE D1 APP-TYPED PLAN BOUNDARY (recorded): the control is
#     STATELESS — it declares no behavior. The message type + bindings
#     + update loop + announcement semantics are the CONSUMER's plan
#     (D1 — app-typed), keyed to the ref-seg-* identities; the keyboard
#     semantics (arrows/Home/End/Space/Enter), the focus-only movement,
#     and the live-region policy are documented in the consumer's plan
#     record. The catalog never carries a generic behavior plan.
#
# Stage 5 U6 (tela-s5-u6-button): the catalog EXTENDS with the **button**
# family — the FIRST catalog behavior component (the behavior/a11y
# boundary; delivery U6). Typed props (label / variant / state / the
# declared event surface + the identity name + the optional accessible-
# name override) → tela.View with the ref-button-<name> identities.
#
# THE BUTTON ACCESSIBILITY CONTRACT (campaign §8 keyboard + focus;
# done_when (a)):
#   - NATIVE BUTTON SEMANTICS: the element IS a native <button> — no ARIA
#     role (a role would duplicate the native semantics).
#   - THE ACCESSIBLE NAME (label/aria-label): the visible label text
#     (native — a <button>'s accessible name is its content) or the
#     declared aria-label override (the aria_label prop — an app-supplied
#     name differing from the label).
#   - THE KEYBOARD CONTRACT: NATIVE button semantics — Space/Enter on the
#     focused button fire the activation event (the declared event
#     surface; button_event() = "click"). The consumer plan binds ONLY the
#     activation event — the native keyboard → click needs no app key map.
#   - VISIBLE FOCUS (campaign §8): the button_style bundle's
#     :focus-visible rule draws the focus indicator from the
#     ref.button.focus token (the theme's accent) — the focus indicator
#     is never removed, no hardcoded color.
#   - THE DISABLED STATE: the native `disabled` attribute when
#     state = "disabled" — the button leaves the tab sequence, NO
#     activation fires, and the state is exposed to assistive tech
#     natively. The plan binds ONLY enabled buttons (a disabled click is
#     a no-op by construction — the native semantics + no subscription).
#   - THE D1 APP-TYPED PLAN BOUNDARY (recorded): the button is STATELESS —
#     it declares no behavior. The concrete message type + the bindings +
#     the update loop are the CONSUMER's plan (D1 — app-typed), keyed to
#     the ref-button-* identities; the catalog never carries a generic
#     behavior plan. The event surface is the props' event_name (the
#     declared activation event); the plan binds that event name.
#
# MODULE SHAPE (U1-locked, stage-5-discovery.md §1): ONE flat module
# mirroring the kernel (G4-safe), stdlib-only + ONE same-package sibling
# import (tela:tela); no public signature references a type outside the
# kernel's own surface. Every new identifier probed collision-free on
# in-tree radix 0.80.0 (the G5 probe discipline) — no kernel-type-name
# collisions (View/Style/Token/Theme/Bundle/Order/...), no seam-type-name
# collisions, no verum/falsum identifiers (fix:verum-b). Casing: types
# PascalCase concatenation (StackProps), fns/fields snake_case, identities
# kebab-case data (MF-8), tokens dotted lowercase (ref.*).
#
# THE SEVEN FAMILIES (delivery U2/U3/U4/U5/U6 outcomes; campaign §3
# component contract):
#
#   LAYOUT — semantic containers for arrangement, no ARIA roles (pure
#   layout grouping; the a11y structure is the container semantics + the
#   prose measure):
#     layout_stack(StackProps)            → ref-layout-stack  — stacked
#       rows: a vertical stack of child views (one per row).
#     layout_grid(GridProps)              → ref-layout-grid   — the
#       two-column grid: children fill the two-column track in order.
#     layout_prose(LayoutProseProps)      → ref-layout-prose  — the prose
#       measure container: constrains the line measure around prose
#       content (the layout-level measure; the paragraph itself is
#       typography_prose).
#
#   TYPOGRAPHY — the text semantics, communicated by MARKUP, never by
#   color alone (campaign §8 no-color-only-communication):
#     typography_heading(HeadingProps)    → ref-typography-heading-<level>
#       — native h1..h6 by level: the HEADING HIERARCHY is the a11y
#       structure (screen readers expose the native heading semantics;
#       the level is the documented 1..6 range, clamped fail-safe at the
#       edges so h0/h7 never emit).
#     typography_prose(ProseProps)        → ref-typography-prose — the
#       paragraph (prose semantics; the layout prose measure wraps it).
#     typography_emphasis(EmphasisProps)  → ref-typography-emphasis-<kind>
#       — semantic emphasis: kind ∈ strong | em | code, emitted as the
#       element tag (strong/em/code are the HTML semantic tags — emphasis
#       is NEVER communicated by color or size alone).
#     typography_scale(ScaleProps)        → ref-typography-scale-<step> —
#       text at a documented type-scale step (xs/sm/md/lg/xl); the scale
#       is decorative sizing (the size comes from the ref.type.scale.*
#       tokens), never a semantic state carrier.
#
#   PANEL / BADGE / METRIC (U3) — theme-surface container + textual
#   status + label/value(+delta) pairs: panel(PanelProps) →
#   ref-panel-<name> (role='region' landmark + aria-label when titled;
#   the surface comes from the ref.panel.* tokens referencing the theme
#   core — no hardcoded color), badge(BadgeProps) → ref-badge-<name>
#   (role='status' + aria-label "<status>: <text>" — meaning never color
#   alone), metric(MetricProps) → ref-metric-<name> (the benchmark
#   grammar's dl/dt/dd definition-list pattern — the textual form
#   preserved).
#
#   TABLE (U4) — the benchmark table grammar as a semantic composite:
#     table(TableProps)                   → ref-table-<name> — headers +
#       rows + cells + optional caption; the native <table>/<caption>/
#       <thead>/<th scope='col'>/<tbody>/<tr>/<td> markup IS the a11y
#       structure (the §8 table contract — headers + scope + accessible
#       name + textual equivalents); stateless (D1: a declared
#       keyboard/sort interaction stays in the consumer plan).
#
#   SEGMENTED-CONTROL (U5) — the Stage 3 control re-homed:
#     segmented_control(SegmentedProps)   → ref-seg-<name> — the group
#       (role='radiogroup' + the accessible name), the
#       ref-seg-<name>-<i> segments (role='radio' + aria-selected +
#       the roving tabindex — ONE tab stop as a whole, §1.3), the
#       control-owned declared live region ref-seg-live (role='status' +
#       aria-live='polite', §1.5 — the no-op rule: announce on a
#       selection change, silent on no-op); stateless (D1: the app-typed
#       plan + the keyboard/live-region semantics stay in the consumer).
#
#   BUTTON (U6) — the first behavior component:
#     button(ButtonProps)                  → ref-button-<name> — NATIVE
#       <button> semantics (no ARIA role — no duplication), the
#       accessible name (the label text / the aria-label override), the
#       NATIVE keyboard contract (Space/Enter activate — the activation
#       event fires, the declared event surface button_event()="click"),
#       the visible focus (the bundle's :focus-visible rule, the
#       ref.button.focus token), the native disabled attribute (no
#       activation, the state exposed); stateless (D1: the app-typed
#       plan + the update loop stay in the consumer, keyed to the
#       ref-button-* identities; the plan binds only enabled buttons).
#
# NO COLOR-ONLY COMMUNICATION (campaign §8): no component in U2 carries
# meaning through color. Emphasis is semantic markup; the scale is
# decorative sizing; the layout containers are structural. The style
# bundles color no state — tokens supply values only through the selected
# theme (campaign §5: themes supply values, not semantics).
#
# STYLE BUNDLES + TOKENS (delivery U2 done_when (c)):
#   layout_style() → tela.Style      — rules keyed on the layout
#     identities, referencing the ref.layout.* tokens.
#   typography_style() → tela.Style  — rules keyed on the typography
#     identities, referencing the ref.type.* tokens (the heading scale,
#     the prose measure/leading, the scale steps).
#   The tokens are zero-arg accessors returning the kernel tela.Token
#   carrier (the MF-7 ONE-carrier pattern — the formslib precedent):
#   ref.layout.gap, ref.layout.prose.measure, ref.type.scale.xs|sm|md|lg|xl,
#   ref.type.heading.weight, ref.type.heading.margin, ref.type.prose.
#   line-height, ref.type.prose.margin. Consumers collect them app-side
#   into their Theme (the compose-without pattern) and pass the bundles to
#   tela.assemble (the Stage 2 assembly contract — cascade order,
#   fail-closed).
#
# fix:<id> markers applied in this unit:
#   fix:g5 — NONE: all new identifiers (layout_stack/layout_grid/
#     layout_prose/typography_heading/typography_prose/typography_emphasis/
#     typography_scale/stack_props/grid_props/layout_prose_props/
#     heading_props/prose_props/emphasis_props/scale_props/clamped_level/
#     layout_style/typography_style/reference_tokens + the token
#     accessors; U3: panel/badge/metric/panel_props/badge_props/
#     metric_props/panel_style/badge_style/metric_style + the
#     ref_panel_*/ref_badge_*/ref_metric_* accessors; U4:
#     table/table_row/table_props/table_header_cells/table_body_cells/
#     table_style + the ref_table_* accessors; U5:
#     segmented_control/segmented_props/segmented_option/
#     segmented_options/segmented_live_region/selected_text/
#     active_tabindex/segmented_style/SegmentedProps + the ref_seg_*
#     accessors; U6:
#     button/button_props/button_event/button_style/ButtonProps + the
#     ref_button_* accessors) probed
#     collision-free on in-tree radix 0.80.0 (a free fn may share a class
#     name — G5's collision is enum-member-specific).
#   fix:codegen001 — the Rust emit-across-imports block persists
#     (attempted + recorded; the TS lane is the proven runtime lane).
#   fix:snapshot-name-collision — the props classes avoid the kernel type
#     names AND the browser/forms carrier names (StackProps/GridProps/
#     LayoutProseProps/HeadingProps/ProseProps/EmphasisProps/ScaleProps/
#     PanelProps/BadgeProps/MetricProps/TableRow/TableProps/
#     SegmentedProps/ButtonProps).
#   fix:verum-b — en-locale naming: no verum/falsum identifiers.
#   G6 note (U6, the keyword-collision record): the delivery's button
#     "variant" prop semantic is spelled **variant_name** — `variant` is
#     the en-locale UNION-VARIANT-CONSTRUCTION keyword (the `variant
#     Selected { … }` spelling, main.fab) and is unavailable as an
#     identifier (PARSE001 — the G6 reserved-keyword rule, probed live on
#     in-tree radix 0.80.0). The working spelling carries the semantic;
#     the data-ref-variant ATTRIBUTE keeps the exact "variant" spelling
#     (attribute names are data). Removal = grep-replace
#     (`variant_name` → `variant`) only if/when a radix-lane keyword
#     change lands; never silently renamed after.
#   LOCALE002 advisory (recorded, non-blocking): the BadgeProps `status`
#     field is a keyword-like spelling (advisory only — it parses + emits,
#     per the web-surface-import DELIVERY §5.2 record); no rename needed.
#
# G4 consumability (done_when (g)): the `→ tela.View` component fns + the
# `→ tela.Style`/`→ tela.Token` accessors are consumable through NORMAL
# qualified imports (the U1 probe (i) + cds-u6; re-verified at real use by
# the canary-app + check-reference — never assumed).

import from "tela:tela" public * ut tela

# ===========================================================================
# LAYOUT family — semantic containers (ref-layout-*).
# ===========================================================================

class StackProps {
    list<tela.View> children
}

fn stack_props(list<tela.View> children) → StackProps {
    return StackProps { children = children }
}

# Stacked rows: a vertical stack of child views, one per row. Pure layout
# grouping (no ARIA role); the row structure is the container semantics.
fn layout_stack(StackProps props) → tela.View {
    return tela.element_full(
        tela.new_identity("ref-layout-stack"),
        tela.html_space(),
        "div",
        [],
        [],
        props.children
    )
}

class GridProps {
    list<tela.View> columns
}

fn grid_props(list<tela.View> columns) → GridProps {
    return GridProps { columns = columns }
}

# The two-column grid: children fill the two-column track in author order
# (the CSS grid rule in layout_style declares the track). Pure layout
# grouping; the column structure is the container semantics.
fn layout_grid(GridProps props) → tela.View {
    return tela.element_full(
        tela.new_identity("ref-layout-grid"),
        tela.html_space(),
        "div",
        [],
        [],
        props.columns
    )
}

class LayoutProseProps {
    list<tela.View> children
}

fn layout_prose_props(list<tela.View> children) → LayoutProseProps {
    return LayoutProseProps { children = children }
}

# The prose measure: constrains the line measure (the ref.layout.prose.
# measure token) around prose content. The measure is a layout-level
# container — prose SEMANTICS live in the typography paragraph.
fn layout_prose(LayoutProseProps props) → tela.View {
    return tela.element_full(
        tela.new_identity("ref-layout-prose"),
        tela.html_space(),
        "div",
        [],
        [],
        props.children
    )
}

# ===========================================================================
# TYPOGRAPHY family — text semantics via markup (ref-typography-*).
# ===========================================================================

class HeadingProps {
    int level
    string text
}

fn heading_props(int level, string text) → HeadingProps {
    return HeadingProps { level = level, text = text }
}

# The heading level, clamped to the documented 1..6 range (fail-safe at
# the edges — h0/h7 never emit; the clamp is asserted by the exempla).
fn clamped_level(int level) → int {
    if level < 1 then return 1
    if level > 6 then return 6
    return level
}

# Heading: native h1..h6 by level — the HEADING HIERARCHY is the a11y
# structure (native heading semantics for screen readers; the level is the
# range contract 1..6). No color-only communication: the heading carries
# its rank in the tag, never in styling alone.
fn typography_heading(HeadingProps props) → tela.View {
    const int level ← clamped_level(props.level)
    return tela.element_full(
        tela.new_identity("ref-typography-heading-" + "§"(level)),
        tela.html_space(),
        "h" + "§"(level),
        [],
        [],
        [ tela.text_view(props.text) ]
    )
}

class ProseProps {
    list<tela.View> children
}

fn prose_props(list<tela.View> children) → ProseProps {
    return ProseProps { children = children }
}

# Prose: the paragraph — prose semantics (the layout prose measure wraps
# it; the type scale + leading come from the ref.type.* tokens). Mixed
# content is carried by the children (text + emphasis compose inline).
fn typography_prose(ProseProps props) → tela.View {
    return tela.element_full(
        tela.new_identity("ref-typography-prose"),
        tela.html_space(),
        "p",
        [],
        [],
        props.children
    )
}

class EmphasisProps {
    string kind
    string text
}

fn emphasis_props(string kind, string text) → EmphasisProps {
    return EmphasisProps { kind = kind, text = text }
}

# Emphasis: semantic emphasis — kind ∈ strong | em | code, emitted as the
# element tag (the HTML semantic emphasis tags). Emphasis is NEVER
# communicated by color or size alone (campaign §8) — the meaning rides
# the markup. The documented kind set is {strong, em, code} (the
# open-element model keeps unknown kinds renderable; the catalog contract
# names the three).
fn typography_emphasis(EmphasisProps props) → tela.View {
    return tela.element_full(
        tela.new_identity("ref-typography-emphasis-" + props.kind),
        tela.html_space(),
        props.kind,
        [],
        [],
        [ tela.text_view(props.text) ]
    )
}

class ScaleProps {
    string step
    string text
}

fn scale_props(string step, string text) → ScaleProps {
    return ScaleProps { step = step, text = text }
}

# Type scale: text at a documented scale step (xs/sm/md/lg/xl). The size
# comes from the ref.type.scale.* tokens via the typography style bundle.
# The scale is decorative sizing — it never carries semantic state (no
# status/level meaning in size, never in color).
fn typography_scale(ScaleProps props) → tela.View {
    return tela.element_full(
        tela.new_identity("ref-typography-scale-" + props.step),
        tela.html_space(),
        "span",
        [],
        [],
        [ tela.text_view(props.text) ]
    )
}

# ===========================================================================
# PANEL family — theme-surface containers (ref-panel-*).
# ===========================================================================

class PanelProps {
    string name
    string title
    list<tela.View> children
}

fn panel_props(string name, string title, list<tela.View> children) → PanelProps {
    return PanelProps { name = name, title = title, children = children }
}

# Panel: a surface/container. THE THEME-SURFACE SEMANTICS (done_when (a)):
# the surface background + border come from the ref.panel.surface /
# ref.panel.border tokens, which reference the theme's core surface.panel /
# border.default tokens (var(--surface-panel) / var(--border-default)) —
# the component contains NO hardcoded color; the panel follows the selected
# theme's surface. The a11y structure: role='region' (a named landmark —
# the accessible name) + aria-label = the title when present (no title → no
# aria-label). A visible title is app content (a heading in the children —
# the heading hierarchy is the app's call).
fn panel(PanelProps props) → tela.View {
    var list<tela.Attribute> attributes ← [
        tela.Attribute { name = "role", value = "region" }
    ]
    if not (props.title ≡ "") {
        attributes.appende(tela.Attribute { name = "aria-label", value = props.title })
    }
    return tela.element_full(
        tela.new_identity("ref-panel-" + props.name),
        tela.html_space(),
        "div",
        attributes,
        [],
        props.children
    )
}

# ===========================================================================
# BADGE family — textual status indicators (ref-badge-*).
# ===========================================================================

class BadgeProps {
    string name
    string status
    string text
}

fn badge_props(string name, string status, string text) → BadgeProps {
    return BadgeProps { name = name, status = status, text = text }
}

# Badge: a small status/label indicator. NO COLOR-ONLY COMMUNICATION
# (done_when (a), campaign §8): the meaning is textual — the label is the
# visible text and the status word rides the accessible name, never color
# alone. The a11y shape: role='status' (the status live-region semantic) +
# aria-label = "<status>: <text>" (the full textual meaning). The style
# bundle may shape the badge (size/padding/radius) but colors nothing
# semantic — a status color is app-side styling over its own selectors.
fn badge(BadgeProps props) → tela.View {
    return tela.element_full(
        tela.new_identity("ref-badge-" + props.name),
        tela.html_space(),
        "span",
        [
            tela.Attribute { name = "role", value = "status" },
            tela.Attribute { name = "aria-label", value = props.status + ": " + props.text }
        ],
        [],
        [ tela.text_view(props.text) ]
    )
}

# ===========================================================================
# METRIC family — label + value (+ delta) pairs (ref-metric-*).
# ===========================================================================

class MetricProps {
    string name
    string label
    string value
    string delta
}

fn metric_props(string name, string label, string value, string delta) → MetricProps {
    return MetricProps { name = name, label = label, value = value, delta = delta }
}

# Metric: label + value (+ optional delta) in the benchmark grammar's
# definition-list pattern (dl/dt/dd — the stage-1 metric-table shape; the
# delivery done_when (a): "the benchmark grammar's metric pattern"). THE
# TEXTUAL FORM IS PRESERVED: the label + value (+ delta) are visible text —
# never replaced by a visualization. The a11y structure: the dl carries the
# ref-metric-<name> identity; dt = the label (the accessible label), dd =
# the value, an optional second dd = the delta ("" → no delta row).
fn metric(MetricProps props) → tela.View {
    var list<tela.View> children ← [
        tela.element_view(tela.html_space(), "dt", [ tela.text_view(props.label) ]),
        tela.element_view(tela.html_space(), "dd", [ tela.text_view(props.value) ])
    ]
    if not (props.delta ≡ "") {
        children.appende(tela.element_view(tela.html_space(), "dd", [ tela.text_view(props.delta) ]))
    }
    return tela.element_full(
        tela.new_identity("ref-metric-" + props.name),
        tela.html_space(),
        "dl",
        [],
        [],
        children
    )
}

# ===========================================================================
# TABLE family — the benchmark table grammar, semantic + accessible
# (ref-table-*; Stage 5 U4).
# ===========================================================================

class TableRow {
    list<string> cells
}

fn table_row(list<string> cells) → TableRow {
    return TableRow { cells = cells }
}

class TableProps {
    string name
    string caption
    list<string> headers
    list<TableRow> rows
}

fn table_props(string name, string caption, list<string> headers, list<TableRow> rows) → TableProps {
    return TableProps { name = name, caption = caption, headers = headers, rows = rows }
}

# The header-row cells: one <th> per header, each carrying the scope='col'
# attribute — the column association is the native th[scope] semantics
# (the §8 "table headers" contract). Stable identities
# ref-table-<name>-header-<i> (the interaction-case focus targets).
fn table_header_cells(string name, list<string> headers) → list<tela.View> {
    var list<tela.View> cells ← vacua
    var int i ← 0
    while i < headers.longitudo() {
        cells.appende(tela.element_full(
            tela.new_identity("ref-table-" + name + "-header-" + "§"(i)),
            tela.html_space(),
            "th",
            [ tela.Attribute { name = "scope", value = "col" } ],
            [],
            [ tela.text_view(headers[i]) ]
        ))
        i ← i + 1
    }
    return cells
}

# One body row: a <tr> of <td> cells. Stable identities
# ref-table-<name>-cell-<r>-<c> (the declared consumer-plan row-navigation
# focus targets).
fn table_body_cells(string name, int row, list<string> cells) → list<tela.View> {
    var list<tela.View> tds ← vacua
    var int i ← 0
    while i < cells.longitudo() {
        tds.appende(tela.element_full(
            tela.new_identity("ref-table-" + name + "-cell-" + "§"(row) + "-" + "§"(i)),
            tela.html_space(),
            "td",
            [],
            [],
            [ tela.text_view(cells[i]) ]
        ))
        i ← i + 1
    }
    return tds
}

# Table: the benchmark table grammar as a semantic composite — <table> →
# optional <caption> (the accessible name) → <thead> (one <tr> of
# <th scope='col'> header cells) → <tbody> (one <tr> per data row, each a
# <td> per cell). The NATIVE semantics ARE the a11y structure (screen
# readers expose the grid natively — no ARIA duplication); the header
# association rides th[scope]; the caption (or the app's recorded
# equivalent — an aria-label/off-screen equivalent is an app choice, the
# component never fabricates a name) provides the accessible name. The
# table is STATELESS — a declared keyboard/sort interaction stays in the
# consumer plan (the D1 app-typed boundary, recorded in the module header).
fn table(TableProps props) → tela.View {
    var list<tela.View> children ← vacua
    if not (props.caption ≡ "") {
        children.appende(tela.element_view(
            tela.html_space(),
            "caption",
            [ tela.text_view(props.caption) ]
        ))
    }
    children.appende(tela.element_view(
        tela.html_space(),
        "thead",
        [ tela.element_view(
            tela.html_space(),
            "tr",
            table_header_cells(props.name, props.headers)
        ) ]
    ))
    var list<tela.View> body_rows ← vacua
    var int r ← 0
    while r < props.rows.longitudo() {
        const TableRow row ← props.rows[r]
        body_rows.appende(tela.element_view(
            tela.html_space(),
            "tr",
            table_body_cells(props.name, r, row.cells)
        ))
        r ← r + 1
    }
    children.appende(tela.element_view(
        tela.html_space(),
        "tbody",
        body_rows
    ))
    return tela.element_full(
        tela.new_identity("ref-table-" + props.name),
        tela.html_space(),
        "table",
        [],
        [],
        children
    )
}

# ===========================================================================
# SEGMENTED-CONTROL family — the Stage 3 control re-homed (ref-seg-*;
# Stage 5 U5). The control is STATELESS — the D1 app-typed plan boundary
# (the message type + bindings + update loop + announcement semantics stay
# in the consumer, keyed to the ref-seg-* identities; the a11y contract is
# documented in the module header).
# ===========================================================================

class SegmentedProps {
    string name
    string label
    list<string> options
    string selected
}

fn segmented_props(string name, string label, list<string> options, string selected) → SegmentedProps {
    return SegmentedProps { name = name, label = label, options = options, selected = selected }
}

fn selected_text(bool selected) → string {
    if selected then return "true"
    return "false"
}

fn active_tabindex(bool selected) → string {
    if selected then return "0"
    return "-1"
}

# One segment: role=radio + aria-selected + the roving tabindex (the
# selected segment is the control's one tab stop, §1.3). Stable identity
# ref-seg-<name>-<i>.
fn segmented_option(string identity, string option, string tabindex, string selected) → tela.View {
    return tela.element_full(
        tela.new_identity(identity),
        tela.html_space(),
        "button",
        [
            tela.Attribute { name = "role", value = "radio" },
            tela.Attribute { name = "aria-selected", value = selected },
            tela.Attribute { name = "tabindex", value = tabindex }
        ],
        [],
        [ tela.text_view(option) ]
    )
}

# The control-owned declared live region (§1.5): explicitly marked with a
# live-region policy (role='status' / aria-live='polite'), owned by the
# control, not an ambient page notification. THE NO-OP RULE: the consumer's
# plan writes the announcement ONLY on a selection change — a no-op is
# SILENT.
fn segmented_live_region() → tela.View {
    return tela.element_full(
        tela.new_identity("ref-seg-live"),
        tela.html_space(),
        "div",
        [
            tela.Attribute { name = "role", value = "status" },
            tela.Attribute { name = "aria-live", value = "polite" }
        ],
        [],
        []
    )
}

# The segment children in focus order (1-based identities:
# ref-seg-<name>-1..N), followed by the control's live region.
fn segmented_options(SegmentedProps props) → list<tela.View> {
    var list<tela.View> options ← vacua
    var int i ← 1
    while i ≤ props.options.longitudo() {
        const string identity ← "ref-seg-" + props.name + "-" + "§"(i)
        const string option ← props.options[i - 1]
        const bool selected ← identity ≡ props.selected
        options.appende(segmented_option(identity, option, active_tabindex(selected), selected_text(selected)))
        i ← i + 1
    }
    options.appende(segmented_live_region())
    return options
}

# The segmented-control component: ordinary Faber over typed props (campaign
# §3 component contract) → a View keyed to stable data-tela identities.
# The group is role=radiogroup + the accessible name (aria-label).
fn segmented_control(SegmentedProps props) → tela.View {
    return tela.element_full(
        tela.new_identity("ref-seg-" + props.name),
        tela.html_space(),
        "div",
        [
            tela.Attribute { name = "role", value = "radiogroup" },
            tela.Attribute { name = "aria-label", value = props.label }
        ],
        [],
        segmented_options(props)
    )
}

# ===========================================================================
# BUTTON family — the first behavior component (ref-button-*; Stage 5 U6).
# The element is a NATIVE <button> (native semantics — no ARIA role); the
# accessible name is the label text or the aria-label override; the
# keyboard contract (Space/Enter) rides the native semantics; the disabled
# state is the native `disabled` attribute (no activation, the state
# exposed); the declared event surface rides the props' event_name. The
# component is STATELESS — the D1 app-typed plan boundary (the message
# type + bindings + update loop stay in the consumer, keyed to the
# ref-button-* identities; the a11y contract is documented in the module
# header).
# ===========================================================================

class ButtonProps {
    string name
    string label
    string variant_name
    string state
    string event_name
    string aria_label
}

fn button_props(string name, string label, string variant_name, string state, string event_name, string aria_label) → ButtonProps {
    return ButtonProps {
        name = name,
        label = label,
        variant_name = variant_name,
        state = state,
        event_name = event_name,
        aria_label = aria_label
    }
}

# The declared activation-event spelling (the event surface's documented
# default — "click"). The consumer plan binds the props' event_name.
fn button_event() → string {
    return "click"
}

# Button: native <button> semantics — no ARIA role (a role would duplicate
# the native semantics). The accessible name: the label text (native) or
# the declared aria-label override (the aria_label prop — the
# "label/aria-label" contract). The keyboard contract (Space/Enter
# activate) rides the native semantics — the plan binds ONLY the declared
# activation event. The disabled state: the native `disabled` attribute
# when state = "disabled" — the button leaves the tab sequence, no
# activation fires, the state is exposed natively. The variant_name (the
# visual treatment, token-keyed — never semantic) rides the
# data-ref-variant attribute. Attribute author order: aria-label (when
# present) → disabled (when disabled) → data-ref-variant → data-tela.
fn button(ButtonProps props) → tela.View {
    var list<tela.Attribute> attributes ← vacua
    if not (props.aria_label ≡ "") {
        attributes.appende(tela.Attribute { name = "aria-label", value = props.aria_label })
    }
    if props.state ≡ "disabled" {
        attributes.appende(tela.Attribute { name = "disabled", value = "" })
    }
    attributes.appende(tela.Attribute { name = "data-ref-variant", value = props.variant_name })
    return tela.element_full(
        tela.new_identity("ref-button-" + props.name),
        tela.html_space(),
        "button",
        attributes,
        [],
        [ tela.text_view(props.label) ]
    )
}

# ===========================================================================
# STYLE BUNDLES — rules keyed on the ref-* identities, referencing the
# ref.* tokens as CSS custom properties (the --ref-* emission form).
# ===========================================================================

fn layout_style() → tela.Style {
    return tela.Style {
        rules = [
            tela.Rule {
                selector = "[data-tela='ref-layout-stack']",
                declarations = [
                    tela.Declaration { name = "display", value = "flex" },
                    tela.Declaration { name = "flex-direction", value = "column" },
                    tela.Declaration { name = "gap", value = "var(--ref-layout-gap)" }
                ]
            },
            tela.Rule {
                selector = "[data-tela='ref-layout-grid']",
                declarations = [
                    tela.Declaration { name = "display", value = "grid" },
                    tela.Declaration { name = "grid-template-columns", value = "repeat(2, 1fr)" },
                    tela.Declaration { name = "gap", value = "var(--ref-layout-gap)" }
                ]
            },
            tela.Rule {
                selector = "[data-tela='ref-layout-prose']",
                declarations = [
                    tela.Declaration { name = "max-width", value = "var(--ref-layout-prose-measure)" },
                    tela.Declaration { name = "margin", value = "0 auto" }
                ]
            }
        ]
    }
}

# The heading scale: each level maps to a scale step token
# (h1 → xl, h2 → lg, h3 → md, h4 → sm, h5/h6 → xs).
fn typography_style() → tela.Style {
    return tela.Style {
        rules = [
            tela.Rule {
                selector = "[data-tela='ref-typography-heading-1']",
                declarations = [
                    tela.Declaration { name = "font-size", value = "var(--ref-type-scale-xl)" },
                    tela.Declaration { name = "font-weight", value = "var(--ref-type-heading-weight)" },
                    tela.Declaration { name = "margin", value = "var(--ref-type-heading-margin)" }
                ]
            },
            tela.Rule {
                selector = "[data-tela='ref-typography-heading-2']",
                declarations = [
                    tela.Declaration { name = "font-size", value = "var(--ref-type-scale-lg)" },
                    tela.Declaration { name = "font-weight", value = "var(--ref-type-heading-weight)" },
                    tela.Declaration { name = "margin", value = "var(--ref-type-heading-margin)" }
                ]
            },
            tela.Rule {
                selector = "[data-tela='ref-typography-heading-3']",
                declarations = [
                    tela.Declaration { name = "font-size", value = "var(--ref-type-scale-md)" },
                    tela.Declaration { name = "font-weight", value = "var(--ref-type-heading-weight)" },
                    tela.Declaration { name = "margin", value = "var(--ref-type-heading-margin)" }
                ]
            },
            tela.Rule {
                selector = "[data-tela='ref-typography-heading-4']",
                declarations = [
                    tela.Declaration { name = "font-size", value = "var(--ref-type-scale-sm)" },
                    tela.Declaration { name = "font-weight", value = "var(--ref-type-heading-weight)" },
                    tela.Declaration { name = "margin", value = "var(--ref-type-heading-margin)" }
                ]
            },
            tela.Rule {
                selector = "[data-tela='ref-typography-heading-5']",
                declarations = [
                    tela.Declaration { name = "font-size", value = "var(--ref-type-scale-xs)" },
                    tela.Declaration { name = "font-weight", value = "var(--ref-type-heading-weight)" },
                    tela.Declaration { name = "margin", value = "var(--ref-type-heading-margin)" }
                ]
            },
            tela.Rule {
                selector = "[data-tela='ref-typography-heading-6']",
                declarations = [
                    tela.Declaration { name = "font-size", value = "var(--ref-type-scale-xs)" },
                    tela.Declaration { name = "font-weight", value = "var(--ref-type-heading-weight)" },
                    tela.Declaration { name = "margin", value = "var(--ref-type-heading-margin)" }
                ]
            },
            tela.Rule {
                selector = "[data-tela='ref-typography-prose']",
                declarations = [
                    tela.Declaration { name = "font-size", value = "var(--ref-type-scale-md)" },
                    tela.Declaration { name = "line-height", value = "var(--ref-type-prose-line-height)" },
                    tela.Declaration { name = "margin", value = "var(--ref-type-prose-margin)" }
                ]
            },
            tela.Rule {
                selector = "[data-tela='ref-typography-scale-xs']",
                declarations = [
                    tela.Declaration { name = "font-size", value = "var(--ref-type-scale-xs)" }
                ]
            },
            tela.Rule {
                selector = "[data-tela='ref-typography-scale-sm']",
                declarations = [
                    tela.Declaration { name = "font-size", value = "var(--ref-type-scale-sm)" }
                ]
            },
            tela.Rule {
                selector = "[data-tela='ref-typography-scale-md']",
                declarations = [
                    tela.Declaration { name = "font-size", value = "var(--ref-type-scale-md)" }
                ]
            },
            tela.Rule {
                selector = "[data-tela='ref-typography-scale-lg']",
                declarations = [
                    tela.Declaration { name = "font-size", value = "var(--ref-type-scale-lg)" }
                ]
            },
            tela.Rule {
                selector = "[data-tela='ref-typography-scale-xl']",
                declarations = [
                    tela.Declaration { name = "font-size", value = "var(--ref-type-scale-xl)" }
                ]
            }
        ]
    }
}

# The panel style bundle: keyed on the ref-panel-* identity PREFIX (the
# variable-suffix form — the formslib precedent). The surface + border
# reference the ref.panel.* tokens, which resolve to the theme's core
# surface.panel / border.default (theme-surface semantics — no hardcoded
# color).
fn panel_style() → tela.Style {
    return tela.Style {
        rules = [
            tela.Rule {
                selector = "[data-tela^='ref-panel-']",
                declarations = [
                    tela.Declaration { name = "background", value = "var(--ref-panel-surface)" },
                    tela.Declaration { name = "border", value = "1px solid var(--ref-panel-border)" },
                    tela.Declaration { name = "border-radius", value = "var(--ref-panel-radius)" },
                    tela.Declaration { name = "padding", value = "var(--ref-panel-padding)" }
                ]
            }
        ]
    }
}

# The badge style bundle: keyed on the ref-badge-* identity prefix. Shapes
# the badge (size/padding/radius) but colors nothing semantic — a badge's
# meaning is textual (the status word + label), never color alone.
fn badge_style() → tela.Style {
    return tela.Style {
        rules = [
            tela.Rule {
                selector = "[data-tela^='ref-badge-']",
                declarations = [
                    tela.Declaration { name = "display", value = "inline-block" },
                    tela.Declaration { name = "font-size", value = "var(--ref-badge-size)" },
                    tela.Declaration { name = "padding", value = "var(--ref-badge-padding)" },
                    tela.Declaration { name = "border-radius", value = "var(--ref-badge-radius)" }
                ]
            }
        ]
    }
}

# The metric style bundle: keyed on the ref-metric-* identity prefix. The
# label/value typography; the label color references the theme's core
# text.muted (ref.metric.label.muted — no hardcoded color).
fn metric_style() → tela.Style {
    return tela.Style {
        rules = [
            tela.Rule {
                selector = "[data-tela^='ref-metric-']",
                declarations = [
                    tela.Declaration { name = "margin", value = "0" },
                    tela.Declaration { name = "padding", value = "0" }
                ]
            },
            tela.Rule {
                selector = "[data-tela^='ref-metric-'] dt",
                declarations = [
                    tela.Declaration { name = "font-size", value = "var(--ref-metric-label-size)" },
                    tela.Declaration { name = "color", value = "var(--ref-metric-label-muted)" }
                ]
            },
            tela.Rule {
                selector = "[data-tela^='ref-metric-'] dd",
                declarations = [
                    tela.Declaration { name = "font-size", value = "var(--ref-metric-value-size)" },
                    tela.Declaration { name = "font-weight", value = "var(--ref-metric-value-weight)" },
                    tela.Declaration { name = "margin", value = "0" }
                ]
            }
        ]
    }
}

# The table style bundle: keyed on the ref-table-* identity PREFIX (the
# variable-suffix form — the composite's cells carry the
# ref-table-<name>-header-*/cell-* identities). The border + caption
# color reference the theme's core tokens (ref.table.border →
# var(--border-default), ref.table.caption.muted → var(--text-muted)) —
# the table follows the selected theme's surface, no hardcoded color.
fn table_style() → tela.Style {
    return tela.Style {
        rules = [
            tela.Rule {
                selector = "[data-tela^='ref-table-']",
                declarations = [
                    tela.Declaration { name = "border-collapse", value = "collapse" },
                    tela.Declaration { name = "width", value = "100%" }
                ]
            },
            tela.Rule {
                selector = "[data-tela^='ref-table-'] th",
                declarations = [
                    tela.Declaration { name = "border", value = "1px solid var(--ref-table-border)" },
                    tela.Declaration { name = "padding", value = "var(--ref-table-padding)" },
                    tela.Declaration { name = "text-align", value = "left" },
                    tela.Declaration { name = "font-weight", value = "var(--ref-table-header-weight)" }
                ]
            },
            tela.Rule {
                selector = "[data-tela^='ref-table-'] td",
                declarations = [
                    tela.Declaration { name = "border", value = "1px solid var(--ref-table-border)" },
                    tela.Declaration { name = "padding", value = "var(--ref-table-padding)" },
                    tela.Declaration { name = "text-align", value = "left" }
                ]
            },
            tela.Rule {
                selector = "[data-tela^='ref-table-'] caption",
                declarations = [
                    tela.Declaration { name = "color", value = "var(--ref-table-caption-muted)" },
                    tela.Declaration { name = "text-align", value = "left" }
                ]
            }
        ]
    }
}

# The segmented-control style bundle: keyed on the ref-seg-* identity
# PREFIX plus the role (the group vs the segments — the prefix alone would
# match both). The group carries the flex layout + gap + radius; the
# segments carry the type scale + padding + border; the SELECTED segment
# border color references the theme's accent core token (the selected
# STATE is communicated by aria-selected — semantic — never by color
# alone; the accent border is decorative emphasis, campaign §8).
fn segmented_style() → tela.Style {
    return tela.Style {
        rules = [
            tela.Rule {
                selector = "[data-tela^='ref-seg-'][role='radiogroup']",
                declarations = [
                    tela.Declaration { name = "display", value = "flex" },
                    tela.Declaration { name = "gap", value = "var(--ref-seg-gap)" },
                    tela.Declaration { name = "border-radius", value = "var(--ref-seg-radius)" }
                ]
            },
            tela.Rule {
                selector = "[data-tela^='ref-seg-'][role='radio']",
                declarations = [
                    tela.Declaration { name = "font-size", value = "var(--ref-seg-size)" },
                    tela.Declaration { name = "padding", value = "var(--ref-seg-padding)" },
                    tela.Declaration { name = "border", value = "1px solid var(--ref-seg-border)" }
                ]
            },
            tela.Rule {
                selector = "[data-tela^='ref-seg-'][role='radio'][aria-selected='true']",
                declarations = [
                    tela.Declaration { name = "border-color", value = "var(--ref-seg-selected-border)" }
                ]
            }
        ]
    }
}

# The button style bundle: keyed on the ref-button-* identity PREFIX +
# the variant attribute (the visual treatment — never semantic) + the
# native state pseudo-classes. The shape rule (display/size/padding/
# border/radius + the base text color) references the ref.button.*
# tokens; the variant treatments reference the theme's core tokens (the
# primary background = the accent, the primary text = the inverse
# surface, secondary = the panel surface, ghost = the transparent
# neutral — the button never hardcodes a color). THE VISIBLE FOCUS
# (campaign §8): the :focus-visible rule draws the focus indicator from
# the ref.button.focus token (the theme's accent) — the indicator is
# never removed, no hardcoded color. THE DISABLED STATE: the :disabled
# rule dims the button (the ref.button.disabled.opacity token) — the
# SEMANTIC state rides the native disabled attribute (no activation,
# exposed to AT); the opacity is the visual treatment, never a
# color-only signal.
fn button_style() → tela.Style {
    return tela.Style {
        rules = [
            tela.Rule {
                selector = "[data-tela^='ref-button-']",
                declarations = [
                    tela.Declaration { name = "display", value = "inline-block" },
                    tela.Declaration { name = "font-size", value = "var(--ref-button-size)" },
                    tela.Declaration { name = "padding", value = "var(--ref-button-padding)" },
                    tela.Declaration { name = "border", value = "1px solid var(--ref-button-border)" },
                    tela.Declaration { name = "border-radius", value = "var(--ref-button-radius)" },
                    tela.Declaration { name = "color", value = "var(--ref-button-text)" }
                ]
            },
            tela.Rule {
                selector = "[data-tela^='ref-button-'][data-ref-variant='primary']",
                declarations = [
                    tela.Declaration { name = "background", value = "var(--ref-button-primary-background)" },
                    tela.Declaration { name = "color", value = "var(--ref-button-primary-text)" }
                ]
            },
            tela.Rule {
                selector = "[data-tela^='ref-button-'][data-ref-variant='secondary']",
                declarations = [
                    tela.Declaration { name = "background", value = "var(--ref-button-secondary-background)" }
                ]
            },
            tela.Rule {
                selector = "[data-tela^='ref-button-'][data-ref-variant='ghost']",
                declarations = [
                    tela.Declaration { name = "background", value = "var(--ref-button-ghost-background)" }
                ]
            },
            tela.Rule {
                selector = "[data-tela^='ref-button-']:focus-visible",
                declarations = [
                    tela.Declaration { name = "outline", value = "2px solid var(--ref-button-focus)" },
                    tela.Declaration { name = "outline-offset", value = "2px" }
                ]
            },
            tela.Rule {
                selector = "[data-tela^='ref-button-']:disabled",
                declarations = [
                    tela.Declaration { name = "opacity", value = "var(--ref-button-disabled-opacity)" },
                    tela.Declaration { name = "cursor", value = "not-allowed" }
                ]
            }
        ]
    }
}

# ===========================================================================
# TOKENS — the namespaced ref.* theme tokens (the kernel Token carrier,
# MF-7): zero-arg accessors returning tela.Token values; consumers collect
# them app-side into their Theme (the compose-without pattern).
# ===========================================================================

fn ref_layout_gap() → tela.Token {
    return tela.Token { name = "ref.layout.gap", value = "1rem" }
}

fn ref_layout_prose_measure() → tela.Token {
    return tela.Token { name = "ref.layout.prose.measure", value = "65ch" }
}

fn ref_type_scale_xs() → tela.Token {
    return tela.Token { name = "ref.type.scale.xs", value = "0.75rem" }
}

fn ref_type_scale_sm() → tela.Token {
    return tela.Token { name = "ref.type.scale.sm", value = "0.875rem" }
}

fn ref_type_scale_md() → tela.Token {
    return tela.Token { name = "ref.type.scale.md", value = "1rem" }
}

fn ref_type_scale_lg() → tela.Token {
    return tela.Token { name = "ref.type.scale.lg", value = "1.25rem" }
}

fn ref_type_scale_xl() → tela.Token {
    return tela.Token { name = "ref.type.scale.xl", value = "1.5rem" }
}

fn ref_type_heading_weight() → tela.Token {
    return tela.Token { name = "ref.type.heading.weight", value = "600" }
}

fn ref_type_heading_margin() → tela.Token {
    return tela.Token { name = "ref.type.heading.margin", value = "0 0 0.5rem 0" }
}

fn ref_type_prose_line_height() → tela.Token {
    return tela.Token { name = "ref.type.prose.line-height", value = "1.6" }
}

fn ref_type_prose_margin() → tela.Token {
    return tela.Token { name = "ref.type.prose.margin", value = "0 0 1rem 0" }
}

# The ref.panel.* tokens — the THEME-SURFACE semantics (Stage 5 U3): the
# color-bearing tokens (surface, border) reference the theme's core tokens
# (var(--surface-panel) / var(--border-default)) — the panel follows the
# selected theme's surface; radius/padding are neutral spacing values.
fn ref_panel_surface() → tela.Token {
    return tela.Token { name = "ref.panel.surface", value = "var(--surface-panel)" }
}

fn ref_panel_border() → tela.Token {
    return tela.Token { name = "ref.panel.border", value = "var(--border-default)" }
}

fn ref_panel_radius() → tela.Token {
    return tela.Token { name = "ref.panel.radius", value = "0.5rem" }
}

fn ref_panel_padding() → tela.Token {
    return tela.Token { name = "ref.panel.padding", value = "1rem" }
}

# The ref.badge.* tokens — badge shaping (size/padding/radius); nothing
# semantic rides color.
fn ref_badge_size() → tela.Token {
    return tela.Token { name = "ref.badge.size", value = "0.75rem" }
}

fn ref_badge_padding() → tela.Token {
    return tela.Token { name = "ref.badge.padding", value = "0.125rem 0.5rem" }
}

fn ref_badge_radius() → tela.Token {
    return tela.Token { name = "ref.badge.radius", value = "0.25rem" }
}

# The ref.metric.* tokens — the label/value typography; the label color
# references the theme's core text.muted (no hardcoded color).
fn ref_metric_label_size() → tela.Token {
    return tela.Token { name = "ref.metric.label.size", value = "0.875rem" }
}

fn ref_metric_label_muted() → tela.Token {
    return tela.Token { name = "ref.metric.label.muted", value = "var(--text-muted)" }
}

fn ref_metric_value_size() → tela.Token {
    return tela.Token { name = "ref.metric.value.size", value = "1.5rem" }
}

fn ref_metric_value_weight() → tela.Token {
    return tela.Token { name = "ref.metric.value.weight", value = "600" }
}

# The ref.table.* tokens — the table borders/typography; the border +
# caption color reference the theme's core tokens (no hardcoded color).
fn ref_table_border() → tela.Token {
    return tela.Token { name = "ref.table.border", value = "var(--border-default)" }
}

fn ref_table_padding() → tela.Token {
    return tela.Token { name = "ref.table.padding", value = "0.5rem 0.75rem" }
}

fn ref_table_header_weight() → tela.Token {
    return tela.Token { name = "ref.table.header.weight", value = "600" }
}

fn ref_table_caption_muted() → tela.Token {
    return tela.Token { name = "ref.table.caption.muted", value = "var(--text-muted)" }
}

# The ref.seg.* tokens — the segmented-control shaping; the border color
# references the theme's core tokens (the selected state is SEMANTIC —
# aria-selected — never color alone; the accent border is decorative).
fn ref_seg_gap() → tela.Token {
    return tela.Token { name = "ref.seg.gap", value = "0.25rem" }
}

fn ref_seg_radius() → tela.Token {
    return tela.Token { name = "ref.seg.radius", value = "0.375rem" }
}

fn ref_seg_size() → tela.Token {
    return tela.Token { name = "ref.seg.size", value = "0.875rem" }
}

fn ref_seg_padding() → tela.Token {
    return tela.Token { name = "ref.seg.padding", value = "0.5rem 0.75rem" }
}

fn ref_seg_border() → tela.Token {
    return tela.Token { name = "ref.seg.border", value = "var(--border-default)" }
}

fn ref_seg_selected_border() → tela.Token {
    return tela.Token { name = "ref.seg.selected.border", value = "var(--accent-primary)" }
}

# The ref.button.* tokens (Stage 5 U6) — the button shape + the variant
# treatments + the visible-focus + the disabled treatment. The
# color-bearing tokens reference the theme's core tokens (the primary
# background = the accent, the primary text = the inverse surface, the
# secondary background = the panel surface, the focus = the accent — no
# hardcoded color); the ghost background = the borderless neutral
# ("transparent" is a value, never a semantic color — the button's
# meaning is never color alone).
fn ref_button_size() → tela.Token {
    return tela.Token { name = "ref.button.size", value = "0.875rem" }
}

fn ref_button_padding() → tela.Token {
    return tela.Token { name = "ref.button.padding", value = "0.5rem 1rem" }
}

fn ref_button_radius() → tela.Token {
    return tela.Token { name = "ref.button.radius", value = "0.25rem" }
}

fn ref_button_border() → tela.Token {
    return tela.Token { name = "ref.button.border", value = "var(--border-default)" }
}

fn ref_button_text() → tela.Token {
    return tela.Token { name = "ref.button.text", value = "var(--text-primary)" }
}

fn ref_button_primary_background() → tela.Token {
    return tela.Token { name = "ref.button.primary.background", value = "var(--accent-primary)" }
}

fn ref_button_primary_text() → tela.Token {
    return tela.Token { name = "ref.button.primary.text", value = "var(--surface-canvas)" }
}

fn ref_button_secondary_background() → tela.Token {
    return tela.Token { name = "ref.button.secondary.background", value = "var(--surface-panel)" }
}

fn ref_button_ghost_background() → tela.Token {
    return tela.Token { name = "ref.button.ghost.background", value = "transparent" }
}

fn ref_button_focus() → tela.Token {
    return tela.Token { name = "ref.button.focus", value = "var(--accent-primary)" }
}

fn ref_button_disabled_opacity() → tela.Token {
    return tela.Token { name = "ref.button.disabled.opacity", value = "0.6" }
}

# The catalog's token collection (the self-usable summary — consumers
# compose their Theme via the individual accessors; this is the package's
# assembly-input convenience, the formslib precedent).
fn reference_tokens() → list<tela.Token> {
    return [
        ref_layout_gap(),
        ref_layout_prose_measure(),
        ref_type_scale_xs(),
        ref_type_scale_sm(),
        ref_type_scale_md(),
        ref_type_scale_lg(),
        ref_type_scale_xl(),
        ref_type_heading_weight(),
        ref_type_heading_margin(),
        ref_type_prose_line_height(),
        ref_type_prose_margin(),
        ref_panel_surface(),
        ref_panel_border(),
        ref_panel_radius(),
        ref_panel_padding(),
        ref_badge_size(),
        ref_badge_padding(),
        ref_badge_radius(),
        ref_metric_label_size(),
        ref_metric_label_muted(),
        ref_metric_value_size(),
        ref_metric_value_weight(),
        ref_table_border(),
        ref_table_padding(),
        ref_table_header_weight(),
        ref_table_caption_muted(),
        ref_seg_gap(),
        ref_seg_radius(),
        ref_seg_size(),
        ref_seg_padding(),
        ref_seg_border(),
        ref_seg_selected_border(),
        ref_button_size(),
        ref_button_padding(),
        ref_button_radius(),
        ref_button_border(),
        ref_button_text(),
        ref_button_primary_background(),
        ref_button_primary_text(),
        ref_button_secondary_background(),
        ref_button_ghost_background(),
        ref_button_focus(),
        ref_button_disabled_opacity()
    ]
}
