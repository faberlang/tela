}

# Prefix + role: the prefix alone would match both the group and the segments.
@ public
fn segmented_style() → tela.Style {
    return tela.Style {
        rules = [
            tela.Rule {
                selector = "[data-tela^='ref-seg-'][role='radiogroup']",
                declarations = [
                    tela.Declaration { name = "display", value = "flex" },
                    tela.Declaration { name = "gap", value = "var(--ref-seg-gap)" },
                    tela.Declaration { name = "border-radius", value = "var(--ref-seg-radius)" }
                ]
            },
            tela.Rule {
                selector = "[data-tela^='ref-seg-'][role='radio']",
                declarations = [
                    tela.Declaration { name = "font-size", value = "var(--ref-seg-size)" },
                    tela.Declaration { name = "padding", value = "var(--ref-seg-padding)" },
                    tela.Declaration { name = "border", value = "1px solid var(--ref-seg-border)" }
                ]
            },
            tela.Rule {
                selector = «[data-tela^='ref-seg-'][role='radio'][aria-selected="true"]»,
                declarations = [
                    tela.Declaration { name = "border-color", value = "var(--ref-seg-selected-border)" }
                ]
            }
        ]
    }
}

@ public
fn button_style() → tela.Style {
    return tela.Style {
        rules = [
            tela.Rule {
                selector = "[data-tela^='ref-button-']",
                declarations = [
                    tela.Declaration { name = "display", value = "inline-block" },
                    tela.Declaration { name = "font-size", value = "var(--ref-button-size)" },
                    tela.Declaration { name = "padding", value = "var(--ref-button-padding)" },
                    tela.Declaration { name = "border", value = "1px solid var(--ref-button-border)" },
                    tela.Declaration { name = "border-radius", value = "var(--ref-button-radius)" },
                    tela.Declaration { name = "color", value = "var(--ref-button-text)" }
                ]
            },
            tela.Rule {
                selector = "[data-tela^='ref-button-'][data-ref-variant='primary']",
                declarations = [
                    tela.Declaration { name = "background", value = "var(--ref-button-primary-background)" },
                    tela.Declaration { name = "color", value = "var(--ref-button-primary-text)" }
                ]
            },
            tela.Rule {
                selector = "[data-tela^='ref-button-'][data-ref-variant='secondary']",
                declarations = [
                    tela.Declaration { name = "background", value = "var(--ref-button-secondary-background)" }
                ]
            },
            tela.Rule {
                selector = "[data-tela^='ref-button-'][data-ref-variant='ghost']",
                declarations = [
                    tela.Declaration { name = "background", value = "var(--ref-button-ghost-background)" }
                ]
            },
            tela.Rule {
                selector = "[data-tela^='ref-button-']:focus-visible",
                declarations = [
                    tela.Declaration { name = "outline", value = "2px solid var(--ref-button-focus)" },
                    tela.Declaration { name = "outline-offset", value = "2px" }
                ]
            },
            tela.Rule {
                selector = "[data-tela^='ref-button-']:disabled",
                declarations = [
                    tela.Declaration { name = "opacity", value = "var(--ref-button-disabled-opacity)" },
                    tela.Declaration { name = "cursor", value = "not-allowed" }
                ]
            }
        ]
    }
}

@ public
fn field_style() → tela.Style {
    return tela.Style {
        rules = [
            tela.Rule {
                selector = "[data-tela^='form-field-']",
                declarations = [
                    tela.Declaration { name = "border-bottom", value = "2px solid var(--form-field-invalid)" },
                    tela.Declaration { name = "color", value = "var(--form-field-valid)" }
                ]
            },
            tela.Rule {
                selector = "[data-tela^='form-field-']:focus",
                declarations = [
                    tela.Declaration { name = "outline", value = "2px solid var(--form-focus)" }
                ]
            },
            tela.Rule {
                selector = "[data-tela^='form-error-']",
                declarations = [
                    tela.Declaration { name = "color", value = "var(--form-field-invalid)" },
                    tela.Declaration { name = "font-size", value = "0.875rem" }
                ]
            },
            tela.Rule {
                selector = "[data-tela='form-live']",
                declarations = [
                    tela.Declaration { name = "font-weight", value = "600" },
                    tela.Declaration { name = "color", value = "var(--form-field-valid)" }
                ]
            },
            tela.Rule {
                selector = "[data-tela^='form-field-']:disabled",
                declarations = [
                    tela.Declaration { name = "opacity", value = "0.6" },
                    tela.Declaration { name = "cursor", value = "not-allowed" }
                ]
            }
        ]
    }
}

