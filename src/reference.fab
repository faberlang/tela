# Accessor names are formslib-collision-free; token names stay form.field.* / form.focus.
@ public
fn field_invalid_token() → tela.Token {
    return tela.Token { name = "form.field.invalid", value = "#dc2626" }
}

@ public
fn field_valid_token() → tela.Token {
    return tela.Token { name = "form.field.valid", value = "#16a34a" }
}

@ public
fn field_focus_token() → tela.Token {
    return tela.Token { name = "form.focus", value = "#2563eb" }
}

# Assembly-input convenience; consumers may still collect accessors individually.
@ public
fn reference_tokens() → list<tela.Token> {
    return [
        ref_layout_gap(),
        ref_layout_prose_measure(),
        ref_type_scale_xs(),
        ref_type_scale_sm(),
        ref_type_scale_md(),
        ref_type_scale_lg(),
        ref_type_scale_xl(),
        ref_type_heading_weight(),
        ref_type_heading_margin(),
        ref_type_prose_line_height(),
        ref_type_prose_margin(),
        ref_panel_surface(),
        ref_panel_border(),
        ref_panel_radius(),
        ref_panel_padding(),
        ref_badge_size(),
        ref_badge_padding(),
        ref_badge_radius(),
        ref_metric_label_size(),
        ref_metric_label_muted(),
        ref_metric_value_size(),
        ref_metric_value_weight(),
        ref_table_border(),
        ref_table_padding(),
        ref_table_header_weight(),
        ref_table_caption_muted(),
        ref_seg_gap(),
        ref_seg_radius(),
        ref_seg_size(),
        ref_seg_padding(),
        ref_seg_border(),
        ref_seg_selected_border(),
        ref_button_size(),
        ref_button_padding(),
        ref_button_radius(),
        ref_button_border(),
        ref_button_text(),
        ref_button_primary_background(),
        ref_button_primary_text(),
        ref_button_secondary_background(),
        ref_button_ghost_background(),
        ref_button_focus(),
        ref_button_disabled_opacity(),
        field_invalid_token(),
        field_valid_token(),
        field_focus_token()
    ]
}
